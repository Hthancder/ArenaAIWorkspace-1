++ (void)applyStaticToLabel:(UIView *)textElement
+               withSummary:(NSString *)summary
+              originalText:(NSString *)originalText
+               isStreaming:(BOOL)isStreaming
+                    config:(DigestBannerRenderConfig *)config
+                layoutHost:(UIView *)layoutHost {
+    if (!textElement || !summary) return;
+    NSString *staticKey = buildStaticRenderKey(summary, originalText, isStreaming, config);
+    if (!isStreaming &&
+        [objc_getAssociatedObject(textElement, kDigestLastStaticKey) isEqualToString:staticKey] &&
+        elementHasDigestStyledAttribute(textElement)) {
+        return;
+    }
+
+    if (!isStreaming) {
+        [self stopForLabel:textElement];
+    }
+    UIImage *badgeImg = nil;
+    NSAttributedString *out = [self buildStaticAttributedForElement:textElement
+                                                        withSummary:summary
+                                                       originalText:originalText
+                                                        isStreaming:isStreaming
+                                                             config:config
+                                                      retainedImage:&badgeImg];
+    objc_setAssociatedObject(textElement, kDigestStaticImgKey, badgeImg, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    objc_setAssociatedObject(textElement, kDigestLastStaticKey, staticKey, OBJC_ASSOCIATION_COPY_NONATOMIC);
+    applyAttributedTextToElement(textElement, out, 4);
+
+    if (isStreaming) {
+        ensureStreamShimmerMaskOnElement(textElement);
+    }
+
+    [textElement invalidateIntrinsicContentSize];
+    [layoutHost setNeedsLayout];
+}
+
++ (void)stopForLabel:(UIView *)textElement {
+    if (!textElement) return;
+    nextElementAnimGeneration(textElement);
+    clearGPUEffectsOnElement(textElement);
+    DigestLabelAnimState *state = objc_getAssociatedObject(textElement, kDigestAnimStateKey);
+    if (state) {
+        [state invalidate];
+        objc_setAssociatedObject(textElement, kDigestAnimStateKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+}
