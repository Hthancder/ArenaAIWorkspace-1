+
+- (id)safeObjectForKey:(NSString *)key {
+    if (key.length == 0) return nil;
+    CFPreferencesAppSynchronize((__bridge CFStringRef)kDigestAppID);
+    CFPropertyListRef cfVal = CFPreferencesCopyAppValue((__bridge CFStringRef)key, (__bridge CFStringRef)kDigestAppID);
+    if (cfVal) {
+        return CFBridgingRelease(cfVal);
+    }
+    return [self objectForKey:key];
+}
+
+- (void)setSafeObject:(id)value forKey:(NSString *)key notify:(BOOL)notify {
+    if (key.length == 0) return;
+    if (value) {
+        [self setObject:value forKey:key];
+    } else {
+        [self removeObjectForKey:key];
+    }
+    [self synchronize];
+    CFPreferencesSetAppValue((__bridge CFStringRef)key, (__bridge CFPropertyListRef)value, (__bridge CFStringRef)kDigestAppID);
+    CFPreferencesAppSynchronize((__bridge CFStringRef)kDigestAppID);
+    if (notify) {
+        CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (__bridge CFStringRef)kDigestDarwinNotify, NULL, NULL, true);
+    }
+}
+
+- (void)removeSafeObjectForKey:(NSString *)key notify:(BOOL)notify {
+    if (key.length == 0) return;
+    [self removeObjectForKey:key];
+    [self synchronize];
+    CFPreferencesSetAppValue((__bridge CFStringRef)key, NULL, (__bridge CFStringRef)kDigestAppID);
+    CFPreferencesAppSynchronize((__bridge CFStringRef)kDigestAppID);
+    if (notify) {
+        CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (__bridge CFStringRef)kDigestDarwinNotify, NULL, NULL, true);
+    }
+}
+@end
