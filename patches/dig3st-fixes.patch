+static void renderExpandedController(UIViewController *vc) {
+    if (!vc || !showOriginalInExpanded) return;
+    @try {
+        NCNotificationRequest *req = nil;
+        if ([vc respondsToSelector:@selector(notificationRequest)]) {
+            req = [(id)vc notificationRequest];
+        }
+        if (!req || !req.dig3st) return;
+
+        UIView *platter = nil;
+        if ([vc respondsToSelector:@selector(_expandedPlatterViewIfLoaded)]) {
+            platter = [(id)vc _expandedPlatterViewIfLoaded];
+        }
+        if (!platter) {
+            @try { platter = [vc valueForKey:@"_expandedPlatterView"]; } @catch (NSException *e) {}
+        }
+        UIView *seamless = nil;
+        if (platter) {
+            @try { seamless = [platter valueForKey:@"notificationContentView"]; } @catch (NSException *e) {}
+        }
+        if (!seamless) {
+            seamless = findSeamlessContentViewInHierarchy(vc.view);
+        }
+        if (!seamless) return;
+
+        UIView *messageEl = nil;
+        @try { messageEl = [seamless valueForKey:@"secondaryTextElement"]; } @catch (NSException *e) {}
+        NSString *msgText = safeKVCString(req.content, @"message");
+        NSString *origText = safeKVCString(req, @"actualMessage");
+        if (!messageEl || !msgText) return;
+
+        @try {
+            [seamless setValue:@(0) forKey:@"secondaryTextMaximumNumberOfLines"];
+            if (platter) [platter setValue:@(0) forKey:@"maximumNumberOfSecondaryTextLines"];
+        } @catch (NSException *e) {}
+
+        DigestBannerRenderConfig *cfg = currentBannerRenderConfig();
+        [DigestBannerAnimator renderExpandedToLabel:messageEl withSummary:msgText originalText:origText config:cfg layoutHost:seamless];
+        relayoutControllerPreferredSize(vc, seamless, platter);
+    } @catch (NSException *e) {
+        NSLog(@"dig3st expanded render error: %@", e);
+    }
+}
+
+static void renderControllerBanner(NCNotificationShortLookViewController *vc) {
+    if (!vc || !vc.notificationRequest) return;
+    @try {
+        if ([vc isKindOfClass:NSClassFromString(@"NCExpandedPlatterViewController")]) {
+            renderExpandedController(vc);
+            return;
+        }
+        UIView *seamlessContentView = findContentViewForController(vc);
+        if (!seamlessContentView) return;
+
+        UIView *messageEl = nil;
+        @try {
+            messageEl = [seamlessContentView valueForKey:@"secondaryTextElement"];
+        } @catch (NSException *e) {}
+        NSString *msgText = safeKVCString(vc.notificationRequest.content, @"message");
+        if (!messageEl || !msgText) return;
+
+        UIView *preview = (UIView *)vc.viewForPreview;
+
+        if (!vc.notificationRequest.dig3st) {
+            [DigestBannerAnimator stopForLabel:messageEl];
+            if ([messageEl isKindOfClass:[UILabel class]]) {
+                ((UILabel *)messageEl).text = msgText;
+            } else if ([messageEl isKindOfClass:[UITextView class]]) {
+                ((UITextView *)messageEl).text = msgText;
+            }
+            [messageEl invalidateIntrinsicContentSize];
+            [seamlessContentView setNeedsLayout];
+            relayoutControllerPreferredSize(vc, seamlessContentView, preview);
+            return;
+        }
+
+        @try {
+            [seamlessContentView setValue:@(4) forKey:@"secondaryTextMaximumNumberOfLines"];
+            if (preview) [preview setValue:@(4) forKey:@"maximumNumberOfSecondaryTextLines"];
+        } @catch (NSException *e) {}
+
+        NSString *origText = safeKVCString(vc.notificationRequest, @"actualMessage");
+        DigestBannerRenderConfig *cfg = currentBannerRenderConfig();
+
+        BOOL isStreaming = NO;
+        @try {
+            isStreaming = [[vc.notificationRequest valueForKey:@"dig3stStreaming"] boolValue];
+        } @catch (NSException *e) {}
+
+        __weak NCNotificationShortLookViewController *weakVC = vc;
+        __weak UIView *weakCV = seamlessContentView;
+        __weak UIView *weakPreview = preview;
+
+        [DigestBannerAnimator updateLabel:messageEl
+                              withSummary:msgText
+                             originalText:origText
+                              isStreaming:isStreaming
+                                   config:cfg
+                               layoutHost:seamlessContentView
+                            onLayoutDelta:^{
+            relayoutControllerPreferredSize(weakVC, weakCV, weakPreview);
+        }];
+    } @catch (NSException *e) {
+        NSLog(@"dig3st render error: %@", e);
+    }
+}
