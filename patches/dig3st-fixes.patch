+static void *kDigestSizingGuard = &kDigestSizingGuard;
+
+static void relayoutControllerPreferredSize(UIViewController *vc, UIView *seamlessContentView, UIView *platterView) {
+    if (!vc || !seamlessContentView) return;
+    if ([objc_getAssociatedObject(vc, kDigestSizingGuard) boolValue]) return;
+    objc_setAssociatedObject(vc, kDigestSizingGuard, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    @try {
+        [seamlessContentView invalidateIntrinsicContentSize];
+        [seamlessContentView setNeedsLayout];
+        [seamlessContentView layoutIfNeeded];
+        if (platterView) {
+            [platterView invalidateIntrinsicContentSize];
+            [platterView setNeedsLayout];
+            [platterView layoutIfNeeded];
+        }
+        UIView *measureView = platterView ?: vc.view;
+        CGFloat w = measureView.bounds.size.width;
+        if (w <= 0) w = vc.view.bounds.size.width;
+        if (w > 0) {
+            CGSize fit = [measureView sizeThatFits:CGSizeMake(w, CGFLOAT_MAX)];
+            if (fit.height > 0 && fabs(fit.height - vc.preferredContentSize.height) > 0.5) {
+                vc.preferredContentSize = CGSizeMake(w, fit.height);
+            }
+        }
+        if ([vc respondsToSelector:@selector(_updatePreferredContentSize)]) {
+            [(id)vc _updatePreferredContentSize];
+        }
+        UIViewController *parent = vc.parentViewController;
+        if (parent) {
+            if (vc.preferredContentSize.height > 0 &&
+                parent.preferredContentSize.height != vc.preferredContentSize.height &&
+                [parent isKindOfClass:NSClassFromString(@"NCNotificationPresentableViewController")]) {
+                parent.preferredContentSize = vc.preferredContentSize;
+            }
+            [parent preferredContentSizeDidChangeForChildContentContainer:vc];
+            if ([parent respondsToSelector:@selector(presentableContext)]) {
+                id ctx = [(id)parent presentableContext];
+                if ([ctx respondsToSelector:@selector(setHostNeedsUpdate)]) {
+                    [(id)ctx setHostNeedsUpdate];
+                }
+            }
+            [parent.view setNeedsLayout];
+        }
+        [vc.view.superview invalidateIntrinsicContentSize];
+        [vc.view.superview setNeedsLayout];
+    } @catch (NSException *e) {}
+    objc_setAssociatedObject(vc, kDigestSizingGuard, @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
