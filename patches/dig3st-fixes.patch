+static DigestBannerRenderConfig *currentBannerRenderConfig(void) {
+    DigestBannerRenderConfig *cfg = [DigestBannerRenderConfig new];
+    cfg.badgeStyle = bannerBadgeStyle;
+    cfg.showPrefix = bannerShowPrefix;
+    cfg.prefixText = bannerPrefixText;
+    cfg.accentColorKey = bannerAccentColor;
+    cfg.boldSummary = bannerBoldSummary;
+    cfg.showOriginalLine = bannerShowOriginal;
+    cfg.animationStyle = streamAnimationStyle;
+    if (!cachedArrowImage && imgData.length > 0) {
+        cachedArrowImage = [[UIImage alloc] initWithData:imgData scale:[[UIScreen mainScreen] scale]];
+    }
+    cfg.arrowImage = cachedArrowImage;
+    return cfg;
+}
+
+static UIView *findSeamlessContentViewInHierarchy(UIView *rootView) {
+    if (!rootView) return nil;
+    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:rootView];
+    Class seamlessCls = NSClassFromString(@"NCNotificationSeamlessContentView");
+    NSUInteger visited = 0;
+    while (queue.count > 0 && visited < 64) {
+        UIView *v = queue.firstObject;
+        [queue removeObjectAtIndex:0];
+        visited++;
+        if (seamlessCls && [v isKindOfClass:seamlessCls]) {
+            return v;
+        }
+        [queue addObjectsFromArray:v.subviews];
+    }
+    return nil;
+}
+
+static UIView *findContentViewForController(NCNotificationShortLookViewController *vc) {
+    UIView *preview = (UIView *)vc.viewForPreview;
+    UIView *cv = nil;
+    @try {
+        cv = [preview valueForKey:@"notificationContentView"];
+    } @catch (NSException *e) {}
+    if (cv) return cv;
+    return findSeamlessContentViewInHierarchy(vc.view);
+}
