+	titleLbl.translatesAutoresizingMaskIntoConstraints = NO;
+	titleLbl.text = @"Minh · Nhóm Dự Án";
+	titleLbl.font = [UIFont systemFontOfSize:14.0 weight:UIFontWeightSemibold];
+	titleLbl.textColor = [UIColor labelColor];
+
+	UILabel *bodyLbl = [UILabel new];
+	bodyLbl.translatesAutoresizingMaskIntoConstraints = NO;
+	bodyLbl.font = [UIFont systemFontOfSize:13.5];
+	bodyLbl.textColor = [UIColor labelColor];
+	bodyLbl.numberOfLines = 0;
+	bodyLbl.preferredMaxLayoutWidth = MAX(200.0, w - 60.0);
+	self.previewBodyLabel = bodyLbl;
+
+	[card addSubview:appIcon];
+	[card addSubview:appLabel];
+	[card addSubview:expBtn];
+	[card addSubview:demoBtn];
