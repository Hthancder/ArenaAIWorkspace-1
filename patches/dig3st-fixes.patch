+static void renderControllerBanner(NCNotificationShortLookViewController *vc) {
+    if (!vc || !vc.notificationRequest) return;
+    @try {
+        if ([vc isKindOfClass:NSClassFromString(@"NCExpandedPlatterViewController")]) {
+            renderExpandedController(vc);
+            return;
+        }
+        UIView *seamlessContentView = findContentViewForController(vc);
+        if (!seamlessContentView) return;
+
+        UIView *messageEl = nil;
+        @try {
+            messageEl = [seamlessContentView valueForKey:@"secondaryTextElement"];
+        } @catch (NSException *e) {}
+        NSString *msgText = safeKVCString(vc.notificationRequest.content, @"message");
+        if (!messageEl || !msgText) return;
+
+        UIView *preview = (UIView *)vc.viewForPreview;
+        NCNotificationRequest *req = vc.notificationRequest;
+
+        if (!req.dig3st) {
+            [DigestBannerAnimator stopForLabel:messageEl];
+            if ([messageEl isKindOfClass:[UILabel class]]) {
+                UILabel *lbl = (UILabel *)messageEl;
+                lbl.attributedText = nil;
+                lbl.text = msgText;
+            } else if ([messageEl isKindOfClass:[UITextView class]]) {
+                UITextView *tv = (UITextView *)messageEl;
+                tv.attributedText = nil;
+                tv.text = msgText;
+            }
+            if ([vc respondsToSelector:@selector(_updateWithProvidedStaticContent)]) {
+                [vc _updateWithProvidedStaticContent];
+            }
+            [messageEl invalidateIntrinsicContentSize];
+            [seamlessContentView setNeedsLayout];
+            relayoutControllerPreferredSize(vc, seamlessContentView, preview);
+            return;
+        }
+
+        NSString *origText = safeKVCString(req, @"actualMessage");
+        DigestBannerRenderConfig *cfg = currentBannerRenderConfig();
+
+        BOOL isStreaming = NO;
+        @try {
+            isStreaming = [[req valueForKey:@"dig3stStreaming"] boolValue];
+        } @catch (NSException *e) {}
+
+        BOOL alreadyDone = (!isStreaming && req.dig3stAnimDone && [req.dig3stAnimKey isEqualToString:msgText]);
+        if (alreadyDone && [DigestBannerAnimator isLabelStaticUpToDate:messageEl
+                                                             withSummary:msgText
+                                                            originalText:origText
+                                                             isStreaming:NO
+                                                                  config:cfg]) {
+            return;
+        }
+
+        @try {
+            id curSecLines = [seamlessContentView valueForKey:@"secondaryTextMaximumNumberOfLines"];
+            if (![curSecLines isKindOfClass:[NSNumber class]] || [curSecLines unsignedIntegerValue] != 4) {
+                [seamlessContentView setValue:@(4) forKey:@"secondaryTextMaximumNumberOfLines"];
+            }
+            if (preview) {
+                id curPrevLines = [preview valueForKey:@"maximumNumberOfSecondaryTextLines"];
+                if (![curPrevLines isKindOfClass:[NSNumber class]] || [curPrevLines unsignedIntegerValue] != 4) {
+                    [preview setValue:@(4) forKey:@"maximumNumberOfSecondaryTextLines"];
+                }
+            }
+            if ([seamlessContentView respondsToSelector:@selector(_updateTextAttributesIfNecessary)]) {
+                [(NCNotificationSeamlessContentView *)seamlessContentView _updateTextAttributesIfNecessary];
+            }
+        } @catch (NSException *e) {}
+
+        __weak NCNotificationShortLookViewController *weakVC = vc;
+        __weak UIView *weakCV = seamlessContentView;
+        __weak UIView *weakPreview = preview;
+        __weak NCNotificationRequest *weakReq = req;
+
+        [DigestBannerAnimator updateLabel:messageEl
+                              withSummary:msgText
+                             originalText:origText
+                              isStreaming:isStreaming
+                          alreadyAnimated:alreadyDone
+                                   config:cfg
+                               layoutHost:seamlessContentView
+                            onLayoutDelta:^{
+            relayoutControllerPreferredSize(weakVC, weakCV, weakPreview);
+        }
+                      onAnimationComplete:^(NSString *completedSummary) {
+            NCNotificationRequest *strongReq = weakReq;
+            if (strongReq && completedSummary.length > 0) {
+                strongReq.dig3stAnimDone = YES;
+                strongReq.dig3stAnimKey = completedSummary;
+            }
+        }];
+    } @catch (NSException *e) {
+        NSLog(@"dig3st render error: %@", e);
+    }
+}
