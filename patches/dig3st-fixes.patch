+}
+
+- (void)refreshPreviewBannerStreaming:(BOOL)streaming text:(NSString *)overrideText {
+	[self refreshPreviewBannerStreaming:streaming text:overrideText animateReveal:NO];
+}
+
+- (void)refreshPreviewBannerStreaming:(BOOL)streaming text:(NSString *)overrideText animateReveal:(BOOL)animateReveal {
+	if (!self.previewBodyLabel) return;
+	NSString *sampleSummary = overrideText ?: @"Minh hẹn 7h tối nay gặp ở quán cũ Nguyễn Huệ để chốt slide.";
+	NSString *sampleOriginal = @"Ê tối nay rảnh không, tầm 7h qua quán cũ chỗ Nguyễn Huệ ngồi chút nha để mình chốt nốt slide thuyết trình ngày mai luôn. Nhớ mang theo USB file thiết kế nhé!";
+	DigestBannerRenderConfig *cfg = [self currentPreviewConfig];
+
+	if (self.expandedPreviewMode) {
+		[DigestBannerAnimator renderExpandedToLabel:self.previewBodyLabel
+										withSummary:sampleSummary
+									   originalText:sampleOriginal
+											 config:cfg
+										 layoutHost:self.previewCardView];
+		[self resizeTableHeaderToFit];
+		return;
+	}
+
+	__weak typeof(self) weakSelf = self;
+	[DigestBannerAnimator updateLabel:self.previewBodyLabel
+						  withSummary:sampleSummary
+						 originalText:sampleOriginal
+						  isStreaming:streaming
+					  alreadyAnimated:(!streaming && !animateReveal)
+							   config:cfg
+						   layoutHost:self.previewCardView
+						onLayoutDelta:^{
+		[weakSelf resizeTableHeaderToFit];
+	}
+				  onAnimationComplete:nil];
+	[self resizeTableHeaderToFit];
+}
+
+- (void)playStreamDemo {
+	self.demoGeneration++;
+	if (self.expandedPreviewMode) {
+		self.expandedPreviewMode = NO;
+		[self updateExpandButtonAppearance];
+		[self updatePreviewModeBadge];
+	}
+	NSUInteger gen = self.demoGeneration;
+	[DigestBannerAnimator stopForLabel:self.previewBodyLabel];
+
+	NSArray<NSString *> *steps = @[
+		@"Minh",
+		@"Minh hẹn 7h",
+		@"Minh hẹn 7h tối nay",
+		@"Minh hẹn 7h tối nay gặp ở",
+		@"Minh hẹn 7h tối nay gặp ở quán cũ",
+		@"Minh hẹn 7h tối nay gặp ở quán cũ Nguyễn Huệ",
+		@"Minh hẹn 7h tối nay gặp ở quán cũ Nguyễn Huệ để chốt slide."
+	];
+
+	__weak typeof(self) weakSelf = self;
+	[self refreshPreviewBannerStreaming:YES text:@"Đang tóm tắt…" animateReveal:NO];
+	for (NSUInteger i = 0; i < steps.count; i++) {
+		BOOL isLast = (i == steps.count - 1);
+		double delay = 0.22 + (i * 0.20);
+		dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+			__strong typeof(weakSelf) strongSelf = weakSelf;
+			if (!strongSelf || strongSelf.demoGeneration != gen) return;
+			[strongSelf refreshPreviewBannerStreaming:!isLast text:steps[i] animateReveal:isLast];
+		});
+	}
+}
+
+- (id)readPreferenceValue:(PSSpecifier *)specifier {
+	DigestPrefsManager *manager = [self prefs];
+	id val = [manager safeObjectForKey:specifier.properties[@"key"]];
+	return val ?: specifier.properties[@"default"];
+}
+
+- (void)setPreferenceValue:(id)value specifier:(PSSpecifier *)specifier {
+	[super setPreferenceValue:value specifier:specifier];
+	NSString *key = specifier.properties[@"key"];
+	if (key.length > 0) {
+		[[self prefs] setSafeObject:value forKey:key notify:YES];
+	}
+	[self updatePreviewModeBadge];
+	if ([key isEqualToString:@"streamingEnabled"] && [value boolValue]) {
+		[self playStreamDemo];
+	} else {
+		[self refreshPreviewBannerStreaming:NO text:nil];
+	}
+}
+
+@end
