+- (void)refreshPreviewBannerStreaming:(BOOL)streaming text:(NSString *)overrideText {
+	if (!self.previewBodyLabel) return;
+	NSString *sampleSummary = overrideText ?: @"Minh hẹn 7h tối nay gặp ở quán cũ Nguyễn Huệ để chốt slide.";
+	NSString *sampleOriginal = @"Ê tối nay rảnh không, tầm 7h qua quán cũ chỗ Nguyễn Huệ ngồi chút nha để mình chốt nốt slide thuyết trình ngày mai luôn. Nhớ mang theo USB file thiết kế nhé!";
+	DigestBannerRenderConfig *cfg = [self currentPreviewConfig];
+
+	if (self.expandedPreviewMode) {
+		[DigestBannerAnimator renderExpandedToLabel:self.previewBodyLabel
+										withSummary:sampleSummary
+									   originalText:sampleOriginal
+											 config:cfg
+										 layoutHost:self.previewCardView];
+		[self resizeTableHeaderToFit];
+		return;
+	}
+
+	__weak typeof(self) weakSelf = self;
+	[DigestBannerAnimator updateLabel:self.previewBodyLabel
+						  withSummary:sampleSummary
+						 originalText:sampleOriginal
+						  isStreaming:streaming
+							   config:cfg
+						   layoutHost:self.previewCardView
+						onLayoutDelta:^{
+		[weakSelf resizeTableHeaderToFit];
+	}];
+	[self resizeTableHeaderToFit];
+}
