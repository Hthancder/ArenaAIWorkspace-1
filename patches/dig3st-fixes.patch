+        UIView *measureView = platterView ?: vc.view;
+        CGFloat w = measureView.bounds.size.width;
+        if (w <= 0) w = vc.view.bounds.size.width;
+        CGSize fit = (w > 0) ? [measureView sizeThatFits:CGSizeMake(w, CGFLOAT_MAX)] : CGSizeZero;
+        NCNotificationRequest *req = [vc respondsToSelector:@selector(notificationRequest)] ? [(NCNotificationViewController *)vc notificationRequest] : nil;
+
+        BOOL bannerNeedsSize = (fit.height > 0 && fabs(fit.height - vc.preferredContentSize.height) > 0.5);
+        BOOL listNeedsSize = (fit.height > 0 && fabs(fit.height - vc.view.bounds.size.height) > 1.0);
+
+        NSString *msgText = req ? (safeKVCString(req.content, @"message") ?: @"") : @"";
+        BOOL isStreaming = NO;
+        if (req) {
+            @try { isStreaming = [[req valueForKey:@"dig3stStreaming"] boolValue]; } @catch (NSException *e) {}
+        }
+        NSString *sig = [NSString stringWithFormat:@"%.1f|%.1f|%.1f|%d|%lu",
+                         w, fit.height, vc.view.bounds.size.height, isStreaming ? 1 : 0, (unsigned long)msgText.hash];
+        NSString *prevSig = objc_getAssociatedObject(vc, kDigestLastLayoutSig);
+
+        if ((bannerNeedsSize || listNeedsSize) && ![sig isEqualToString:prevSig]) {
+            objc_setAssociatedObject(vc, kDigestLastLayoutSig, sig, OBJC_ASSOCIATION_COPY_NONATOMIC);
+            if (fit.height > 0) {
+                vc.preferredContentSize = CGSizeMake(w, fit.height);
+            }
+            clearCachesForRequest(req, vc);
+            if ([vc isKindOfClass:NSClassFromString(@"NCNotificationViewController")] &&
+                [vc respondsToSelector:@selector(_updatePreferredContentSize)]) {
+                [(NCNotificationViewController *)vc _updatePreferredContentSize];
+            }
+            UIViewController *parent = vc.parentViewController;
+            if (parent) {
+                if ([parent isKindOfClass:NSClassFromString(@"NCNotificationPresentableViewController")]) {
+                    NCNotificationPresentableViewController *pvc = (NCNotificationPresentableViewController *)parent;
+                    if (vc.preferredContentSize.height > 0 &&
+                        fabs(pvc.preferredContentSize.height - vc.preferredContentSize.height) > 0.5) {
+                        pvc.preferredContentSize = vc.preferredContentSize;
+                    }
+                    [pvc preferredContentSizeDidChangeForChildContentContainer:vc];
+                    if ([pvc respondsToSelector:@selector(presentableContext)]) {
+                        id<DigestBNPresentableContext> ctx = pvc.presentableContext;
+                        if ([ctx respondsToSelector:@selector(setHostNeedsUpdate)]) {
+                            [ctx setHostNeedsUpdate];
+                        }
+                    }
+                } else {
+                    [parent preferredContentSizeDidChangeForChildContentContainer:vc];
+                }
+                [parent.view setNeedsLayout];
+            }
+            if (listNeedsSize) {
+                invalidateAncestorListViewsFromView(vc.view, req);
+            }
+            [vc.view.superview invalidateIntrinsicContentSize];
+            [vc.view.superview setNeedsLayout];
+        }
+    } @catch (NSException *e) {}
+    objc_setAssociatedObject(vc, kDigestSizingGuard, @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
