+static void renderExpandedController(UIViewController *vc) {
+    if (!vc || !showOriginalInExpanded) return;
+    @try {
+        NCNotificationRequest *req = nil;
+        if ([vc isKindOfClass:NSClassFromString(@"NCExpandedPlatterViewController")]) {
+            req = ((NCExpandedPlatterViewController *)vc).notificationRequest;
+        } else if ([vc isKindOfClass:NSClassFromString(@"NCNotificationViewController")]) {
+            req = ((NCNotificationViewController *)vc).notificationRequest;
+        }
+        if (!req || !req.dig3st) return;
+
+        UIView *platter = nil;
+        if ([vc isKindOfClass:NSClassFromString(@"NCExpandedPlatterViewController")] &&
+            [vc respondsToSelector:@selector(_expandedPlatterViewIfLoaded)]) {
+            platter = [(NCExpandedPlatterViewController *)vc _expandedPlatterViewIfLoaded];
+        }
+        if (!platter) {
+            @try { platter = [vc valueForKey:@"_expandedPlatterView"]; } @catch (NSException *e) {}
+        }
+        UIView *seamless = nil;
+        if (platter) {
+            @try { seamless = [platter valueForKey:@"notificationContentView"]; } @catch (NSException *e) {}
+        }
+        if (!seamless) {
+            seamless = findSeamlessContentViewInHierarchy(vc.view);
+        }
+        if (!seamless) return;
+
+        UIView *messageEl = nil;
+        @try { messageEl = [seamless valueForKey:@"secondaryTextElement"]; } @catch (NSException *e) {}
+        NSString *msgText = safeKVCString(req.content, @"message");
+        NSString *origText = safeKVCString(req, @"actualMessage");
+        if (!messageEl || !msgText) return;
+
+        @try {
+            [seamless setValue:@(0) forKey:@"secondaryTextMaximumNumberOfLines"];
+            if (platter) [platter setValue:@(0) forKey:@"maximumNumberOfSecondaryTextLines"];
+        } @catch (NSException *e) {}
+
+        DigestBannerRenderConfig *cfg = currentBannerRenderConfig();
+        [DigestBannerAnimator renderExpandedToLabel:messageEl withSummary:msgText originalText:origText config:cfg layoutHost:seamless];
+        relayoutControllerPreferredSize(vc, seamless, platter);
+    } @catch (NSException *e) {
+        NSLog(@"dig3st expanded render error: %@", e);
+    }
+}
