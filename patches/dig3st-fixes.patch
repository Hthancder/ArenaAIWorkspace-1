+            NSArray *reqs = [gl respondsToSelector:@selector(orderedRequests)] ? gl.orderedRequests : nil;
+            NCNotificationRequest *matched = matchingRequestInArray(reqs, targetReq);
+            if (!matched) continue;
+            NCNotificationListView *glv = [gl respondsToSelector:@selector(groupListView)] ? gl.groupListView : nil;
+            BOOL glVisible = NO;
+            if (glv && glv.window != nil) {
+                glVisible = ![glv respondsToSelector:@selector(isNotificationListViewCurrentlyVisible)] || [glv isNotificationListViewCurrentlyVisible];
+            }
+            BOOL shouldRelayoutGLV = !glVisible || !reloadOffscreenOnly;
+            if (!shouldRelayoutGLV) {
+                NSUInteger idxCheck = [reqs indexOfObjectIdenticalTo:matched];
+                if (idxCheck == NSNotFound) idxCheck = [reqs indexOfObject:matched];
+                UIView *cellView = (idxCheck != NSNotFound && [glv respondsToSelector:@selector(visibleViews)])
+                    ? glv.visibleViews[@(idxCheck)] : nil;
+                if (!cellView) {
+                    shouldRelayoutGLV = YES;
+                } else if (cellView.bounds.size.width > 0) {
+                    CGSize fit = [cellView sizeThatFits:CGSizeMake(cellView.bounds.size.width, CGFLOAT_MAX)];
+                    if (fit.height > 0 && fabs(fit.height - cellView.bounds.size.height) > 1.0) {
+                        shouldRelayoutGLV = YES;
+                    }
+                }
+            }
+            if (!clearCachesFirst && !shouldRelayoutGLV) {
+                continue;
+            }
+            if ([gl respondsToSelector:@selector(notificationListCache)]) {
+                NCNotificationListCache *glCache = gl.notificationListCache;
+                if (glCache && [glCache respondsToSelector:@selector(clearCachedHeightsForNotificationRequest:)]) {
+                    [glCache clearCachedHeightsForNotificationRequest:targetReq];
+                    [glCache clearCachedHeightsForNotificationRequest:matched];
+                }
+            }
+            if (!glVisible || !reloadOffscreenOnly) {
+                if ([gl respondsToSelector:@selector(reloadNotificationRequest:)]) {
+                    [gl reloadNotificationRequest:matched];
+                }
+            }
+            if (glv && shouldRelayoutGLV) {
+                if ([glv respondsToSelector:@selector(setCachedSizeValid:)]) {
+                    glv.cachedSizeValid = NO;
+                }
+                NSUInteger idx = [reqs indexOfObjectIdenticalTo:matched];
+                if (idx == NSNotFound) idx = [reqs indexOfObject:matched];
+                if (idx != NSNotFound && [glv respondsToSelector:@selector(reloadViewAtIndex:)]) {
+                    [glv reloadViewAtIndex:idx];
+                }
