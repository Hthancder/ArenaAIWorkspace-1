+static NSArray<NSDictionary *> *recordAndFetchContext(NCNotificationRequest *req, NSString *message, BOOL fetchPrior, BOOL effectiveCtxEnabled) {
+    if (!effectiveCtxEnabled || message.length == 0) return nil;
+    NSString *title = safeKVCString(req.content, @"title");
+    NSString *convKey = contextKeyForRequest(req, title);
+    NSDate *now = [NSDate date];
+    NSArray<NSDictionary *> *priorSnapshot = nil;
+
+    @synchronized(contextLock) {
+        if (!contextBuffer) {
+            contextBuffer = [NSMutableDictionary new];
+        }
+        NSMutableArray<NSDictionary *> *entries = contextBuffer[convKey];
+        if (!entries) {
+            entries = [NSMutableArray new];
+            contextBuffer[convKey] = entries;
+        }
+
+        NSMutableIndexSet *expired = [NSMutableIndexSet indexSet];
+        [entries enumerateObjectsUsingBlock:^(NSDictionary *entry, NSUInteger idx, BOOL *stop) {
+            NSDate *ts = entry[@"date"];
+            if (!ts || [now timeIntervalSinceDate:ts] > contextWindowSeconds) {
+                [expired addIndex:idx];
+            }
+        }];
+        if (expired.count > 0) {
+            [entries removeObjectsAtIndexes:expired];
+        }
+
+        if (fetchPrior && entries.count > 0) {
+            NSInteger count = (NSInteger)entries.count;
+            NSInteger start = MAX(0, count - contextMaxMessages);
+            priorSnapshot = [entries subarrayWithRange:NSMakeRange(start, count - start)];
+        }
+
+        NSDictionary *last = entries.lastObject;
+        NSString *sender = title ?: @"";
+        BOOL isDup = (last != nil && [last[@"message"] isEqualToString:message] && [last[@"sender"] isEqualToString:sender] && [now timeIntervalSinceDate:last[@"date"]] < 5.0);
+        if (!isDup) {
+            [entries addObject:@{
+                @"date": now,
+                @"sender": sender,
+                @"message": message
+            }];
+            while ((NSInteger)entries.count > contextMaxMessages) {
+                [entries removeObjectAtIndex:0];
+            }
+        }
+    }
+    return priorSnapshot;
+}
