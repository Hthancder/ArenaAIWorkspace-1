+	if (!header || !card) return;
+	CGFloat w = self.view.frame.size.width;
+	if (w <= 0) return;
+	CGFloat cardWidth = MAX(200.0, w - 32.0);
+	self.previewBodyLabel.preferredMaxLayoutWidth = MAX(172.0, cardWidth - 28.0);
+	[card setNeedsLayout];
+	[card layoutIfNeeded];
+	CGSize fit = [card systemLayoutSizeFittingSize:CGSizeMake(cardWidth, UILayoutFittingCompressedSize.height)
+					 withHorizontalFittingPriority:UILayoutPriorityRequired
+						   verticalFittingPriority:UILayoutPriorityFittingSizeLevel];
+	CGFloat newH = ceil(fit.height) + 18.0;
+	if (fabs(header.frame.size.height - newH) > 1.0 || fabs(header.frame.size.width - w) > 1.0) {
+		header.frame = CGRectMake(0, 0, w, MAX(116.0, newH));
+		card.frame = CGRectMake(16.0, 12.0, cardWidth, MAX(98.0, ceil(fit.height)));
+		self.table.tableHeaderView = header;
+	}
+}
