+static NSString *buildContextPrompt(NCNotificationRequest *req, NSString *message, NSArray<NSDictionary *> *priorEntries) {
+    NSString *appName = resolveAppName(req);
+    NSString *title = safeKVCString(req.content, @"title");
+    NSString *subtitle = safeKVCString(req.content, @"subtitle");
+
+    NSMutableString *contextHeader = [NSMutableString string];
+    if (includeContext) {
+        if (appName.length > 0) {
+            [contextHeader appendFormat:@"[%@]", appName];
+        }
+        if (title.length > 0 && (!appName || ![title isEqualToString:appName])) {
+            if (contextHeader.length > 0) [contextHeader appendString:@" "];
+            [contextHeader appendString:title];
+        }
+        if (subtitle.length > 0 && (!title || ![subtitle isEqualToString:title])) {
+            if (contextHeader.length > 0) [contextHeader appendString:@" - "];
+            [contextHeader appendString:subtitle];
+        }
+    }
+
+    if (priorEntries.count == 0) {
+        if (contextHeader.length == 0) return message;
+        return [NSString stringWithFormat:@"Source (do NOT repeat this source label in your reply): %@\nNotification:\n%@", contextHeader, message];
+    }
+
+    NSDate *now = [NSDate date];
+    NSMutableArray<NSString *> *formattedLines = [NSMutableArray new];
+    NSInteger usedChars = 0;
+    for (NSDictionary *entry in [priorEntries reverseObjectEnumerator]) {
+        NSString *msg = entry[@"message"] ?: @"";
+        NSString *sender = entry[@"sender"] ?: @"";
+        NSDate *ts = entry[@"date"];
+        NSMutableString *line = [NSMutableString stringWithString:@"- "];
+        if (contextIncludeTime && ts) {
+            [line appendFormat:@"[%@] ", formatRelativeAge([now timeIntervalSinceDate:ts])];
+        }
+        if (sender.length > 0) {
+            [line appendFormat:@"%@: ", sender];
+        }
+        [line appendString:msg];
+        if (usedChars + (NSInteger)line.length > contextMaxChars && formattedLines.count > 0) {
+            break;
+        }
+        usedChars += (NSInteger)line.length;
+        [formattedLines insertObject:line atIndex:0];
+    }
+
+    NSMutableString *result = [NSMutableString string];
+    if (contextHeader.length > 0) {
+        [result appendFormat:@"Source (do NOT repeat in output): %@\n", contextHeader];
+    }
+    if (formattedLines.count > 0) {
+        [result appendString:@"Earlier messages in this conversation (context only, summarize ONLY the current notification):\n"];
+        [result appendString:[formattedLines componentsJoinedByString:@"\n"]];
+        [result appendString:@"\nCurrent notification to summarize:\n"];
+    }
+    if (title.length > 0 && (!appName || ![title isEqualToString:appName])) {
+        [result appendFormat:@"%@: %@", title, message];
+    } else {
+        [result appendString:message];
+    }
+    return result;
+}
