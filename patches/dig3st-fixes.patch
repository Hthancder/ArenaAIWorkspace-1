diff --git a/preferences/DigestAppDetailController.m b/preferences/DigestAppDetailController.m
new file mode 100644
index 0000000..a57f5e1
--- /dev/null
+++ b/preferences/DigestAppDetailController.m
@@ -0,0 +1,182 @@
+#import "../headers/HeadersPreferences.h"
+#import <Preferences/PSListItemsController.h>
+
+@interface PSSpecifier (DigestValues)
+- (void)setValues:(NSArray *)values titles:(NSArray *)titles;
+@end
+
+@interface DigestAppDetailController : PSListController
+@property (nonatomic, copy) NSString *bundleId;
+@property (nonatomic, copy) NSString *appName;
+@property (nonatomic, assign) BOOL hasAppearedOnce;
+@end
+
+static id isAppDefaultEnabled(NSString *bundleId) {
+	NSArray *defaultEnabled = @[@"com.apple.MobileSMS", @"com.apple.news", @"ph.telegra.Telegraph", @"com.apple.mobilemail"];
+	return [defaultEnabled containsObject:bundleId] ? @YES : @NO;
+}
+
+@implementation DigestAppDetailController
+
+- (void)viewDidLoad {
+	[super viewDidLoad];
+	self.title = self.appName.length > 0 ? self.appName : self.bundleId;
+}
+
+- (void)viewWillAppear:(BOOL)animated {
+	[super viewWillAppear:animated];
+	if (self.hasAppearedOnce) {
+		[self reloadSpecifiers];
+	}
+	self.hasAppearedOnce = YES;
+}
+
+- (NSArray *)specifiers {
+	if (!_specifiers && self.bundleId.length > 0) {
+		NSMutableArray *list = [NSMutableArray new];
+
+		PSSpecifier *grp1 = [PSSpecifier groupSpecifierWithName:@"App Summarization"];
+		[grp1 setProperty:@"Override global settings exclusively for this app. Changes apply immediately without respring." forKey:@"footerText"];
+		[list addObject:grp1];
+
+		PSSpecifier *enSp = [PSSpecifier preferenceSpecifierNamed:@"Enable Summarization"
+														   target:self
+															  set:@selector(setPreferenceValue:specifier:)
+															  get:@selector(readPreferenceValue:)
+														   detail:Nil
+															 cell:PSSwitchCell
+															 edit:Nil];
+		[enSp setProperty:self.bundleId forKey:@"key"];
+		[enSp setProperty:NSClassFromString(@"DigestSwitch") forKey:@"cellClass"];
+		[enSp setProperty:@"power" forKey:@"systemIcon"];
+		[list addObject:enSp];
+
+		PSSpecifier *grp2 = [PSSpecifier groupSpecifierWithName:@"Per-App Overrides"];
+		[list addObject:grp2];
+
+		NSArray *triTitles = @[@"Default (Global)", @"Force ON", @"Force OFF"];
+		NSArray *triValues = @[@"default", @"on", @"off"];
+
+		PSSpecifier *ctxSp = [PSSpecifier preferenceSpecifierNamed:@"Context Buffer"
+															target:self
+															   set:@selector(setPreferenceValue:specifier:)
+															   get:@selector(readPreferenceValue:)
+															detail:NSClassFromString(@"PSListItemsController")
+															  cell:PSLinkListCell
+															  edit:Nil];
+		[ctxSp setProperty:[NSString stringWithFormat:@"appCtx_%@", self.bundleId] forKey:@"key"];
+		[ctxSp setProperty:@"default" forKey:@"default"];
+		[ctxSp setProperty:@"com.uncore.dig3st" forKey:@"defaults"];
+		[ctxSp setValues:triValues titles:triTitles];
+		[list addObject:ctxSp];
+
+		PSSpecifier *trSp = [PSSpecifier preferenceSpecifierNamed:@"Auto-Translate to VN"
+														   target:self
+															  set:@selector(setPreferenceValue:specifier:)
+															  get:@selector(readPreferenceValue:)
+														   detail:NSClassFromString(@"PSListItemsController")
+															 cell:PSLinkListCell
+															 edit:Nil];
+		[trSp setProperty:[NSString stringWithFormat:@"appTrans_%@", self.bundleId] forKey:@"key"];
+		[trSp setProperty:@"default" forKey:@"default"];
+		[trSp setProperty:@"com.uncore.dig3st" forKey:@"defaults"];
+		[trSp setValues:triValues titles:triTitles];
+		[list addObject:trSp];
+
+		PSSpecifier *stSp = [PSSpecifier preferenceSpecifierNamed:@"Streaming Text"
+														   target:self
+															  set:@selector(setPreferenceValue:specifier:)
+															  get:@selector(readPreferenceValue:)
+														   detail:NSClassFromString(@"PSListItemsController")
+															 cell:PSLinkListCell
+															 edit:Nil];
+		[stSp setProperty:[NSString stringWithFormat:@"appStream_%@", self.bundleId] forKey:@"key"];
+		[stSp setProperty:@"default" forKey:@"default"];
+		[stSp setProperty:@"com.uncore.dig3st" forKey:@"defaults"];
+		[stSp setValues:triValues titles:triTitles];
+		[list addObject:stSp];
+
+		PSSpecifier *prSp = [PSSpecifier preferenceSpecifierNamed:@"Custom App Prompt"
+														   target:self
+															  set:Nil
+															  get:Nil
+														   detail:NSClassFromString(@"DigestPromptEditorController")
+															 cell:PSLinkCell
+															 edit:Nil];
+		NSString *pKey = [NSString stringWithFormat:@"appPrompt_%@", self.bundleId];
+		DigestPrefsManager *manager = [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+		[manager synchronize];
+		NSString *rawPrompt = [manager safeObjectForKey:pKey];
+		NSString *curPrompt = ([rawPrompt isKindOfClass:[NSString class]]) ? [[rawPrompt stringByReplacingOccurrencesOfString:@"\r\n" withString:@" "] stringByReplacingOccurrencesOfString:@"\n" withString:@" "] : nil;
+		[prSp setProperty:NSClassFromString(@"DigestSubtitleLinkCell") forKey:@"cellClass"];
+		[prSp setProperty:@"text.bubble" forKey:@"systemIcon"];
+		[prSp setProperty:pKey forKey:@"prefKey"];
+		[prSp setProperty:[NSString stringWithFormat:@"Prompt (%@)", self.appName ?: self.bundleId] forKey:@"editorTitle"];
+		[prSp setProperty:([curPrompt isKindOfClass:[NSString class]] && curPrompt.length > 0) ? curPrompt : @"Using global prompt" forKey:@"cellSubtitleText"];
+		[list addObject:prSp];
+
+		PSSpecifier *grp3 = [PSSpecifier groupSpecifierWithName:@""];
+		[list addObject:grp3];
+
+		PSSpecifier *rstSp = [PSSpecifier preferenceSpecifierNamed:@"Reset App Overrides"
+															target:self
+															   set:Nil
+															   get:Nil
+															detail:Nil
+															  cell:PSButtonCell
+															  edit:Nil];
+		[rstSp setButtonAction:@selector(resetAppOverrides)];
+		[rstSp setProperty:NSClassFromString(@"DigestButton") forKey:@"cellClass"];
+		[rstSp setProperty:@"gobackward" forKey:@"systemIcon"];
+		[rstSp setProperty:@YES forKey:@"isDestructive"];
+		[list addObject:rstSp];
+
+		_specifiers = list;
+	}
+	return _specifiers;
+}
+
+- (id)readPreferenceValue:(PSSpecifier *)specifier {
+	DigestPrefsManager *manager = [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+	CFPreferencesAppSynchronize(CFSTR("com.uncore.dig3st"));
+	[manager synchronize];
+	NSString *key = specifier.properties[@"key"];
+	id val = [manager safeObjectForKey:key];
+	if (val == nil && [key isEqualToString:self.bundleId]) {
+		return isAppDefaultEnabled(self.bundleId);
+	}
+	return val ?: specifier.properties[@"default"];
+}
+
+- (void)setPreferenceValue:(id)value specifier:(PSSpecifier *)specifier {
+	[super setPreferenceValue:value specifier:specifier];
+	NSString *key = specifier.properties[@"key"];
+	if (key.length > 0) {
+		DigestPrefsManager *manager = [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+		[manager setObject:value forKey:key];
+		[manager synchronize];
+		CFPreferencesSetAppValue((__bridge CFStringRef)key, (__bridge CFPropertyListRef)value, CFSTR("com.uncore.dig3st"));
+		CFPreferencesAppSynchronize(CFSTR("com.uncore.dig3st"));
+		CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (CFStringRef)@"com.uncore.dig3st/preferences.changed", NULL, NULL, true);
+	}
+}
+
+- (void)resetAppOverrides {
+	DigestPrefsManager *manager = [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+	NSArray *keys = @[
+		[NSString stringWithFormat:@"appCtx_%@", self.bundleId],
+		[NSString stringWithFormat:@"appTrans_%@", self.bundleId],
+		[NSString stringWithFormat:@"appStream_%@", self.bundleId],
+		[NSString stringWithFormat:@"appPrompt_%@", self.bundleId]
+	];
+	for (NSString *k in keys) {
+		[manager removeObjectForKey:k];
+		CFPreferencesSetAppValue((__bridge CFStringRef)k, NULL, CFSTR("com.uncore.dig3st"));
+	}
+	[manager synchronize];
+	CFPreferencesAppSynchronize(CFSTR("com.uncore.dig3st"));
+	CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (CFStringRef)@"com.uncore.dig3st/preferences.changed", NULL, NULL, true);
+	[self reloadSpecifiers];
+}
+
+@end
