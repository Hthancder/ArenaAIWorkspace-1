+static void refreshRuntimePrefs(void) {
+    if (!prefsManager) return;
+    NSDictionary *prefs = [prefsManager copyAllPreferences];
+    cachedPrefsSnapshot = prefs;
+    [summaryCache removeAllObjects];
+
+    tweakEnabled = [prefs[@"enabled"] boolValue];
+    id ctxObj = prefs[@"includeContext"];
+    includeContext = ctxObj ? [ctxObj boolValue] : YES;
+
+    id bufEnabled = prefs[@"contextBufferEnabled"];
+    contextBufferEnabled = bufEnabled ? [bufEnabled boolValue] : YES;
+    id perThread = prefs[@"contextPerThread"];
+    contextPerThread = perThread ? [perThread boolValue] : YES;
+
+    NSInteger maxMsgs = [prefs[@"contextMaxMessages"] integerValue];
+    contextMaxMessages = (maxMsgs >= 1 && maxMsgs <= 20) ? maxMsgs : 4;
+
+    NSInteger winMins = [prefs[@"contextWindowMinutes"] integerValue];
+    contextWindowSeconds = (winMins >= 1 && winMins <= 1440) ? (winMins * 60.0) : 600.0;
+
+    NSInteger maxChars = [prefs[@"contextMaxChars"] integerValue];
+    contextMaxChars = (maxChars >= 100 && maxChars <= 4000) ? maxChars : 800;
+
+    id incTime = prefs[@"contextIncludeTime"];
+    contextIncludeTime = incTime ? [incTime boolValue] : YES;
+    id recShort = prefs[@"contextRecordShort"];
+    contextRecordShort = recShort ? [recShort boolValue] : YES;
+
+    id minCharsObj = prefs[@"minChars"];
+    cachedMinChars = minCharsObj ? MAX(0, [minCharsObj integerValue]) : 15;
+
+    NSString *badge = prefs[@"bannerBadgeStyle"];
+    bannerBadgeStyle = ([badge isKindOfClass:[NSString class]] && badge.length > 0) ? [badge copy] : @"arrow";
+    bannerShowPrefix = [prefs[@"bannerShowPrefix"] boolValue];
+    NSString *prefix = prefs[@"bannerPrefixText"];
+    bannerPrefixText = ([prefix isKindOfClass:[NSString class]] && prefix.length > 0) ? [prefix copy] : @"[AI]";
+    NSString *accent = prefs[@"bannerAccentColor"];
+    bannerAccentColor = ([accent isKindOfClass:[NSString class]] && accent.length > 0) ? [accent copy] : @"default";
+    bannerBoldSummary = [prefs[@"bannerBoldSummary"] boolValue];
+    bannerShowOriginal = [prefs[@"bannerShowOriginal"] boolValue];
+
+    id expOrig = prefs[@"showOriginalInExpanded"];
+    showOriginalInExpanded = expOrig ? [expOrig boolValue] : YES;
+
+    id strEn = prefs[@"streamingEnabled"];
+    streamingEnabled = strEn ? [strEn boolValue] : YES;
+
+    NSString *anim = prefs[@"streamAnimationStyle"];
+    streamAnimationStyle = ([anim isKindOfClass:[NSString class]] && anim.length > 0) ? [anim copy] : @"aiSweep";
+
+    pauseInLowPowerMode = [prefs[@"pauseInLowPowerMode"] boolValue];
+    lowPowerActive = [[NSProcessInfo processInfo] isLowPowerModeEnabled];
+    rebuildCachedBannerConfig();
+}
 
