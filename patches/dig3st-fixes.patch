++ (void)stopForLabel:(UIView *)textElement {
+    if (!textElement) return;
+    DigestLabelAnimState *state = objc_getAssociatedObject(textElement, kDigestAnimStateKey);
+    if (state) {
+        [state invalidate];
+        objc_setAssociatedObject(textElement, kDigestAnimStateKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+}
+
++ (void)updateLabel:(UIView *)textElement
+        withSummary:(NSString *)summary
+       originalText:(NSString *)originalText
+        isStreaming:(BOOL)isStreaming
+             config:(DigestBannerRenderConfig *)config
+         layoutHost:(UIView *)layoutHost
+      onLayoutDelta:(void (^)(void))layoutDeltaBlock {
+    if (!textElement || !summary) return;
+
+    NSString *anim = config.animationStyle ?: @"fadeWords";
+    NSString *renderKey = [NSString stringWithFormat:@"%@|%@|%@|%@|%d|%@|%d|%d|%@|%@",
+                           summary, originalText ?: @"", isStreaming ? @"1" : @"0",
+                           config.badgeStyle ?: @"", config.showPrefix, config.prefixText ?: @"",
+                           config.boldSummary, config.showOriginalLine,
+                           config.accentColorKey ?: @"", anim];
+
+    DigestLabelAnimState *state = objc_getAssociatedObject(textElement, kDigestAnimStateKey);
+    if (state && [state.lastRenderKey isEqualToString:renderKey]) {
+        return;
+    }
+
+    if ([anim isEqualToString:@"none"] || [anim isEqualToString:@"crossfade"]) {
+        if (state) {
+            [state invalidate];
+        } else {
+            state = [DigestLabelAnimState new];
+            objc_setAssociatedObject(textElement, kDigestAnimStateKey, state, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+        state.textElement = textElement;
+        state.layoutHost = layoutHost;
+        state.lastRenderKey = renderKey;
+        state.layoutDeltaBlock = layoutDeltaBlock;
+
+        UIFont *baseFont = baseFontForElement(textElement);
+        UIImage *badgeImg = nil;
+        NSMutableAttributedString *out = [[self prefixAttributedStringWithConfig:config baseFont:baseFont retainedImage:&badgeImg] mutableCopy];
+        state.retainedBadgeImage = badgeImg;
+
+        UIFont *summaryFont = config.boldSummary
+            ? [UIFont systemFontOfSize:baseFont.pointSize weight:UIFontWeightSemibold]
+            : baseFont;
+        [out appendAttributedString:[[NSAttributedString alloc] initWithString:summary attributes:@{
+            NSFontAttributeName: summaryFont,
+            NSForegroundColorAttributeName: [UIColor labelColor]
+        }]];
+
+        if (isStreaming) {
+            UIColor *accent = [self resolveAccentColor:config.accentColorKey] ?: [UIColor systemBlueColor];
+            [out appendAttributedString:[[NSAttributedString alloc] initWithString:@" ●" attributes:@{
+                NSFontAttributeName: [UIFont systemFontOfSize:MAX(9.0, baseFont.pointSize - 3.0)],
+                NSForegroundColorAttributeName: accent
+            }]];
+        } else if (config.showOriginalLine && originalText.length > 0 && ![originalText isEqualToString:summary]) {
+            NSString *flatOrig = [[originalText stringByReplacingOccurrencesOfString:@"\r\n" withString:@" "] stringByReplacingOccurrencesOfString:@"\n" withString:@" "];
+            if (flatOrig.length > 70) {
+                NSRange safeRange = [flatOrig rangeOfComposedCharacterSequencesForRange:NSMakeRange(0, 70)];
+                flatOrig = [[flatOrig substringWithRange:safeRange] stringByAppendingString:@"…"];
+            }
+            UIFont *origFont = [UIFont systemFontOfSize:MAX(11.0, baseFont.pointSize - 2.0)];
+            [out appendAttributedString:[[NSAttributedString alloc] initWithString:[NSString stringWithFormat:@"\n%@", flatOrig] attributes:@{
+                NSFontAttributeName: origFont,
+                NSForegroundColorAttributeName: [UIColor secondaryLabelColor]
+            }]];
+        }
+
+        if ([anim isEqualToString:@"crossfade"]) {
+            [UIView transitionWithView:textElement duration:0.22 options:UIViewAnimationOptionTransitionCrossDissolve | UIViewAnimationOptionAllowUserInteraction animations:^{
+                applyAttributedTextToElement(textElement, out, 4);
+            } completion:nil];
+        } else {
+            applyAttributedTextToElement(textElement, out, 4);
+        }
+        [textElement invalidateIntrinsicContentSize];
+        [layoutHost setNeedsLayout];
+        if (layoutDeltaBlock) {
+            layoutDeltaBlock();
+        }
+        return;
+    }
+
+    if (!state) {
+        state = [DigestLabelAnimState new];
+        state.streamStartTime = CACurrentMediaTime();
+        objc_setAssociatedObject(textElement, kDigestAnimStateKey, state, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+
+    BOOL isNewSession = (state.targetSummary.length == 0 ||
+                         (![summary hasPrefix:state.targetSummary] && ![state.targetSummary hasPrefix:summary]));
+    if (isNewSession) {
+        state.tokens = [NSMutableArray new];
+        state.tokenBirthTimes = [NSMutableArray new];
+        state.revealedChars = 0;
+        state.streamStartTime = CACurrentMediaTime();
+        state.lastTypeStepTime = state.streamStartTime;
+    }
+
+    state.textElement = textElement;
+    state.layoutHost = layoutHost;
+    state.lastRenderKey = renderKey;
+    state.targetSummary = summary;
+    state.originalText = originalText;
+    state.isStreaming = isStreaming;
+    state.config = config;
+    state.layoutDeltaBlock = layoutDeltaBlock;
+
+    [state syncTokensForTarget:summary];
+    [state ensureDisplayLink];
+    [state handleDisplayLink:state.displayLink];
+}
+
++ (void)renderExpandedToLabel:(UIView *)textElement
+                  withSummary:(NSString *)summary
+                 originalText:(NSString *)originalText
+                       config:(DigestBannerRenderConfig *)config
+                   layoutHost:(UIView *)layoutHost {
+    if (!textElement || !summary) return;
+    [self stopForLabel:textElement];
+
+    NSString *renderKey = [NSString stringWithFormat:@"exp|%@|%@|%@|%d|%@|%@",
+                           summary, originalText ?: @"", config.badgeStyle ?: @"",
+                           config.showPrefix, config.prefixText ?: @"", config.accentColorKey ?: @""];
+    NSString *prevKey = objc_getAssociatedObject(textElement, kDigestExpKey);
+    if ([prevKey isEqualToString:renderKey]) return;
+    objc_setAssociatedObject(textElement, kDigestExpKey, renderKey, OBJC_ASSOCIATION_COPY_NONATOMIC);
+
+    UIFont *baseFont = baseFontForElement(textElement);
+    UIImage *badgeImg = nil;
+    NSMutableAttributedString *out = [[self prefixAttributedStringWithConfig:config baseFont:baseFont retainedImage:&badgeImg] mutableCopy];
+    objc_setAssociatedObject(textElement, kDigestExpImg, badgeImg, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+
+    UIFont *summaryFont = [UIFont systemFontOfSize:baseFont.pointSize weight:UIFontWeightSemibold];
+    [out appendAttributedString:[[NSAttributedString alloc] initWithString:summary attributes:@{
+        NSFontAttributeName: summaryFont,
+        NSForegroundColorAttributeName: [UIColor labelColor]
+    }]];
+
+    if (originalText.length > 0 && ![originalText isEqualToString:summary]) {
+        UIFont *dividerFont = [UIFont systemFontOfSize:MAX(11.0, baseFont.pointSize - 3.0) weight:UIFontWeightMedium];
+        [out appendAttributedString:[[NSAttributedString alloc] initWithString:@"\n\n── Nội dung gốc ──\n" attributes:@{
+            NSFontAttributeName: dividerFont,
+            NSForegroundColorAttributeName: [UIColor tertiaryLabelColor]
+        }]];
+        [out appendAttributedString:[[NSAttributedString alloc] initWithString:originalText attributes:@{
+            NSFontAttributeName: baseFont,
+            NSForegroundColorAttributeName: [UIColor secondaryLabelColor]
+        }]];
+    }
+
+    applyAttributedTextToElement(textElement, out, 0);
+    [textElement invalidateIntrinsicContentSize];
+    [layoutHost setNeedsLayout];
+}
+
+@end
