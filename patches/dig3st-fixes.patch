--- /dev/null
+++ b/src/DigestBannerAnimator.m
@@ -0,0 +1,577 @@
+#import "../headers/Digest/DigestBannerAnimator.h"
+#import <QuartzCore/QuartzCore.h>
+#import <objc/runtime.h>
+
+@interface NSObject (DigestNCTextSupport)
+- (void)nc_setNumberOfLines:(unsigned long long)lines;
+@end
+
+@implementation DigestBannerRenderConfig
+@end
+
+@protocol DigestDisplayLinkReceiver <NSObject>
+- (void)handleDisplayLink:(CADisplayLink *)link;
+@end
+
+@interface DigestDisplayLinkProxy : NSObject
+@property (nonatomic, weak) id<DigestDisplayLinkReceiver> target;
+- (void)tick:(CADisplayLink *)link;
+@end
+
+@implementation DigestDisplayLinkProxy
+- (void)tick:(CADisplayLink *)link {
+    id<DigestDisplayLinkReceiver> t = self.target;
+    if (t) {
+        [t handleDisplayLink:link];
+    } else {
+        [link invalidate];
+    }
+}
+@end
+
+@interface DigestLabelAnimState : NSObject <DigestDisplayLinkReceiver>
+@property (nonatomic, weak) UIView *textElement;
+@property (nonatomic, weak) UIView *layoutHost;
+@property (nonatomic, copy) NSString *lastRenderKey;
+@property (nonatomic, copy) NSString *targetSummary;
+@property (nonatomic, copy) NSString *originalText;
+@property (nonatomic, assign) BOOL isStreaming;
+@property (nonatomic, strong) DigestBannerRenderConfig *config;
+@property (nonatomic, strong) NSMutableArray<NSString *> *tokens;
+@property (nonatomic, strong) NSMutableArray<NSNumber *> *tokenBirthTimes;
+@property (nonatomic, assign) NSUInteger revealedChars;
+@property (nonatomic, assign) CFTimeInterval streamStartTime;
+@property (nonatomic, assign) CFTimeInterval lastTypeStepTime;
+@property (nonatomic, assign) NSUInteger lastLayoutTokenCount;
+@property (nonatomic, assign) BOOL lastLayoutStreaming;
+@property (nonatomic, strong) CADisplayLink *displayLink;
+@property (nonatomic, strong) UIImage *retainedBadgeImage;
+@property (nonatomic, copy) void (^layoutDeltaBlock)(void);
+- (void)invalidate;
+@end
+
+static void *kDigestAnimStateKey = &kDigestAnimStateKey;
+static void *kDigestExpKey = &kDigestExpKey;
+static void *kDigestExpImg = &kDigestExpImg;
+
+static void applyAttributedTextToElement(UIView *el, NSAttributedString *attr, NSUInteger maxLines) {
+    if (!el || !attr) return;
+    if ([el respondsToSelector:@selector(nc_setNumberOfLines:)]) {
+        [(id)el nc_setNumberOfLines:(unsigned long long)maxLines];
+    }
+    if ([el isKindOfClass:[UILabel class]]) {
+        UILabel *lbl = (UILabel *)el;
+        lbl.numberOfLines = (NSInteger)maxLines;
+        lbl.lineBreakMode = NSLineBreakByTruncatingTail;
+        lbl.attributedText = attr;
+    } else if ([el isKindOfClass:[UITextView class]]) {
+        UITextView *tv = (UITextView *)el;
+        tv.textContainer.maximumNumberOfLines = maxLines;
+        tv.textContainer.lineBreakMode = NSLineBreakByTruncatingTail;
+        tv.attributedText = attr;
+    } else if ([el respondsToSelector:@selector(setAttributedText:)]) {
+        [(id)el setAttributedText:attr];
+    }
+}
+
+static UIFont *baseFontForElement(UIView *el) {
+    if ([el respondsToSelector:@selector(font)]) {
+        UIFont *f = [(id)el font];
+        if ([f isKindOfClass:[UIFont class]]) return f;
+    }
+    return [UIFont systemFontOfSize:14.0];
+}
+
+@implementation DigestLabelAnimState
+- (instancetype)init {
+    self = [super init];
+    if (self) {
+        _tokens = [NSMutableArray new];
+        _tokenBirthTimes = [NSMutableArray new];
+    }
+    return self;
+}
+
+- (void)invalidate {
+    if (self.displayLink) {
+        [self.displayLink invalidate];
+        self.displayLink = nil;
+    }
+}
+
+- (void)dealloc {
+    [self invalidate];
+}
+
+- (void)ensureDisplayLink {
+    if (self.displayLink) return;
+    DigestDisplayLinkProxy *proxy = [DigestDisplayLinkProxy new];
+    proxy.target = self;
+    self.displayLink = [CADisplayLink displayLinkWithTarget:proxy selector:@selector(tick:)];
+    [self.displayLink addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
+}
+
+- (NSArray<NSString *> *)tokenizeText:(NSString *)text {
+    if (text.length == 0) return @[];
+    NSMutableArray<NSString *> *parts = [NSMutableArray new];
+    NSUInteger len = text.length;
+    NSUInteger idx = 0;
+    NSCharacterSet *ws = [NSCharacterSet whitespaceAndNewlineCharacterSet];
+    while (idx < len) {
+        NSUInteger start = idx;
+        BOOL isSpace = [ws characterIsMember:[text characterAtIndex:idx]];
+        while (idx < len && ([ws characterIsMember:[text characterAtIndex:idx]] == isSpace)) {
+            NSRange seq = [text rangeOfComposedCharacterSequenceAtIndex:idx];
+            idx = NSMaxRange(seq);
+        }
+        [parts addObject:[text substringWithRange:NSMakeRange(start, idx - start)]];
+    }
+    return parts;
+}
+
+- (void)syncTokensForTarget:(NSString *)newText {
+    NSArray<NSString *> *newTokens = [self tokenizeText:newText];
+    CFTimeInterval now = CACurrentMediaTime();
+    NSMutableArray<NSNumber *> *newBirths = [NSMutableArray arrayWithCapacity:newTokens.count];
+
+    NSUInteger commonCount = 0;
+    while (commonCount < self.tokens.count && commonCount < newTokens.count &&
+           [self.tokens[commonCount] isEqualToString:newTokens[commonCount]]) {
+        [newBirths addObject:self.tokenBirthTimes[commonCount]];
+        commonCount++;
+    }
+
+    NSUInteger wordOrder = 0;
+    NSCharacterSet *ws = [NSCharacterSet whitespaceAndNewlineCharacterSet];
+    for (NSUInteger i = commonCount; i < newTokens.count; i++) {
+        NSString *tok = newTokens[i];
+        BOOL onlySpace = ([tok stringByTrimmingCharactersInSet:ws].length == 0);
+        CFTimeInterval stagger = onlySpace ? 0.0 : (wordOrder * 0.048);
+        if (!onlySpace) wordOrder++;
+        [newBirths addObject:@(now + stagger)];
+    }
+
+    self.tokens = [newTokens mutableCopy];
+    self.tokenBirthTimes = newBirths;
+}
+
+- (void)handleDisplayLink:(CADisplayLink *)link {
+    UIView *el = self.textElement;
+    if (!el) {
+        [self invalidate];
+        return;
+    }
+
+    CFTimeInterval now = CACurrentMediaTime();
+    NSString *anim = self.config.animationStyle ?: @"fadeWords";
+    UIFont *baseFont = baseFontForElement(el);
+    UIFont *summaryFont = self.config.boldSummary
+        ? [UIFont systemFontOfSize:baseFont.pointSize weight:UIFontWeightSemibold]
+        : baseFont;
+    UIColor *baseTextColor = [UIColor labelColor];
+    UIColor *accentColor = [DigestBannerAnimator resolveAccentColor:self.config.accentColorKey] ?: [UIColor systemBlueColor];
+
+    UIImage *badgeImg = nil;
+    NSMutableAttributedString *out = [[DigestBannerAnimator prefixAttributedStringWithConfig:self.config baseFont:baseFont retainedImage:&badgeImg] mutableCopy];
+    self.retainedBadgeImage = badgeImg;
+
+    BOOL needsMoreFrames = NO;
+    BOOL needsRelayout = (self.lastLayoutStreaming != self.isStreaming);
+
+    if ([anim isEqualToString:@"typewriter"]) {
+        if (self.lastTypeStepTime <= 0) {
+            self.lastTypeStepTime = now;
+        }
+        NSUInteger targetLen = self.targetSummary.length;
+        if (self.revealedChars < targetLen) {
+            CFTimeInterval dt = MAX(0.0, now - self.lastTypeStepTime);
+            NSUInteger remaining = targetLen - self.revealedChars;
+            CGFloat cps = self.isStreaming ? MAX(42.0, MIN(95.0, remaining * 3.0)) : MAX(70.0, remaining * 4.5);
+            NSUInteger step = (NSUInteger)floor(dt * cps);
+            if (step >= 1) {
+                NSUInteger nextIdx = MIN(targetLen, self.revealedChars + step);
+                if (nextIdx < targetLen) {
+                    NSRange seq = [self.targetSummary rangeOfComposedCharacterSequenceAtIndex:nextIdx];
+                    if (seq.location < nextIdx) {
+                        nextIdx = NSMaxRange(seq);
+                    }
+                }
+                self.revealedChars = nextIdx;
+                self.lastTypeStepTime = now;
+                needsRelayout = YES;
+            }
+            if (self.revealedChars < targetLen) {
+                needsMoreFrames = YES;
+            }
+        }
+        NSString *visible = (self.revealedChars >= self.targetSummary.length)
+            ? (self.targetSummary ?: @"")
+            : [self.targetSummary substringToIndex:self.revealedChars];
+
+        if (visible.length > 0) {
+            NSMutableAttributedString *visAttr = [[NSMutableAttributedString alloc] initWithString:visible attributes:@{
+                NSFontAttributeName: summaryFont,
+                NSForegroundColorAttributeName: baseTextColor
+            }];
+            NSUInteger tail = 0;
+            NSUInteger idx = visible.length;
+            while (idx > 0 && tail < 4 && (self.isStreaming || self.revealedChars < self.targetSummary.length)) {
+                NSRange seq = [visible rangeOfComposedCharacterSequenceAtIndex:idx - 1];
+                CGFloat alpha = 0.25 + tail * 0.22;
+                [visAttr addAttribute:NSForegroundColorAttributeName value:[baseTextColor colorWithAlphaComponent:MIN(1.0, alpha)] range:seq];
+                idx = seq.location;
+                tail++;
+            }
+            [out appendAttributedString:visAttr];
+        }
+        if (self.isStreaming || self.revealedChars < self.targetSummary.length) {
+            CGFloat pulse = 0.30 + 0.70 * (0.5 + 0.5 * sin((now - self.streamStartTime) * 7.0));
+            [out appendAttributedString:[[NSAttributedString alloc] initWithString:@" ▍" attributes:@{
+                NSFontAttributeName: summaryFont,
+                NSForegroundColorAttributeName: [accentColor colorWithAlphaComponent:pulse]
+            }]];
+            needsMoreFrames = YES;
+        }
+    } else if ([anim isEqualToString:@"shimmer"]) {
+        CFTimeInterval elapsed = now - self.streamStartTime;
+        CGFloat phase = (CGFloat)fmod(elapsed * 1.65, 2.0);
+        CGFloat fadeDur = 0.34;
+        for (NSUInteger i = 0; i < self.tokens.count; i++) {
+            NSString *tok = self.tokens[i];
+            CFTimeInterval birth = [self.tokenBirthTimes[i] doubleValue];
+            CGFloat age = (CGFloat)(now - birth);
+            CGFloat fadeAlpha = (age <= 0) ? 0.06 : (age >= fadeDur ? 1.0 : (0.06 + 0.94 * (1.0 - pow(1.0 - (age / fadeDur), 3.0))));
+            if (age < fadeDur) {
+                needsMoreFrames = YES;
+            }
+            CGFloat shimmerAlpha = 1.0;
+            UIColor *tokColor = baseTextColor;
+            if (self.isStreaming) {
+                CGFloat normPos = (CGFloat)i / MAX(1.0, (CGFloat)self.tokens.count);
+                CGFloat wave = 0.5 + 0.5 * cos((normPos - phase) * M_PI * 2.0);
+                shimmerAlpha = 0.28 + 0.72 * wave;
+                if (wave > 0.85) {
+                    CGFloat r1 = 0, g1 = 0, b1 = 0, a1 = 1;
+                    CGFloat r2 = 0, g2 = 0, b2 = 0, a2 = 1;
+                    if ([baseTextColor getRed:&r1 green:&g1 blue:&b1 alpha:&a1] &&
+                        [accentColor getRed:&r2 green:&g2 blue:&b2 alpha:&a2]) {
+                        CGFloat mix = (wave - 0.85) / 0.15 * 0.45;
+                        tokColor = [UIColor colorWithRed:(r1 + (r2 - r1) * mix)
+                                                   green:(g1 + (g2 - g1) * mix)
+                                                    blue:(b1 + (b2 - b1) * mix)
+                                                   alpha:MIN(1.0, fadeAlpha * shimmerAlpha)];
+                    }
+                } else {
+                    tokColor = [baseTextColor colorWithAlphaComponent:MIN(1.0, fadeAlpha * shimmerAlpha)];
+                }
+                needsMoreFrames = YES;
+            } else {
+                tokColor = [baseTextColor colorWithAlphaComponent:fadeAlpha];
+            }
+            [out appendAttributedString:[[NSAttributedString alloc] initWithString:tok attributes:@{
+                NSFontAttributeName: summaryFont,
+                NSForegroundColorAttributeName: tokColor
+            }]];
+        }
+        if (self.isStreaming) {
+            CGFloat pulse = 0.30 + 0.70 * (0.5 + 0.5 * sin(elapsed * 6.5));
+            [out appendAttributedString:[[NSAttributedString alloc] initWithString:@" ●" attributes:@{
+                NSFontAttributeName: [UIFont systemFontOfSize:MAX(9.0, baseFont.pointSize - 3.0)],
+                NSForegroundColorAttributeName: [accentColor colorWithAlphaComponent:pulse]
+            }]];
+        }
+    } else {
+        // fadeWords (default)
+        CFTimeInterval fadeDur = 0.38;
+        for (NSUInteger i = 0; i < self.tokens.count; i++) {
+            NSString *tok = self.tokens[i];
+            CFTimeInterval birth = [self.tokenBirthTimes[i] doubleValue];
+            CGFloat age = (CGFloat)(now - birth);
+            CGFloat alpha;
+            if (age <= 0) {
+                alpha = 0.05;
+                needsMoreFrames = YES;
+            } else if (age >= fadeDur) {
+                alpha = 1.0;
+            } else {
+                CGFloat t = age / fadeDur;
+                CGFloat eased = 1.0 - pow(1.0 - t, 3.0);
+                alpha = 0.05 + 0.95 * eased;
+                needsMoreFrames = YES;
+            }
+            [out appendAttributedString:[[NSAttributedString alloc] initWithString:tok attributes:@{
+                NSFontAttributeName: summaryFont,
+                NSForegroundColorAttributeName: [baseTextColor colorWithAlphaComponent:alpha]
+            }]];
+        }
+        if (self.isStreaming) {
+            CGFloat pulse = 0.25 + 0.75 * (0.5 + 0.5 * sin((now - self.streamStartTime) * 6.0));
+            [out appendAttributedString:[[NSAttributedString alloc] initWithString:@" ●" attributes:@{
+                NSFontAttributeName: [UIFont systemFontOfSize:MAX(9.0, baseFont.pointSize - 3.0)],
+                NSForegroundColorAttributeName: [accentColor colorWithAlphaComponent:pulse]
+            }]];
+            needsMoreFrames = YES;
+        }
+    }
+
+    if (self.config.showOriginalLine && !self.isStreaming && self.originalText.length > 0 && ![self.originalText isEqualToString:self.targetSummary]) {
+        NSString *flatOrig = [[self.originalText stringByReplacingOccurrencesOfString:@"\r\n" withString:@" "] stringByReplacingOccurrencesOfString:@"\n" withString:@" "];
+        if (flatOrig.length > 70) {
+            NSRange safeRange = [flatOrig rangeOfComposedCharacterSequencesForRange:NSMakeRange(0, 70)];
+            flatOrig = [[flatOrig substringWithRange:safeRange] stringByAppendingString:@"…"];
+        }
+        UIFont *origFont = [UIFont systemFontOfSize:MAX(11.0, baseFont.pointSize - 2.0)];
+        [out appendAttributedString:[[NSAttributedString alloc] initWithString:[NSString stringWithFormat:@"\n%@", flatOrig] attributes:@{
+            NSFontAttributeName: origFont,
+            NSForegroundColorAttributeName: [UIColor secondaryLabelColor]
+        }]];
+    }
+
+    applyAttributedTextToElement(el, out, 4);
+
+    if (needsRelayout || self.tokens.count != self.lastLayoutTokenCount) {
+        self.lastLayoutTokenCount = self.tokens.count;
+        self.lastLayoutStreaming = self.isStreaming;
+        [el invalidateIntrinsicContentSize];
+        [self.layoutHost setNeedsLayout];
+        if (self.layoutDeltaBlock) {
+            self.layoutDeltaBlock();
+        }
+    }
+
+    if (!needsMoreFrames) {
+        [self invalidate];
+    }
+}
+@end
+
+@implementation DigestBannerAnimator
+
++ (UIColor *)resolveAccentColor:(NSString *)key {
+    if ([key isEqualToString:@"label"]) return [UIColor labelColor];
+    if ([key isEqualToString:@"blue"]) return [UIColor systemBlueColor];
+    if ([key isEqualToString:@"purple"]) return [UIColor systemPurpleColor];
+    if ([key isEqualToString:@"teal"]) return [UIColor systemTealColor];
+    if ([key isEqualToString:@"orange"]) return [UIColor systemOrangeColor];
+    if ([key isEqualToString:@"red"]) return [UIColor systemRedColor];
+    if ([key isEqualToString:@"green"]) return [UIColor systemGreenColor];
+    return nil;
+}
+
++ (NSAttributedString *)prefixAttributedStringWithConfig:(DigestBannerRenderConfig *)config
+                                               baseFont:(UIFont *)baseFont
+                                          retainedImage:(UIImage **)outImage {
+    NSMutableAttributedString *prefixAttr = [[NSMutableAttributedString alloc] init];
+    NSString *badgeStyle = config.badgeStyle ?: @"arrow";
+    NSString *prefixText = config.prefixText.length > 0 ? config.prefixText : @"[AI]";
+    UIColor *accent = [self resolveAccentColor:config.accentColorKey];
+
+    if ([badgeStyle isEqualToString:@"sparkles"] || [badgeStyle isEqualToString:@"bolt"] || [badgeStyle isEqualToString:@"cpu"]) {
+        NSString *symbolName = [badgeStyle isEqualToString:@"bolt"] ? @"bolt.fill" : badgeStyle;
+        UIImageSymbolConfiguration *symConfig = [UIImageSymbolConfiguration configurationWithPointSize:MAX(11.0, baseFont.pointSize - 1.0) weight:UIFontWeightSemibold];
+        UIImage *symImg = [UIImage systemImageNamed:symbolName withConfiguration:symConfig];
+        if (symImg) {
+            UIImage *tinted = [symImg imageWithTintColor:(accent ?: [UIColor labelColor]) renderingMode:UIImageRenderingModeAlwaysOriginal];
+            if (outImage) *outImage = tinted;
+            NSTextAttachment *attachment = [[NSTextAttachment alloc] init];
+            attachment.image = tinted;
+            CGFloat h = MAX(12.0, baseFont.pointSize - 1.0);
+            CGFloat w = (tinted.size.height > 0) ? (tinted.size.width / tinted.size.height) * h : h;
+            attachment.bounds = CGRectMake(0, -2.0, w, h);
+            [prefixAttr appendAttributedString:[NSAttributedString attributedStringWithAttachment:attachment]];
+            [prefixAttr appendAttributedString:[[NSAttributedString alloc] initWithString:@" "]];
+        }
+    } else if ([badgeStyle isEqualToString:@"arrow"]) {
+        UIImage *image = config.arrowImage;
+        if (!image) {
+            UIImageSymbolConfiguration *symConfig = [UIImageSymbolConfiguration configurationWithPointSize:MAX(11.0, baseFont.pointSize - 1.0) weight:UIFontWeightSemibold];
+            image = [UIImage systemImageNamed:@"arrow.turn.down.right" withConfiguration:symConfig];
+        }
+        if (image) {
+            UIImage *finalImg = accent
+                ? [image imageWithTintColor:accent renderingMode:UIImageRenderingModeAlwaysOriginal]
+                : (config.arrowImage ? image : [image imageWithTintColor:[UIColor labelColor] renderingMode:UIImageRenderingModeAlwaysOriginal]);
+            if (outImage) *outImage = finalImg;
+            NSTextAttachment *attachment = [[NSTextAttachment alloc] init];
+            attachment.image = finalImg;
+            attachment.bounds = CGRectMake(0, -1.0, 19, 12);
+            [prefixAttr appendAttributedString:[[NSAttributedString alloc] initWithString:@" "]];
+            [prefixAttr appendAttributedString:[NSAttributedString attributedStringWithAttachment:attachment]];
+            [prefixAttr appendAttributedString:[[NSAttributedString alloc] initWithString:@"  "]];
+        }
+    }
+
+    if ((config.showPrefix || [badgeStyle isEqualToString:@"text"]) && prefixText.length > 0) {
+        UIFont *prefixFont = [UIFont systemFontOfSize:baseFont.pointSize weight:UIFontWeightSemibold];
+        [prefixAttr appendAttributedString:[[NSAttributedString alloc] initWithString:[NSString stringWithFormat:@"%@ ", prefixText] attributes:@{
+            NSFontAttributeName: prefixFont,
+            NSForegroundColorAttributeName: (accent ?: [UIColor labelColor])
+        }]];
+    }
+
+    return prefixAttr;
+}
