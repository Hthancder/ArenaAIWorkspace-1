+-(void)showPromptPresets {
+	UIAlertController *sheet = [UIAlertController alertControllerWithTitle:@"Prompt Presets"
+		message:@"Chọn mẫu prompt tối ưu (áp dụng ngay không cần respring)"
+		preferredStyle:UIAlertControllerStyleActionSheet];
+
+	__weak typeof(self) weakSelf = self;
+	[sheet addAction:[UIAlertAction actionWithTitle:@"Tiếng Việt (Chuẩn — giữ số & tên)" style:UIAlertActionStyleDefault handler:^(UIAlertAction *action) {
+		[weakSelf applyPromptPreset:@"Tóm tắt thông báo sau thật ngắn gọn (tối đa 12-15 từ). Giữ nguyên tên người gửi, số tiền, mã số, giờ hẹn và địa điểm nếu có; chỉ trả về câu tóm tắt:"
+			systemPrompt:@"Bạn là trợ lý tóm tắt thông báo ngắn gọn, chính xác. Luôn giữ đúng ngôn ngữ gốc của thông báo (tiếng Việt tự nhiên nếu thông báo là tiếng Việt) và không bịa thêm thông tin."];
+	}]];
+	[sheet addAction:[UIAlertAction actionWithTitle:@"Tiếng Việt (Siêu ngắn — dưới 8 từ)" style:UIAlertActionStyleDefault handler:^(UIAlertAction *action) {
+		[weakSelf applyPromptPreset:@"Rút gọn thông báo sau thành 1 cụm dưới 8 từ, giữ nguyên tên riêng và con số quan trọng, chỉ trả về kết quả:"
+			systemPrompt:@"Bạn là trợ lý tóm tắt thông báo cực ngắn, đúng ngôn ngữ gốc, giữ nguyên tên riêng và con số quan trọng."];
+	}]];
+	[sheet addAction:[UIAlertAction actionWithTitle:@"Multilingual / English (Natural)" style:UIAlertActionStyleDefault handler:^(UIAlertAction *action) {
+		[weakSelf applyPromptPreset:@"Summarize this notification concisely in its original language (max 12-15 words). Preserve names, numbers, amounts, codes, and times:"
+			systemPrompt:@"You are an assistant that summarizes notifications concisely in the same language as the original notification. Output only the summary."];
+	}]];
+	[sheet addAction:[UIAlertAction actionWithTitle:@"Original dig3st Default" style:UIAlertActionStyleDefault handler:^(UIAlertAction *action) {
+		[weakSelf applyPromptPreset:@"Summarize this text as sort as possible only mention about the content do not go in detail,super simple shorten anything you can (urls,numbers),compromise understandability in favor of keeping it short,only keep keywords,if possible fit it in a max a sentence of 5 words"
+			systemPrompt:@"You are an assistant that summarizes notifications."];
+	}]];
+	[sheet addAction:[UIAlertAction actionWithTitle:@"Cancel" style:UIAlertActionStyleCancel handler:nil]];
+
+	UIPopoverPresentationController *popover = sheet.popoverPresentationController;
+	if (popover) {
+		popover.sourceView = self.view;
+		popover.sourceRect = CGRectMake(CGRectGetMidX(self.view.bounds), CGRectGetMidY(self.view.bounds), 1, 1);
+		popover.permittedArrowDirections = 0;
+	}
+	[self presentViewController:sheet animated:YES completion:nil];
+}
