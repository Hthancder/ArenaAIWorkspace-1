+static NSString *safeKVCString(id obj, NSString *key) {
+    if (!obj || key.length == 0) return nil;
+    @try {
+        id value = [obj valueForKey:key];
+        if ([value isKindOfClass:[NSString class]]) {
+            NSString *trimmed = [(NSString *)value stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+            return trimmed.length > 0 ? trimmed : nil;
+        }
+    } @catch (NSException *e) {
+        return nil;
+    }
+    return nil;
+}
+
+static NSString *resolveAppName(NCNotificationRequest *req) {
+    NSString *header = safeKVCString(req.content, @"header");
+    if (header.length > 0) return header;
+    if (req.sectionIdentifier.length > 0) {
+        @try {
+            Class sbAppCtrl = %c(SBApplicationController);
+            if (sbAppCtrl) {
+                id ctrl = [sbAppCtrl sharedInstance];
+                id app = [ctrl applicationWithBundleIdentifier:req.sectionIdentifier];
+                NSString *displayName = safeKVCString(app, @"displayName");
+                if (displayName.length > 0) return displayName;
+            }
+        } @catch (NSException *e) {}
+        return req.sectionIdentifier;
+    }
+    return nil;
+}
+
+static NSString *contextKeyForRequest(NCNotificationRequest *req, NSString *title) {
+    NSString *bundleId = req.sectionIdentifier.length > 0 ? req.sectionIdentifier : @"unknown";
+    if (!contextPerThread) {
+        return bundleId;
+    }
+    NSString *threadId = safeKVCString(req, @"threadIdentifier") ?: safeKVCString(req.content, @"threadIdentifier");
+    NSString *notifId = safeKVCString(req, @"notificationIdentifier");
+    if (threadId.length > 0 && ![threadId hasPrefix:@"debug-thread-req-"] && (!notifId || ![threadId isEqualToString:notifId])) {
+        return [NSString stringWithFormat:@"%@|t:%@", bundleId, threadId];
+    }
+    if (title.length > 0) {
+        return [NSString stringWithFormat:@"%@|s:%@", bundleId, title];
+    }
+    return [NSString stringWithFormat:@"%@|default", bundleId];
+}
+
+static NSString *formatRelativeAge(NSTimeInterval seconds) {
+    NSInteger sec = (NSInteger)MAX(0, seconds);
+    if (sec < 60) {
+        return [NSString stringWithFormat:@"-%lds", (long)sec];
+    }
+    NSInteger mins = sec / 60;
+    if (mins < 60) {
+        return [NSString stringWithFormat:@"-%ldm", (long)mins];
+    }
+    NSInteger hrs = mins / 60;
+    return [NSString stringWithFormat:@"-%ldh", (long)hrs];
+}
