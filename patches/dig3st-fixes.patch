+#pragma mark - NSURLSessionDataDelegate (SSE Streaming)
+
+- (void)URLSession:(NSURLSession *)session
+          dataTask:(NSURLSessionDataTask *)dataTask
+didReceiveResponse:(NSURLResponse *)response
+ completionHandler:(void (^)(NSURLSessionResponseDisposition disposition))completionHandler {
+    DigestStreamContext *ctx = nil;
+    @synchronized(self.streamLock) {
+        ctx = self.streamContexts[@(dataTask.taskIdentifier)];
+    }
+    if (ctx && [response isKindOfClass:[NSHTTPURLResponse class]]) {
+        ctx.httpStatusCode = ((NSHTTPURLResponse *)response).statusCode;
+    }
+    if (completionHandler) {
+        completionHandler(NSURLSessionResponseAllow);
+    }
+}
+
+- (void)processSSELine:(NSString *)line context:(DigestStreamContext *)ctx {
+    NSString *trimmed = [line stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+    if (![trimmed hasPrefix:@"data:"]) return;
+    ctx.sawSSE = YES;
+    NSString *payload = [[trimmed substringFromIndex:5] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
+    if (payload.length == 0 || [payload isEqualToString:@"[DONE]"]) return;
+
+    NSData *jsonData = [payload dataUsingEncoding:NSUTF8StringEncoding];
+    if (!jsonData) return;
+    id jsonObj = [NSJSONSerialization JSONObjectWithData:jsonData options:0 error:nil];
+    if (![jsonObj isKindOfClass:[NSDictionary class]]) return;
+
+    if (jsonObj[@"error"]) {
+        NSLog(@"SSE error payload: %@", jsonObj[@"error"]);
+    }
+
+    id choices = jsonObj[@"choices"];
+    if (![choices isKindOfClass:[NSArray class]] || [choices count] == 0) return;
+
+    NSDictionary *choice0 = choices[0];
+    if (![choice0 isKindOfClass:[NSDictionary class]]) return;
+
+    NSString *deltaText = nil;
+    id delta = choice0[@"delta"];
+    if ([delta isKindOfClass:[NSDictionary class]]) {
+        deltaText = [self extractTextValue:delta[@"content"]] ?: [self extractTextValue:delta[@"text"]];
+    }
+    if (deltaText.length == 0 && [choice0[@"message"] isKindOfClass:[NSDictionary class]]) {
+        deltaText = [self extractTextValue:choice0[@"message"][@"content"]];
+    }
+    if (deltaText.length == 0 && [choice0[@"text"] isKindOfClass:[NSString class]]) {
+        deltaText = choice0[@"text"];
+    }
+    if (deltaText.length > 0) {
+        [ctx.accumulatedText appendString:deltaText];
+    }
+}
+
+- (void)URLSession:(NSURLSession *)session dataTask:(NSURLSessionDataTask *)dataTask didReceiveData:(NSData *)data {
+    DigestStreamContext *ctx = nil;
+    NSUInteger activeStreamCount = 1;
+    @synchronized(self.streamLock) {
+        ctx = self.streamContexts[@(dataTask.taskIdentifier)];
+        activeStreamCount = self.streamContexts.count;
+    }
+    if (!ctx || ctx.finished || data.length == 0) return;
+
+    [ctx.rawBuffer appendData:data];
+
+    const uint8_t *bytes = (const uint8_t *)ctx.rawBuffer.bytes;
+    NSUInteger length = ctx.rawBuffer.length;
+
+    // If response begins with JSON ('{' or '[') and has not produced SSE 'data:' lines,
+    // keep the entire buffer intact for JSON parsing in didCompleteWithError:.
+    if (!ctx.sawSSE) {
+        NSUInteger first = 0;
+        while (first < length && (bytes[first] == ' ' || bytes[first] == '\t' || bytes[first] == '\r' || bytes[first] == '\n')) {
+            first++;
+        }
+        if (first < length && (bytes[first] == '{' || bytes[first] == '[')) {
+            return;
+        }
+    }
+
+    NSUInteger lineStart = 0;
+    BOOL appendedAny = NO;
+
+    for (NSUInteger i = 0; i < length; i++) {
+        if (bytes[i] == '\n') {
+            NSUInteger s = lineStart;
+            NSUInteger e = i;
+            while (s < e && (bytes[s] == ' ' || bytes[s] == '\t' || bytes[s] == '\r')) s++;
+            while (e > s && (bytes[e - 1] == ' ' || bytes[e - 1] == '\t' || bytes[e - 1] == '\r')) e--;
+            if ((e - s) >= 5 &&
+                bytes[s] == 'd' && bytes[s + 1] == 'a' && bytes[s + 2] == 't' &&
+                bytes[s + 3] == 'a' && bytes[s + 4] == ':') {
+                ctx.sawSSE = YES;
+                NSString *lineStr = [[NSString alloc] initWithBytes:(bytes + s) length:(e - s) encoding:NSUTF8StringEncoding];
+                if (lineStr.length > 0) {
+                    NSUInteger beforeLen = ctx.accumulatedText.length;
+                    [self processSSELine:lineStr context:ctx];
+                    if (ctx.accumulatedText.length > beforeLen) {
+                        appendedAny = YES;
+                    }
+                }
+            }
+            lineStart = i + 1;
+        }
+    }
+
+    if (lineStart > 0 && ctx.sawSSE) {
+        [ctx.rawBuffer replaceBytesInRange:NSMakeRange(0, lineStart) withBytes:NULL length:0];
+    }
+
+    if (appendedAny && ctx.partialBlock) {
+        CFTimeInterval now = CACurrentMediaTime();
+        CFTimeInterval minInterval = (activeStreamCount > 2) ? 0.14 : 0.085;
+        if (now - ctx.lastEmitTime >= minInterval) {
+            ctx.lastEmitTime = now;
+            NSString *snapshot = [self cleanText:ctx.accumulatedText trimEnd:NO];
+            if (snapshot.length > 0) {
+                void (^partial)(NSString *) = ctx.partialBlock;
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    partial(snapshot);
+                });
+            }
+        }
+    }
+}
+
+- (void)URLSession:(NSURLSession *)session task:(NSURLSessionTask *)task didCompleteWithError:(NSError *)error {
+    DigestStreamContext *ctx = nil;
+    @synchronized(self.streamLock) {
+        ctx = self.streamContexts[@(task.taskIdentifier)];
+        [self.streamContexts removeObjectForKey:@(task.taskIdentifier)];
+    }
+    if (!ctx || ctx.finished) return;
+    ctx.finished = YES;
+
+    if (ctx.httpStatusCode == 0 && [task.response isKindOfClass:[NSHTTPURLResponse class]]) {
+        ctx.httpStatusCode = ((NSHTTPURLResponse *)task.response).statusCode;
+    }
+
+    if (ctx.rawBuffer.length > 0) {
+        NSString *tail = [[NSString alloc] initWithData:ctx.rawBuffer encoding:NSUTF8StringEncoding];
+        if (tail.length > 0) {
+            NSString *trimmedTail = [tail stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+            if (ctx.sawSSE || (![trimmedTail hasPrefix:@"{"] && ![trimmedTail hasPrefix:@"["] && [tail containsString:@"data:"])) {
+                for (NSString *line in [tail componentsSeparatedByString:@"\n"]) {
+                    [self processSSELine:line context:ctx];
+                }
+            } else if (ctx.accumulatedText.length == 0) {
+                id jsonResponse = [NSJSONSerialization JSONObjectWithData:ctx.rawBuffer options:0 error:nil];
+                if ([jsonResponse isKindOfClass:[NSDictionary class]]) {
+                    if (jsonResponse[@"error"] || ctx.httpStatusCode >= 400) {
+                        NSLog(@"Stream endpoint returned JSON error (HTTP %ld): %@", (long)ctx.httpStatusCode, jsonResponse[@"error"] ?: jsonResponse);
+                        [self.logger log:[NSString stringWithFormat:@"Stream API error HTTP %ld: %@", (long)ctx.httpStatusCode, jsonResponse[@"error"] ?: jsonResponse] level:LOGLEVEL_WARNING];
+                    }
+                    id choices = jsonResponse[@"choices"];
+                    if ([choices isKindOfClass:[NSArray class]] && [choices count] > 0) {
+                        NSDictionary *choice0 = [choices[0] isKindOfClass:[NSDictionary class]] ? choices[0] : nil;
+                        id rawContent = [choice0[@"message"] isKindOfClass:[NSDictionary class]]
+                            ? choice0[@"message"][@"content"]
+                            : choice0[@"text"];
+                        NSString *content = [self extractTextValue:rawContent];
+                        if (content.length > 0) {
+                            [ctx.accumulatedText appendString:content];
+                        }
+                    }
+                } else if (ctx.httpStatusCode >= 400) {
+                    NSLog(@"Stream HTTP %ld error body: %@", (long)ctx.httpStatusCode, trimmedTail);
+                }
+            }
+        }
+    }
+
+    if (error) {
+        NSLog(@"Stream request failed (HTTP %ld): %@", (long)ctx.httpStatusCode, error.localizedDescription);
+    }
+
+    NSString *finalResult = (error && ctx.accumulatedText.length == 0)
+        ? @""
+        : [self cleanText:ctx.accumulatedText trimEnd:YES];
+
+    BOOL canFallback = (ctx.allowStreamFallback &&
+                        finalResult.length == 0 &&
+                        ctx.query != nil &&
+                        ctx.httpStatusCode != 401 &&
+                        ctx.httpStatusCode != 403);
+    if (canFallback) {
+        NSLog(@"Streaming returned empty/error (HTTP %ld); falling back to non-stream request", (long)ctx.httpStatusCode);
+        [self summarizeInternal:ctx.query
+                  autoTranslate:ctx.autoTranslateOverride
+                   customPrompt:ctx.customPromptOverride
+                     streamMode:NO
+                  allowFallback:NO
+                      onPartial:nil
+                     completion:ctx.completionBlock];
+        return;
+    }
+
+    void (^comp)(NSString *) = ctx.completionBlock;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (comp) comp(finalResult);
+    });
+}
 @end
