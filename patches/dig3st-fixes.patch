+static void renderControllerBannerStaticOnly(NCNotificationShortLookViewController *vc) {
+    if (!vc || !vc.notificationRequest || !vc.notificationRequest.dig3st) return;
+    @try {
+        if ([vc isKindOfClass:NSClassFromString(@"NCExpandedPlatterViewController")]) {
+            renderExpandedController(vc);
+            return;
+        }
+        UIView *seamlessContentView = findContentViewForController(vc);
+        if (!seamlessContentView) return;
+
+        UIView *messageEl = nil;
+        @try { messageEl = [seamlessContentView valueForKey:@"secondaryTextElement"]; } @catch (NSException *e) {}
+        NSString *msgText = safeKVCString(vc.notificationRequest.content, @"message");
+        if (!messageEl || !msgText) return;
+
+        NCNotificationRequest *req = vc.notificationRequest;
+        NSString *origText = safeKVCString(req, @"actualMessage");
+        DigestBannerRenderConfig *cfg = currentBannerRenderConfig();
+        BOOL isStreaming = NO;
+        @try {
+            isStreaming = [[req valueForKey:@"dig3stStreaming"] boolValue];
+        } @catch (NSException *e) {}
+
+        if ([DigestBannerAnimator isLabelStaticUpToDate:messageEl
+                                            withSummary:msgText
+                                           originalText:origText
+                                            isStreaming:isStreaming
+                                                 config:cfg]) {
+            return;
+        }
+
+        UIView *preview = (UIView *)vc.viewForPreview;
+        @try {
+            id curSecLines = [seamlessContentView valueForKey:@"secondaryTextMaximumNumberOfLines"];
+            if (![curSecLines isKindOfClass:[NSNumber class]] || [curSecLines unsignedIntegerValue] != 4) {
+                [seamlessContentView setValue:@(4) forKey:@"secondaryTextMaximumNumberOfLines"];
+            }
+            if (preview) {
+                id curPrevLines = [preview valueForKey:@"maximumNumberOfSecondaryTextLines"];
+                if (![curPrevLines isKindOfClass:[NSNumber class]] || [curPrevLines unsignedIntegerValue] != 4) {
+                    [preview setValue:@(4) forKey:@"maximumNumberOfSecondaryTextLines"];
+                }
+            }
+            if ([seamlessContentView respondsToSelector:@selector(_updateTextAttributesIfNecessary)]) {
+                [(NCNotificationSeamlessContentView *)seamlessContentView _updateTextAttributesIfNecessary];
+            }
+        } @catch (NSException *e) {}
+
+        if ([DigestBannerAnimator hasActiveAnimationForLabel:messageEl]) {
+            NSString *animTarget = [DigestBannerAnimator currentTargetSummaryForLabel:messageEl];
+            if ([animTarget isEqualToString:msgText]) {
+                [DigestBannerAnimator refreshNowForLabel:messageEl];
+                return;
+            }
+            renderControllerBanner(vc);
+            return;
+        }
+
+        [DigestBannerAnimator applyStaticToLabel:messageEl
+                                     withSummary:msgText
+                                    originalText:origText
+                                     isStreaming:isStreaming
+                                          config:cfg
+                                      layoutHost:seamlessContentView];
+    } @catch (NSException *e) {}
+}
