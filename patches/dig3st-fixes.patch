+@interface SBApplicationController : NSObject
++ (instancetype)sharedInstance;
+- (SBApplication *)applicationWithBundleIdentifier:(NSString *)bundleIdentifier;
+@end
+
+static NSString *safeKVCString(id obj, NSString *key) {
+    if (!obj || key.length == 0) return nil;
+    @try {
+        id value = [obj valueForKey:key];
+        if ([value isKindOfClass:[NSString class]]) {
+            NSString *trimmed = [(NSString *)value stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+            return trimmed.length > 0 ? trimmed : nil;
+        }
+    } @catch (NSException *e) {
+        return nil;
+    }
+    return nil;
+}
+
+static NSString *resolveAppName(NCNotificationRequest *req) {
+    NSString *header = safeKVCString(req.content, @"header");
+    if (header.length > 0) return header;
+    if (req.sectionIdentifier.length > 0) {
+        @try {
+            Class sbAppCtrl = %c(SBApplicationController);
+            if (sbAppCtrl) {
+                id ctrl = [sbAppCtrl sharedInstance];
+                id app = [ctrl applicationWithBundleIdentifier:req.sectionIdentifier];
+                NSString *displayName = safeKVCString(app, @"displayName");
+                if (displayName.length > 0) return displayName;
+            }
+        } @catch (NSException *e) {}
+        return req.sectionIdentifier;
+    }
+    return nil;
+}
+
+static NSString *buildContextPrompt(NCNotificationRequest *req, NSString *message) {
+    if (!includeContext) return message;
+    NSString *appName = resolveAppName(req);
+    NSString *title = safeKVCString(req.content, @"title");
+    NSString *subtitle = safeKVCString(req.content, @"subtitle");
+
+    NSMutableString *contextHeader = [NSMutableString string];
+    if (appName.length > 0) {
+        [contextHeader appendFormat:@"[%@]", appName];
+    }
+    if (title.length > 0 && (!appName || ![title isEqualToString:appName])) {
+        if (contextHeader.length > 0) [contextHeader appendString:@" "];
+        [contextHeader appendString:title];
+    }
+    if (subtitle.length > 0 && (!title || ![subtitle isEqualToString:title])) {
+        if (contextHeader.length > 0) [contextHeader appendString:@" - "];
+        [contextHeader appendString:subtitle];
+    }
+    if (contextHeader.length == 0) return message;
+    return [NSString stringWithFormat:@"%@: %@", contextHeader, message];
+}
+
+static void refreshRuntimePrefs(void) {
+    if (!prefsManager) return;
+    CFPreferencesAppSynchronize(CFSTR("com.uncore.dig3st"));
+    [prefsManager synchronize];
+    tweakEnabled = [[prefsManager objectForKey:@"enabled"] boolValue];
+    id ctxObj = [prefsManager objectForKey:@"includeContext"];
+    includeContext = ctxObj ? [ctxObj boolValue] : YES;
+}
 
