+static void pruneContextBufferLocked(NSDate *now) {
+    if (contextBuffer.count == 0) return;
+    NSMutableArray<NSString *> *emptyKeys = [NSMutableArray new];
+    [contextBuffer enumerateKeysAndObjectsUsingBlock:^(NSString *k, NSMutableArray<NSDictionary *> *entries, BOOL *stop) {
+        while (entries.count > 0) {
+            NSDate *ts = entries.firstObject[@"date"];
+            if (!ts || [now timeIntervalSinceDate:ts] > contextWindowSeconds) {
+                [entries removeObjectAtIndex:0];
+            } else {
+                break;
+            }
+        }
+        if (entries.count == 0) {
+            [emptyKeys addObject:k];
+        }
+    }];
+    if (emptyKeys.count > 0) {
+        [contextBuffer removeObjectsForKeys:emptyKeys];
+    }
+    while (contextBuffer.count > DIGEST_MAX_CONTEXT_BUCKETS) {
+        __block NSString *oldestKey = nil;
+        __block NSDate *oldestDate = [NSDate distantFuture];
+        [contextBuffer enumerateKeysAndObjectsUsingBlock:^(NSString *k, NSMutableArray<NSDictionary *> *entries, BOOL *stop) {
+            NSDate *d = entries.lastObject[@"date"] ?: [NSDate distantPast];
+            if ([d compare:oldestDate] == NSOrderedAscending) {
+                oldestDate = d;
+                oldestKey = k;
+            }
+        }];
+        if (oldestKey) {
+            [contextBuffer removeObjectForKey:oldestKey];
+        } else {
+            break;
+        }
+    }
+}
