--- /dev/null
+++ b/preferences/DigestPromptEditorController.m
@@ -0,0 +1,189 @@
+#import "../headers/HeadersPreferences.h"
+
+@interface DigestPromptEditorController : PSViewController <UITextViewDelegate>
+@property (nonatomic, strong) UITextView *textView;
+@property (nonatomic, strong) UILabel *statsLabel;
+@property (nonatomic, strong) UILabel *hintLabel;
+@property (nonatomic, strong) NSLayoutConstraint *bottomConstraint;
+@property (nonatomic, copy) NSString *prefKey;
+@property (nonatomic, copy) NSString *defaultText;
+@end
+
+@implementation DigestPromptEditorController
+
+- (void)viewDidLoad {
+    [super viewDidLoad];
+    self.view.backgroundColor = [UIColor systemGroupedBackgroundColor];
+
+    self.prefKey = self.specifier.properties[@"prefKey"] ?: (self.specifier.properties[@"key"] ?: @"prompt");
+    NSString *title = self.specifier.properties[@"editorTitle"] ?: (self.specifier.name ?: @"Edit Prompt");
+    self.title = title;
+
+    if ([self.prefKey isEqualToString:@"systemPrompt"]) {
+        self.defaultText = @"You are an assistant that summarizes notifications concisely in the same language as the original notification. Output only the summary.";
+    } else if ([self.prefKey hasPrefix:@"appPrompt_"]) {
+        self.defaultText = @"";
+    } else {
+        self.defaultText = @"Summarize this notification concisely in its original language (max 12-15 words). Preserve names, numbers, amounts, codes, and times:";
+    }
+
+    self.navigationItem.rightBarButtonItem = [[UIBarButtonItem alloc] initWithTitle:@"Save" style:UIBarButtonItemStyleDone target:self action:@selector(saveAndBack)];
+
+    self.hintLabel = [UILabel new];
+    self.hintLabel.translatesAutoresizingMaskIntoConstraints = NO;
+    self.hintLabel.font = [UIFont systemFontOfSize:13.0];
+    self.hintLabel.textColor = [UIColor secondaryLabelColor];
+    self.hintLabel.numberOfLines = 0;
+    if ([self.prefKey hasPrefix:@"appPrompt_"]) {
+        self.hintLabel.text = @"Custom prompt only for this app. Leave empty to use the global prompt.";
+    } else if ([self.prefKey isEqualToString:@"systemPrompt"]) {
+        self.hintLabel.text = @"System instructions defining AI tone, language accuracy, and formatting rules.";
+    } else {
+        self.hintLabel.text = @"Instruction prepended before each notification. Supports multi-line Vietnamese and English.";
+    }
+
+    self.textView = [UITextView new];
+    self.textView.translatesAutoresizingMaskIntoConstraints = NO;
+    self.textView.font = [UIFont systemFontOfSize:15.5];
+    self.textView.textColor = [UIColor labelColor];
+    self.textView.backgroundColor = [UIColor secondarySystemGroupedBackgroundColor];
+    self.textView.layer.cornerRadius = 14.0;
+    self.textView.layer.borderWidth = 0.5;
+    self.textView.layer.borderColor = [UIColor separatorColor].CGColor;
+    self.textView.textContainerInset = UIEdgeInsetsMake(14, 12, 14, 12);
+    self.textView.autocorrectionType = UITextAutocorrectionTypeNo;
+    self.textView.delegate = self;
+
+    DigestPrefsManager *manager = [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+    CFPreferencesAppSynchronize(CFSTR("com.uncore.dig3st"));
+    [manager synchronize];
+    NSString *current = [manager safeObjectForKey:self.prefKey];
+    self.textView.text = [current isKindOfClass:[NSString class]] ? current : @"";
+
+    UIView *bar = [UIView new];
+    bar.translatesAutoresizingMaskIntoConstraints = NO;
+
+    self.statsLabel = [UILabel new];
+    self.statsLabel.translatesAutoresizingMaskIntoConstraints = NO;
+    self.statsLabel.font = [UIFont monospacedDigitSystemFontOfSize:12.0 weight:UIFontWeightMedium];
+    self.statsLabel.textColor = [UIColor secondaryLabelColor];
+
+    UIButton *copyBtn = [UIButton buttonWithType:UIButtonTypeSystem];
+    copyBtn.translatesAutoresizingMaskIntoConstraints = NO;
+    [copyBtn setTitle:@"Copy" forState:UIControlStateNormal];
+    [copyBtn addTarget:self action:@selector(copyText) forControlEvents:UIControlEventTouchUpInside];
+
+    UIButton *clearBtn = [UIButton buttonWithType:UIButtonTypeSystem];
+    clearBtn.translatesAutoresizingMaskIntoConstraints = NO;
+    [clearBtn setTitle:@"Clear" forState:UIControlStateNormal];
+    [clearBtn addTarget:self action:@selector(clearText) forControlEvents:UIControlEventTouchUpInside];
+
+    UIButton *resetBtn = [UIButton buttonWithType:UIButtonTypeSystem];
+    resetBtn.translatesAutoresizingMaskIntoConstraints = NO;
+    [resetBtn setTitle:@"Reset" forState:UIControlStateNormal];
+    [resetBtn setTitleColor:[UIColor systemRedColor] forState:UIControlStateNormal];
+    [resetBtn addTarget:self action:@selector(resetDefault) forControlEvents:UIControlEventTouchUpInside];
+
+    [bar addSubview:self.statsLabel];
+    [bar addSubview:copyBtn];
+    [bar addSubview:clearBtn];
+    [bar addSubview:resetBtn];
+
+    [self.view addSubview:self.hintLabel];
+    [self.view addSubview:self.textView];
+    [self.view addSubview:bar];
+
+    UILayoutGuide *safe = self.view.safeAreaLayoutGuide;
+    self.bottomConstraint = [bar.bottomAnchor constraintEqualToAnchor:safe.bottomAnchor constant:-12.0];
+
+    [NSLayoutConstraint activateConstraints:@[
+        [self.hintLabel.topAnchor constraintEqualToAnchor:safe.topAnchor constant:12.0],
+        [self.hintLabel.leadingAnchor constraintEqualToAnchor:safe.leadingAnchor constant:16.0],
+        [self.hintLabel.trailingAnchor constraintEqualToAnchor:safe.trailingAnchor constant:-16.0],
+
+        [self.textView.topAnchor constraintEqualToAnchor:self.hintLabel.bottomAnchor constant:10.0],
+        [self.textView.leadingAnchor constraintEqualToAnchor:safe.leadingAnchor constant:16.0],
+        [self.textView.trailingAnchor constraintEqualToAnchor:safe.trailingAnchor constant:-16.0],
+        [self.textView.bottomAnchor constraintEqualToAnchor:bar.topAnchor constant:-10.0],
+
+        [bar.leadingAnchor constraintEqualToAnchor:safe.leadingAnchor constant:16.0],
+        [bar.trailingAnchor constraintEqualToAnchor:safe.trailingAnchor constant:-16.0],
+        [bar.heightAnchor constraintEqualToConstant:34.0],
+        self.bottomConstraint,
+
+        [self.statsLabel.leadingAnchor constraintEqualToAnchor:bar.leadingAnchor],
+        [self.statsLabel.centerYAnchor constraintEqualToAnchor:bar.centerYAnchor],
+
+        [resetBtn.trailingAnchor constraintEqualToAnchor:bar.trailingAnchor],
+        [resetBtn.centerYAnchor constraintEqualToAnchor:bar.centerYAnchor],
+
+        [clearBtn.trailingAnchor constraintEqualToAnchor:resetBtn.leadingAnchor constant:-14.0],
+        [clearBtn.centerYAnchor constraintEqualToAnchor:bar.centerYAnchor],
+
+        [copyBtn.trailingAnchor constraintEqualToAnchor:clearBtn.leadingAnchor constant:-14.0],
+        [copyBtn.centerYAnchor constraintEqualToAnchor:bar.centerYAnchor]
+    ]];
+
+    [[NSNotificationCenter defaultCenter] addObserver:self selector:@selector(keyboardChanged:) name:UIKeyboardWillChangeFrameNotification object:nil];
+    [self updateStats];
+}
+
+- (void)dealloc {
+    [[NSNotificationCenter defaultCenter] removeObserver:self name:UIKeyboardWillChangeFrameNotification object:nil];
+}
+
+- (void)keyboardChanged:(NSNotification *)note {
+    CGRect endFrame = [note.userInfo[UIKeyboardFrameEndUserInfoKey] CGRectValue];
+    CGRect converted = [self.view convertRect:endFrame fromView:nil];
+    CGFloat overlap = MAX(0.0, CGRectGetHeight(self.view.bounds) - self.view.safeAreaInsets.bottom - CGRectGetMinY(converted));
+    self.bottomConstraint.constant = -(overlap + 12.0);
+    NSTimeInterval dur = [note.userInfo[UIKeyboardAnimationDurationUserInfoKey] doubleValue];
+    [UIView animateWithDuration:dur animations:^{
+        [self.view layoutIfNeeded];
+    }];
+}
+
+- (void)textViewDidChange:(UITextView *)textView {
+    [self updateStats];
+}
+
+- (void)updateStats {
+    NSString *txt = self.textView.text ?: @"";
+    NSString *trimmed = [txt stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+    NSUInteger words = trimmed.length > 0
+        ? [[trimmed componentsSeparatedByCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] filteredArrayUsingPredicate:[NSPredicate predicateWithFormat:@"length > 0"]].count
+        : 0;
+    self.statsLabel.text = [NSString stringWithFormat:@"%lu chars · %lu words", (unsigned long)txt.length, (unsigned long)words];
+}
+
+- (void)copyText {
+    [UIPasteboard generalPasteboard].string = self.textView.text ?: @"";
+}
+
+- (void)clearText {
+    self.textView.text = @"";
+    [self updateStats];
+}
+
+- (void)resetDefault {
+    self.textView.text = self.defaultText ?: @"";
+    [self updateStats];
+}
+
+- (void)saveAndBack {
+    NSString *val = [self.textView.text stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] ?: @"";
+    DigestPrefsManager *manager = [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+    if (val.length == 0 && [self.prefKey hasPrefix:@"appPrompt_"]) {
+        [manager removeObjectForKey:self.prefKey];
+        CFPreferencesSetAppValue((__bridge CFStringRef)self.prefKey, NULL, CFSTR("com.uncore.dig3st"));
+    } else {
+        [manager setObject:val forKey:self.prefKey];
+        CFPreferencesSetAppValue((__bridge CFStringRef)self.prefKey, (__bridge CFPropertyListRef)val, CFSTR("com.uncore.dig3st"));
+    }
+    [manager synchronize];
+    CFPreferencesAppSynchronize(CFSTR("com.uncore.dig3st"));
+    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (CFStringRef)@"com.uncore.dig3st/preferences.changed", NULL, NULL, true);
+    [self.navigationController popViewControllerAnimated:YES];
+}
+
+@end
