+- (void)viewDidLoad {
+	[super viewDidLoad];
+
+	UISearchController *sc = [[UISearchController alloc] initWithSearchResultsController:nil];
+	sc.searchResultsUpdater = self;
+	sc.obscuresBackgroundDuringPresentation = NO;
+	sc.searchBar.placeholder = @"Search app name or bundle ID";
+	self.searchController = sc;
+	self.navigationItem.searchController = sc;
+	self.navigationItem.hidesSearchBarWhenScrolling = NO;
+	self.definesPresentationContext = YES;
+
+	__weak typeof(self) weakSelf = self;
+	UIAction *enableAll = [UIAction actionWithTitle:@"Enable All Listed"
+											  image:[UIImage systemImageNamed:@"checkmark.circle"]
+										 identifier:nil
+											handler:^(__kindof UIAction *action) {
+		[weakSelf setVisibleAppsEnabled:@YES onlyNonApple:NO];
+	}];
+	UIAction *disableAll = [UIAction actionWithTitle:@"Disable All Listed"
+											   image:[UIImage systemImageNamed:@"xmark.circle"]
+										  identifier:nil
+											 handler:^(__kindof UIAction *action) {
