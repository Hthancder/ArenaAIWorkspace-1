+
+	UIMenu *menu = [UIMenu menuWithTitle:@"" children:@[enableAll, disableAll, thirdPartyOnly]];
+	self.navigationItem.rightBarButtonItem = [[UIBarButtonItem alloc] initWithImage:[UIImage systemImageNamed:@"ellipsis.circle"] menu:menu];
+}
+
+- (void)viewWillAppear:(BOOL)animated {
+	[super viewWillAppear:animated];
+	if (self.hasAppearedOnce) {
+		[self refreshOverrideSubtitles];
+		[self reloadSpecifiers];
+	}
+	self.hasAppearedOnce = YES;
+}
+
+- (NSString *)overrideSummaryForBundleId:(NSString *)bundleId {
+	if (bundleId.length == 0) return nil;
+	DigestPrefsManager *manager = [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+	NSMutableArray *parts = [NSMutableArray new];
+	NSString *ctx = [manager safeObjectForKey:[NSString stringWithFormat:@"appCtx_%@", bundleId]];
+	if ([ctx isEqualToString:@"on"]) [parts addObject:@"Context: ON"];
+	else if ([ctx isEqualToString:@"off"]) [parts addObject:@"Context: OFF"];
+
+	NSString *tr = [manager safeObjectForKey:[NSString stringWithFormat:@"appTrans_%@", bundleId]];
+	if ([tr isEqualToString:@"on"]) [parts addObject:@"VN: ON"];
+	else if ([tr isEqualToString:@"off"]) [parts addObject:@"VN: OFF"];
+
+	NSString *st = [manager safeObjectForKey:[NSString stringWithFormat:@"appStream_%@", bundleId]];
+	if ([st isEqualToString:@"on"]) [parts addObject:@"Stream: ON"];
+	else if ([st isEqualToString:@"off"]) [parts addObject:@"Stream: OFF"];
+
+	NSString *pr = [manager safeObjectForKey:[NSString stringWithFormat:@"appPrompt_%@", bundleId]];
+	if ([pr isKindOfClass:[NSString class]] && pr.length > 0) [parts addObject:@"Custom Prompt"];
+
+	return parts.count > 0 ? [parts componentsJoinedByString:@" · "] : nil;
+}
+
+- (void)refreshOverrideSubtitles {
+	DigestPrefsManager *manager = [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+	CFPreferencesAppSynchronize(CFSTR("com.uncore.dig3st"));
+	[manager synchronize];
+	for (PSSpecifier *sp in self.allAppSpecifiers) {
+		NSString *bid = sp.properties[@"digestKey"];
+		if (!bid) continue;
+		NSString *summary = [self overrideSummaryForBundleId:bid];
+		if (summary) {
+			[sp setProperty:summary forKey:@"cellSubtitleText"];
+		} else {
+			[sp removePropertyForKey:@"cellSubtitleText"];
+		}
+	}
+}
+
+- (void)setVisibleAppsEnabled:(NSNumber *)enabled onlyNonApple:(BOOL)onlyNonApple {
+	DigestPrefsManager *manager = [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+	NSArray *targets = [self.specifiers copy];
+	for (PSSpecifier *specifier in targets) {
+		NSString *key = specifier.properties[@"digestKey"];
+		if (key.length == 0) continue;
+		NSNumber *valueToSet = onlyNonApple ? ([key hasPrefix:@"com.apple"] ? @NO : @YES) : enabled;
+		[manager setObject:valueToSet forKey:key];
+		CFPreferencesSetAppValue((__bridge CFStringRef)key, (__bridge CFPropertyListRef)valueToSet, CFSTR("com.uncore.dig3st"));
+	}
+	[manager synchronize];
+	CFPreferencesAppSynchronize(CFSTR("com.uncore.dig3st"));
+	CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (CFStringRef)@"com.uncore.dig3st/preferences.changed", NULL, NULL, true);
+	[self reloadSpecifiers];
+}
+
+- (void)updateSearchResultsForSearchController:(UISearchController *)searchController {
+	NSString *query = [searchController.searchBar.text stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] ?: @"";
+	if (![query isEqualToString:(self.searchQuery ?: @"")]) {
+		self.searchQuery = query;
+		[self reloadSpecifiers];
+	}
+}
 
