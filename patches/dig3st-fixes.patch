+static BOOL updateVisibleControllersForRequest(NCNotificationRequest *targetReq) {
+    if (!targetReq) return NO;
+    NSString *targetId = safeKVCString(targetReq, @"notificationIdentifier");
+    BOOL updatedAny = NO;
+
+    if (activeControllers) {
+        for (NCNotificationShortLookViewController *vc in [activeControllers allObjects]) {
+            if (!vc || !vc.notificationRequest) continue;
+            BOOL match = (vc.notificationRequest == targetReq);
+            if (!match && targetId.length > 0) {
+                NSString *vcId = safeKVCString(vc.notificationRequest, @"notificationIdentifier");
+                match = (vcId.length > 0 && [vcId isEqualToString:targetId]);
+            }
+            if (match) {
+                updatedAny = YES;
+                renderControllerBanner(vc);
+            }
+        }
+    }
+
+    if (activeExpandedControllers) {
+        for (UIViewController *evc in [activeExpandedControllers allObjects]) {
+            if (!evc || ![evc respondsToSelector:@selector(notificationRequest)]) continue;
+            NCNotificationRequest *evReq = [(id)evc notificationRequest];
+            if (!evReq) continue;
+            BOOL match = (evReq == targetReq);
+            if (!match && targetId.length > 0) {
+                NSString *evId = safeKVCString(evReq, @"notificationIdentifier");
+                match = (evId.length > 0 && [evId isEqualToString:targetId]);
+            }
+            if (match) {
+                updatedAny = YES;
+                renderExpandedController(evc);
+            }
+        }
+    }
+    return updatedAny;
+}
