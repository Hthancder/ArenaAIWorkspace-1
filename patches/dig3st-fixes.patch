+static void refreshRuntimePrefs(void) {
+    if (!prefsManager) return;
+    CFPreferencesAppSynchronize(CFSTR("com.uncore.dig3st"));
+    [prefsManager synchronize];
+
+    tweakEnabled = [[prefsManager objectForKey:@"enabled"] boolValue];
+    id ctxObj = [prefsManager objectForKey:@"includeContext"];
+    includeContext = ctxObj ? [ctxObj boolValue] : YES;
+
+    id bufEnabled = [prefsManager objectForKey:@"contextBufferEnabled"];
+    contextBufferEnabled = bufEnabled ? [bufEnabled boolValue] : YES;
+    id perThread = [prefsManager objectForKey:@"contextPerThread"];
+    contextPerThread = perThread ? [perThread boolValue] : YES;
+
+    NSInteger maxMsgs = [[prefsManager objectForKey:@"contextMaxMessages"] integerValue];
+    contextMaxMessages = (maxMsgs >= 1 && maxMsgs <= 20) ? maxMsgs : 4;
+
+    NSInteger winMins = [[prefsManager objectForKey:@"contextWindowMinutes"] integerValue];
+    contextWindowSeconds = (winMins >= 1 && winMins <= 1440) ? (winMins * 60.0) : 600.0;
+
+    NSInteger maxChars = [[prefsManager objectForKey:@"contextMaxChars"] integerValue];
+    contextMaxChars = (maxChars >= 100 && maxChars <= 4000) ? maxChars : 800;
+
+    id incTime = [prefsManager objectForKey:@"contextIncludeTime"];
+    contextIncludeTime = incTime ? [incTime boolValue] : YES;
+    id recShort = [prefsManager objectForKey:@"contextRecordShort"];
+    contextRecordShort = recShort ? [recShort boolValue] : YES;
+
+    NSString *badge = [prefsManager objectForKey:@"bannerBadgeStyle"];
+    bannerBadgeStyle = ([badge isKindOfClass:[NSString class]] && badge.length > 0) ? [badge copy] : @"arrow";
+    NSString *prefix = [prefsManager objectForKey:@"bannerPrefixText"];
+    bannerPrefixText = ([prefix isKindOfClass:[NSString class]] && prefix.length > 0) ? [prefix copy] : @"[AI]";
+    NSString *accent = [prefsManager objectForKey:@"bannerAccentColor"];
+    bannerAccentColor = ([accent isKindOfClass:[NSString class]] && accent.length > 0) ? [accent copy] : @"default";
+    bannerBoldSummary = [[prefsManager objectForKey:@"bannerBoldSummary"] boolValue];
+    bannerShowOriginal = [[prefsManager objectForKey:@"bannerShowOriginal"] boolValue];
+}
 
