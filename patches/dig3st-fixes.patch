++ (void)runNativeRevealOnElement:(UIView *)el
+                           style:(NSString *)anim
+                          config:(DigestBannerRenderConfig *)config {
+    if (!el || el.window == nil) return;
+
+    NSUInteger gen = nextElementAnimGeneration(el);
+    clearGPUEffectsOnElement(el);
+
+    __weak UIView *weakEl = el;
+    void (^cleanupMask)(void) = ^{
+        UIView *strongEl = weakEl;
+        if (!strongEl || currentElementAnimGeneration(strongEl) != gen) return;
+        if (strongEl.layer.mask) {
+            [strongEl.layer.mask removeAllAnimations];
+            strongEl.layer.mask = nil;
+        }
+        strongEl.layer.shadowOpacity = 0.0f;
+        strongEl.layer.shadowRadius = 0.0f;
+    };
+
+    if ([anim isEqualToString:@"crossfade"]) {
+        CATransition *tr = [CATransition animation];
+        tr.type = kCATransitionFade;
+        tr.duration = 0.22;
+        tr.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
+        [el.layer addAnimation:tr forKey:@"dig3stTransition"];
+        return;
+    }
+
+    // Native Spring Rise + Scale + Opacity (CoreAnimation Render Server GPU)
+    CASpringAnimation *posY = [CASpringAnimation animationWithKeyPath:@"transform.translation.y"];
+    posY.fromValue = @([anim isEqualToString:@"springFade"] ? 5.5 : 3.5);
+    posY.toValue = @0.0;
+    posY.damping = 22.0;
+    posY.stiffness = 280.0;
+    posY.mass = 0.85;
+    posY.initialVelocity = 0.0;
+    posY.duration = posY.settlingDuration;
+
+    CASpringAnimation *scale = [CASpringAnimation animationWithKeyPath:@"transform.scale"];
+    scale.fromValue = @([anim isEqualToString:@"springFade"] ? 0.985 : 0.992);
+    scale.toValue = @1.0;
+    scale.damping = 22.0;
+    scale.stiffness = 280.0;
+    scale.mass = 0.85;
+    scale.duration = scale.settlingDuration;
+
+    CABasicAnimation *fade = [CABasicAnimation animationWithKeyPath:@"opacity"];
+    fade.fromValue = @0.15;
+    fade.toValue = @1.0;
+    fade.duration = 0.24;
+    fade.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
+
+    CAAnimationGroup *group = [CAAnimationGroup animation];
+    group.animations = @[posY, scale, fade];
+    group.duration = MAX(0.38, MIN(0.55, posY.settlingDuration));
+    group.removedOnCompletion = YES;
+    [el.layer addAnimation:group forKey:@"dig3stReveal"];
+
+    // Accent / Apple Intelligence Aura Glow
+    if ([anim isEqualToString:@"glowPulse"]) {
+        UIColor *accent = [self resolveAccentColor:config.accentColorKey];
+        if (!accent) {
+            accent = [UIColor colorWithRed:0.46 green:0.38 blue:1.0 alpha:1.0];
+        }
+        UIColor *resolvedAccent = [accent resolvedColorWithTraitCollection:el.traitCollection];
+        el.layer.shadowColor = resolvedAccent.CGColor;
+        el.layer.shadowOffset = CGSizeZero;
+        el.layer.shadowRadius = 6.5;
+
+        CAKeyframeAnimation *glowAnim = [CAKeyframeAnimation animationWithKeyPath:@"shadowOpacity"];
+        glowAnim.values = @[@0.0, @0.62, @0.0];
+        glowAnim.keyTimes = @[@0.0, @0.32, @1.0];
+        glowAnim.duration = 0.62;
+        glowAnim.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
+        glowAnim.removedOnCompletion = YES;
+        [el.layer addAnimation:glowAnim forKey:@"dig3stGlow"];
+    }
+
+    // Horizontal Alpha Sweep Mask for aiSweep / shimmer / glowPulse (only when laid out)
+    CGRect bounds = el.bounds;
+    if (([anim isEqualToString:@"aiSweep"] || [anim isEqualToString:@"shimmer"] || [anim isEqualToString:@"glowPulse"]) &&
+        bounds.size.width >= 16.0 && bounds.size.height >= 4.0) {
+        CAGradientLayer *grad = [CAGradientLayer layer];
+        grad.frame = CGRectMake(-16.0, -16.0, bounds.size.width + 32.0, MAX(bounds.size.height + 64.0, 220.0));
+        grad.startPoint = CGPointMake(0.0, 0.45);
+        grad.endPoint = CGPointMake(1.0, 0.55);
+
+        if ([anim isEqualToString:@"shimmer"]) {
+            UIColor *dim = [[UIColor whiteColor] colorWithAlphaComponent:0.35];
+            UIColor *full = [UIColor whiteColor];
+            grad.colors = @[(id)full.CGColor, (id)dim.CGColor, (id)full.CGColor];
+            grad.locations = @[@(-0.4), @(-0.2), @(0.0)];
+
+            [CATransaction begin];
+            [CATransaction setCompletionBlock:cleanupMask];
+            CABasicAnimation *sweep = [CABasicAnimation animationWithKeyPath:@"locations"];
+            sweep.fromValue = @[@(-0.4), @(-0.2), @(0.0)];
+            sweep.toValue = @[@(1.0), @(1.2), @(1.4)];
+            sweep.duration = 0.48;
+            sweep.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
+            sweep.fillMode = kCAFillModeForwards;
+            sweep.removedOnCompletion = NO;
+            [grad addAnimation:sweep forKey:@"dig3stSweep"];
+            [CATransaction commit];
+        } else {
+            UIColor *full = [UIColor whiteColor];
+            UIColor *soft = [[UIColor whiteColor] colorWithAlphaComponent:0.14];
+            grad.colors = @[(id)full.CGColor, (id)full.CGColor, (id)soft.CGColor];
+            grad.locations = @[@(-0.45), @(-0.20), @(0.0)];
+
+            [CATransaction begin];
+            [CATransaction setCompletionBlock:cleanupMask];
+            CABasicAnimation *sweep = [CABasicAnimation animationWithKeyPath:@"locations"];
+            sweep.fromValue = @[@(-0.45), @(-0.20), @(0.0)];
+            sweep.toValue = @[@(1.0), @(1.25), @(1.45)];
+            sweep.duration = 0.44;
+            sweep.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
+            sweep.fillMode = kCAFillModeForwards;
+            sweep.removedOnCompletion = NO;
+            [grad addAnimation:sweep forKey:@"dig3stSweep"];
+            [CATransaction commit];
+        }
+        el.layer.mask = grad;
+    } else if ([anim isEqualToString:@"glowPulse"]) {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.68 * NSEC_PER_SEC)), dispatch_get_main_queue(), cleanupMask);
+    }
+}
