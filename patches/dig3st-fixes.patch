+-(void)applyPromptPreset:(NSString *)prompt systemPrompt:(NSString *)systemPrompt {
+	DigestPrefsManager *manager = [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+	[manager setObject:prompt forKey:@"prompt"];
+	[manager setObject:systemPrompt forKey:@"systemPrompt"];
+	[manager synchronize];
+	CFPreferencesSetAppValue(CFSTR("prompt"), (__bridge CFStringRef)prompt, CFSTR("com.uncore.dig3st"));
+	CFPreferencesSetAppValue(CFSTR("systemPrompt"), (__bridge CFStringRef)systemPrompt, CFSTR("com.uncore.dig3st"));
+	CFPreferencesAppSynchronize(CFSTR("com.uncore.dig3st"));
+	CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (CFStringRef)@"com.uncore.dig3st/preferences.changed", NULL, NULL, true);
+	[self reloadSpecifiers];
+}
