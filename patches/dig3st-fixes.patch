+- (void)refreshOverrideSubtitles {
+	DigestPrefsManager *manager = self.manager ?: [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+	NSDictionary *prefs = [manager copyAllPreferences];
+	for (PSSpecifier *sp in self.allAppSpecifiers) {
+		NSString *bid = sp.properties[@"digestKey"];
+		if (bid.length == 0) continue;
+		NSString *summary = [self overrideSummaryForBundleId:bid prefs:prefs];
+		if (summary) {
+			[sp setProperty:summary forKey:@"cellSubtitleText"];
+		} else {
+			[sp removePropertyForKey:@"cellSubtitleText"];
+		}
+	}
+}
