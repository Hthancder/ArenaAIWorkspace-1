+static NSString *const kDigestStyledAttrKey = @"dig3stStyled";
+
+static void *kDigestAnimStateKey = &kDigestAnimStateKey;
+static void *kDigestStaticImgKey = &kDigestStaticImgKey;
+static void *kDigestLastStaticKey = &kDigestLastStaticKey;
+static void *kDigestStreamMaskKey = &kDigestStreamMaskKey;
+static void *kDigestAnimGenKey = &kDigestAnimGenKey;
+static void *kDigestExpKey = &kDigestExpKey;
+static void *kDigestExpImg = &kDigestExpImg;
