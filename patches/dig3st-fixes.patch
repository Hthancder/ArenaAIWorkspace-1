+static NSUInteger nextElementAnimGeneration(UIView *el) {
+    NSNumber *cur = objc_getAssociatedObject(el, kDigestAnimGenKey);
+    NSUInteger next = cur ? ([cur unsignedIntegerValue] + 1) : 1;
+    objc_setAssociatedObject(el, kDigestAnimGenKey, @(next), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    return next;
+}
+
+static NSUInteger currentElementAnimGeneration(UIView *el) {
+    NSNumber *cur = objc_getAssociatedObject(el, kDigestAnimGenKey);
+    return cur ? [cur unsignedIntegerValue] : 0;
+}
+
+static void clearGPUEffectsOnElement(UIView *el) {
+    if (!el) return;
+    [el.layer removeAnimationForKey:@"dig3stReveal"];
+    [el.layer removeAnimationForKey:@"dig3stGlow"];
+    [el.layer removeAnimationForKey:@"dig3stTransition"];
+    CAGradientLayer *streamMask = objc_getAssociatedObject(el, kDigestStreamMaskKey);
+    if (streamMask) {
+        [streamMask removeAllAnimations];
+        objc_setAssociatedObject(el, kDigestStreamMaskKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+    if (el.layer.mask) {
+        [el.layer.mask removeAllAnimations];
+        el.layer.mask = nil;
+    }
+    el.layer.opacity = 1.0f;
+    el.layer.transform = CATransform3DIdentity;
+    el.layer.shadowOpacity = 0.0f;
+    el.layer.shadowRadius = 0.0f;
+}
+
+static void ensureStreamShimmerMaskOnElement(UIView *el) {
+    if (!el || el.window == nil) return;
+    CGRect bounds = el.bounds;
+    if (bounds.size.width < 12.0 || bounds.size.height < 4.0) return;
+
+    CGRect maskFrame = CGRectMake(-16.0, -12.0, bounds.size.width + 32.0, MAX(bounds.size.height + 40.0, 120.0));
+    CAGradientLayer *existing = objc_getAssociatedObject(el, kDigestStreamMaskKey);
+    if (existing && el.layer.mask == existing) {
+        if (!CGRectEqualToRect(existing.frame, maskFrame)) {
+            [CATransaction begin];
+            [CATransaction setDisableActions:YES];
+            existing.frame = maskFrame;
+            [CATransaction commit];
+        }
+        return;
+    }
+
+    CAGradientLayer *grad = [CAGradientLayer layer];
+    grad.frame = maskFrame;
+    grad.startPoint = CGPointMake(0.0, 0.45);
+    grad.endPoint = CGPointMake(1.0, 0.55);
+    UIColor *dim = [[UIColor whiteColor] colorWithAlphaComponent:0.42];
+    UIColor *bright = [UIColor whiteColor];
+    grad.colors = @[(id)dim.CGColor, (id)bright.CGColor, (id)dim.CGColor];
+    grad.locations = @[@(-0.6), @(-0.3), @(0.0)];
+
+    CABasicAnimation *sweep = [CABasicAnimation animationWithKeyPath:@"locations"];
+    sweep.fromValue = @[@(-0.65), @(-0.32), @(0.0)];
+    sweep.toValue = @[@(1.0), @(1.32), @(1.65)];
+    sweep.duration = 1.15;
+    sweep.repeatCount = HUGE_VALF;
+    sweep.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
+    sweep.removedOnCompletion = NO;
+    [grad addAnimation:sweep forKey:@"dig3stStreamShimmer"];
+
+    objc_setAssociatedObject(el, kDigestStreamMaskKey, grad, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    el.layer.mask = grad;
+}
+
+static void applyAttributedTextToElement(UIView *el, NSAttributedString *attr, NSUInteger maxLines) {
+    if (!el || !attr) return;
+    if ([el respondsToSelector:@selector(nc_setNumberOfLines:)]) {
+        [(id)el nc_setNumberOfLines:(unsigned long long)maxLines];
+    }
+    if ([el isKindOfClass:[UILabel class]]) {
+        UILabel *lbl = (UILabel *)el;
+        lbl.numberOfLines = (NSInteger)maxLines;
+        lbl.lineBreakMode = NSLineBreakByTruncatingTail;
+        lbl.attributedText = attr;
+    } else if ([el isKindOfClass:[UITextView class]]) {
+        UITextView *tv = (UITextView *)el;
+        tv.textContainer.maximumNumberOfLines = maxLines;
+        tv.textContainer.lineBreakMode = NSLineBreakByTruncatingTail;
+        tv.attributedText = attr;
+    } else if ([el respondsToSelector:@selector(setAttributedText:)]) {
+        [(id)el setAttributedText:attr];
+    }
+}
+
+static BOOL elementHasDigestStyledAttribute(UIView *el) {
+    if (!el) return NO;
+    NSAttributedString *cur = nil;
+    if ([el isKindOfClass:[UILabel class]]) {
+        cur = ((UILabel *)el).attributedText;
+    } else if ([el isKindOfClass:[UITextView class]]) {
+        cur = ((UITextView *)el).attributedText;
+    } else if ([el respondsToSelector:@selector(attributedText)]) {
+        cur = [(id)el attributedText];
+    }
+    if (![cur isKindOfClass:[NSAttributedString class]] || cur.length == 0) return NO;
+    id marker = [cur attribute:kDigestStyledAttrKey atIndex:0 effectiveRange:NULL];
+    return [marker boolValue];
+}
+
+static UIFont *baseFontForElement(UIView *el) {
+    if ([el respondsToSelector:@selector(font)]) {
+        UIFont *f = [(id)el font];
+        if ([f isKindOfClass:[UIFont class]]) return f;
+    }
+    return [UIFont systemFontOfSize:14.0];
+}
+
+static NSString *buildStaticRenderKey(NSString *summary,
+                                      NSString *originalText,
+                                      BOOL isStreaming,
+                                      DigestBannerRenderConfig *config) {
+    return [NSString stringWithFormat:@"s|%@|%@|%d|%@|%d|%@|%d|%d|%@",
+            summary ?: @"",
+            originalText ?: @"",
+            isStreaming ? 1 : 0,
+            config.badgeStyle ?: @"",
+            config.showPrefix ? 1 : 0,
+            config.prefixText ?: @"",
+            config.boldSummary ? 1 : 0,
+            config.showOriginalLine ? 1 : 0,
+            config.accentColorKey ?: @""];
+}
