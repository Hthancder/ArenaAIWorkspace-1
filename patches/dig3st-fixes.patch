++ (void)updateLabel:(UIView *)textElement
+        withSummary:(NSString *)summary
+       originalText:(NSString *)originalText
+        isStreaming:(BOOL)isStreaming
+             config:(DigestBannerRenderConfig *)config
+         layoutHost:(UIView *)layoutHost
+      onLayoutDelta:(void (^)(void))layoutDeltaBlock {
+    [self updateLabel:textElement
+          withSummary:summary
+         originalText:originalText
+          isStreaming:isStreaming
+      alreadyAnimated:NO
+               config:config
+           layoutHost:layoutHost
+        onLayoutDelta:layoutDeltaBlock
+  onAnimationComplete:nil];
+}
+
++ (void)updateLabel:(UIView *)textElement
+        withSummary:(NSString *)summary
+       originalText:(NSString *)originalText
+        isStreaming:(BOOL)isStreaming
+    alreadyAnimated:(BOOL)alreadyAnimated
+             config:(DigestBannerRenderConfig *)config
+         layoutHost:(UIView *)layoutHost
+      onLayoutDelta:(void (^)(void))layoutDeltaBlock
+onAnimationComplete:(void (^)(NSString *completedSummary))completeBlock {
+    if (!textElement || !summary) return;
+
+    NSString *anim = config.animationStyle ?: @"aiSweep";
+
+    // Never replay animation if this notification already finished animating (e.g. scroll/swipe back)
+    if (alreadyAnimated && !isStreaming) {
+        [self applyStaticToLabel:textElement
+                     withSummary:summary
+                    originalText:originalText
+                     isStreaming:NO
+                          config:config
+                      layoutHost:layoutHost];
+        return;
+    }
+
+    NSString *renderKey = [NSString stringWithFormat:@"%@|%@|%@|%@|%d|%@|%d|%d|%@|%@",
+                           summary, originalText ?: @"", isStreaming ? @"1" : @"0",
+                           config.badgeStyle ?: @"", config.showPrefix, config.prefixText ?: @"",
+                           config.boldSummary, config.showOriginalLine,
+                           config.accentColorKey ?: @"", anim];
+
+    DigestLabelAnimState *state = objc_getAssociatedObject(textElement, kDigestAnimStateKey);
+    BOOL wantsCPUDisplayLink = ([anim isEqualToString:@"fadeWords"] || [anim isEqualToString:@"typewriter"]);
+    if (wantsCPUDisplayLink) {
+        BOOL lpm = [[NSProcessInfo processInfo] isLowPowerModeEnabled];
+        BOOL alreadyOwned = (state != nil && state.displayLink != nil);
+        if (lpm || (!alreadyOwned && digestActiveDisplayLinks().count >= 2)) {
+            anim = @"springFade";
+            wantsCPUDisplayLink = NO;
+        }
+    }
+
+    if (state && [state.lastRenderKey isEqualToString:renderKey] && elementHasDigestStyledAttribute(textElement)) {
+        if (isStreaming) {
+            ensureStreamShimmerMaskOnElement(textElement);
+        } else if (!wantsCPUDisplayLink && !state.completionNotified && textElement.window != nil) {
+            BOOL needsBounds = ([anim isEqualToString:@"aiSweep"] || [anim isEqualToString:@"shimmer"]);
+            if (!needsBounds || textElement.bounds.size.width >= 16.0) {
+                state.completionNotified = YES;
+                if (![anim isEqualToString:@"none"]) {
+                    [self runNativeRevealOnElement:textElement style:anim config:config];
+                }
+                if (completeBlock) {
+                    completeBlock(summary);
+                }
+            }
+        }
+        return;
+    }
+
+    if (!wantsCPUDisplayLink) {
+        if (state && state.displayLink) {
+            [state invalidate];
+        }
+        BOOL isNewTarget = (!state || ![state.targetSummary isEqualToString:summary]);
+        if (!state) {
+            state = [DigestLabelAnimState new];
+            objc_setAssociatedObject(textElement, kDigestAnimStateKey, state, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+        if (isNewTarget) {
+            state.completionNotified = NO;
+        }
+        BOOL wasStreaming = state.isStreaming;
+        NSString *prevSummary = state.targetSummary;
+        state.textElement = textElement;
+        state.layoutHost = layoutHost;
+        state.lastRenderKey = renderKey;
+        state.targetSummary = summary;
+        state.originalText = originalText;
+        state.isStreaming = isStreaming;
+        state.config = config;
+        state.layoutDeltaBlock = layoutDeltaBlock;
+        state.completionCallback = completeBlock;
+
+        NSString *staticKey = buildStaticRenderKey(summary, originalText, isStreaming, config);
+        UIImage *badgeImg = nil;
+        NSAttributedString *out = [self buildStaticAttributedForElement:textElement
+                                                            withSummary:summary
+                                                           originalText:originalText
+                                                            isStreaming:isStreaming
+                                                                 config:config
+                                                          retainedImage:&badgeImg];
+        objc_setAssociatedObject(textElement, kDigestStaticImgKey, badgeImg, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        objc_setAssociatedObject(textElement, kDigestLastStaticKey, staticKey, OBJC_ASSOCIATION_COPY_NONATOMIC);
+
+        if (isStreaming) {
+            if (prevSummary.length > 0 && ![prevSummary isEqualToString:summary] && textElement.window != nil) {
+                CATransition *tr = [CATransition animation];
+                tr.type = kCATransitionFade;
+                tr.duration = 0.14;
+                tr.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
+                [textElement.layer addAnimation:tr forKey:@"dig3stTransition"];
+            }
+            applyAttributedTextToElement(textElement, out, 4);
+            ensureStreamShimmerMaskOnElement(textElement);
+        } else {
+            clearGPUEffectsOnElement(textElement);
+            applyAttributedTextToElement(textElement, out, 4);
+            if (!state.completionNotified && textElement.window != nil) {
+                BOOL needsBounds = ([anim isEqualToString:@"aiSweep"] || [anim isEqualToString:@"shimmer"]);
+                if (!needsBounds || textElement.bounds.size.width >= 16.0) {
+                    state.completionNotified = YES;
+                    if (![anim isEqualToString:@"none"]) {
+                        [self runNativeRevealOnElement:textElement style:anim config:config];
+                    }
+                    if (completeBlock) {
+                        completeBlock(summary);
+                    }
+                }
+            }
+        }
+
+        [textElement invalidateIntrinsicContentSize];
+        [layoutHost setNeedsLayout];
+        if (layoutDeltaBlock && (wasStreaming != isStreaming || ![prevSummary isEqualToString:summary])) {
+            layoutDeltaBlock();
+        }
+        return;
+    }
+
+    // CPU-driven word/typewriter streaming animation (capped at 2 concurrent)
+    if (!state) {
+        state = [DigestLabelAnimState new];
+        state.streamStartTime = CACurrentMediaTime();
+        objc_setAssociatedObject(textElement, kDigestAnimStateKey, state, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+
+    BOOL isNewSession = (state.targetSummary.length == 0 ||
+                         (![summary hasPrefix:state.targetSummary] && ![state.targetSummary hasPrefix:summary]));
+    if (isNewSession) {
+        clearGPUEffectsOnElement(textElement);
+        state.tokens = [NSMutableArray new];
+        state.tokenBirthTimes = [NSMutableArray new];
+        state.revealedChars = 0;
+        state.streamStartTime = CACurrentMediaTime();
+        state.lastTypeStepTime = state.streamStartTime;
+        state.missingWindowTicks = 0;
+        state.completionNotified = NO;
+    }
+
+    state.textElement = textElement;
+    state.layoutHost = layoutHost;
+    state.lastRenderKey = renderKey;
+    state.targetSummary = summary;
+    state.originalText = originalText;
+    state.isStreaming = isStreaming;
+    state.config = config;
+    state.layoutDeltaBlock = layoutDeltaBlock;
+    state.completionCallback = completeBlock;
+
+    [state syncTokensForTarget:summary];
+    [state ensureDisplayLink];
+    [state handleDisplayLink:nil];
+}
+
++ (void)renderExpandedToLabel:(UIView *)textElement
+                  withSummary:(NSString *)summary
+                 originalText:(NSString *)originalText
+                       config:(DigestBannerRenderConfig *)config
+                   layoutHost:(UIView *)layoutHost {
+    if (!textElement || !summary) return;
+    [self stopForLabel:textElement];
+
+    NSString *renderKey = [NSString stringWithFormat:@"exp|%@|%@|%@|%d|%@|%@",
+                           summary, originalText ?: @"", config.badgeStyle ?: @"",
+                           config.showPrefix, config.prefixText ?: @"", config.accentColorKey ?: @""];
+    NSString *prevKey = objc_getAssociatedObject(textElement, kDigestExpKey);
+    if ([prevKey isEqualToString:renderKey] && elementHasDigestStyledAttribute(textElement)) return;
+    objc_setAssociatedObject(textElement, kDigestExpKey, renderKey, OBJC_ASSOCIATION_COPY_NONATOMIC);
+
+    UIFont *baseFont = baseFontForElement(textElement);
+    UIImage *badgeImg = nil;
+    NSMutableAttributedString *out = [[self prefixAttributedStringWithConfig:config baseFont:baseFont retainedImage:&badgeImg] mutableCopy];
+    objc_setAssociatedObject(textElement, kDigestExpImg, badgeImg, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+
+    UIFont *summaryFont = [UIFont systemFontOfSize:baseFont.pointSize weight:UIFontWeightSemibold];
+    UIColor *baseTextColor = [[UIColor labelColor] resolvedColorWithTraitCollection:textElement.traitCollection];
+    [out appendAttributedString:[[NSAttributedString alloc] initWithString:summary attributes:@{
+        NSFontAttributeName: summaryFont,
+        NSForegroundColorAttributeName: baseTextColor
+    }]];
+
+    if (originalText.length > 0 && ![originalText isEqualToString:summary]) {
+        UIFont *dividerFont = [UIFont systemFontOfSize:MAX(11.0, baseFont.pointSize - 3.0) weight:UIFontWeightMedium];
+        [out appendAttributedString:[[NSAttributedString alloc] initWithString:@"\n\n── Nội dung gốc ──\n" attributes:@{
+            NSFontAttributeName: dividerFont,
+            NSForegroundColorAttributeName: [UIColor tertiaryLabelColor]
+        }]];
+        [out appendAttributedString:[[NSAttributedString alloc] initWithString:originalText attributes:@{
+            NSFontAttributeName: baseFont,
+            NSForegroundColorAttributeName: [UIColor secondaryLabelColor]
+        }]];
+    }
+
+    if (out.length > 0) {
+        [out addAttribute:kDigestStyledAttrKey value:@YES range:NSMakeRange(0, 1)];
+    }
+    applyAttributedTextToElement(textElement, out, 0);
+    [textElement invalidateIntrinsicContentSize];
+    [layoutHost setNeedsLayout];
+}
+
+@end
