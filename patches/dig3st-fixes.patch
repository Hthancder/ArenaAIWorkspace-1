+static void refreshRuntimePrefs(void) {
+    if (!prefsManager) return;
+    CFPreferencesAppSynchronize(CFSTR("com.uncore.dig3st"));
+    [prefsManager synchronize];
+
+    tweakEnabled = [[prefsManager safeObjectForKey:@"enabled"] boolValue];
+    id ctxObj = [prefsManager safeObjectForKey:@"includeContext"];
+    includeContext = ctxObj ? [ctxObj boolValue] : YES;
+
+    id bufEnabled = [prefsManager safeObjectForKey:@"contextBufferEnabled"];
+    contextBufferEnabled = bufEnabled ? [bufEnabled boolValue] : YES;
+    id perThread = [prefsManager safeObjectForKey:@"contextPerThread"];
+    contextPerThread = perThread ? [perThread boolValue] : YES;
+
+    NSInteger maxMsgs = [[prefsManager safeObjectForKey:@"contextMaxMessages"] integerValue];
+    contextMaxMessages = (maxMsgs >= 1 && maxMsgs <= 20) ? maxMsgs : 4;
+
+    NSInteger winMins = [[prefsManager safeObjectForKey:@"contextWindowMinutes"] integerValue];
+    contextWindowSeconds = (winMins >= 1 && winMins <= 1440) ? (winMins * 60.0) : 600.0;
+
+    NSInteger maxChars = [[prefsManager safeObjectForKey:@"contextMaxChars"] integerValue];
+    contextMaxChars = (maxChars >= 100 && maxChars <= 4000) ? maxChars : 800;
+
+    id incTime = [prefsManager safeObjectForKey:@"contextIncludeTime"];
+    contextIncludeTime = incTime ? [incTime boolValue] : YES;
+    id recShort = [prefsManager safeObjectForKey:@"contextRecordShort"];
+    contextRecordShort = recShort ? [recShort boolValue] : YES;
+
+    NSString *badge = [prefsManager safeObjectForKey:@"bannerBadgeStyle"];
+    bannerBadgeStyle = ([badge isKindOfClass:[NSString class]] && badge.length > 0) ? [badge copy] : @"arrow";
+    bannerShowPrefix = [[prefsManager safeObjectForKey:@"bannerShowPrefix"] boolValue];
+    NSString *prefix = [prefsManager safeObjectForKey:@"bannerPrefixText"];
+    bannerPrefixText = ([prefix isKindOfClass:[NSString class]] && prefix.length > 0) ? [prefix copy] : @"[AI]";
+    NSString *accent = [prefsManager safeObjectForKey:@"bannerAccentColor"];
+    bannerAccentColor = ([accent isKindOfClass:[NSString class]] && accent.length > 0) ? [accent copy] : @"default";
+    bannerBoldSummary = [[prefsManager safeObjectForKey:@"bannerBoldSummary"] boolValue];
+    bannerShowOriginal = [[prefsManager safeObjectForKey:@"bannerShowOriginal"] boolValue];
+
+    id expOrig = [prefsManager safeObjectForKey:@"showOriginalInExpanded"];
+    showOriginalInExpanded = expOrig ? [expOrig boolValue] : YES;
+
+    id strEn = [prefsManager safeObjectForKey:@"streamingEnabled"];
+    streamingEnabled = strEn ? [strEn boolValue] : YES;
+
+    NSString *anim = [prefsManager safeObjectForKey:@"streamAnimationStyle"];
+    streamAnimationStyle = ([anim isKindOfClass:[NSString class]] && anim.length > 0) ? [anim copy] : @"fadeWords";
+
+    pauseInLowPowerMode = [[prefsManager safeObjectForKey:@"pauseInLowPowerMode"] boolValue];
+    lowPowerActive = [[NSProcessInfo processInfo] isLowPowerModeEnabled];
+}
 
