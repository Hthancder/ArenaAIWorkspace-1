+static NSHashTable<DigestLabelAnimState *> *digestActiveDisplayLinks(void) {
+    static NSHashTable<DigestLabelAnimState *> *table = nil;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        table = [NSHashTable weakObjectsHashTable];
+    });
+    return table;
+}
+
+static NSCharacterSet *digestWhitespaceSet(void) {
+    static NSCharacterSet *ws = nil;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        ws = [NSCharacterSet whitespaceAndNewlineCharacterSet];
+    });
+    return ws;
+}
+
+static NSCache<NSString *, UIImage *> *digestSymbolCache(void) {
+    static NSCache<NSString *, UIImage *> *cache = nil;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        cache = [NSCache new];
+        cache.countLimit = 24;
+    });
+    return cache;
+}
