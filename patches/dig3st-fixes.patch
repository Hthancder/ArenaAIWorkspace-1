+#import "../headers/HeadersPreferences.h"
+#import <Preferences/PSListItemsController.h>
+
+@interface DigestAppearanceController : PSListController
+@property (nonatomic, assign) BOOL hasAppearedOnce;
+@property (nonatomic, strong) UILabel *previewBodyLabel;
+@property (nonatomic, strong) UILabel *previewModeBadge;
+@property (nonatomic, strong) UIView *previewCardView;
+@property (nonatomic, strong) UIButton *demoButton;
+@property (nonatomic, strong) UIButton *expandPreviewButton;
+@property (nonatomic, strong) UIImage *arrowImage;
+@property (nonatomic, assign) NSUInteger demoGeneration;
+@property (nonatomic, assign) BOOL expandedPreviewMode;
+@property (nonatomic, copy) NSString *lastSeenAnimStyle;
+@property (nonatomic, assign) BOOL lastSeenStreamingEnabled;
+@property (nonatomic, copy) NSString *lastSeenBadgeStyle;
+@property (nonatomic, copy) NSString *lastSeenAccentColor;
+@end
+
+@implementation DigestAppearanceController
+
+- (NSArray *)specifiers {
+	if (!_specifiers) {
+		_specifiers = [self loadSpecifiersFromPlistName:@"Appearance" target:self];
+	}
+	return _specifiers;
+}
+
+- (DigestPrefsManager *)prefs {
+	return [NSClassFromString(@"DigestPrefsManager") sharedInstance];
+}
+
+- (void)viewDidLoad {
+	[super viewDidLoad];
+	NSString *arrowPath = [[NSBundle bundleForClass:self.class] pathForResource:@"arrow" ofType:@"png"];
+	if (arrowPath) {
+		self.arrowImage = [UIImage imageWithContentsOfFile:arrowPath];
+	}
+	[[NSNotificationCenter defaultCenter] addObserver:self selector:@selector(textFieldChanged:) name:UITextFieldTextDidChangeNotification object:nil];
+	[[NSNotificationCenter defaultCenter] addObserver:self selector:@selector(textFieldEnded:) name:UITextFieldTextDidEndEditingNotification object:nil];
+}
+
+- (void)dealloc {
+	[[NSNotificationCenter defaultCenter] removeObserver:self name:UITextFieldTextDidChangeNotification object:nil];
+	[[NSNotificationCenter defaultCenter] removeObserver:self name:UITextFieldTextDidEndEditingNotification object:nil];
+	[DigestBannerAnimator stopForLabel:self.previewBodyLabel];
+}
+
+- (NSString *)animationDisplayName:(NSString *)animKey {
+	if ([animKey isEqualToString:@"aiSweep"]) return @"Apple AI Sweep";
+	if ([animKey isEqualToString:@"springFade"]) return @"Spring Pop";
+	if ([animKey isEqualToString:@"glowPulse"]) return @"Glow Pulse";
+	if ([animKey isEqualToString:@"shimmer"]) return @"Shimmer Wave";
+	if ([animKey isEqualToString:@"fadeWords"]) return @"Word Fade-In";
+	if ([animKey isEqualToString:@"typewriter"]) return @"Typewriter";
+	if ([animKey isEqualToString:@"crossfade"]) return @"Soft Crossfade";
+	if ([animKey isEqualToString:@"none"]) return @"Instant";
+	return @"Apple AI Sweep";
+}
+
+- (void)viewWillAppear:(BOOL)animated {
+	[super viewWillAppear:animated];
+	DigestPrefsManager *manager = [self prefs];
+
+	NSString *curAnim = [manager safeObjectForKey:@"streamAnimationStyle"] ?: @"aiSweep";
+	id strObj = [manager safeObjectForKey:@"streamingEnabled"];
+	BOOL curStreaming = strObj ? [strObj boolValue] : YES;
+	NSString *curBadge = [manager safeObjectForKey:@"bannerBadgeStyle"] ?: @"arrow";
+	NSString *curAccent = [manager safeObjectForKey:@"bannerAccentColor"] ?: @"default";
+
+	if (self.hasAppearedOnce) {
+		[self reloadSpecifiers];
+	}
+
+	BOOL animChanged = self.hasAppearedOnce && (![curAnim isEqualToString:self.lastSeenAnimStyle] || curStreaming != self.lastSeenStreamingEnabled);
+	self.lastSeenAnimStyle = curAnim;
+	self.lastSeenStreamingEnabled = curStreaming;
+	self.lastSeenBadgeStyle = curBadge;
+	self.lastSeenAccentColor = curAccent;
+	self.hasAppearedOnce = YES;
+
+	[self updatePreviewModeBadge];
+
+	if (animChanged && curStreaming) {
+		self.expandedPreviewMode = NO;
+		[self updateExpandButtonAppearance];
+		dispatch_async(dispatch_get_main_queue(), ^{
+			[self playStreamDemo];
+		});
+	} else {
+		[self refreshPreviewBannerStreaming:NO text:nil animateReveal:animChanged];
+	}
+}
+
+- (void)viewWillDisappear:(BOOL)animated {
+	[super viewWillDisappear:animated];
+	self.demoGeneration++;
+	[DigestBannerAnimator stopForLabel:self.previewBodyLabel];
+	[self.view endEditing:YES];
+}
+
+- (void)traitCollectionDidChange:(UITraitCollection *)previousTraitCollection {
+	[super traitCollectionDidChange:previousTraitCollection];
+	if (self.previewCardView) {
+		self.previewCardView.layer.borderColor = [UIColor separatorColor].CGColor;
+	}
+}
+
+- (void)viewDidLayoutSubviews {
+	[super viewDidLayoutSubviews];
+	if (!self.table.tableHeaderView || ABS(self.table.tableHeaderView.frame.size.width - self.view.frame.size.width) > 1.0) {
+		[self setupPreviewHeader];
+	}
+}
+
+- (void)commitPrefixTextField:(UITextField *)tf reloadSwitchIfAutoEnabled:(BOOL)reloadSwitch notifyRemote:(BOOL)notifyRemote {
+	if (![tf isKindOfClass:[UITextField class]] || ![tf isDescendantOfView:self.table]) return;
+	NSString *txt = tf.text ?: @"";
+	DigestPrefsManager *manager = [self prefs];
+
+	BOOL showPrefix = [[manager safeObjectForKey:@"bannerShowPrefix"] boolValue];
+	if (txt.length > 0 && !showPrefix) {
+		[manager setSafeObject:txt forKey:@"bannerPrefixText" notify:NO];
+		[manager setSafeObject:@YES forKey:@"bannerShowPrefix" notify:notifyRemote];
+		if (reloadSwitch) {
+			PSSpecifier *sp = [self specifierForID:@"bannerShowPrefix"] ?: [self specifierForKey:@"bannerShowPrefix"];
+			if (sp) [self reloadSpecifier:sp animated:YES];
+		}
+	} else {
+		[manager setSafeObject:txt forKey:@"bannerPrefixText" notify:notifyRemote];
+	}
+
+	[self refreshPreviewBannerStreaming:NO text:nil];
+}
+
+- (PSSpecifier *)specifierForKey:(NSString *)key {
+	for (PSSpecifier *sp in self.specifiers) {
+		if ([sp.properties[@"key"] isEqualToString:key]) return sp;
+	}
+	return nil;
+}
+
+- (void)textFieldChanged:(NSNotification *)note {
+	[self commitPrefixTextField:note.object reloadSwitchIfAutoEnabled:YES notifyRemote:NO];
+}
+
+- (void)textFieldEnded:(NSNotification *)note {
+	[self commitPrefixTextField:note.object reloadSwitchIfAutoEnabled:YES notifyRemote:YES];
+}
+
+- (DigestBannerRenderConfig *)currentPreviewConfig {
+	DigestPrefsManager *manager = [self prefs];
+
+	DigestBannerRenderConfig *cfg = [DigestBannerRenderConfig new];
+	NSString *badge = [manager safeObjectForKey:@"bannerBadgeStyle"];
+	cfg.badgeStyle = ([badge isKindOfClass:[NSString class]] && badge.length > 0) ? badge : @"arrow";
+	cfg.showPrefix = [[manager safeObjectForKey:@"bannerShowPrefix"] boolValue];
+	NSString *prefix = [manager safeObjectForKey:@"bannerPrefixText"];
+	cfg.prefixText = ([prefix isKindOfClass:[NSString class]] && prefix.length > 0) ? prefix : @"[AI]";
+	NSString *accent = [manager safeObjectForKey:@"bannerAccentColor"];
+	cfg.accentColorKey = ([accent isKindOfClass:[NSString class]] && accent.length > 0) ? accent : @"default";
+	cfg.boldSummary = [[manager safeObjectForKey:@"bannerBoldSummary"] boolValue];
+	cfg.showOriginalLine = [[manager safeObjectForKey:@"bannerShowOriginal"] boolValue];
+	NSString *anim = [manager safeObjectForKey:@"streamAnimationStyle"];
+	cfg.animationStyle = ([anim isKindOfClass:[NSString class]] && anim.length > 0) ? anim : @"aiSweep";
+	cfg.arrowImage = self.arrowImage;
+	return cfg;
+}
+
+- (void)updatePreviewModeBadge {
+	if (!self.previewModeBadge) return;
+	DigestPrefsManager *manager = [self prefs];
+	id strObj = [manager safeObjectForKey:@"streamingEnabled"];
+	BOOL strOn = strObj ? [strObj boolValue] : YES;
+	NSString *animKey = [manager safeObjectForKey:@"streamAnimationStyle"] ?: @"aiSweep";
+	if (self.expandedPreviewMode) {
+		self.previewModeBadge.text = @"LONG-PRESS PREVIEW · FULL ORIGINAL";
+	} else {
+		self.previewModeBadge.text = [NSString stringWithFormat:@"LIVE PREVIEW · %@", strOn ? [self animationDisplayName:animKey].uppercaseString : @"STREAM OFF"];
+	}
+}
+
+- (void)updateExpandButtonAppearance {
+	if (!self.expandPreviewButton) return;
+	UIButtonConfiguration *bcfg = [UIButtonConfiguration tintedButtonConfiguration];
+	bcfg.title = self.expandedPreviewMode ? @"Banner" : @"Expanded";
+	bcfg.cornerStyle = UIButtonConfigurationCornerStyleCapsule;
+	bcfg.contentInsets = NSDirectionalEdgeInsetsMake(4, 9, 4, 9);
+	bcfg.baseForegroundColor = self.expandedPreviewMode ? [UIColor systemOrangeColor] : [UIColor secondaryLabelColor];
+	bcfg.baseBackgroundColor = self.expandedPreviewMode ? [UIColor systemOrangeColor] : [UIColor tertiarySystemFillColor];
+	bcfg.titleTextAttributesTransformer = ^NSDictionary<NSAttributedStringKey, id> *(NSDictionary<NSAttributedStringKey, id> *incoming) {
+		NSMutableDictionary *d = [incoming mutableCopy];
