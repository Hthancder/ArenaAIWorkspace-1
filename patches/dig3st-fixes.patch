+- (NSString *)overrideSummaryForBundleId:(NSString *)bundleId prefs:(NSDictionary *)prefs {
+	if (bundleId.length == 0 || !prefs) return nil;
+	NSMutableArray *parts = nil;
+
+	id ctx = prefs[[@"appCtx_" stringByAppendingString:bundleId]];
+	if ([ctx isKindOfClass:[NSString class]]) {
+		if ([ctx isEqualToString:@"on"]) { parts = parts ?: [NSMutableArray new]; [parts addObject:@"Context: ON"]; }
+		else if ([ctx isEqualToString:@"off"]) { parts = parts ?: [NSMutableArray new]; [parts addObject:@"Context: OFF"]; }
+	}
+
+	id tr = prefs[[@"appTrans_" stringByAppendingString:bundleId]];
+	if ([tr isKindOfClass:[NSString class]]) {
+		if ([tr isEqualToString:@"on"]) { parts = parts ?: [NSMutableArray new]; [parts addObject:@"VN: ON"]; }
+		else if ([tr isEqualToString:@"off"]) { parts = parts ?: [NSMutableArray new]; [parts addObject:@"VN: OFF"]; }
+	}
+
+	id st = prefs[[@"appStream_" stringByAppendingString:bundleId]];
+	if ([st isKindOfClass:[NSString class]]) {
+		if ([st isEqualToString:@"on"]) { parts = parts ?: [NSMutableArray new]; [parts addObject:@"Stream: ON"]; }
+		else if ([st isEqualToString:@"off"]) { parts = parts ?: [NSMutableArray new]; [parts addObject:@"Stream: OFF"]; }
+	}
+
+	id pr = prefs[[@"appPrompt_" stringByAppendingString:bundleId]];
+	if ([pr isKindOfClass:[NSString class]] && [(NSString *)pr length] > 0) {
+		parts = parts ?: [NSMutableArray new];
+		[parts addObject:@"Custom Prompt"];
+	}
+
+	return parts.count > 0 ? [parts componentsJoinedByString:@" · "] : nil;
+}
