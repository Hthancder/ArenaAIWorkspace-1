+                                                                       error:nil];
+        thinkOpenRegex = [NSRegularExpression regularExpressionWithPattern:@"<think>[\\s\\S]*$"
+                                                                   options:NSRegularExpressionCaseInsensitive
+                                                                     error:nil];
+    });
+
+    if ([cleaned rangeOfString:@"<think" options:NSCaseInsensitiveSearch].location != NSNotFound) {
+        if (thinkClosedRegex) {
+            cleaned = [thinkClosedRegex stringByReplacingMatchesInString:cleaned options:0 range:NSMakeRange(0, cleaned.length) withTemplate:@""];
+        }
+        if (thinkOpenRegex && [cleaned rangeOfString:@"<think" options:NSCaseInsensitiveSearch].location != NSNotFound) {
+            cleaned = [thinkOpenRegex stringByReplacingMatchesInString:cleaned options:0 range:NSMakeRange(0, cleaned.length) withTemplate:@""];
+        }
+    }
+
+    if ([cleaned rangeOfString:@"\n"].location != NSNotFound || [cleaned rangeOfString:@"\r"].location != NSNotFound) {
+        cleaned = [[cleaned stringByReplacingOccurrencesOfString:@"\r\n" withString:@" "] stringByReplacingOccurrencesOfString:@"\n" withString:@" "];
+    }
+
+    NSRange nonSpace = [cleaned rangeOfCharacterFromSet:nonWhitespace];
+    if (nonSpace.location == NSNotFound) return @"";
+    if (nonSpace.location > 0) {
+        cleaned = [cleaned substringFromIndex:nonSpace.location];
+    }
+
+    NSUInteger probeLen = MIN((NSUInteger)36, cleaned.length);
+    if (prefixRegex && [cleaned rangeOfCharacterFromSet:sepChars options:0 range:NSMakeRange(0, probeLen)].location != NSNotFound) {
+        NSRange match = [prefixRegex rangeOfFirstMatchInString:cleaned options:0 range:NSMakeRange(0, cleaned.length)];
+        if (match.location == 0 && match.length > 0 && match.length < cleaned.length) {
+            cleaned = [cleaned substringFromIndex:match.length];
+        }
+    }
+
+    if (trimEnd) {
+        return [cleaned stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+    }
+    return cleaned;
+}
