{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taskora",
  "version": "2.1.0",
  "identifier": "com.taskora.todo",
  "build": {
    "frontendDist": "../src-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Taskora",
        "width": 1320,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "category": "Productivity",
    "shortDescription": "Ứng dụng quản lý công việc",
    "longDescription": "Taskora — ứng dụng quản lý công việc trên Windows: danh sách, thẻ, ưu tiên P1–P4, lặp lại, thống kê, liquid glass.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
