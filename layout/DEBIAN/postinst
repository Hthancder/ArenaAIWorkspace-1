#!/bin/sh
# SiriBridge postinst — dọn cờ safe mode để lần respring sau tweak được phép chạy.
#
# Nếu máy rơi vào safe mode, tạo file dưới đây rồi respring để TẮT hẳn tweak:
#   touch /var/mobile/Library/Preferences/com.hthancder.siribridge.safemode
# Xoá file đó (hoặc cài lại gói) để bật lại.

PREFS=/var/mobile/Library/Preferences
STATE="$PREFS/com.hthancder.siribridge.state.plist"

if [ -f "$STATE" ]; then
  rm -f "$STATE"
fi
chown mobile:mobile "$PREFS" 2>/dev/null || true

echo "SiriBridge: đã cài. Bật/tắt trong Settings → SiriBridge."
echo "Nếu bị safe mode: touch $PREFS/com.hthancder.siribridge.safemode && killall -9 SpringBoard"
exit 0
