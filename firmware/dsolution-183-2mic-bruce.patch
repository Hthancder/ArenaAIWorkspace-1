+
+static FatGeom computeFatGeom(VmscStorageMode mode) {
+    FatGeom g = {};
+    g.reservedSectors = 1;
+    g.numFats = 2;
+    g.secPerClus = 1;
+    if (mode == VMSC_RAM_2M) {
+        // 4400 * 512 = 2,252,800 B -> >= 4085 clusters -> strict Microsoft FAT16
+        g.totalSectors = 4400;
+        g.fatSectors = 18;
+        g.rootEntries = 512;
+        g.isFat16 = true;
+    } else if (mode == VMSC_FLASH_1M) {
+        // 2048 * 512 = 1,048,576 B -> FAT12
+        g.totalSectors = 2048;
+        g.fatSectors = 6;
+        g.rootEntries = 224;
+        g.isFat16 = false;
+    } else if (mode == VMSC_FLASH_512K) {
+        // 1024 * 512 = 524,288 B -> FAT12
+        g.totalSectors = 1024;
+        g.fatSectors = 3;
+        g.rootEntries = 128;
+        g.isFat16 = false;
+    } else {
+        // 256 * 512 = 131,072 B (128 KB) -> FAT12, fits inside Dual-Boot 256KB brucefs
+        g.totalSectors = 256;
+        g.fatSectors = 2;
+        g.rootEntries = 64;
+        g.isFat16 = false;
+    }
+    g.fatStartSec = g.reservedSectors;
+    g.rootStartSec = g.fatStartSec + (uint32_t)g.numFats * g.fatSectors;
+    g.rootSectors = ((uint32_t)g.rootEntries * 32U + (kSecSize - 1)) / kSecSize;
+    g.dataStartSec = g.rootStartSec + g.rootSectors;
+    g.totalClusters = (g.totalSectors - g.dataStartSec) / g.secPerClus;
+    return g;
+}
+
+static inline void wr16(uint8_t *p, uint16_t v) {
+    p[0] = (uint8_t)(v & 0xFF);
+    p[1] = (uint8_t)((v >> 8) & 0xFF);
+}
+static inline void wr32(uint8_t *p, uint32_t v) {
+    p[0] = (uint8_t)(v & 0xFF);
+    p[1] = (uint8_t)((v >> 8) & 0xFF);
+    p[2] = (uint8_t)((v >> 16) & 0xFF);
+    p[3] = (uint8_t)((v >> 24) & 0xFF);
+}
+static inline uint16_t rd16(const uint8_t *p) { return (uint16_t)p[0] | ((uint16_t)p[1] << 8); }
+static inline uint32_t rd32(const uint8_t *p) {
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static void fatSetCluster(uint8_t *fatBase, uint32_t clus, uint16_t val, bool isFat16) {
+    if (isFat16) {
+        wr16(fatBase + clus * 2, val);
+    } else {
+        uint32_t off = clus + (clus / 2);
+        if (clus & 1) {
+            fatBase[off] = (uint8_t)((fatBase[off] & 0x0F) | ((val & 0x0F) << 4));
+            fatBase[off + 1] = (uint8_t)((val >> 4) & 0xFF);
+        } else {
+            fatBase[off] = (uint8_t)(val & 0xFF);
+            fatBase[off + 1] = (uint8_t)((fatBase[off + 1] & 0xF0) | ((val >> 8) & 0x0F));
+        }
+    }
+}
+
+static uint16_t fatGetCluster(const uint8_t *fatBase, uint32_t clus, bool isFat16) {
+    if (isFat16) return rd16(fatBase + clus * 2);
+    uint32_t off = clus + (clus / 2);
+    uint16_t pair = (uint16_t)fatBase[off] | ((uint16_t)fatBase[off + 1] << 8);
+    return (clus & 1) ? (uint16_t)(pair >> 4) : (uint16_t)(pair & 0x0FFF);
+}
+
+static bool fatIsEof(uint16_t val, bool isFat16) {
+    return isFat16 ? (val >= 0xFFF8) : (val >= 0x0FF8);
+}
+
+static uint16_t fatEofVal(bool isFat16) { return isFat16 ? 0xFFFF : 0x0FFF; }
+
+static void formatDiskMemory(uint8_t *mem, const FatGeom &g, const char *volLabel) {
+    memset(mem, 0, g.totalSectors * kSecSize);
+    uint8_t *bs = mem;
+    bs[0] = 0xEB;
+    bs[1] = 0x3C;
+    bs[2] = 0x90;
+    memcpy(bs + 3, "MSDOS5.0", 8);
+    wr16(bs + 11, kSecSize);
+    bs[13] = g.secPerClus;
+    wr16(bs + 14, g.reservedSectors);
+    bs[16] = g.numFats;
+    wr16(bs + 17, g.rootEntries);
+    wr16(bs + 19, (uint16_t)g.totalSectors);
+    bs[21] = 0xF8;
+    wr16(bs + 22, g.fatSectors);
+    wr16(bs + 24, 32); // sectors/track
+    wr16(bs + 26, 64); // heads
+    bs[36] = 0x80;
+    bs[38] = 0x29;
+    wr32(bs + 39, 0x42525543UL); // 'BRUC'
+    char lbl[12];
+    memset(lbl, ' ', 11);
+    for (int i = 0; i < 11 && volLabel[i]; i++) lbl[i] = (char)toupper((unsigned char)volLabel[i]);
+    memcpy(bs + 43, lbl, 11);
+    memcpy(bs + 54, g.isFat16 ? "FAT16   " : "FAT12   ", 8);
+    bs[510] = 0x55;
+    bs[511] = 0xAA;
+
+    // Initialize both FAT copies
+    for (uint8_t f = 0; f < g.numFats; f++) {
+        uint8_t *fat = mem + (g.fatStartSec + f * g.fatSectors) * kSecSize;
+        fatSetCluster(fat, 0, g.isFat16 ? 0xFFF8 : 0x0FF8, g.isFat16);
+        fatSetCluster(fat, 1, fatEofVal(g.isFat16), g.isFat16);
+    }
+
+    // Volume label entry in root dir
+    uint8_t *root = mem + g.rootStartSec * kSecSize;
+    memcpy(root, lbl, 11);
+    root[11] = 0x08; // ATTR_VOLUME_ID
+}
+
+static bool parseFatGeomFromMemory(const uint8_t *mem, uint32_t memBytes, FatGeom &g) {
+    if (!mem || memBytes < 512) return false;
+    if (mem[510] != 0x55 || mem[511] != 0xAA) return false;
+    uint16_t bps = rd16(mem + 11);
+    if (bps != kSecSize) return false;
+    g.secPerClus = mem[13];
+    g.reservedSectors = rd16(mem + 14);
+    g.numFats = mem[16];
+    g.rootEntries = rd16(mem + 17);
+    uint16_t tot16 = rd16(mem + 19);
+    uint32_t tot32 = rd32(mem + 32);
+    g.totalSectors = tot16 ? tot16 : tot32;
+    g.fatSectors = rd16(mem + 22);
+    if (g.secPerClus == 0 || g.numFats == 0 || g.fatSectors == 0 ||
+        g.totalSectors * kSecSize > memBytes) {
+        return false;
+    }
+    g.fatStartSec = g.reservedSectors;
+    g.rootStartSec = g.fatStartSec + (uint32_t)g.numFats * g.fatSectors;
+    g.rootSectors = ((uint32_t)g.rootEntries * 32U + (kSecSize - 1)) / kSecSize;
+    g.dataStartSec = g.rootStartSec + g.rootSectors;
+    if (g.dataStartSec >= g.totalSectors) return false;
+    g.totalClusters = (g.totalSectors - g.dataStartSec) / g.secPerClus;
+    g.isFat16 = (g.totalClusters >= 4085);
+    return true;
+}
+
+static uint8_t lfnChecksum(const uint8_t shortName11[11]) {
+    uint8_t sum = 0;
+    for (int i = 0; i < 11; i++) sum = (uint8_t)(((sum & 1) ? 0x80 : 0) + (sum >> 1) + shortName11[i]);
+    return sum;
+}
+
+static void makeShortName83(const String &fname, int seqHint, uint8_t out11[11]) {
+    memset(out11, ' ', 11);
+    int dot = fname.lastIndexOf('.');
+    String base = (dot > 0) ? fname.substring(0, dot) : fname;
+    String ext = (dot > 0 && dot + 1 < (int)fname.length()) ? fname.substring(dot + 1) : "";
+
+    auto cleanChar = [](char c) -> char {
+        c = (char)toupper((unsigned char)c);
+        if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '$') return c;
+        return '_';
+    };
+
+    String bClean;
+    for (size_t i = 0; i < base.length() && bClean.length() < 8; i++) {
+        if (base[i] != ' ' && base[i] != '.') bClean += cleanChar(base[i]);
+    }
+    if (bClean.isEmpty()) bClean = "FILE";
+    if (fname.length() > 12 || dot != fname.indexOf('.') || base.length() > 8 || ext.length() > 3) {
+        char suf[6];
+        snprintf(suf, sizeof(suf), "~%d", (seqHint % 99) + 1);
+        int keep = std::max(1, 8 - (int)strlen(suf));
+        bClean = bClean.substring(0, keep) + suf;
+    }
+    for (size_t i = 0; i < bClean.length() && i < 8; i++) out11[i] = (uint8_t)bClean[i];
+
+    int ei = 0;
+    for (size_t i = 0; i < ext.length() && ei < 3; i++) {
+        if (ext[i] != ' ') out11[8 + ei++] = (uint8_t)cleanChar(ext[i]);
+    }
+}
+
+static bool writeLfnEntries(
+    uint8_t *root, uint16_t maxEntries, uint16_t &cursor, const String &name, const uint8_t short11[11]
+) {
+    // Check if strict ASCII 8.3 uppercase matches cleanly -> no LFN needed
+    bool needsLfn = false;
+    if (name.length() > 12) needsLfn = true;
+    for (size_t i = 0; i < name.length(); i++) {
+        char c = name[i];
+        if ((c >= 'a' && c <= 'z') || c == ' ') {
+            needsLfn = true;
+            break;
+        }
+    }
+    if (!needsLfn) return true;
+
+    size_t nlen = std::min<size_t>(name.length(), 130);
+    int nSlots = (int)((nlen + 12) / 13);
+    if (cursor + nSlots >= maxEntries) return false;
+
+    uint8_t cksum = lfnChecksum(short11);
+    for (int s = nSlots; s >= 1; s--) {
+        uint8_t *ent = root + (cursor++) * 32;
+        memset(ent, 0xFF, 32);
+        ent[0] = (uint8_t)((s == nSlots ? 0x40 : 0x00) | s);
+        ent[11] = 0x0F; // ATTR_LONG_NAME
+        ent[12] = 0x00;
+        ent[13] = cksum;
+        ent[26] = 0x00;
+        ent[27] = 0x00;
+        static const uint8_t charOffs[13] = {1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30};
+        size_t baseIdx = (size_t)(s - 1) * 13;
+        for (int k = 0; k < 13; k++) {
+            size_t ci = baseIdx + k;
+            uint16_t u16 = 0xFFFF;
+            if (ci < nlen) u16 = (uint8_t)name[ci];
+            else if (ci == nlen) u16 = 0x0000;
+            ent[charOffs[k]] = (uint8_t)(u16 & 0xFF);
+            ent[charOffs[k] + 1] = (uint8_t)(u16 >> 8);
+        }
+    }
+    return true;
+}
+
+static int importVaultToDiskMemory(uint8_t *mem, const FatGeom &g) {
+    if (!LittleFS.exists(kVaultDir)) LittleFS.mkdir(kVaultDir);
+    File dir = LittleFS.open(kVaultDir);
+    if (!dir) return 0;
+
+    uint8_t *fat0 = mem + g.fatStartSec * kSecSize;
+    uint8_t *fat1 = mem + (g.fatStartSec + g.fatSectors) * kSecSize;
+    uint8_t *root = mem + g.rootStartSec * kSecSize;
+    uint32_t clusBytes = (uint32_t)g.secPerClus * kSecSize;
+
+    // Find first free root slot & free cluster
+    uint16_t rootIdx = 0;
+    while (rootIdx < g.rootEntries && root[rootIdx * 32] != 0x00) rootIdx++;
+
+    uint32_t nextClus = 2;
+    auto allocCluster = [&]() -> uint32_t {
+        while (nextClus < g.totalClusters + 2) {
+            if (fatGetCluster(fat0, nextClus, g.isFat16) == 0) {
+                fatSetCluster(fat0, nextClus, fatEofVal(g.isFat16), g.isFat16);
+                return nextClus++;
+            }
+            nextClus++;
+        }
+        return 0;
+    };
+
+    int imported = 0;
+    int seqHint = 1;
+    while (true) {
+        bool isDir = false;
+        String fpath = dir.getNextFileName(&isDir);
+        if (fpath.isEmpty()) break;
+        if (isDir) continue;
+        String name = fpath.substring(fpath.lastIndexOf('/') + 1);
+        if (name.isEmpty() || name.startsWith(".")) continue;
+
+        File src = LittleFS.open(fpath, FILE_READ);
+        if (!src) continue;
+        uint32_t fsize = (uint32_t)src.size();
+
+        uint8_t short11[11];
+        makeShortName83(name, seqHint++, short11);
+
+        // Check duplicate short name in root & overwrite or skip
+        if (rootIdx + 12 >= g.rootEntries) {
+            src.close();
+            break;
+        }
+
+        uint32_t firstClus = 0;
+        uint32_t prevClus = 0;
+        uint32_t remaining = fsize;
+        bool diskFull = false;
+
+        while (remaining > 0) {
+            uint32_t c = allocCluster();
+            if (c == 0) {
+                diskFull = true;
+                break;
+            }
+            if (firstClus == 0) firstClus = c;
+            if (prevClus != 0) fatSetCluster(fat0, prevClus, (uint16_t)c, g.isFat16);
+            prevClus = c;
+
+            uint8_t *dst = mem + (g.dataStartSec + (c - 2) * g.secPerClus) * kSecSize;
+            uint32_t toRead = std::min(remaining, clusBytes);
+            size_t got = src.read(dst, toRead);
+            if (got < toRead) memset(dst + got, 0, toRead - got);
+            remaining -= toRead;
+        }
+        src.close();
+        if (diskFull) break;
+
+        if (!writeLfnEntries(root, g.rootEntries, rootIdx, name, short11)) break;
+        uint8_t *ent = root + (rootIdx++) * 32;
+        memset(ent, 0, 32);
+        memcpy(ent, short11, 11);
+        ent[11] = 0x20; // ARCHIVE
+        wr16(ent + 26, (uint16_t)(firstClus & 0xFFFF));
+        wr32(ent + 28, fsize);
+        imported++;
+    }
+    dir.close();
+
+    // Mirror FAT0 -> FAT1
+    memcpy(fat1, fat0, (size_t)g.fatSectors * kSecSize);
+    return imported;
+}
+
+static int exportDiskMemoryToVault(const uint8_t *mem, uint32_t memBytes) {
+    FatGeom g;
+    if (!parseFatGeomFromMemory(mem, memBytes, g)) return -1;
+    if (!LittleFS.exists(kVaultDir)) LittleFS.mkdir(kVaultDir);
+
+    const uint8_t *fat0 = mem + g.fatStartSec * kSecSize;
+    const uint8_t *root = mem + g.rootStartSec * kSecSize;
+    uint32_t clusBytes = (uint32_t)g.secPerClus * kSecSize;
+
+    char lfnBuf[260] = {0};
+    int saved = 0;
+
+    for (uint16_t i = 0; i < g.rootEntries; i++) {
+        const uint8_t *ent = root + i * 32;
+        if (ent[0] == 0x00) break;
+        if (ent[0] == 0xE5) {
+            lfnBuf[0] = '\0';
+            continue;
+        }
+        uint8_t attr = ent[11];
+        if (attr == 0x0F) {
+            uint8_t ord = ent[0] & 0x1F;
+            if (ord >= 1 && ord <= 19) {
+                static const uint8_t charOffs[13] = {1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30};
+                if (ent[0] & 0x40) memset(lfnBuf, 0, sizeof(lfnBuf));
+                int base = (ord - 1) * 13;
+                for (int k = 0; k < 13; k++) {
+                    uint16_t uc = (uint16_t)ent[charOffs[k]] | ((uint16_t)ent[charOffs[k] + 1] << 8);
+                    if (uc == 0x0000 || uc == 0xFFFF) break;
+                    if (base + k < 255) lfnBuf[base + k] = (uc < 0x80) ? (char)uc : '_';
+                }
+            }
+            continue;
+        }
+        if ((attr & 0x08) || (attr & 0x10) || (attr & 0x02)) { // Volume label, dir, or hidden system
+            lfnBuf[0] = '\0';
+            continue;
+        }
+
+        String fname;
+        if (lfnBuf[0] != '\0') {
+            fname = String(lfnBuf);
+        } else {
+            String base, ext;
+            for (int b = 0; b < 8 && ent[b] != ' '; b++) base += (char)ent[b];
+            for (int e = 0; e < 3 && ent[8 + e] != ' '; e++) ext += (char)ent[8 + e];
+            fname = ext.isEmpty() ? base : (base + "." + ext);
+        }
+        lfnBuf[0] = '\0';
+        fname.trim();
+        fname.replace("/", "_");
+        fname.replace("\\", "_");
+        if (fname.isEmpty() || fname.startsWith(".") || fname.indexOf("..") >= 0 ||
+            fname.startsWith("WPSettings") || fname.startsWith("IndexerVolumeGuid")) {
+            continue;
+        }
+
+        uint32_t fsize = rd32(ent + 28);
+        uint32_t clus = rd16(ent + 26);
+        if (fsize > memBytes) continue;
+
+        String outPath = String(kVaultDir) + "/" + fname;
+        File dst = LittleFS.open(outPath, FILE_WRITE);
+        if (!dst) continue;
+
+        uint32_t left = fsize;
+        uint32_t safety = 0;
+        while (left > 0 && clus >= 2 && clus < g.totalClusters + 2 && safety++ < g.totalClusters) {
+            const uint8_t *src = mem + (g.dataStartSec + (clus - 2) * g.secPerClus) * kSecSize;
+            uint32_t n = std::min(left, clusBytes);
+            dst.write(src, n);
+            left -= n;
+            uint16_t nxt = fatGetCluster(fat0, clus, g.isFat16);
+            if (fatIsEof(nxt, g.isFat16)) break;
+            clus = nxt;
+        }
+        dst.close();
+        saved++;
+    }
+    return saved;
+}
+
+static bool saveMemoryToFlashImage() {
+    if (!s_diskMem || !s_backedByFlash) return false;
+    ensureDiskMux();
+    if (xSemaphoreTake(s_diskMux, pdMS_TO_TICKS(1000)) != pdTRUE) return false;
+
+    bool existed = LittleFS.exists(kFlashImgPath);
+    File f = LittleFS.open(kFlashImgPath, existed ? "r+b" : FILE_WRITE);
+    if (!f) {
+        xSemaphoreGive(s_diskMux);
+        return false;
+    }
+
+    if (!existed || f.size() != s_diskBytes) {
+        f.close();
+        f = LittleFS.open(kFlashImgPath, FILE_WRITE);
+        if (!f) {
+            xSemaphoreGive(s_diskMux);
+            return false;
+        }
+        f.write(s_diskMem, s_diskBytes);
+        if (s_dirtyMap) memset(s_dirtyMap, 0, (s_diskSectors + 7) / 8);
+    } else if (s_dirtyMap) {
+        for (uint32_t sec = 0; sec < s_diskSectors; sec++) {
+            if (s_dirtyMap[sec >> 3] & (1U << (sec & 7))) {
+                f.seek((size_t)sec * kSecSize);
+                f.write(s_diskMem + (size_t)sec * kSecSize, kSecSize);
+                s_dirtyMap[sec >> 3] &= ~(1U << (sec & 7));
+            }
+        }
+    }
+    f.flush();
+    f.close();
+    s_dirtyAny = false;
+    xSemaphoreGive(s_diskMux);
+    return true;
+}
+
+static int32_t vmscReadCb(uint32_t lba, uint32_t offset, void *buffer, uint32_t bufsize) {
+    if (!s_diskMem) return -1;
+    uint64_t byteOff = (uint64_t)lba * kSecSize + offset;
+    if (byteOff + bufsize > s_diskBytes) return -1;
+    memcpy(buffer, s_diskMem + byteOff, bufsize);
+    s_rxBytes += bufsize;
+    return (int32_t)bufsize;
+}
+
+static int32_t vmscWriteCb(uint32_t lba, uint32_t offset, uint8_t *buffer, uint32_t bufsize) {
+    if (!s_diskMem) return -1;
+    uint64_t byteOff = (uint64_t)lba * kSecSize + offset;
+    if (byteOff + bufsize > s_diskBytes) return -1;
+    memcpy(s_diskMem + byteOff, buffer, bufsize);
+    if (s_backedByFlash && s_dirtyMap) {
+        uint32_t firstSec = (uint32_t)(byteOff / kSecSize);
+        uint32_t lastSec = (uint32_t)((byteOff + bufsize - 1) / kSecSize);
+        for (uint32_t s = firstSec; s <= lastSec && s < s_diskSectors; s++) {
+            s_dirtyMap[s >> 3] |= (1U << (s & 7));
+        }
+        s_dirtyAny = true;
+        s_lastWriteMs = millis();
+    }
+    s_txBytes += bufsize;
+    return (int32_t)bufsize;
+}
+
+static bool vmscStartStopCb(uint8_t power_condition, bool start, bool load_eject) {
+    (void)power_condition;
+    if (!start && load_eject) {
+        s_ejectRequested = true;
+        return false;
+    }
+    return true;
+}
+
+static String pickDuckyScriptForComposite() {
+    std::vector<String> scripts;
+    const char *dirs[2] = {kVaultDir, "/"};
+    for (const char *dpath : dirs) {
+        if (!LittleFS.exists(dpath)) continue;
+        File dir = LittleFS.open(dpath);
+        if (!dir) continue;
+        while (true) {
+            bool isDir = false;
+            String p = dir.getNextFileName(&isDir);
+            if (p.isEmpty()) break;
+            if (!isDir && (p.endsWith(".txt") || p.endsWith(".duck"))) {
+                if (std::find(scripts.begin(), scripts.end(), p) == scripts.end()) scripts.push_back(p);
+            }
+        }
+        dir.close();
+    }
+    if (scripts.empty()) {
+        displayWarning("No .txt script in LittleFS or /usb_vault", true);
+        return "";
+    }
+    int sel = -1;
+    options.clear();
+    for (size_t i = 0; i < scripts.size() && i < 14; i++) {
+        options.push_back({scripts[i], [&, i]() { sel = (int)i; }});
+    }
+    options.push_back({"Cancel", [&]() { sel = -1; }});
+    loopOptions(options, MENU_TYPE_SUBMENU, "Pick BadUSB Script");
+    options.clear();
+    return (sel >= 0) ? scripts[sel] : String("");
+}
+
+} // namespace
+
+#ifdef USB_as_HID
+USBHIDKeyboard *virtualMscKeyboard() { return &s_vmscKbd; }
+#endif
+
+bool virtualMscEnsureVaultDir() {
+    if (!LittleFS.exists(kVaultDir)) return LittleFS.mkdir(kVaultDir);
+    return true;
+}
+
+String virtualMscVaultInfoJson() {
+    virtualMscEnsureVaultDir();
+    String json = "{\"vaultFiles\":[";
+    File dir = LittleFS.open(kVaultDir);
+    int idx = 0;
+    uint32_t totalBytes = 0;
+    if (dir) {
+        while (true) {
+            bool isDir = false;
+            String p = dir.getNextFileName(&isDir);
+            if (p.isEmpty()) break;
+            if (isDir) continue;
+            File f = LittleFS.open(p, FILE_READ);
+            uint32_t sz = f ? (uint32_t)f.size() : 0;
+            if (f) f.close();
+            totalBytes += sz;
+            String name = p.substring(p.lastIndexOf('/') + 1);
+            if (idx++ > 0) json += ",";
+            json += "{\"name\":\"" + name + "\",\"size\":" + String((unsigned long)sz) + "}";
+        }
+        dir.close();
+    }
+    uint32_t flashImgSz = 0;
+    if (LittleFS.exists(kFlashImgPath)) {
+        File im = LittleFS.open(kFlashImgPath, FILE_READ);
+        if (im) {
+            flashImgSz = (uint32_t)im.size();
+            im.close();
+        }
+    }
+    json += "],\"vaultTotalBytes\":" + String((unsigned long)totalBytes);
+    json += ",\"flashImgBytes\":" + String((unsigned long)flashImgSz);
+    json += ",\"psramFree\":" + String((unsigned long)ESP.getFreePsram()) + "}";
+    return json;
+}
+
+void virtual_msc_setup(bool startWithCompositeBadUsb) {
+    virtualMscEnsureVaultDir();
+
+    VmscStorageMode stMode = VMSC_RAM_2M;
+    bool compositeBadUsb = startWithCompositeBadUsb;
+    bool loadVault = true;
+    bool reuseExistingFlashImg = LittleFS.exists(kFlashImgPath);
+    String duckyPath = "";
+
+    // Pre-mount clean configuration menu
+    bool largeFlash = (LittleFS.totalBytes() > 1024UL * 1024UL);
+    bool goMount = false;
+    while (!goMount) {
+        int sel = -1;
+        options.clear();
+        const char *stLbl = (stMode == VMSC_RAM_2M) ? "Storage: RAM 2.2MB (PSRAM)"
+                            : (stMode == VMSC_FLASH_128K) ? "Storage: Flash 128KB (Saved)"
+                            : (stMode == VMSC_FLASH_512K) ? "Storage: Flash 512KB (Saved)"
+                                                          : "Storage: Flash 1MB (Saved)";
+        options.push_back({stLbl, [&]() { sel = 0; }});
+        options.push_back({String("USB Mode: ") + (compositeBadUsb ? "Drive + BadUSB" : "USB Drive Only"), [&]() { sel = 1; }});
+        if (stMode != VMSC_RAM_2M && LittleFS.exists(kFlashImgPath)) {
+            options.push_back({String("Flash Img: ") + (reuseExistingFlashImg ? "Keep Saved" : "Rebuild / Vault"),
+                               [&]() { sel = 2; }});
+        } else {
+            options.push_back({String("Preload /usb_vault: ") + (loadVault ? "ON" : "Blank"), [&]() { sel = 2; }});
+        }
+        if (compositeBadUsb) {
+            String scLbl = duckyPath.isEmpty() ? "Script: <Pick .txt>" : ("Script: " + duckyPath.substring(duckyPath.lastIndexOf('/') + 1));
+            options.push_back({scLbl, [&]() { sel = 3; }});
+        }
+        options.push_back({"[MOUNT VIRTUAL USB]", [&]() { sel = 4; }});
+        options.push_back({"Save /usb_disk -> /vault", [&]() { sel = 5; }});
+        options.push_back({"Cancel", [&]() { sel = 6; }});
+        loopOptions(options, MENU_TYPE_SUBMENU, "Virtual USB Drive");
+        options.clear();
+
+        if (sel < 0 || sel == 6) return;
+        if (sel == 0) {
+            if (largeFlash) {
+                stMode = (VmscStorageMode)(((int)stMode + 1) % 4);
+            } else {
+                stMode = (stMode == VMSC_RAM_2M) ? VMSC_FLASH_128K : VMSC_RAM_2M;
+            }
+        } else if (sel == 1) {
+            compositeBadUsb = !compositeBadUsb;
+        } else if (sel == 2) {
+            if (stMode != VMSC_RAM_2M && LittleFS.exists(kFlashImgPath)) {
+                reuseExistingFlashImg = !reuseExistingFlashImg;
+            } else {
+                loadVault = !loadVault;
+            }
+        } else if (sel == 3) {
+            duckyPath = pickDuckyScriptForComposite();
+        } else if (sel == 4) {
+            if (compositeBadUsb && duckyPath.isEmpty()) {
+                duckyPath = pickDuckyScriptForComposite();
+                if (duckyPath.isEmpty()) continue;
+            }
+            goMount = true;
+        } else if (sel == 5) {
+            if (!LittleFS.exists(kFlashImgPath)) {
+                displayWarning("No /usb_disk.img saved yet", true);
+            } else {
+                File f = LittleFS.open(kFlashImgPath, FILE_READ);
+                size_t sz = f ? f.size() : 0;
+                uint8_t *tmp = (sz > 0 && psramFound()) ? (uint8_t *)ps_malloc(sz) : nullptr;
+                if (f && tmp && f.read(tmp, sz) == sz) {
+                    int n = exportDiskMemoryToVault(tmp, sz);
+                    displayInfo("Exported " + String(n) + " file(s) to /usb_vault", true);
+                } else {
+                    displayError("Read /usb_disk.img failed", true);
+                }
+                if (f) f.close();
+                if (tmp) free(tmp);
+            }
+        }
+    }
+
+    drawMainBorderWithTitle("Virtual USB Drive");
+    padprintln("");
+    padprintln("Preparing filesystem...");
+
+    FatGeom geom = computeFatGeom(stMode);
+    s_backedByFlash = (stMode != VMSC_RAM_2M);
+    s_diskSectors = geom.totalSectors;
+    s_diskBytes = geom.totalSectors * kSecSize;
+
+    if (psramFound()) s_diskMem = (uint8_t *)ps_malloc(s_diskBytes);
+    if (!s_diskMem) s_diskMem = (uint8_t *)malloc(s_diskBytes);
+    if (!s_diskMem) {
+        displayError("Insufficient PSRAM for USB", true);
+        return;
+    }
+
+    if (s_backedByFlash) {
+        s_dirtyMap = (uint8_t *)calloc((s_diskSectors + 7) / 8, 1);
+    }
+
+    int preloadedFiles = 0;
+    if (s_backedByFlash && reuseExistingFlashImg && LittleFS.exists(kFlashImgPath)) {
+        File f = LittleFS.open(kFlashImgPath, FILE_READ);
+        if (f && f.size() == s_diskBytes && f.read(s_diskMem, s_diskBytes) == s_diskBytes) {
+            padprintln("Loaded saved /usb_disk.img");
+        } else {
+            formatDiskMemory(s_diskMem, geom, "BRUCE FLASH");
+            if (loadVault) preloadedFiles = importVaultToDiskMemory(s_diskMem, geom);
+            if (s_dirtyMap) memset(s_dirtyMap, 0xFF, (s_diskSectors + 7) / 8);
+            s_dirtyAny = true;
+        }
+        if (f) f.close();
+    } else {
+        size_t lfsFree = (LittleFS.totalBytes() > LittleFS.usedBytes())
+                             ? (LittleFS.totalBytes() - LittleFS.usedBytes())
+                             : 0;
+        if (s_backedByFlash && lfsFree < s_diskBytes + 65536) {
+            free(s_diskMem);
+            s_diskMem = nullptr;
+            free(s_dirtyMap);
+            s_dirtyMap = nullptr;
+            displayError("LittleFS too low for disk image", true);
+            return;
+        }
+        formatDiskMemory(s_diskMem, geom, s_backedByFlash ? "BRUCE FLASH" : "BRUCE RAM");
+        if (loadVault) preloadedFiles = importVaultToDiskMemory(s_diskMem, geom);
+        if (s_backedByFlash) {
+            if (s_dirtyMap) memset(s_dirtyMap, 0xFF, (s_diskSectors + 7) / 8);
+            s_dirtyAny = true;
+            saveMemoryToFlashImage();
+        }
+    }
+
+    s_rxBytes = 0;
+    s_txBytes = 0;
+    s_ejectRequested = false;
+    s_usbEventState = -1;
+
+    if (!s_usbEventHooked) {
+        s_usbEventHooked = true;
+        USB.onEvent([](void *, esp_event_base_t base, int32_t id, void *) {
+            if (base == ARDUINO_USB_EVENTS) s_usbEventState = id;
+        });
+    }
+
+    s_msc.vendorID("BRUCE");
+    s_msc.productID(s_backedByFlash ? "FLASH_DISK" : "PSRAM_DISK");
+    s_msc.productRevision("1.1");
+    s_msc.onRead(vmscReadCb);
+    s_msc.onWrite(vmscWriteCb);
+    s_msc.onStartStop(vmscStartStopCb);
+    s_msc.isWritable(true);
+    s_msc.begin(s_diskSectors, kSecSize);
+    s_msc.mediaPresent(true);
+    s_mscInited = true;
+
+#ifdef USB_as_HID
+    if (compositeBadUsb && !s_vmscKbdBegan) {
+        const uint8_t *layout = (const uint8_t *)pgm_read_ptr(&keyboardLayouts[bruceConfig.badUSBBLEKeyboardLayout]);
+        s_vmscKbd.begin(layout);
+        s_vmscKbd.setDelay(bruceConfig.badUSBBLEKeyDelay);
+        s_vmscKbdBegan = true;
+    }
+#endif
+    USB.begin();
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    bool badUsbExecuted = false;
+    bool wasMounted = false;
+    uint32_t mountedAtMs = 0;
+    uint32_t lastDraw = 0;
+    String toastMsg = preloadedFiles > 0 ? ("Preloaded " + String(preloadedFiles) + " vault file(s)") : "";
+    uint32_t toastUntil = preloadedFiles > 0 ? (millis() + 3000UL) : 0;
+    returnToMenu = false;
+
+    while (!returnToMenu && !s_ejectRequested) {
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+
+        bool isMounted = tud_mounted() || (s_usbEventState == ARDUINO_USB_STARTED_EVENT);
+        if (isMounted && mountedAtMs == 0) mountedAtMs = millis();
+        if (wasMounted && !isMounted) {
+            toastMsg = "USB Host Disconnected";
+            toastUntil = millis() + 2600UL;
+            lastDraw = 0;
+        }
+        wasMounted = isMounted;
+
+        // Periodically flush dirty sectors to /usb_disk.img after 700ms idle
+        if (s_backedByFlash && s_dirtyAny && (millis() - s_lastWriteMs) > 700UL) {
+            saveMemoryToFlashImage();
+            toastMsg = "Synced changes to Flash";
+            toastUntil = millis() + 2000UL;
+        }
+
+        if (check(PrevPress)) {
+            // Vol-: quickly inspect files currently inside the virtual FAT disk
+            if (hasSprite) {
+                frame.deleteSprite();
+                hasSprite = false;
+            }
+            FatGeom dg;
+            String listStr = "Virtual USB Root Files:\n";
+            if (parseFatGeomFromMemory(s_diskMem, s_diskBytes, dg)) {
+                const uint8_t *root = s_diskMem + dg.rootStartSec * kSecSize;
+                char lfn[128] = {0};
+                int fc = 0;
+                for (uint16_t ri = 0; ri < dg.rootEntries && fc < 12; ri++) {
+                    const uint8_t *ent = root + ri * 32;
+                    if (ent[0] == 0x00) break;
+                    if (ent[0] == 0xE5) {
+                        lfn[0] = '\0';
+                        continue;
+                    }
+                    if (ent[11] == 0x0F) {
+                        uint8_t ord = ent[0] & 0x1F;
+                        if (ord >= 1 && ord <= 9) {
+                            static const uint8_t co[13] = {1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30};
+                            if (ent[0] & 0x40) memset(lfn, 0, sizeof(lfn));
+                            int base = (ord - 1) * 13;
+                            for (int k = 0; k < 13; k++) {
+                                uint16_t uc = (uint16_t)ent[co[k]] | ((uint16_t)ent[co[k] + 1] << 8);
+                                if (uc == 0 || uc == 0xFFFF) break;
+                                if (base + k < 120) lfn[base + k] = (uc < 0x80) ? (char)uc : '_';
+                            }
+                        }
+                        continue;
+                    }
+                    if (ent[11] & 0x1A) {
+                        lfn[0] = '\0';
+                        continue;
+                    }
+                    String fn = (lfn[0] != '\0') ? String(lfn) : String("");
+                    if (fn.isEmpty()) {
+                        for (int b = 0; b < 8 && ent[b] != ' '; b++) fn += (char)ent[b];
+                        String ext;
+                        for (int e = 0; e < 3 && ent[8 + e] != ' '; e++) ext += (char)ent[8 + e];
+                        if (!ext.isEmpty()) fn += "." + ext;
+                    }
+                    lfn[0] = '\0';
+                    uint32_t fsz = rd32(ent + 28);
+                    listStr += " - " + fn + " (" + String((unsigned long)fsz) + "B)\n";
+                    fc++;
+                }
+                if (fc == 0) listStr += "  (Disk is empty)";
+            } else {
+                listStr += "  (FAT table unavailable)";
+            }
+            displayInfo(listStr, true);
+            hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+            lastDraw = 0;
+        }
+
+        if (check(SelPress)) {
+            if (compositeBadUsb && isMounted && !duckyPath.isEmpty()) {
+#ifdef USB_as_HID
+                if (hasSprite) {
+                    frame.deleteSprite();
+                    hasSprite = false;
+                }
+                key_input(LittleFS, duckyPath, &s_vmscKbd);
+                badUsbExecuted = true;
+                hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+#endif
+            } else {
+                // Save current RAM or Flash disk contents back to /usb_vault
+                int cnt = exportDiskMemoryToVault(s_diskMem, s_diskBytes);
+                if (s_backedByFlash && s_dirtyAny) saveMemoryToFlashImage();
+                toastMsg = (cnt >= 0) ? ("Saved " + String(cnt) + " file(s) -> /usb_vault") : "Sync error";
+                toastUntil = millis() + 2800UL;
+            }
+            lastDraw = 0;
+        }
+
+        if (check(NextPress)) {
+            // Vol+ quick sync to /usb_vault even in composite mode
+            int cnt = exportDiskMemoryToVault(s_diskMem, s_diskBytes);
+            if (s_backedByFlash && s_dirtyAny) saveMemoryToFlashImage();
+            toastMsg = (cnt >= 0) ? ("Saved " + String(cnt) + " file(s) -> /usb_vault") : "Sync error";
+            toastUntil = millis() + 2800UL;
+            lastDraw = 0;
+        }
+
+        if (millis() - lastDraw >= 180) {
+            lastDraw = millis();
+            if (hasSprite) {
+                const uint16_t bg = bruceConfig.bgColor;
+                const uint16_t pri = bruceConfig.priColor;
+                const uint16_t sec = bruceConfig.secColor;
+                const uint16_t okCol = 0x2F2F;
+                const uint16_t warnCol = 0xFD84;
+
+                frame.fillScreen(bg);
+                frame.fillRect(0, 0, tftWidth, 24, blendColors(bg, pri, 28));
+                frame.setTextSize(1);
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(pri, blendColors(bg, pri, 28));
+                frame.drawString(compositeBadUsb ? "USB DRIVE + BADUSB" : "VIRTUAL USB DRIVE", 8, 12);
+                frame.setTextDatum(MR_DATUM);
+                frame.setTextColor(s_backedByFlash ? warnCol : okCol, blendColors(bg, pri, 28));
+                frame.drawString(s_backedByFlash ? "FLASH" : "PSRAM", tftWidth - 8, 12);
+
+                // Status card
+                frame.fillRoundRect(10, 32, tftWidth - 20, 74, 8, blendColors(bg, pri, 12));
+                frame.drawRoundRect(10, 32, tftWidth - 20, 74, 8, isMounted ? okCol : warnCol);
+
+                // Mini USB stick icon inside status card
+                frame.fillRoundRect(22, 49, 44, 26, 4, pri);
+                frame.fillRoundRect(66, 54, 14, 16, 2, TFT_LIGHTGREY);
+                frame.fillCircle(30, 62, 4, isMounted ? okCol : TFT_RED);
+
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextSize(2);
+                frame.setTextColor(isMounted ? okCol : warnCol, blendColors(bg, pri, 12));
+                frame.drawString(isMounted ? "MOUNTED" : "WAIT USB", 92, 54);
+                frame.setTextSize(1);
+                frame.setTextColor(TFT_WHITE, blendColors(bg, pri, 12));
+                String capStr = s_backedByFlash
+                                    ? (String(s_diskBytes / 1024) + " KB (/usb_disk.img)")
+                                    : "2.2 MB (PSRAM Fast)";
+                frame.drawString(capStr, 92, 74);
+                frame.setTextColor(sec, blendColors(bg, pri, 12));
+                frame.drawString(
+                    s_backedByFlash ? (s_dirtyAny ? "Pending Flash sync..." : "Saved in Flash")
+                                    : "RAM-Disk (Save w/ Vol+)",
+                    92,
+                    90
+                );
+
+                // Transfer counters
+                frame.fillRoundRect(10, 114, (tftWidth - 28) / 2, 44, 6, blendColors(bg, pri, 8));
+                frame.fillRoundRect(18 + (tftWidth - 28) / 2, 114, (tftWidth - 28) / 2, 44, 6, blendColors(bg, pri, 8));
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 8));
+                frame.drawString("HOST READ", 10 + (tftWidth - 28) / 4, 126);
+                frame.drawString("HOST WRITE", 18 + (tftWidth - 28) * 3 / 4, 126);
+                frame.setTextColor(pri, blendColors(bg, pri, 8));
+                frame.drawString(String((unsigned long)(s_rxBytes / 1024)) + " KB", 10 + (tftWidth - 28) / 4, 142);
+                frame.drawString(String((unsigned long)(s_txBytes / 1024)) + " KB", 18 + (tftWidth - 28) * 3 / 4, 142);
+
+                if (compositeBadUsb) {
+                    frame.fillRoundRect(10, 166, tftWidth - 20, 42, 6, blendColors(bg, pri, 10));
+                    frame.setTextDatum(ML_DATUM);
+                    frame.setTextColor(TFT_WHITE, blendColors(bg, pri, 10));
+                    String sname = duckyPath.substring(duckyPath.lastIndexOf('/') + 1);
+                    frame.drawString("Payload: " + sname.substring(0, 22), 18, 180);
+                    frame.setTextColor(badUsbExecuted ? okCol : warnCol, blendColors(bg, pri, 10));
+                    frame.drawString(badUsbExecuted ? "Executed (Boot:Re-run)" : "Press Boot to run DuckyScript", 18, 196);
+                } else if (millis() < toastUntil && !toastMsg.isEmpty()) {
+                    frame.fillRoundRect(10, 170, tftWidth - 20, 32, 6, blendColors(bg, okCol, 28));
+                    frame.setTextDatum(MC_DATUM);
+                    frame.setTextColor(okCol, blendColors(bg, okCol, 28));
+                    frame.drawString(toastMsg, tftWidth / 2, 186);
+                } else {
+                    frame.setTextDatum(MC_DATUM);
+                    frame.setTextColor(sec, bg);
+                    frame.drawString("Copy files from PC, then save to /usb_vault", tftWidth / 2, 186);
+                }
+
+                frame.fillRect(0, tftHeight - 20, tftWidth, 20, blendColors(bg, pri, 14));
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 14));
+                frame.drawString(
+                    compositeBadUsb ? "Boot:Run   Vol-:Files   Vol+:Save   Hold:Eject"
+                                    : "Boot/Vol+:Save   Vol-:Files   Hold:Eject",
+                    tftWidth / 2,
+                    tftHeight - 10
+                );
+                frame.pushSprite(0, 0);
+                tft.markUnmappedPixels();
+            }
+            wakeUpScreen();
+        }
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+
+    // Finalize: persist Flash dirty sectors, and offer/auto-save if needed
+    if (s_backedByFlash) {
+        saveMemoryToFlashImage();
+    } else if (s_txBytes > 0) {
+        int saved = exportDiskMemoryToVault(s_diskMem, s_diskBytes);
+        if (saved > 0) displayInfo("Saved " + String(saved) + " new/updated file(s)\nto /usb_vault!", true);
+    }
+
+    s_msc.mediaPresent(false);
+    vTaskDelay(pdMS_TO_TICKS(150));
+
+    if (hasSprite) frame.deleteSprite();
+    free(s_diskMem);
+    s_diskMem = nullptr;
+    free(s_dirtyMap);
+    s_dirtyMap = nullptr;
+    s_diskBytes = 0;
+    s_diskSectors = 0;
+    s_dirtyAny = false;
+    tft.fillScreen(bruceConfig.bgColor);
+}
+#else
+void virtual_msc_setup(bool) {}
+String virtualMscVaultInfoJson() { return "{}"; }
+bool virtualMscEnsureVaultDir() { return false; }
+#endif
