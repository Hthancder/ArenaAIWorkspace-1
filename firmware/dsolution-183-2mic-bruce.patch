+    if (j.length() > 2) return j;
+    return String("{\"running\":false,\"auto\":") +
+           (bruceConfig.seclabPlus.hidLedAutoArm ? "true" : "false") +
+           ",\"phase\":\"IDLE\",\"ledState\":\"OFF\",\"bits\":0,\"bytes\":0,\"decoded\":\"\","
+           "\"payload\":\"" + kPayloadPath + "\",\"json\":\"" + kLastJsonPath + "\"}";
+}
+
+void smartBadUsbMouseJiggler(uint32_t durationSec, uint16_t intervalMs, bool clickScript, String *errOut) {
+    if (!ensureMouse(errOut)) return;
+    if (intervalMs < 200) intervalMs = 200;
+    uint32_t t0 = millis();
+    uint32_t lastDraw = 0;
+    uint32_t ticks = 0;
+    drawMainBorderWithTitle(clickScript ? "MOUSE CLICK SCRIPT" : "MOUSE JIGGLER");
+    while ((durationSec == 0 || millis() - t0 < durationSec * 1000UL) && !check(EscPress)) {
+        int8_t dx = (ticks % 4 < 2) ? 2 : -2;
+        int8_t dy = (ticks % 8 < 4) ? 1 : -1;
+        s_mouse->move(dx, dy);
+        if (clickScript && ticks % 20 == 19) {
+            s_mouse->click(MOUSE_LEFT);
+            vTaskDelay(pdMS_TO_TICKS(80));
+        }
+        ticks++;
+        if (millis() - lastDraw > 500) {
+            lastDraw = millis();
+            drawMainBorderWithTitle(clickScript ? "MOUSE CLICK SCRIPT" : "MOUSE JIGGLER");
+            padprintln("Moves  : " + String((unsigned long)ticks));
+            padprintln("Period : " + String((unsigned)intervalMs) + " ms");
+            padprintln("Left click: " + String(clickScript ? "scripted" : "off"));
+            padprintln("Time   : " + String((unsigned long)((millis() - t0) / 1000UL)) + " s");
+            padprintln("Hold Boot to stop");
+        }
+        vTaskDelay(pdMS_TO_TICKS(intervalMs));
+    }
+    s_mouse->release(MOUSE_ALL);
+    displayInfo("Mouse finished", true);
+}
