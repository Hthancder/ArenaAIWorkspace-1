+static const char *phyCodeToStr(uint8_t p) {
+    if (p == 2) return "2M";
+    if (p == 3) return "CODED";
+    if (p == 1) return "1M";
+    return "?";
+}
+
+static String toHexStr(const uint8_t *data, size_t len, size_t maxBytes = 24) {
+    if (!data || len == 0) return "<empty>";
+    String s;
+    size_t n = std::min(len, maxBytes);
+    char buf[4];
+    for (size_t i = 0; i < n; i++) {
+        snprintf(buf, sizeof(buf), i == 0 ? "%02X" : " %02X", data[i]);
+        s += buf;
+    }
+    if (len > maxBytes) s += "..";
+    return s;
+}
+
+static String toAsciiStr(const uint8_t *data, size_t len, size_t maxChars = 22) {
+    if (!data || len == 0) return "";
+    String s;
+    size_t n = std::min(len, maxChars);
+    for (size_t i = 0; i < n; i++) {
+        char c = (data[i] >= 32 && data[i] <= 126) ? (char)data[i] : '.';
+        s += c;
+    }
+    return s;
+}
+
+static String shortUuidLabel(const String &uuid) {
+    String u = uuid;
+    u.toUpperCase();
+    if (u.startsWith("0X")) u = u.substring(2);
+    // Match 16-bit UUIDs
+    if (u == "1800") return "Generic Access";
+    if (u == "1801") return "Generic Attr";
+    if (u == "180A") return "Device Info";
+    if (u == "180D") return "Heart Rate";
+    if (u == "180F") return "Battery Svc";
+    if (u == "1812") return "HID / Keyboard";
+    if (u == "181A") return "Env Sensing";
+    if (u == "FEE0" || u == "FEE1") return "Wearable/Mi";
+    if (u == "FE9F") return "Google FastPair";
+    if (u.startsWith("6E400001")) return "Nordic UART";
+    if (u.startsWith("6E400002")) return "NUS RX";
+    if (u.startsWith("6E400003")) return "NUS TX";
+    if (u == "2A00") return "Device Name";
+    if (u == "2A19") return "Battery Level";
+    if (u == "2A24") return "Model Number";
+    if (u == "2A29") return "Manufacturer";
+    if (u == "2A37") return "HR Measure";
+    if (u.length() > 12) return u.substring(0, 8) + "..";
+    return "0x" + u;
+}
+
+static bool isSystemServiceUuid(const String &uuid) {
+    String u = uuid;
+    u.toUpperCase();
+    if (u.startsWith("0X")) u = u.substring(2);
+    return (u == "1800" || u == "1801" || u == "00001800-0000-1000-8000-00805F9B34FB" ||
+            u == "00001801-0000-1000-8000-00805F9B34FB");
+}
+
+static String sanitizeAddrFile(const String &addr) {
+    String out;
+    for (size_t i = 0; i < addr.length(); i++) {
+        char c = addr[i];
+        if (c == ':' || c == '-') continue;
+        out += (char)tolower((unsigned char)c);
+    }
+    return String(kGattProfilesDir) + "/gatt_" + out + ".json";
+}
+
+static bool saveGattProfileJson(const GattProfile &prof) {
+    if (!LittleFS.exists(kGattProfilesDir)) LittleFS.mkdir(kGattProfilesDir);
+    String path = sanitizeAddrFile(prof.addr);
+    JsonDocument doc;
+    doc["name"] = prof.name;
+    doc["addr"] = prof.addr;
+    doc["addrType"] = prof.addrType;
+    doc["rssi"] = prof.rssi;
+    if (!prof.mfrData.empty()) {
+        String mh;
+        char b[3];
+        for (uint8_t v : prof.mfrData) {
+            snprintf(b, sizeof(b), "%02X", v);
+            mh += b;
+        }
+        doc["mfrHex"] = mh;
+    }
+    JsonArray advArr = doc["advUuids"].to<JsonArray>();
+    for (const auto &u : prof.advUuids) advArr.add(u);
+    JsonArray svcArr = doc["services"].to<JsonArray>();
+    for (const auto &s : prof.services) {
+        JsonObject so = svcArr.add<JsonObject>();
+        so["uuid"] = s.uuid;
+    }
+    JsonArray chrArr = doc["chars"].to<JsonArray>();
+    for (const auto &c : prof.chars) {
+        JsonObject co = chrArr.add<JsonObject>();
+        co["svc"] = c.svcUuid;
+        co["uuid"] = c.uuid;
+        co["props"] = c.props;
+        String vh;
+        char b[3];
+        for (size_t i = 0; i < c.val.size() && i < 64; i++) {
+            snprintf(b, sizeof(b), "%02X", c.val[i]);
+            vh += b;
+        }
+        co["hex"] = vh;
+    }
+    File f = LittleFS.open(path, FILE_WRITE);
+    if (!f) return false;
+    serializeJson(doc, f);
+    f.close();
+    return true;
+}
+
+static bool hexStringToBytes(const String &hexIn, std::vector<uint8_t> &out) {
+    out.clear();
+    String clean;
+    for (size_t i = 0; i < hexIn.length(); i++) {
+        char c = hexIn[i];
+        if (isxdigit((unsigned char)c)) clean += c;
+    }
+    if (clean.length() < 2 || (clean.length() % 2) != 0) return false;
+    for (size_t i = 0; i + 1 < clean.length(); i += 2) {
+        char b[3] = {clean[i], clean[i + 1], '\0'};
+        out.push_back((uint8_t)strtoul(b, nullptr, 16));
+    }
+    return true;
+}
+
+static bool loadGattProfileJson(const String &path, GattProfile &prof) {
+    File f = LittleFS.open(path, FILE_READ);
+    if (!f) return false;
+    JsonDocument doc;
+    DeserializationError err = deserializeJson(doc, f);
+    f.close();
+    if (err) return false;
+
+    prof = GattProfile();
+    prof.name = doc["name"] | "Cloned BLE";
+    prof.addr = doc["addr"] | "00:00:00:00:00:00";
+    prof.addrType = doc["addrType"] | 0;
+    prof.rssi = doc["rssi"] | -50;
+    hexStringToBytes(doc["mfrHex"] | "", prof.mfrData);
+
+    for (JsonVariant v : doc["advUuids"].as<JsonArray>()) prof.advUuids.push_back(v.as<String>());
+    for (JsonObject so : doc["services"].as<JsonArray>()) {
+        GattSvcSnap s;
+        s.uuid = so["uuid"] | "";
+        s.label = shortUuidLabel(s.uuid);
+        if (!s.uuid.isEmpty()) prof.services.push_back(s);
+    }
+    for (JsonObject co : doc["chars"].as<JsonArray>()) {
+        GattChrSnap c;
+        c.svcUuid = co["svc"] | "";
+        c.uuid = co["uuid"] | "";
+        c.props = co["props"] | 0x02;
+        c.handle = 0;
+        c.subscribed = false;
+        c.remote = nullptr;
+        hexStringToBytes(co["hex"] | "", c.val);
+        if (!c.uuid.isEmpty() && !c.svcUuid.isEmpty()) prof.chars.push_back(c);
+    }
+    return !prof.services.empty();
+}
