+static String readJsonSnapshotOrEmpty(const char *path, size_t maxBytes = 12288) {
+    if (!LittleFS.exists(path)) return "{}";
+    File f = LittleFS.open(path, FILE_READ);
+    if (!f) return "{}";
+    size_t sz = f.size();
+    if (sz < 2 || sz > maxBytes) {
+        f.close();
+        return "{}";
+    }
+    String out;
+    out.reserve(sz + 1);
+    while (f.available()) out += (char)f.read();
+    f.close();
+    out.trim();
+    if (!out.startsWith("{") || !out.endsWith("}")) return "{}";
+    return out;
+}
