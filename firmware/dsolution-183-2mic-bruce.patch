+void ble_gatt_cloner_setup() {
+    if (!LittleFS.exists(kGattProfilesDir)) LittleFS.mkdir(kGattProfilesDir);
+
+    // Collect saved profiles
+    std::vector<String> savedPaths;
+    std::vector<String> savedLabels;
+    if (LittleFS.exists(kGattProfilesDir)) {
+        File dir = LittleFS.open(kGattProfilesDir);
+        if (dir) {
+            while (true) {
+                bool isDir = false;
+                String p = dir.getNextFileName(&isDir);
+                if (p.isEmpty()) break;
+                if (!isDir && p.endsWith(".json")) {
+                    GattProfile gp;
+                    if (loadGattProfileJson(p, gp)) {
+                        savedPaths.push_back(p);
+                        savedLabels.push_back("Clone: " + gp.name.substring(0, 14) + " [" + String(gp.chars.size()) + "C]");
+                    }
+                }
+            }
+            dir.close();
+        }
+    }
+
+    int modeChoice = -1;
+    options.clear();
+    options.push_back({"Scan & Explore GATT", [&]() { modeChoice = 0; }});
+    for (size_t i = 0; i < savedLabels.size() && i < 8; i++) {
+        options.push_back({savedLabels[i], [&, i]() { modeChoice = (int)(10 + i); }});
+    }
+    options.push_back({"Back", [&]() { modeChoice = -1; }});
+    loopOptions(options, MENU_TYPE_SUBMENU, "GATT Explorer & Cloner");
+    options.clear();
+
+    if (modeChoice < 0) return;
+
+    if (modeChoice >= 10) {
+        size_t idx = (size_t)(modeChoice - 10);
+        GattProfile gp;
+        if (idx < savedPaths.size() && loadGattProfileJson(savedPaths[idx], gp)) {
+            runPeripheralCloner(gp);
+        } else {
+            displayError("Load GATT profile failed", true);
+        }
+        return;
+    }
+
+    // Active 4s scan
+    if (!ble_scan_setup() || pBLEScan == nullptr) {
+        displayError("BLE Scan init failed", true);
+        return;
+    }
+
+    displayTextLine("Scanning BLE (4s)...");
+    pBLEScan->clearResults();
+    BLEScanResults found = pBLEScan->getResults(4000, false);
+    std::vector<ScanTarget> targets;
+    for (int i = 0; i < found.getCount() && targets.size() < 28; i++) {
+        const NimBLEAdvertisedDevice *d = found.getDevice(i);
+        if (!d) continue;
+        ScanTarget st;
+        st.name = d->getName().c_str();
+        if (st.name.isEmpty()) st.name = "<no name>";
+        st.addr = d->getAddress().toString().c_str();
+        st.addrType = d->getAddressType();
+        st.rssi = d->getRSSI();
+        if (d->haveManufacturerData()) {
+            std::string md = d->getManufacturerData();
+            st.mfrData.assign(md.begin(), md.end());
+        }
+        for (uint8_t s = 0; s < d->getServiceUUIDCount() && s < 4; s++) {
+            st.advUuids.push_back(d->getServiceUUID(s).toString().c_str());
+        }
+        targets.push_back(st);
+    }
+    pBLEScan->stop();
+    pBLEScan->clearResults();
+
+    if (targets.empty()) {
+        stopBLEStack();
+        displayWarning("No BLE targets found", true);
+        return;
+    }
+
+    std::sort(targets.begin(), targets.end(), [](const ScanTarget &a, const ScanTarget &b) {
+        return a.rssi > b.rssi;
+    });
+
+    int pick = -1;
+    options.clear();
+    for (size_t i = 0; i < targets.size() && i < 16; i++) {
+        String lbl = (targets[i].name != "<no name>") ? targets[i].name.substring(0, 14) : targets[i].addr.substring(9);
+        lbl += " (" + String(targets[i].rssi) + "dB)";
+        options.push_back({lbl, [&, i]() { pick = (int)i; }});
+    }
+    options.push_back({"Cancel", [&]() { pick = -1; }});
+    loopOptions(options, MENU_TYPE_SUBMENU, "Select BLE Target");
+    options.clear();
+
+    if (pick >= 0 && pick < (int)targets.size()) {
+        inspectAndExploreTarget(targets[pick]);
+    } else {
+        stopBLEStack();
+    }
+}
+#else
+void ble_gatt_cloner_setup() {}
+String bleGattGetStateJson() { return "{}"; }
+String bleGattSavedProfilesJson() { return "[]"; }
+#endif
