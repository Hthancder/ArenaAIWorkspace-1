+/*********************************************************************
+**  Function: showPowerStats
+**  Displays live battery, CPU, radio, and OTA diagnostics
+**********************************************************************/
+void showPowerStats() {
+    drawMainBorderWithTitle("Power Stats", true);
+    int padX = BORDER_PAD_X + 4;
+    int y = STATUS_BAR_HEIGHT + FM * LH + 6;
+    const int step = LH * FP + 4;
+
+    int batPct = getBattery();
+    int batMv = getBatteryMv();
+    bool chg = isCharging();
+
+    auto row = [&](const String &k, const String &v, uint16_t valCol) {
+        tft.setTextSize(FP);
+        tft.setTextColor(bruceConfig.secColor, bruceConfig.bgColor);
+        tft.drawString(k, padX, y);
+        tft.setTextColor(valCol, bruceConfig.bgColor);
+        tft.drawRightString(v, tftWidth - padX, y, 1);
+        y += step;
+    };
+
+    String modeName = bruceConfig.powerMode == POWER_MODE_ECO
+                          ? "Eco Saver"
+                          : (bruceConfig.powerMode == POWER_MODE_PERFORMANCE ? "Performance" : "Balanced");
+    String batStr = String(batPct) + "%";
+    if (batMv > 0) batStr += " (" + String(batMv) + "mV)";
+
+    row("Battery:", batStr, batPct <= 15 ? TFT_RED : bruceConfig.priColor);
+    row("Charge:", chg ? "Charging (USB)" : "Discharging", chg ? TFT_GREEN : bruceConfig.priColor);
+    row("Power Mode:", modeName, bruceConfig.priColor);
+    row("CPU Clock:", String(getCpuFrequencyMhz()) + " MHz", bruceConfig.priColor);
+    row(
+        "Dim / Off:",
+        (bruceConfig.dimmerSet ? String(bruceConfig.dimmerSet) + "s" : "Off") + " / " +
+            (bruceConfig.screenOffSet > 0 ? String(bruceConfig.screenOffSet) + "s" : "Off"),
+        bruceConfig.priColor
+    );
+    row("Audio Amp:", isSpeakerActive() ? "ACTIVE" : "MUTED (Idle)", isSpeakerActive() ? TFT_YELLOW : TFT_GREEN);
+    row(
+        "WiFi / WebUI:",
+        WiFi.getMode() == WIFI_MODE_NULL ? String("OFF")
+                                         : (isWebUIActive ? wifiIP : String("ON")),
+        WiFi.getMode() == WIFI_MODE_NULL ? bruceConfig.secColor : TFT_GREEN
+    );
+    row(
+        "Heap / PSRAM:",
+        String(ESP.getFreeHeap() / 1024) + "K / " + String(ESP.getFreePsram() / 1024) + "K",
+        bruceConfig.priColor
+    );
+
+    tft.setTextSize(FP);
+    tft.setTextColor(bruceConfig.secColor, bruceConfig.bgColor);
+    tft.drawCentreString("[Any Key] Back", tftWidth / 2, tftHeight - BORDER_PAD_X - LH * FP, 1);
+
+    while (!check(AnyKeyPress)) { vTaskDelay(pdMS_TO_TICKS(30)); }
+}
