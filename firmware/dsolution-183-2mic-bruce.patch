diff --git a/src/core/serial_commands/seclab_commands.cpp b/src/core/serial_commands/seclab_commands.cpp
new file mode 100644
index 00000000..d8acc1f1
--- /dev/null
+++ b/src/core/serial_commands/seclab_commands.cpp
@@ -0,0 +1,418 @@
+#include "seclab_commands.h"
+#include <Arduino.h>
+#include <globals.h>
+
+#if !defined(LITE_VERSION)
+
+#include "core/config.h"
+#include "core/seclab_util.h"
+#include "modules/badusb_ble/smart_badusb.h"
+#include "modules/ble/ble_security_audit.h"
+#include "modules/wifi/lan_auditor.h"
+#include "modules/wifi/lan_guard.h"
+#include "modules/wifi/napt_http_inspector.h"
+#include "modules/wifi/napt_router.h"
+#include "modules/wifi/pmf_csa_test.h"
+#include "modules/wifi/pmkid_capture.h"
+#include "modules/wifi/portal_napt.h"
+#include "modules/wifi/responder_plus.h"
+
+static void slPrint(const String &s) { serialDevice->println(s); }
+
+static void slHelp() {
+    slPrint("SecLab+ CLI (authorized audits only):");
+    slPrint("  seclab status | settings | stopall | help");
+    slPrint("  seclab perm [on|off|status]       payload admin check");
+    slPrint("  seclab set <key> <value> [extra] see SETTINGS KEYS below");
+    slPrint("  seclab pairmode [justworks|mitm|status]");
+    slPrint("  seclab pmkid start|stop|export|clear|status [bssid] [ssid] [channel]");
+    slPrint("  seclab csa start|stop|clear|status [bssid] [ssid] [apCh] [newCh] [bursts]");
+    slPrint("  seclab portal start|stop|handoff [on|off]|status");
+    slPrint("  seclab lan start|stop|export|clear|status [deep|quick]");
+    slPrint("  seclab responder start|stop|clear|status");
+    slPrint("  seclab guard start|stop|auto [on|off]|clear|status");
+    slPrint("  seclab http start|stop|export|clear|auto|redact|status [port]");
+    slPrint("  seclab led start|stop|export|clear|generate|status [windows|macos|linux]");
+    slPrint("  seclab os windows|macos|linux");
+    slPrint("  seclab ble tag_start|tag_stop|pair|fuzzer|clear|status [addr] [type] [justworks|mitm|duration]");
+    slPrint("  KEYS: pairmode perm hidauto oswarn hidtimeout httpport httpauto redact handoff");
+    slPrint("        lanauto fuzzer autoexport csa(channel,bursts)");
+}
+
+static void slResult(bool ok, const String &success, const String &err) {
+    if (ok) slPrint(success);
+    else slPrint(String("Action failed: ") + (err.isEmpty() ? String("unknown error") : err));
+}
+
+static bool slTruth(const String &v, bool defVal) {
+    String s = v;
+    s.toLowerCase();
+    if (s == "on" || s == "1" || s == "true" || s == "yes") return true;
+    if (s == "off" || s == "0" || s == "false" || s == "no") return false;
+    return defVal;
+}
+
+static void slSettings() {
+    slPrint("SecLab+ settings:");
+    slPrint("  OS profile      : " + smartBadUsbProfileName(smartBadUsbGetOsProfile()));
+    slPrint("  Admin check     : " + String(bruceConfig.seclabPlus.badUsbPermissionCheck ? "ON" : "OFF"));
+    slPrint("  OS warning      : " + String(bruceConfig.seclabPlus.badUsbOsWarn ? "ON" : "OFF"));
+    slPrint("  LED auto-arm    : " + String(bruceConfig.seclabPlus.hidLedAutoArm ? "ON" : "OFF"));
+    slPrint("  LED timeout     : " + String(bruceConfig.seclabPlus.hidLedTimeoutSec) + "s");
+    slPrint("  HTTP auto/redact: " + String(bruceConfig.seclabPlus.httpInspectorAutoStart ? "ON" : "OFF") + "/" +
+            String(bruceConfig.seclabPlus.httpInspectorRedact ? "ON" : "OFF"));
+    slPrint("  HTTP proxy port : " + String(bruceConfig.seclabPlus.httpInspectorPort));
+    slPrint("  Portal handoff  : " + String(bruceConfig.seclabPlus.portalNaptHandoff ? "ON" : "OFF"));
+    slPrint("  LAN Guard auto  : " + String(bruceConfig.seclabPlus.lanGuardAutoArm ? "ON" : "OFF"));
+    slPrint("  BLE boundary writes : " + String(bruceConfig.seclabPlus.bleSafeFuzzer ? "ON" : "OFF"));
+    slPrint("  Pair audit mode : " + String(bruceConfig.seclabPlus.blePairAuditJustWorks ? "JUST_WORKS" : "MITM_BASELINE"));
+    slPrint("  PMKID auto-exp  : " + String(bruceConfig.seclabPlus.pmkidAutoExport ? "ON" : "OFF"));
+    slPrint("  CSA defaults    : CH" + String(bruceConfig.seclabPlus.csaChannel) + " / " +
+            String(bruceConfig.seclabPlus.csaBursts) + " bursts");
+}
+
+static void slStopAll() {
+    pmkidStop();
+    csaStop();
+    portalNaptStop();
+    lanAuditStop();
+    responderPlusStop();
+    lanGuardStop();
+    naptHttpInspectorStop();
+    smartBadUsbStopLedLink();
+    bleTagBeaconStop();
+    naptStop(false);
+    slPrint("All stoppable SecLab+ tools stopped");
+    if (blePairingAuditIsRunning()) slPrint("Pairing audit will finish on its own");
+}
+
+static void slStatus() {
+    slPrint("PMKID: " + pmkidGetStateJson());
+    slPrint("CSA: " + csaGetStateJson());
+    slPrint("PORTAL: " + portalNaptGetStateJson());
+    slPrint("LAN: " + lanAuditGetStateJson());
+    slPrint("RESPONDER+: " + responderPlusGetStateJson());
+    slPrint("GUARD: " + lanGuardGetStateJson());
+    slPrint("HTTP: " + naptHttpInspectorGetStateJson());
+    slPrint("LED: " + smartBadUsbGetLedLinkStateJson());
+    slPrint("BLE_AUDIT: " + bleSecurityAuditGetStateJson());
+    slPrint("PAIR: " + blePairingAuditGetStateJson());
+    slPrint("TAG: " + bleTagBeaconGetStateJson());
+    slSettings();
+}
+
+uint32_t seclabCallback(cmd *c) {
+    Command cmd(c);
+    String m = cmd.getArgument("module").getValue();
+    String a = cmd.getArgument("action").getValue();
+    String v = cmd.getArgument("value").getValue();
+    String x = cmd.getArgument("extra").getValue();
+    String n = cmd.getArgument("num").getValue();
+    m.trim(); m.toLowerCase();
+    a.trim(); a.toLowerCase();
+    v.trim();
+    x.trim();
+    n.trim();
+
+    if (m.isEmpty() || m == "help" || m == "status") {
+        if (m == "status") slStatus();
+        else slHelp();
+        return true;
+    }
+
+    if (m == "set") {
+        String key = a;
+        key.trim(); key.toLowerCase();
+        String val = v.isEmpty() ? x : v;
+        val.trim(); val.toLowerCase();
+        if (key.isEmpty() || key == "help" || key == "status") {
+            slPrint("Usage: seclab set <key> <value> [extra]");
+            slPrint("Keys: pairmode perm hidauto oswarn hidtimeout httpport httpauto redact handoff lanauto fuzzer autoexport csa");
+            if (key == "status") { slSettings(); return true; }
+            return false;
+        }
+        if (key == "pairmode") {
+            bool jw = !(val == "mitm" || val == "baseline" || val == "off" || val == "0");
+            if (val.isEmpty() || val == "toggle") jw = !bruceConfig.seclabPlus.blePairAuditJustWorks;
+            bruceConfig.seclabPlus.blePairAuditJustWorks = jw;
+        } else if (key == "perm") {
+            bruceConfig.seclabPlus.badUsbPermissionCheck = val.isEmpty() ? !bruceConfig.seclabPlus.badUsbPermissionCheck
+                                                                         : slTruth(val, bruceConfig.seclabPlus.badUsbPermissionCheck);
+        } else if (key == "hidauto") {
+            bruceConfig.seclabPlus.hidLedAutoArm = val.isEmpty() ? !bruceConfig.seclabPlus.hidLedAutoArm
+                                                                 : slTruth(val, bruceConfig.seclabPlus.hidLedAutoArm);
+        } else if (key == "oswarn") {
+            bruceConfig.seclabPlus.badUsbOsWarn = val.isEmpty() ? !bruceConfig.seclabPlus.badUsbOsWarn
+                                                                : slTruth(val, bruceConfig.seclabPlus.badUsbOsWarn);
+        } else if (key == "httpauto") {
+            bruceConfig.seclabPlus.httpInspectorAutoStart = val.isEmpty()
+                ? !bruceConfig.seclabPlus.httpInspectorAutoStart
+                : slTruth(val, bruceConfig.seclabPlus.httpInspectorAutoStart);
+        } else if (key == "redact") {
+            bruceConfig.seclabPlus.httpInspectorRedact = val.isEmpty()
+                ? !bruceConfig.seclabPlus.httpInspectorRedact
+                : slTruth(val, bruceConfig.seclabPlus.httpInspectorRedact);
+        } else if (key == "fuzzer") {
+            bruceConfig.seclabPlus.bleSafeFuzzer = val.isEmpty() ? !bruceConfig.seclabPlus.bleSafeFuzzer
+                                                                 : slTruth(val, bruceConfig.seclabPlus.bleSafeFuzzer);
+        } else if (key == "autoexport") {
+            bruceConfig.seclabPlus.pmkidAutoExport = val.isEmpty() ? !bruceConfig.seclabPlus.pmkidAutoExport
+                                                                    : slTruth(val, bruceConfig.seclabPlus.pmkidAutoExport);
+        } else if (key == "hidtimeout") {
+            int n = val.toInt();
+            if (n < 3) n = 3;
+            if (n > 300) n = 300;
+            bruceConfig.seclabPlus.hidLedTimeoutSec = (uint16_t)n;
+        } else if (key == "httpport") {
+            int n = val.toInt();
+            if (n < 1024 || n > 65535) { slPrint("Proxy port must be 1024-65535"); return false; }
+            bruceConfig.seclabPlus.httpInspectorPort = (uint16_t)n;
+        } else if (key == "csa") {
+            int ch = v.toInt();
+            int bursts = x.isEmpty() ? (int)bruceConfig.seclabPlus.csaBursts : x.toInt();
+            if (ch < 1) ch = 1;
+            if (ch > 14) ch = 14;
+            if (bursts < 1) bursts = 1;
+            if (bursts > 20) bursts = 20;
+            bruceConfig.seclabPlus.csaChannel = (uint8_t)ch;
+            bruceConfig.seclabPlus.csaBursts = (uint16_t)bursts;
+        } else if (key == "handoff") {
+            bool en = val.isEmpty() ? !bruceConfig.seclabPlus.portalNaptHandoff
+                                    : slTruth(val, bruceConfig.seclabPlus.portalNaptHandoff);
+            portalNaptSetArmed(en);
+            slPrint(String("Portal handoff ") + (en ? "ON" : "OFF"));
+            return true;
+        } else if (key == "lanauto") {
+            bool en = val.isEmpty() ? !lanGuardGetAuto() : slTruth(val, lanGuardGetAuto());
+            lanGuardSetAuto(en);
+            slPrint(String("LAN Guard auto ") + (en ? "ON" : "OFF"));
+            return true;
+        } else {
+            slPrint("Unknown settings key: " + key);
+            return false;
+        }
+        bruceConfig.validateSecLabPlus();
+        bruceConfig.saveFile();
+        slSettings();
+        return true;
+    }
+    if (m == "stopall") { slStopAll(); return true; }
+    if (m == "settings") { slSettings(); return true; }
+    if (m == "perm") {
+        String val = v.isEmpty() ? a : v;
+        val.trim(); val.toLowerCase();
+        if (val == "status" || m == "status") {
+            slPrint(String("Payload admin check: ") + (bruceConfig.seclabPlus.badUsbPermissionCheck ? "ON" : "OFF"));
+            return true;
+        }
+        bool en = (val.isEmpty() || val == "toggle") ? !bruceConfig.seclabPlus.badUsbPermissionCheck
+                                                     : slTruth(val, bruceConfig.seclabPlus.badUsbPermissionCheck);
+        bruceConfig.seclabPlus.badUsbPermissionCheck = en;
+        bruceConfig.saveFile();
+        slPrint(String("Payload admin check ") + (en ? "ON" : "OFF"));
+        return true;
+    }
+    if (m == "pairmode") {
+        String val = v.isEmpty() ? a : v;
+        val.trim(); val.toLowerCase();
+        if (val == "status") {
+            slPrint(String("Pair audit mode: ") + (bruceConfig.seclabPlus.blePairAuditJustWorks ? "JUST_WORKS" : "MITM_BASELINE"));
+            return true;
+        }
+        bool jw;
+        if (val.isEmpty() || val == "toggle") jw = !bruceConfig.seclabPlus.blePairAuditJustWorks;
+        else jw = !(val == "mitm" || val == "baseline" || val == "off" || val == "0");
+        bruceConfig.seclabPlus.blePairAuditJustWorks = jw;
+        bruceConfig.saveFile();
+        slPrint(String("Pair audit mode: ") + (jw ? "JUST_WORKS" : "MITM_BASELINE"));
+        return true;
+    }
+
+    String err;
+    if (m == "pmkid") {
+        if (a == "start") {
+            bool ok = (!v.isEmpty() && !x.isEmpty()) ? pmkidStart(v, x, (uint8_t)n.toInt(), &err) : pmkidStartStrongest(&err);
+            slResult(ok, "PMKID capture started", err);
+            return ok;
+        }
+        if (a == "stop") { pmkidStop(); slPrint("PMKID stopped"); return true; }
+        if (a == "export") { slPrint(pmkidExportHc22000() ? "Saved /pmkid/all.hc22000" : "Export failed"); return true; }
+        if (a == "clear") {
+            bool ok = pmkidClear();
+            slPrint(ok ? "PMKID cleared" : "Stop PMKID capture before clearing");
+            return ok;
+        }
+        slPrint(pmkidGetStateJson()); return true;
+    }
+
+    if (m == "csa") {
+        if (a == "start") {
+            bool ok = (!v.isEmpty() && !x.isEmpty())
+                          ? csaStart(v, x, (uint8_t)n.toInt(), (uint8_t)bruceConfig.seclabPlus.csaChannel,
+                                     (uint16_t)bruceConfig.seclabPlus.csaBursts, &err)
+                          : csaStartStrongest(&err);
+            slResult(ok, "CSA/PMF test started", err);
+            return ok;
+        }
+        if (a == "stop") { csaStop(); slPrint("CSA stopped"); return true; }
+        if (a == "clear") { csaClear(); slPrint("CSA cleared"); return true; }
+        slPrint(csaGetStateJson()); return true;
+    }
+
+    if (m == "portal") {
+        if (a == "start") { { bool ok = portalNaptStartAuto(&err); slResult(ok, "Portal -> NAPT started", err); return ok; } }
+        if (a == "stop") { portalNaptStop(); slPrint("Portal stopped"); return true; }
+        if (a == "handoff") {
+            bool en = v.isEmpty() ? !bruceConfig.seclabPlus.portalNaptHandoff : slTruth(v, true);
+            portalNaptSetArmed(en);
+            slPrint(String("Portal handoff ") + (en ? "ON" : "OFF"));
+            return true;
+        }
+        slPrint(portalNaptGetStateJson()); return true;
+    }
+
+    if (m == "lan") {
+        if (a == "start") {
+            bool deep = v.isEmpty() ? true : (v != "quick");
+            bool ok = lanAuditStart(deep, &err);
+            slResult(ok, "LAN audit started", err);
+            return ok;
+        }
+        if (a == "stop") { lanAuditStop(); slPrint("LAN audit stopped"); return true; }
+        if (a == "export") { slPrint(lanAuditExport() ? "Saved /lan_audit.json + .csv" : "Export failed"); return true; }
+        if (a == "clear") { lanAuditClear(); slPrint("LAN audit cleared"); return true; }
+        slPrint(lanAuditGetStateJson()); return true;
+    }
+
+    if (m == "responder") {
+        if (a == "start") { bool ok = responderPlusStart(&err); slResult(ok, "Responder+ started", err); return ok; }
+        if (a == "stop") { responderPlusStop(); slPrint("Responder+ stopped"); return true; }
+        if (a == "clear") { responderPlusClear(); slPrint("Responder+ hits cleared"); return true; }
+        slPrint(responderPlusGetStateJson()); return true;
+    }
+
+    if (m == "guard") {
+        if (a == "start") { bool ok = lanGuardStart(&err); slResult(ok, "LAN Guard started", err); return ok; }
+        if (a == "stop") { lanGuardStop(); slPrint("LAN Guard stopped"); return true; }
+        if (a == "clear") { lanGuardClear(); slPrint("LAN Guard cleared"); return true; }
+        if (a == "auto") {
+            bool en = v.isEmpty() ? !lanGuardGetAuto() : slTruth(v, true);
+            lanGuardSetAuto(en);
+            slPrint(String("LAN Guard auto ") + (en ? "ON" : "OFF"));
+            return true;
+        }
+        slPrint(lanGuardGetStateJson()); return true;
+    }
+
+    if (m == "http") {
+        if (a == "start") {
+            uint16_t p = n.toInt() ? (uint16_t)n.toInt() : (uint16_t)0;
+            bool ok = naptHttpInspectorStart(p, &err);
+            slResult(ok, "HTTP inspector started", err);
+            return ok;
+        }
+        if (a == "stop") { naptHttpInspectorStop(); slPrint("HTTP inspector stopped"); return true; }
+        if (a == "export") { slPrint(naptHttpInspectorExport() ? "Saved /napt_http_findings.json" : "Export failed"); return true; }
+        if (a == "clear") { naptHttpInspectorClear(); slPrint("HTTP findings cleared"); return true; }
+        if (a == "auto" || a == "redact") {
+            bool *flag = (a == "auto") ? &bruceConfig.seclabPlus.httpInspectorAutoStart
+                                       : &bruceConfig.seclabPlus.httpInspectorRedact;
+            *flag = v.isEmpty() ? !(*flag) : slTruth(v, *flag);
+            bruceConfig.saveFile();
+            slPrint(String(a == "auto" ? "HTTP auto-start " : "HTTP redaction ") + (*flag ? "ON" : "OFF"));
+            return true;
+        }
+        slPrint(naptHttpInspectorGetStateJson()); return true;
+    }
+
+    if (m == "os") {
+        String p = v.isEmpty() ? a : v;
+        p.toLowerCase();
+        BadUsbOsProfile prof = p.startsWith("mac") ? BADUSB_OS_MACOS :
+                               (p.startsWith("lin") ? BADUSB_OS_LINUX : BADUSB_OS_WINDOWS);
+        smartBadUsbSetOsProfile(prof);
+        slPrint("OS profile: " + smartBadUsbProfileName(prof));
+        return true;
+    }
+
+    if (m == "led") {
+        if (a == "start") { bool ok = smartBadUsbStartLedLink(0, &err); slResult(ok, "LED Link armed", err); return ok; }
+        if (a == "stop") { smartBadUsbStopLedLink(); slPrint("LED Link stopped"); return true; }
+        if (a == "export") { slPrint(smartBadUsbExportLedLink() ? "Saved /led_link/export.json" : "Export failed"); return true; }
+        if (a == "clear") { smartBadUsbClearLedLink(); slPrint("LED Link cleared"); return true; }
+        if (a == "generate") {
+            String p = v.isEmpty() ? a : v;
+            p.toLowerCase();
+            BadUsbOsProfile prof = p.startsWith("mac") ? BADUSB_OS_MACOS :
+                                   (p.startsWith("lin") ? BADUSB_OS_LINUX : BADUSB_OS_WINDOWS);
+            String path;
+            bool ok = smartBadUsbGeneratePayload(prof, bruceConfig.seclabPlus.badUsbPermissionCheck, &path, &err);
+            slResult(ok, "Payload saved: " + path, err);
+            return ok;
+        }
+        slPrint(smartBadUsbGetLedLinkStateJson()); return true;
+    }
+
+    if (m == "ble") {
+        if (a == "tag_start" || a == "tag") {
+            uint32_t sec = n.toInt() ? (uint32_t)n.toInt() : 60;
+            if (sec < 5) sec = 5;
+            if (sec > 300) sec = 300;
+            bool ok = bleTagBeaconStart(sec, &err);
+            slResult(ok, String("Tag verification beacon started (") + sec + "s)", err);
+            return ok;
+        }
+        if (a == "tag_stop") { bleTagBeaconStop(); slPrint("Tag beacon stopped"); return true; }
+        if (a == "pair") {
+            if (v.isEmpty()) {
+                slPrint("Usage: seclab ble pair AA:BB:CC:DD:EE:FF [type] [justworks|mitm]");
+                return false;
+            }
+            uint8_t mac[6] = {0};
+            if (!seclabParseMac(v, mac)) { slPrint("Invalid BLE MAC. Use AA:BB:CC:DD:EE:FF"); return false; }
+            String canonical = seclabMacColon(mac);
+            String mode = n;
+            mode.trim(); mode.toLowerCase();
+            bool jw = mode.isEmpty() ? bruceConfig.seclabPlus.blePairAuditJustWorks
+                                     : !(mode == "mitm" || mode == "baseline" || mode == "0" || mode == "off");
+            bruceConfig.seclabPlus.blePairAuditJustWorks = jw;
+            bruceConfig.saveFile();
+            bool ok = blePairingAuditStartAsync(canonical, (uint8_t)x.toInt(), jw, &err);
+            slResult(ok, String("Pairing audit queued (") + (jw ? "Just Works" : "MITM baseline") + ")", err);
+            return ok;
+        }
+        if (a == "fuzzer") {
+            bool en = v.isEmpty() ? !bruceConfig.seclabPlus.bleSafeFuzzer : slTruth(v, true);
+            bruceConfig.seclabPlus.bleSafeFuzzer = en;
+            bruceConfig.saveFile();
+            slPrint(String("BLE Boundary writes ") + (en ? "ON" : "OFF"));
+            return true;
+        }
+        if (a == "clear") { bleSecurityAuditClear(); slPrint("BLE reports cleared"); return true; }
+        slPrint("AUDIT: " + bleSecurityAuditGetStateJson());
+        slPrint("PAIR: " + blePairingAuditGetStateJson());
+        slPrint("TAG: " + bleTagBeaconGetStateJson());
+        return true;
+    }
+
+    slHelp();
+    return false;
+}
+
+#else  // LITE_VERSION
+
+uint32_t seclabCallback(cmd *) {
+    serialDevice->println("SecLab+ is not available on LITE build");
+    return false;
+}
+
+#endif
+
+void createSecLabCommands(SimpleCLI *cli) {
+    Command c = cli->addCommand("seclab", seclabCallback);
+    c.addPosArg("module", "status");
+    c.addPosArg("action", "status");
+    c.addPosArg("value", "");
+    c.addPosArg("extra", "");
+    c.addPosArg("num", "");
+}
