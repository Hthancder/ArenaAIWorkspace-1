index 00000000..147cd1fe
--- /dev/null
+++ b/src/core/tftLogger/legacy_text_packet.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+// Older serial display clients know DRAWSTRING (16), not the datum extension
+// (22). Keep their framing intact; only the WebUI gets the alignment byte.
+inline size_t legacyTextPacket(const uint8_t *input, size_t size, uint8_t *output) {
+    if (!input || !output || size < 14 || input[0] != 0xAA || input[1] != size || input[2] != 22)
+        return 0;
+    std::memcpy(output, input, 13);
+    output[1] = static_cast<uint8_t>(size - 1);
+    output[2] = 16;
+    std::memcpy(output + 13, input + 14, size - 14);
+    return size - 1;
+}
