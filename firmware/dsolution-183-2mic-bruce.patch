+static const FeatureEntry *findFeatureEntry(const String &label, const String &context) {
+    // 1. Exact or prefix match on itemLabel first
+    for (const auto &e : kFeatureEntries) {
+        if (label.equalsIgnoreCase(e.match)) return &e;
+    }
+    for (const auto &e : kFeatureEntries) {
+        String m(e.match);
+        if (label.startsWith(m) || (m.length() >= 4 && label.indexOf(m) == 0)) return &e;
+    }
+    // 2. Fallback to menuContext (e.g. parent submenu title)
+    if (context.length() > 0) {
+        for (const auto &e : kFeatureEntries) {
+            if (context.equalsIgnoreCase(e.match) || context.indexOf(e.match) >= 0) return &e;
+        }
+    }
+    return nullptr;
+}
+
+enum GuideLineType : uint8_t {
+    GL_EMPTY = 0,
+    GL_SECTION,
+    GL_BULLET,
+    GL_TEXT
+};
+
+struct GuideLine {
+    GuideLineType type;
+    String text;
+    String prefix; // bullet/number prefix on first line of item
+};
+
+static std::vector<GuideLine> buildWrappedLines(const String &rawBody, int maxChars) {
+    std::vector<GuideLine> out;
+    int start = 0;
+    const int len = rawBody.length();
+
+    while (start <= len) {
+        int nl = rawBody.indexOf('\n', start);
+        if (nl < 0) nl = len;
+        String line = rawBody.substring(start, nl);
+        line.trim();
+        start = nl + 1;
+
+        if (line.length() == 0) {
+            if (!out.empty() && out.back().type != GL_EMPTY) { out.push_back({GL_EMPTY, "", ""}); }
+            continue;
+        }
+
+        if (line.startsWith("# ")) {
+            if (!out.empty() && out.back().type != GL_EMPTY) { out.push_back({GL_EMPTY, "", ""}); }
+            out.push_back({GL_SECTION, line.substring(2), ""});
+            continue;
+        }
+
+        bool isBullet = false;
+        String pfx = "";
+        String content = line;
+
+        if (line.startsWith("- ")) {
+            isBullet = true;
+            pfx = "*";
+            content = line.substring(2);
+        } else if (line.length() >= 3 && isdigit(line[0]) && line[1] == '.' && line[2] == ' ') {
+            isBullet = true;
+            pfx = line.substring(0, 2);
+            content = line.substring(3);
+        }
+
+        int wrapWidth = isBullet ? max(12, maxChars - 3) : maxChars;
+        std::vector<String> wrapped = wrapText(content, wrapWidth);
+        if (wrapped.empty()) wrapped.push_back("");
+
+        for (size_t i = 0; i < wrapped.size(); i++) {
+            GuideLine gl;
+            gl.type = isBullet ? GL_BULLET : GL_TEXT;
+            gl.text = wrapped[i];
+            gl.prefix = (isBullet && i == 0) ? pfx : "";
+            out.push_back(gl);
+        }
+    }
+    return out;
+}
