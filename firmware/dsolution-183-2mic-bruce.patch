+#ifndef __RESPONDER_PLUS_H__
+#define __RESPONDER_PLUS_H__
+
+#include <Arduino.h>
+
+// 2B (part 1) — Responder+ : mDNS + LLMNR + NBNS name answers plus a WPAD
+// proxy auto-config endpoint. Complements Bruce's legacy NBNS/LLMNR Responder
+// so macOS / iOS / current Windows name-resolution fallbacks are covered too.
+void responder_plus_setup();
+
