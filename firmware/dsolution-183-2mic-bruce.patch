+
+void BruceConfig::validateMdnsHost() {
+    String src = mdnsHost;
+    src.trim();
+    src.toLowerCase();
+    if (src.endsWith(".local")) src = src.substring(0, src.length() - 6);
+    String clean;
+    clean.reserve(24);
+    for (size_t i = 0; i < src.length() && clean.length() < 24; i++) {
+        char c = src[i];
+        if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') clean += c;
+    }
+    while (clean.endsWith("-")) clean.remove(clean.length() - 1);
+    while (clean.startsWith("-")) clean.remove(0, 1);
+    if (clean.length() < 2) clean = "bruce";
+    mdnsHost = clean;
+}
