+static void formatMacStr(const uint8_t *mac, char *out, size_t outSize) {
+    snprintf(
+        out,
+        outSize,
+        "%02X:%02X:%02X:%02X:%02X:%02X",
+        mac[0],
+        mac[1],
+        mac[2],
+        mac[3],
+        mac[4],
+        mac[5]
+    );
+}
