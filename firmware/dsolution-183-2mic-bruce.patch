+namespace {
+static SemaphoreHandle_t s_capMtx = nullptr;
+static SemaphoreHandle_t s_capDoneSem = nullptr;
+static String *volatile s_capTarget = nullptr;
+
+class TeeSerialDevice : public SerialDevice {
+public:
+    TeeSerialDevice(SerialDevice *inner, String *cap) : _inner(inner), _cap(cap) {}
+
+    void appendStr(const char *s, size_t len) {
+        if (!_cap || !s || len == 0) return;
+        constexpr size_t kMaxCap = 2560;
+        if (_cap->length() >= kMaxCap) return;
+        size_t take = min(len, kMaxCap - _cap->length());
+        for (size_t i = 0; i < take; i++) (*_cap) += s[i];
+    }
+
+    size_t println(const String &s) override {
+        appendStr(s.c_str(), s.length());
+        appendStr("\n", 1);
+        return _inner ? _inner->println(s) : s.length() + 1;
+    }
+    size_t println(size_t n) override { return println(String(n)); }
+    size_t println(uint32_t n) override { return println(String(n)); }
+    size_t println() override {
+        appendStr("\n", 1);
+        return _inner ? _inner->println() : 1;
+    }
+    size_t println(int n, int format = DEC) override { return println(String(n, format)); }
+    size_t print(int n, int format = DEC) override { return print(String(n, format)); }
+    size_t print(const String &s) override {
+        appendStr(s.c_str(), s.length());
+        return _inner ? _inner->print(s) : s.length();
+    }
+    void vprintf(const char *fmt, va_list args) override {
+        char buf[256];
+        va_list copy;
+        va_copy(copy, args);
+        int n = vsnprintf(buf, sizeof(buf), fmt, copy);
+        va_end(copy);
+        if (n > 0) appendStr(buf, min((size_t)n, sizeof(buf) - 1));
+        if (_inner) _inner->vprintf(fmt, args);
+    }
+    int read() override { return _inner ? _inner->read() : -1; }
+    size_t write(uint8_t *str, size_t size) override {
+        appendStr((const char *)str, size);
+        return _inner ? _inner->write(str, size) : size;
+    }
+    void flush() override {
+        if (_inner) _inner->flush();
+    }
+    int available() override { return _inner ? _inner->available() : 0; }
+    String readStringUntil(char terminator) override {
+        return _inner ? _inner->readStringUntil(terminator) : String("");
