+namespace {
+
+constexpr const char *kStatePath = "/responder_plus_state.json";
+constexpr const char *kLogPath = "/responder_plus.log";
+constexpr int kMaxHits = 32;
+
+struct Hit {
+    uint32_t tsSec;
+    char ip[16];
+    char name[48];
+    char proto[8];
+    bool wpad;
+};
+
+static TaskHandle_t s_task = nullptr;
+static SemaphoreHandle_t s_mux = nullptr;
+static volatile bool s_running = false;
+static volatile bool s_stopReq = false;
+static std::vector<Hit> s_hits;
+static uint32_t s_mdnsHits = 0, s_llmnrHits = 0, s_nbnsHits = 0, s_wpadFetches = 0;
+static uint32_t s_startedMs = 0;
+static char s_lastErr[96] = {0};
+static bool s_wpadServer = false;
+
+static void ensureMux() {
+    if (!s_mux) s_mux = xSemaphoreCreateMutex();
+}
+
+static void setErr(const String &e) {
+    strncpy(s_lastErr, e.c_str(), sizeof(s_lastErr) - 1);
+    s_lastErr[sizeof(s_lastErr) - 1] = 0;
+}
+
+static IPAddress ourIp() {
+    if (WiFi.getMode() & WIFI_MODE_AP) {
+        IPAddress ap = WiFi.softAPIP();
+        if ((uint32_t)ap != 0) return ap;
+    }
+    if (WiFi.isConnected()) return WiFi.localIP();
+    return IPAddress(0, 0, 0, 0);
+}
+
+static void addHitLocked(const IPAddress &src, const String &name, const char *proto, bool wpad) {
+    Hit h = {};
+    h.tsSec = seclabUptimeSec();
+    strncpy(h.ip, src.toString().c_str(), sizeof(h.ip) - 1);
+    strncpy(h.name, seclabSafeText(name, 47).c_str(), sizeof(h.name) - 1);
+    strncpy(h.proto, proto, sizeof(h.proto) - 1);
+    h.wpad = wpad;
+    if (s_hits.size() >= kMaxHits) s_hits.erase(s_hits.begin());
+    s_hits.push_back(h);
+    if (strcmp(proto, "mDNS") == 0) s_mdnsHits++;
+    else if (strcmp(proto, "LLMNR") == 0) s_llmnrHits++;
+    else s_nbnsHits++;
+    String lowName = String(h.name);
+    lowName.toLowerCase();
+    bool isWpad = wpad || lowName.indexOf("wpad") >= 0;
+    if (isWpad) s_wpadFetches++;
+    seclabAppendLog(kLogPath, String(h.tsSec) + "," + h.ip + "," + h.proto + "," + h.name);
+}
+
+static void persistStateLocked() {
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"ourIp\":\"" + seclabIp(ourIp()) + "\",";
+    j += "\"mdns\":" + String((unsigned long)s_mdnsHits) + ",";
+    j += "\"llmnr\":" + String((unsigned long)s_llmnrHits) + ",";
+    j += "\"nbns\":" + String((unsigned long)s_nbnsHits) + ",";
+    j += "\"wpadHits\":" + String((unsigned long)s_wpadFetches) + ",";
+    j += "\"wpadServer\":" + String(s_wpadServer ? "true" : "false") + ",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + ",";
+    j += "\"hits\":[";
+    for (size_t i = 0; i < s_hits.size(); i++) {
+        const Hit &h = s_hits[i];
+        if (i) j += ",";
+        j += "{\"ts\":" + String((unsigned long)h.tsSec) + ",\"ip\":\"" + h.ip +
+             "\",\"name\":\"" + seclabJsonEscape(h.name) + "\",\"proto\":\"" + h.proto +
+             "\",\"wpad\":" + String(h.wpad ? "true" : "false") + "}";
+    }
+    j += "]}";
+    seclabWriteState(kStatePath, j);
+}
+
+static bool readDnsName(const uint8_t *pkt, size_t len, size_t &off, String &out) {
+    out = "";
+    size_t hops = 0;
+    while (hops++ < 12) {
+        if (off >= len) return false;
+        uint8_t n = pkt[off];
+        if ((n & 0xC0) == 0xC0) { off += 2; return !out.isEmpty(); }
+        off++;
+        if (n == 0) break;
+        if (off + n > len) return false;
+        if (!out.isEmpty()) out += ".";
+        for (size_t i = 0; i < n; i++) out += (char)pkt[off + i];
+        off += n;
+    }
+    return !out.isEmpty();
+}
+
+static size_t buildDnsAResponse(uint8_t *out, size_t cap, const uint8_t *query, size_t qlen,
+                                size_t qnameLen, uint16_t qtype, uint16_t qclass, uint16_t id,
+                                const IPAddress &ip, uint16_t flags) {
+    // out = header(12) + original question + answer(16)
+    if (cap < 12 + qlen + 16) return 0;
+    memset(out, 0, cap);
+    out[0] = (uint8_t)(id >> 8); out[1] = (uint8_t)(id & 0xFF);
+    out[2] = (uint8_t)(flags >> 8); out[3] = (uint8_t)(flags & 0xFF);
+    out[4] = 0x00; out[5] = 0x01; // QDCOUNT
+    out[6] = 0x00; out[7] = 0x01; // ANCOUNT
+    memcpy(out + 12, query, qlen);
+    size_t p = 12 + qlen;
+    out[p++] = 0xC0; out[p++] = 0x0C;       // name pointer to question
+    out[p++] = (uint8_t)(qtype >> 8); out[p++] = (uint8_t)(qtype & 0xFF);
+    out[p++] = (uint8_t)(qclass >> 8); out[p++] = (uint8_t)(qclass & 0xFF);
+    out[p++] = 0x00; out[p++] = 0x00; out[p++] = 0x00; out[p++] = 0x78; // TTL 120s
+    out[p++] = 0x00; out[p++] = 0x04;       // RDLENGTH
+    out[p++] = ip[0]; out[p++] = ip[1]; out[p++] = ip[2]; out[p++] = ip[3];
+    (void)qnameLen;
+    return p;
+}
+
+static void handleDnsQuery(WiFiUDP &udp, const uint8_t *pkt, size_t len, const IPAddress &src,
+                           uint16_t srcPort, bool multicast, const char *proto) {
+    if (len < 17) return;
+    uint16_t id = (uint16_t)((pkt[0] << 8) | pkt[1]);
+    if ((pkt[2] & 0x80) != 0) return; // response, not a query
+    size_t off = 12;
+    String name;
+    if (!readDnsName(pkt, len, off, name)) return;
+    if (off + 4 > len) return;
+    uint16_t qtype = (uint16_t)((pkt[off] << 8) | pkt[off + 1]);
+    uint16_t qclass = (uint16_t)((pkt[off + 2] << 8) | pkt[off + 3]);
+    size_t qEnd = off + 4;
+    if (qtype != 1 || qclass != 1) return; // A / IN only
+
+    IPAddress ip = ourIp();
+    if ((uint32_t)ip == 0) return;
+    uint8_t resp[256];
+    size_t n = buildDnsAResponse(resp, sizeof(resp), pkt + 12, qEnd - 12, 0, qtype, qclass, id, ip,
+                                 multicast ? 0x8400 : 0x8000);
+    if (!n) return;
+
+    if (multicast) {
+        udp.beginPacket(IPAddress(224, 0, 0, 251), 5353);
+    } else {
+        udp.beginPacket(src, srcPort);
+    }
+    udp.write(resp, n);
+    udp.endPacket();
+
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(30)) == pdTRUE) {
+        addHitLocked(src, name, proto, false);
+        persistStateLocked();
+        xSemaphoreGive(s_mux);
+    }
+}
+
+static void handleNbnsQuery(WiFiUDP &udp, const uint8_t *pkt, size_t len, const IPAddress &src,
+                            uint16_t srcPort) {
+    if (len < 50) return;
+    uint16_t id = (uint16_t)((pkt[0] << 8) | pkt[1]);
+    if ((pkt[2] & 0x80) != 0) return; // response
+    // Encoded NetBIOS name: 0x20 (length), 32 bytes, 0x00 terminator.
+    size_t nameOff = 12;
+    if (pkt[nameOff] != 0x20) return;
+    uint8_t encoded[34];
+    memcpy(encoded, pkt + nameOff, 34);
+    if (encoded[33] != 0x00) return;
+    // Decode first level for logging: 'A'..'P' nibbles.
+    String name;
+    for (int i = 0; i < 30; i += 2) {
+        uint8_t hi = (encoded[1 + i] - 'A') & 0x0F;
+        uint8_t lo = (encoded[2 + i] - 'A') & 0x0F;
+        char c = (char)((hi << 4) | lo);
+        if (c == ' ') break;
+        name += c;
+    }
+    IPAddress ip = ourIp();
+    if ((uint32_t)ip == 0) return;
+    uint8_t resp[128] = {0};
+    size_t p = 0;
+    resp[p++] = (uint8_t)(id >> 8); resp[p++] = (uint8_t)(id & 0xFF);
+    resp[p++] = 0x85; resp[p++] = 0x00;       // response, authoritative
+    resp[p++] = 0x00; resp[p++] = 0x00;       // QDCOUNT
+    resp[p++] = 0x00; resp[p++] = 0x01;       // ANCOUNT
+    memcpy(resp + p, encoded, 34); p += 34;
+    resp[p++] = 0x00; resp[p++] = 0x20;       // NB (unique name)
+    resp[p++] = 0x00; resp[p++] = 0x01;       // IN
+    resp[p++] = 0x00; resp[p++] = 0x00; resp[p++] = 0x00; resp[p++] = 0x78; // TTL
+    resp[p++] = 0x00; resp[p++] = 0x06;       // RDLENGTH
+    resp[p++] = 0x00; resp[p++] = 0x00;       // NB_FLAGS
+    resp[p++] = ip[0]; resp[p++] = ip[1]; resp[p++] = ip[2]; resp[p++] = ip[3];
+
+    udp.beginPacket(src, srcPort);
+    udp.write(resp, p);
+    udp.endPacket();
+
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(30)) == pdTRUE) {
+        addHitLocked(src, name.isEmpty() ? "NBNS" : name, "NBNS", false);
+        persistStateLocked();
+        xSemaphoreGive(s_mux);
+    }
+}
+
+static String wpadPac() {
+    IPAddress ip = ourIp();
+    String pac = "// Bruce SecLab+ WPAD test file (authorized audits only)\n";
+    pac += "function FindProxyForURL(url, host) {\n";
+    pac += "  if (isPlainHostName(host)) return \"DIRECT\";\n";
+    pac += "  return \"PROXY ";
+    pac += ip.toString() + ":" + String(bruceConfig.seclabPlus.httpInspectorPort) + "; DIRECT\";\n";
+    pac += "}\n";
+    return pac;
+}
+
+static void responderTask(void *) {
+    WiFiUDP mdns, llmnr, nbns;
+    bool mdnsOk = mdns.beginMulticast(IPAddress(224, 0, 0, 251), 5353);
+    bool llmnrOk = llmnr.beginMulticast(IPAddress(224, 0, 0, 252), 5355);
+    bool nbnsOk = nbns.begin(137);
+    WiFiServer wpad(80);
+    s_wpadServer = false;
+    if (!isWebUIActive) {
+        wpad.begin();
+        wpad.setTimeout(1);
+        s_wpadServer = true;
+    }
+    if (!mdnsOk && !llmnrOk && !nbnsOk) setErr("UDP 5353/5355/137 busy");
+
+    uint8_t pkt[512];
+    uint32_t lastState = 0;
+    while (!s_stopReq) {
+        if (mdnsOk && mdns.parsePacket() > 0) {
+            int n = mdns.read(pkt, sizeof(pkt));
+            if (n > 0) handleDnsQuery(mdns, pkt, (size_t)n, mdns.remoteIP(), mdns.remotePort(), true, "mDNS");
+        }
+        if (llmnrOk && llmnr.parsePacket() > 0) {
+            int n = llmnr.read(pkt, sizeof(pkt));
+            if (n > 0) handleDnsQuery(llmnr, pkt, (size_t)n, llmnr.remoteIP(), llmnr.remotePort(), false, "LLMNR");
+        }
+        if (nbnsOk && nbns.parsePacket() > 0) {
+            int n = nbns.read(pkt, sizeof(pkt));
+            if (n > 0) handleNbnsQuery(nbns, pkt, (size_t)n, nbns.remoteIP(), nbns.remotePort());
+        }
+        if (s_wpadServer) {
+            WiFiClient c = wpad.available();
+            if (c) {
+                String req;
+                uint32_t t0 = millis();
+                while (millis() - t0 < 120 && req.length() < 256) {
+                    if (c.available()) req += (char)c.read();
+                    else vTaskDelay(pdMS_TO_TICKS(2));
+                }
+                if (req.indexOf("/wpad.dat") >= 0) {
+                    String pac = wpadPac();
+                    c.printf("HTTP/1.1 200 OK\r\nContent-Type: application/x-ns-proxy-autoconfig\r\n"
+                             "Content-Length: %u\r\nConnection: close\r\n\r\n", (unsigned)pac.length());
+                    c.print(pac);
+                    ensureMux();
+                    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(30)) == pdTRUE) {
+                        addHitLocked(c.remoteIP(), "wpad.dat", "WPAD", true);
+                        persistStateLocked();
+                        xSemaphoreGive(s_mux);
+                    }
+                } else {
+                    c.print("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
+                }
+                c.stop();
+            }
+        }
+        // Follow the WebUI lifecycle: when the AsyncWebServer owns :80 it
+        // serves /wpad.dat; otherwise this lightweight server does.
+        if (isWebUIActive && s_wpadServer) {
+            wpad.stop();
+            s_wpadServer = false;
+        } else if (!isWebUIActive && !s_wpadServer) {
+            wpad.begin();
+            wpad.setTimeout(1);
+            s_wpadServer = true;
+        }
+
+        if (millis() - lastState > 2000) {
+            lastState = millis();
+            ensureMux();
+            if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                persistStateLocked();
+                xSemaphoreGive(s_mux);
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(12));
+    }
+    wpad.stop();
+    mdns.stop(); llmnr.stop(); nbns.stop();
+    s_wpadServer = false;
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(200)) == pdTRUE) {
+        persistStateLocked();
+        xSemaphoreGive(s_mux);
+    }
+    s_running = false;
+    s_task = nullptr;
+    vTaskDelete(NULL);
+}
+
+static bool startEngine(String *errOut) {
+    if (s_running) return true;
+    if (!WiFi.isConnected() && !(WiFi.getMode() & WIFI_MODE_AP)) {
+        if (errOut) *errOut = "Connect to Wi-Fi STA or start the AP first";
+        return false;
+    }
+    ensureMux();
+    s_lastErr[0] = 0;
+    s_startedMs = millis();
+    s_stopReq = false;
+    s_running = true;
+    if (xTaskCreatePinnedToCore(responderTask, "responder+", 5120, nullptr, 2, &s_task, 0) != pdPASS) {
+        s_running = false;
+        s_task = nullptr;
+        setErr("Responder task spawn failed");
+        if (errOut) *errOut = s_lastErr;
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+bool responderPlusStart(String *errOut) { return startEngine(errOut); }
+
+void responderPlusStop() {
+    if (!s_running) return;
+    s_stopReq = true;
+    for (int i = 0; i < 60 && s_running; i++) vTaskDelay(pdMS_TO_TICKS(25));
+}
+
+bool responderPlusIsRunning() { return s_running; }
+
+void responderPlusClear() {
+    if (s_running) return;
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(200)) == pdTRUE) {
+        s_hits.clear();
+        s_mdnsHits = s_llmnrHits = s_nbnsHits = s_wpadFetches = 0;
+        s_lastErr[0] = 0;
+        persistStateLocked();
+        xSemaphoreGive(s_mux);
+    }
+    LittleFS.remove(kLogPath);
+}
+
+String responderPlusGetStateJson() {
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(100)) != pdTRUE) return seclabReadState(kStatePath);
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"ourIp\":\"" + seclabIp(ourIp()) + "\",";
+    j += "\"mdns\":" + String((unsigned long)s_mdnsHits) + ",";
+    j += "\"llmnr\":" + String((unsigned long)s_llmnrHits) + ",";
+    j += "\"nbns\":" + String((unsigned long)s_nbnsHits) + ",";
+    j += "\"wpadHits\":" + String((unsigned long)s_wpadFetches) + ",";
+    j += "\"wpadServer\":" + String(s_wpadServer ? "true" : "false") + ",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + ",";
+    j += "\"hits\":[";
+    for (size_t i = 0; i < s_hits.size(); i++) {
+        const Hit &h = s_hits[i];
+        if (i) j += ",";
+        j += "{\"ts\":" + String((unsigned long)h.tsSec) + ",\"ip\":\"" + h.ip +
+             "\",\"name\":\"" + seclabJsonEscape(h.name) + "\",\"proto\":\"" + h.proto +
+             "\",\"wpad\":" + String(h.wpad ? "true" : "false") + "}";
+    }
+    j += "]}";
+    xSemaphoreGive(s_mux);
+    return j;
+}
+
+void responder_plus_setup() {
+    if (!WiFi.isConnected() && !(WiFi.getMode() & WIFI_MODE_AP)) {
+        displayWarning("Join a network or start the AP first", true);
+        return;
+    }
+    int choice = -1;
+    options = {
+        {responderPlusIsRunning() ? "Stop Responder+" : "Start Responder+", [&]() { choice = 0; }},
+        {"View Hit Log", [&]() { choice = 1; }},
+        {"Clear Hits", [&]() { choice = 2; }},
+        {"Back", [&]() { choice = 3; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "Responder+ (mDNS/WPAD)");
+    options.clear();
+    if (choice == 0) {
+        if (responderPlusIsRunning()) responderPlusStop();
+        else {
+            String err;
+            if (!responderPlusStart(&err)) { displayError("Start failed: " + err, true); return; }
+        }
+    } else if (choice == 1) {
+        if (LittleFS.exists(kLogPath)) loopSD(LittleFS, false, "*", "/");
+        else displayInfo("No hits yet", true);
+        return;
+    } else if (choice == 2) {
+        responderPlusClear();
+        displayInfo("Hits cleared", true);
+        return;
+    } else return;
+
+    uint32_t lastDraw = 0;
+    while (s_running) {
+        if (check(EscPress)) { responderPlusStop(); break; }
+        if (millis() - lastDraw > 450) {
+            lastDraw = millis();
+            drawMainBorderWithTitle("RESPONDER+");
+            ensureMux();
+            if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                padprintln("IP        : " + ourIp().toString());
+                padprintln("mDNS / LLMNR / NBNS");
+                padprintln(String((unsigned long)s_mdnsHits) + " / " + String((unsigned long)s_llmnrHits) +
+                           " / " + String((unsigned long)s_nbnsHits));
+                padprintln("WPAD hits : " + String((unsigned long)s_wpadFetches));
+                padprintln(s_wpadServer ? "PAC: http://" + ourIp().toString() + "/wpad.dat"
+                                        : "PAC served by WebUI /wpad.dat");
+                padprintln("");
+                int shown = 0;
+                for (auto it = s_hits.rbegin(); it != s_hits.rend() && shown < 4; ++it, ++shown) {
+                    padprintln(String(it->ip) + " " + it->proto + " " + String(it->name));
+                }
+                xSemaphoreGive(s_mux);
+            }
+            padprintln("Hold Boot to stop");
+        }
+        vTaskDelay(pdMS_TO_TICKS(30));
+    }
+}
+
+#else  // LITE_VERSION
+
+void responder_plus_setup() {}
+bool responderPlusStart(String *errOut) { if (errOut) *errOut = "LITE build"; return false; }
+void responderPlusStop() {}
+bool responderPlusIsRunning() { return false; }
+void responderPlusClear() {}
+String responderPlusGetStateJson() { return "{}"; }
+
+#endif
