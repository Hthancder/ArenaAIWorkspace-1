+void ble_guard_setup() {
+    radioFreeWiFiForBle();
+    stopBLEStack();
+    vTaskDelay(pdMS_TO_TICKS(100));
+
+    if (!radioHasMemForBle()) {
+        displayError("Low DMA RAM for BLE", true);
+        return;
+    }
+
+    NimBLEDevice::init("");
+    NimBLEScan *scan = NimBLEDevice::getScan();
+    if (!scan) {
+        NimBLEDevice::deinit(true);
+        displayError("BLE scan init failed", true);
+        return;
+    }
+
+    scan->setActiveScan(false); // pure passive
+    scan->setInterval(97);
+    scan->setWindow(89);
+    scan->setDuplicateFilter(true);
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    std::vector<TrackerSighting> trackers;
+    trackers.reserve(24);
+    int scrollIdx = 0;
+    bool paused = false;
+    uint32_t sweeps = 0;
+    uint32_t lastSeenDevs = 0;
+    uint32_t peakDevs = 0;
+    uint32_t appleContCount = 0;
+    bool floodAlert = false;
+    String bannerHint = "";
+    uint32_t bannerHintUntil = 0;
+    returnToMenu = false;
+
+    while (!returnToMenu) {
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+        if (check(NextPress)) paused = !paused;
+        if (check(PrevPress)) {
+            trackers.clear();
+            scrollIdx = 0;
+            peakDevs = 0;
+            floodAlert = false;
+            bannerHint = "Cleared list";
+            bannerHintUntil = millis() + 1500;
+        }
+        if (check(UpPress) && scrollIdx > 0) scrollIdx--;
+        if (check(DownPress) && scrollIdx + 1 < (int)trackers.size()) scrollIdx++;
+        if (check(SelPress)) {
+            if (saveBleGuardReport(trackers, peakDevs, floodAlert)) {
+                bannerHint = "Saved /ble_guard.log";
+            } else {
+                bannerHint = "Save failed";
+            }
+            bannerHintUntil = millis() + 1800;
+        }
+
+        if (!paused) {
+            NimBLEScanResults results = scan->getResults(1000, false);
+            int cnt = results.getCount();
+            lastSeenDevs = (uint32_t)cnt;
+            if (lastSeenDevs > peakDevs) peakDevs = lastSeenDevs;
+            appleContCount = 0;
+            sweeps++;
+
+            for (int i = 0; i < cnt; i++) {
+                const NimBLEAdvertisedDevice *dev = results.getDevice(i);
+                if (!dev) continue;
+
+                // Track Apple Continuity packets to detect BLE spam bursts
+                if (dev->getManufacturerDataCount() > 0) {
+                    std::string md = dev->getManufacturerData(0);
+                    if (md.size() >= 3 && (uint8_t)md[0] == 0x4C && (uint8_t)md[1] == 0x00) {
+                        appleContCount++;
+                    }
+                }
+
+                const char *kind = classifyTracker(dev);
+                if (!kind) continue;
+
+                String mac = String(dev->getAddress().toString().c_str());
+                mac.toUpperCase();
+                int rssi = dev->getRSSI();
+                bool updated = false;
+                for (auto &t : trackers) {
+                    if (t.mac == mac) {
+                        t.rssi = rssi;
+                        t.hits++;
+                        t.lastSeenMs = millis();
+                        t.kind = kind;
+                        updated = true;
+                        break;
+                    }
+                }
+                if (!updated && trackers.size() < 40) {
+                    trackers.push_back({mac, String(kind), rssi, 1, millis()});
+                }
+            }
+            scan->clearResults();
+
+            floodAlert = (lastSeenDevs >= 48 || appleContCount >= 22);
+
+            std::sort(trackers.begin(), trackers.end(), [](const TrackerSighting &a, const TrackerSighting &b) {
+                if (a.rssi != b.rssi) return a.rssi > b.rssi;
+                return a.hits > b.hits;
+            });
+            if (scrollIdx >= (int)trackers.size() && scrollIdx > 0) {
+                scrollIdx = max(0, (int)trackers.size() - 1);
+            }
+        } else {
+            vTaskDelay(pdMS_TO_TICKS(50));
+        }
+
+        const uint16_t bg = bruceConfig.bgColor;
+        const uint16_t pri = bruceConfig.priColor;
+        const uint16_t sec = bruceConfig.secColor;
+        bool warn = floodAlert || !trackers.empty();
+        uint16_t accent = floodAlert ? TFT_RED : (!trackers.empty() ? TFT_YELLOW : pri);
+
+        if (hasSprite) {
+            frame.fillScreen(bg);
+            frame.drawRoundRect(3, 3, tftWidth - 6, tftHeight - 6, 6, accent);
+
+            frame.fillRoundRect(8, 8, tftWidth - 16, 24, 4, blendColors(bg, accent, warn ? 30 : 20));
+            frame.setTextDatum(ML_DATUM);
+            frame.setTextSize(1);
+            frame.setTextColor(accent, blendColors(bg, accent, warn ? 30 : 20));
+            frame.drawString(
+                floodAlert ? "BLE GUARD [SPAM BURST!]"
+                           : (paused ? "BLE GUARD [PAUSED]" : "BLE PRIVACY GUARD"),
+                14,
+                20
+            );
+            frame.setTextDatum(MR_DATUM);
+            frame.setTextColor(TFT_WHITE, blendColors(bg, accent, warn ? 30 : 20));
+            frame.drawString("Tags:" + String(trackers.size()), tftWidth - 14, 20);
+
+            frame.setTextDatum(TL_DATUM);
+            frame.setTextColor(sec, bg);
+            frame.drawString(
+                "BLE/sweep: " + String(lastSeenDevs) + " (peak " + String(peakDevs) + ")  #"+ String(sweeps),
+                12,
+                38
+            );
+
+            int listY = 54;
+            int listH = tftHeight - 82;
+            frame.drawRoundRect(8, listY, tftWidth - 16, listH, 5, blendColors(bg, pri, 65));
+
+            if (trackers.empty()) {
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, bg);
+                frame.drawString("No AirTag / SmartTag / Tile", tftWidth / 2, listY + listH / 2 - 8);
+                frame.drawString("trackers detected nearby.", tftWidth / 2, listY + listH / 2 + 8);
+            } else {
+                int rowH = 30;
+                int fit = listH / rowH;
+                for (int r = 0; r < fit && (scrollIdx + r) < (int)trackers.size(); r++) {
+                    const TrackerSighting &t = trackers[scrollIdx + r];
+                    int ry = listY + 4 + r * rowH;
+                    bool strong = (t.rssi >= -62);
+                    uint16_t rowBg = blendColors(bg, strong ? TFT_RED : pri, strong ? 28 : 14);
+                    frame.fillRoundRect(12, ry, tftWidth - 24, rowH - 3, 4, rowBg);
+                    frame.setTextDatum(TL_DATUM);
+                    frame.setTextColor(strong ? TFT_YELLOW : pri, rowBg);
+                    frame.drawString(t.kind + " (" + String(t.hits) + "x)", 17, ry + 4);
+                    frame.setTextColor(TFT_WHITE, rowBg);
+                    frame.drawString(t.mac, 17, ry + 15);
+                    frame.setTextDatum(MR_DATUM);
+                    frame.setTextColor(strong ? TFT_RED : sec, rowBg);
+                    frame.drawString(String(t.rssi) + " dBm", tftWidth - 17, ry + 13);
+                }
+            }
+
+            frame.setTextDatum(MC_DATUM);
+            if (!bannerHint.isEmpty() && (int32_t)(millis() - bannerHintUntil) < 0) {
+                frame.setTextColor(TFT_GREEN, bg);
+                frame.drawString(bannerHint, tftWidth / 2, tftHeight - 14);
+            } else {
+                frame.setTextColor(sec, bg);
+                frame.drawString("Sel:Save  Next:Pause  Prev:Clr  Esc:Exit", tftWidth / 2, tftHeight - 14);
+            }
+            frame.pushSprite(0, 0);
+        }
+        wakeUpScreen();
+    }
+
+    if (hasSprite) frame.deleteSprite();
+    scan->stop();
+    scan->clearResults();
+    stopBLEStack();
+    tft.fillScreen(bruceConfig.bgColor);
+}
