+void napt_router_setup() {
+    bool wasWebUi = isWebUiActiveOrStarting();
+    if (!s_naptRunning) {
+        if (!WiFi.isConnected()) {
+            cleanlyStopWebUiForWiFiFeature();
+            radioFreeBleForWifi();
+            String ssid, pwd;
+            if (!pickStaNetworkInteractive(ssid, pwd)) {
+                wifiDisconnect();
+                return;
+            }
+            drawMainBorderWithTitle("Travel Router");
+            padprintln("");
+            padprintln("Connecting: " + ssid);
+            padprintln("Enabling NAPT + DNS Proxy...");
+            String err;
+            if (!naptStartBackground(ssid, pwd, &err)) {
+                displayError(err.isEmpty() ? "NAPT Failed" : err, true);
+                naptStop(true);
+                return;
+            }
+        } else {
+            String err;
+            if (!naptStartBackground("", "", &err)) {
+                displayError(err.isEmpty() ? "NAPT Failed" : err, true);
+                return;
+            }
+        }
+    }
+    (void)wasWebUi;
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    int viewMode = 0; // 0 = Live DNS Feed, 1 = Clients
+    int scroll = 0;
+    uint32_t lastDraw = 0;
+    returnToMenu = false;
+
+    while (!returnToMenu) {
+        InputHandler();
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+        if (check(PrevPress)) {
+            if (scroll > 0) scroll--;
+            lastDraw = 0;
+        }
+        if (check(NextPress)) {
+            scroll++;
+            lastDraw = 0;
+        }
+        if (check(SelPress)) {
+            int act = -1;
+            options.clear();
+            options.push_back({viewMode == 0 ? "View: Connected Clients" : "View: Live DNS Feed", [&]() { act = 0; }});
+            options.push_back({String("Block Trackers: ") + (s_autoBlockTrackers ? "ON" : "OFF"), [&]() { act = 1; }});
+            options.push_back({"Run Background (keep AP)", [&]() { act = 2; }});
+            options.push_back({"Export /napt_dns.log", [&]() { act = 3; }});
+            options.push_back({"Clear DNS Feed", [&]() { act = 4; }});
+            options.push_back({"Stop Router & Exit", [&]() { act = 5; }});
+            loopOptions(options, MENU_TYPE_SUBMENU, "Travel Router Menu");
+            options.clear();
+
+            if (act == 0) {
+                viewMode = 1 - viewMode;
+                scroll = 0;
+            } else if (act == 1) {
+                s_autoBlockTrackers = !s_autoBlockTrackers;
+            } else if (act == 2) {
+                if (hasSprite) frame.deleteSprite();
+                displayInfo("NAPT running in background!\nAP: " + bruceConfig.wifiAp.ssid, true);
+                return;
+            } else if (act == 3) {
+                displayInfo(naptExportLog() ? "Saved /napt_dns.log" : "Export failed", true);
+            } else if (act == 4) {
+                naptClearLog();
+                scroll = 0;
+            } else if (act == 5) {
+                returnToMenu = true;
+                break;
+            }
+            lastDraw = 0;
+        }
+
+        if (millis() - lastDraw >= 300) {
+            lastDraw = millis();
+            std::vector<NaptClientInfo> clients = queryApClients();
+            std::vector<DnsFeedEntry> snap;
+            uint32_t tot = 0, blk = 0, trk = 0;
+            ensureNaptMutex();
+            if (xSemaphoreTake(s_naptMutex, pdMS_TO_TICKS(40)) == pdTRUE) {
+                tot = s_totalQueries;
+                blk = s_blockedQueries;
+                trk = s_trackerQueries;
+                int cnt = std::min(s_feedCount, 24);
+                for (int i = 0; i < cnt; i++) {
+                    int idx = (s_feedHead - 1 - i + kNaptLogCap) % kNaptLogCap;
+                    snap.push_back(s_feed[idx]);
+                }
+                xSemaphoreGive(s_naptMutex);
+            }
+
+            if (hasSprite) {
+                const uint16_t bg = bruceConfig.bgColor;
+                const uint16_t pri = bruceConfig.priColor;
+                const uint16_t sec = bruceConfig.secColor;
+                const uint16_t okCol = 0x2F2F;   // mint green
+                const uint16_t warnCol = 0xFD84; // amber
+                const uint16_t errCol = 0xF9CA;  // coral red
+
+                frame.fillScreen(bg);
+                frame.fillRect(0, 0, tftWidth, 24, blendColors(bg, pri, 28));
+                frame.setTextSize(1);
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(pri, blendColors(bg, pri, 28));
+                frame.drawString(viewMode == 0 ? "TRAVEL ROUTER | DNS LIVE" : "TRAVEL ROUTER | CLIENTS", 8, 12);
+                frame.setTextDatum(MR_DATUM);
+                frame.setTextColor(WiFi.isConnected() ? okCol : warnCol, blendColors(bg, pri, 28));
+                frame.drawString(String(clients.size()) + " Cli", tftWidth - 8, 12);
+
+                // Uplink + Hotspot summary bar
+                frame.fillRoundRect(6, 28, tftWidth - 12, 34, 5, blendColors(bg, pri, 12));
+                frame.drawRoundRect(6, 28, tftWidth - 12, 34, 5, blendColors(bg, pri, 50));
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(TFT_WHITE, blendColors(bg, pri, 12));
+                String upLine = "AP:" + bruceConfig.wifiAp.ssid.substring(0, 10) + " -> " +
+                                WiFi.SSID().substring(0, 13) + " (" + String(WiFi.RSSI()) + ")";
+                frame.drawString(upLine, 12, 38);
+                frame.setTextColor(sec, blendColors(bg, pri, 12));
+                String statLine = "DNS:" + String(tot) + "  Trk:" + String(trk) + "  Blk:" + String(blk) +
+                                  (s_autoBlockTrackers ? " [ADBLK]" : "");
+                frame.drawString(statLine, 12, 52);
+
+                int listY = 68;
+                int rowH = 24;
+                int maxRows = 6;
+
+                if (viewMode == 0) {
+                    int maxScroll = std::max(0, (int)snap.size() - maxRows);
+                    if (scroll > maxScroll) scroll = maxScroll;
+                    if (snap.empty()) {
+                        frame.setTextDatum(MC_DATUM);
+                        frame.setTextColor(sec, bg);
+                        frame.drawString("Join '" + bruceConfig.wifiAp.ssid + "' to browse", tftWidth / 2, 132);
+                        frame.drawString("DNS domains appear live here", tftWidth / 2, 148);
+                    } else {
+                        for (int r = 0; r < maxRows && (scroll + r) < (int)snap.size(); r++) {
+                            const DnsFeedEntry &e = snap[scroll + r];
+                            int ry = listY + r * rowH;
+                            uint16_t rowBg = (r % 2 == 0) ? blendColors(bg, pri, 8) : bg;
+                            uint16_t dotCol = e.blocked ? errCol : (e.tracker ? warnCol : okCol);
+                            frame.fillRoundRect(6, ry, tftWidth - 12, rowH - 2, 4, rowBg);
+                            frame.fillCircle(14, ry + (rowH - 2) / 2, 3, dotCol);
+
+                            // Short last octet of client IP
+                            String ipStr(e.clientIp);
+                            int dotPos = ipStr.lastIndexOf('.');
+                            String tag = (dotPos >= 0) ? ("." + ipStr.substring(dotPos + 1)) : ipStr;
+                            frame.setTextDatum(ML_DATUM);
+                            frame.setTextColor(sec, rowBg);
+                            frame.drawString(tag, 22, ry + (rowH - 2) / 2);
+
+                            String dom(e.domain);
+                            if (dom.length() > 29) dom = dom.substring(0, 27) + "..";
+                            frame.setTextColor(e.blocked ? errCol : TFT_WHITE, rowBg);
+                            frame.drawString(dom, 52, ry + (rowH - 2) / 2);
+
+                            if (e.blocked || e.tracker) {
+                                frame.setTextDatum(MR_DATUM);
+                                frame.setTextColor(dotCol, rowBg);
+                                frame.drawString(e.blocked ? "BLK" : "TRK", tftWidth - 11, ry + (rowH - 2) / 2);
+                            }
+                        }
+                    }
+                } else {
+                    int maxScroll = std::max(0, (int)clients.size() - maxRows);
+                    if (scroll > maxScroll) scroll = maxScroll;
+                    if (clients.empty()) {
+                        frame.setTextDatum(MC_DATUM);
+                        frame.setTextColor(sec, bg);
+                        frame.drawString("No devices connected yet", tftWidth / 2, 138);
+                    } else {
+                        for (int r = 0; r < maxRows && (scroll + r) < (int)clients.size(); r++) {
+                            const NaptClientInfo &c = clients[scroll + r];
+                            int ry = listY + r * rowH;
+                            uint16_t rowBg = blendColors(bg, pri, 10);
+                            frame.fillRoundRect(6, ry, tftWidth - 12, rowH - 2, 4, rowBg);
+                            frame.setTextDatum(ML_DATUM);
+                            frame.setTextColor(pri, rowBg);
+                            frame.drawString(c.ip, 12, ry + (rowH - 2) / 2);
+                            frame.setTextColor(TFT_WHITE, rowBg);
+                            frame.drawString(c.mac, 108, ry + (rowH - 2) / 2);
+                            frame.setTextDatum(MR_DATUM);
+                            frame.setTextColor(okCol, rowBg);
+                            frame.drawString(String(c.rssi) + "dB", tftWidth - 10, ry + (rowH - 2) / 2);
+                        }
+                    }
+                }
+
+                frame.fillRect(0, tftHeight - 20, tftWidth, 20, blendColors(bg, pri, 14));
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 14));
+                frame.drawString("Vol-/+:Scroll   Boot:Menu   Hold:Stop", tftWidth / 2, tftHeight - 10);
+                frame.pushSprite(0, 0);
+            }
+            wakeUpScreen();
+        }
+        vTaskDelay(pdMS_TO_TICKS(25));
+    }
+
+    if (hasSprite) frame.deleteSprite();
+    naptStop(true);
+    tft.fillScreen(bruceConfig.bgColor);
+}
