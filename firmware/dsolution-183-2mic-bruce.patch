diff --git a/src/modules/wifi/lan_guard.cpp b/src/modules/wifi/lan_guard.cpp
new file mode 100644
index 00000000..04ec986b
--- /dev/null
+++ b/src/modules/wifi/lan_guard.cpp
@@ -0,0 +1,433 @@
+#include "lan_guard.h"
+#include "lan_guard_logic.h"
+#if !defined(LITE_VERSION)
+
+#include "core/config.h"
+#include "core/display.h"
+#include "core/led_control.h"
+#include "core/mykeyboard.h"
+#include "core/seclab_util.h"
+#include "core/utils.h"
+#include <Arduino.h>
+#include <LittleFS.h>
+#include <WiFi.h>
+#include <WiFiClient.h>
+#include <WiFiUdp.h>
+#include <cstring>
+#include <esp_netif.h>
+#include <esp_wifi.h>
+#include <esp_netif_net_stack.h>
+#include <globals.h>
+#include <lwip/etharp.h>
+#include <lwip/ip4_addr.h>
+#include <lwip/tcpip.h> // LOCK_TCPIP_CORE / UNLOCK_TCPIP_CORE helpers
+#include <vector>
+
+namespace {
+
+constexpr const char *kStatePath = "/lan_guard_state.json";
+constexpr const char *kLogPath = "/lan_guard.log";
+constexpr int kMaxAlerts = 24;
+
+struct Alert {
+    uint32_t tsSec;
+    char kind[16];   // ARP_CHANGE | DHCP_MISMATCH (indicators, not proof)
+    char ip[16];
+    char mac[13];
+    char detail[64];
+};
+
+static TaskHandle_t s_task = nullptr;
+static SemaphoreHandle_t s_mux = nullptr;
+static volatile bool s_running = false;
+static volatile bool s_stopReq = false;
+static std::vector<Alert> s_alerts;
+static LanGuardGatewayBaseline s_baseline;
+static uint32_t s_arpChanges = 0, s_rogueDhcp = 0, s_dhcpSeen = 0;
+static uint32_t s_startedMs = 0;
+static uint32_t s_lastDhcpSample = 0, s_lastArpSample = 0;
+static bool s_sampledDhcp = false, s_sampledArp = false;
+static char s_lastErr[96] = {0};
+static bool s_dhcpSniffOk = false;
+static bool s_arpWatchOk = false;
+
+static void ensureMux() {
+    if (!s_mux) s_mux = xSemaphoreCreateMutex();
+}
+
+static void setErr(const String &e) {
+    strncpy(s_lastErr, e.c_str(), sizeof(s_lastErr) - 1);
+    s_lastErr[sizeof(s_lastErr) - 1] = 0;
+}
+
+// Only STA has an upstream gateway. In AP+STA mode, UDP input does not
+// identify the ingress interface, so DHCP comparisons must be disabled.
+static IPAddress staGateway() {
+    return WiFi.isConnected() ? WiFi.gatewayIP() : IPAddress(0, 0, 0, 0);
+}
+
+static void pushAlertLocked(const char *kind, const IPAddress &ip, const uint8_t mac[6],
+                            const String &detail) {
+    Alert a = {};
+    a.tsSec = seclabUptimeSec();
+    strncpy(a.kind, kind, sizeof(a.kind) - 1);
+    strncpy(a.ip, ip.toString().c_str(), sizeof(a.ip) - 1);
+    if (mac) strncpy(a.mac, seclabMacHex(mac).c_str(), sizeof(a.mac) - 1);
+    strncpy(a.detail, seclabSafeText(detail, 63).c_str(), sizeof(a.detail) - 1);
+    if (s_alerts.size() >= kMaxAlerts) s_alerts.erase(s_alerts.begin());
+    s_alerts.push_back(a);
+    seclabAppendLog(kLogPath, String(a.tsSec) + "," + a.kind + "," + a.ip + "," + a.mac + "," + a.detail);
+}
+
+static void persistStateLocked() {
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"auto\":" + String(bruceConfig.seclabPlus.lanGuardAutoArm ? "true" : "false") + ",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"dhcpSniff\":" + String(s_dhcpSniffOk ? "true" : "false") + ",";
+    j += "\"arpWatch\":" + String(s_arpWatchOk ? "true" : "false") + ",";
+    j += "\"gateway\":\"" + seclabIp(staGateway()) + "\",";
+    j += "\"gatewayMac\":\"" + (s_baseline.known() ? seclabMacColon(s_baseline.mac()) : String("--")) + "\",";
+    j += "\"arpChanges\":" + String((unsigned long)s_arpChanges) + ",";
+    // Legacy key retained for older clients; this is a heuristic mismatch,
+    // not a confirmed rogue server.
+    j += "\"rogueDhcp\":" + String((unsigned long)s_rogueDhcp) + ",";
+    j += "\"dhcpMismatch\":" + String((unsigned long)s_rogueDhcp) + ",";
+    j += "\"dhcpComparison\":\"" +
+         String(s_dhcpSniffOk && WiFi.isConnected() && !(WiFi.getMode() & WIFI_MODE_AP) && (uint32_t)staGateway() != 0
+                    ? "gateway-heuristic" : "unavailable") + "\",";
+    j += "\"dhcpCoverage\":\"best-effort\",";
+    j += "\"dhcpSeen\":" + String((unsigned long)s_dhcpSeen) + ",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + ",";
+    j += "\"alerts\":[";
+    for (size_t i = 0; i < s_alerts.size(); i++) {
+        const Alert &a = s_alerts[i];
+        if (i) j += ",";
+        j += "{\"ts\":" + String((unsigned long)a.tsSec) + ",\"kind\":\"" + a.kind +
+             "\",\"ip\":\"" + a.ip + "\",\"mac\":\"" + a.mac +
+             "\",\"detail\":\"" + seclabJsonEscape(a.detail) + "\"}";
+    }
+    j += "]}";
+    seclabWriteState(kStatePath, j);
+}
+
+static bool readArpGatewayMac(const IPAddress &gw, uint8_t out[6]) {
+    esp_netif_t *handle = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    if (!handle) return false;
+    struct netif *iface = (struct netif *)esp_netif_get_netif_impl(handle);
+    if (!iface) return false;
+    if ((uint32_t)gw == 0) return false;
+    ip4_addr_t g;
+    IP4_ADDR(&g, gw[0], gw[1], gw[2], gw[3]);
+    struct eth_addr *eth = nullptr;
+    const ip4_addr_t *ip = nullptr;
+    LOCK_TCPIP_CORE();
+    int8_t idx = etharp_find_addr(iface, &g, &eth, &ip);
+    bool ok = (idx >= 0 && eth != nullptr);
+    if (ok) memcpy(out, eth->addr, 6);
+    UNLOCK_TCPIP_CORE();
+    return ok;
+}
+
+static void parseDhcp(const uint8_t *p, size_t len) {
+    LanGuardDhcpReply reply;
+    if (!lanGuardParseDhcp(p, len, reply)) return;
+    const IPAddress serverId(reply.server[0], reply.server[1], reply.server[2], reply.server[3]);
+    const IPAddress yiaddr(reply.offered[0], reply.offered[1], reply.offered[2], reply.offered[3]);
+    const IPAddress gateway = staGateway();
+    // DHCP relays and separate DHCP servers are normal. A mismatch is only an
+    // observation for investigation, not evidence of an unauthorized server.
+    const bool comparable = WiFi.isConnected() && !(WiFi.getMode() & WIFI_MODE_AP) &&
+                            (uint32_t)gateway != 0;
+    const bool mismatch = comparable && reply.hasServer && (uint32_t)serverId != 0 && serverId != gateway;
+
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(50)) != pdTRUE) return;
+    s_dhcpSeen++;
+    if (mismatch) {
+        s_rogueDhcp++;
+        // BOOTP chaddr identifies the client, not the DHCP server. The UDP
+        // socket does not supply a sender MAC, so do not mislabel it.
+        if (lanGuardAllowSample(millis(), s_lastDhcpSample, s_sampledDhcp, 5000)) {
+            pushAlertLocked("DHCP_MISMATCH", serverId, nullptr,
+                            "server differs from gateway; offered " + yiaddr.toString());
+            persistStateLocked();
+        }
+    }
+    xSemaphoreGive(s_mux);
+}
+
+static void lanGuardTask(void *) {
+    WiFiUDP dhcp;
+    const bool boundDhcp = dhcp.begin(68);
+    ensureMux();
+    if (xSemaphoreTake(s_mux, portMAX_DELAY) == pdTRUE) {
+        s_dhcpSniffOk = boundDhcp;
+        s_arpWatchOk = false;
+        if (!boundDhcp) {
+            // On STA the lwIP DHCP client often owns :68; ARP watching can still work.
+            setErr("UDP 68 unavailable; DHCP monitoring is limited");
+        }
+        persistStateLocked();
+        xSemaphoreGive(s_mux);
+    }
+
+    uint8_t pkt[768];
+    uint32_t lastArp = 0, lastState = 0, lastProbe = 0;
+    while (!s_stopReq) {
+        if (s_dhcpSniffOk) {
+            int packetSize = dhcp.parsePacket();
+            if (packetSize > 0) {
+                const uint16_t sourcePort = dhcp.remotePort();
+                int n = dhcp.read(pkt, sizeof(pkt));
+                // Ignore oversized/truncated datagrams, and only process DHCP
+                // replies sent from the server/relay port.
+                if (packetSize <= (int)sizeof(pkt) && n == packetSize && sourcePort == 67)
+                    parseDhcp(pkt, (size_t)n);
+            }
+        }
+
+        if (millis() - lastProbe > 3000) {
+            lastProbe = millis();
+            // Force an ARP resolution of the gateway (discard port, short
+            // timeout). This is a benign TCP connect attempt, not a scan.
+            WiFiClient c;
+            IPAddress gw = staGateway();
+            if ((uint32_t)gw != 0) {
+                c.connect(gw, 9, 120);
+                c.stop();
+            }
+        }
+
+        if (millis() - lastArp > 1200) {
+            lastArp = millis();
+            IPAddress gateway = staGateway();
+            wifi_ap_record_t ap = {};
+            const bool linked = WiFi.isConnected() && (uint32_t)gateway != 0 &&
+                                esp_wifi_sta_get_ap_info(&ap) == ESP_OK;
+            const uint8_t gatewayBytes[4] = {gateway[0], gateway[1], gateway[2], gateway[3]};
+            uint8_t mac[6] = {}, previous[6] = {};
+            const bool haveMac = linked && readArpGatewayMac(gateway, mac);
+            // Do not attribute an ARP lookup to a link that changed mid-read.
+            wifi_ap_record_t current = {};
+            const bool sameLink = linked && WiFi.isConnected() && staGateway() == gateway &&
+                                  esp_wifi_sta_get_ap_info(&current) == ESP_OK &&
+                                  memcmp(ap.bssid, current.bssid, 6) == 0;
+            ensureMux();
+            if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                s_arpWatchOk = sameLink;
+                if (!sameLink) s_baseline.clear();
+                else {
+                    s_baseline.link(gatewayBytes, ap.bssid);
+                    if (haveMac && s_baseline.observe(mac, previous)) {
+                        s_arpChanges++;
+                        if (lanGuardAllowSample(millis(), s_lastArpSample, s_sampledArp, 5000)) {
+                            pushAlertLocked("ARP_CHANGE", gateway, mac,
+                                            "gateway MAC changed from " + seclabMacColon(previous));
+                            persistStateLocked();
+                        }
+                    }
+                }
+                xSemaphoreGive(s_mux);
+            }
+        }
+
+        if (millis() - lastState > 30000) {
+            lastState = millis();
+            ensureMux();
+            if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                persistStateLocked();
+                xSemaphoreGive(s_mux);
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+    dhcp.stop();
+    ensureMux();
+    if (xSemaphoreTake(s_mux, portMAX_DELAY) == pdTRUE) {
+        s_dhcpSniffOk = false;
+        s_arpWatchOk = false;
+        s_baseline.clear();
+        s_running = false;
+        persistStateLocked();
+        xSemaphoreGive(s_mux);
+    } else {
+        s_running = false;
+    }
+    // Publish task retirement only after the final state write has completed.
+    s_task = nullptr;
+    vTaskDelete(NULL);
+}
+
+static bool startEngine(String *errOut) {
+    if (s_running && !s_stopReq) return true;
+    if (s_running || s_task) {
+        if (errOut) *errOut = "LAN Guard is still stopping";
+        return false;
+    }
+    if (!WiFi.isConnected() && !(WiFi.getMode() & WIFI_MODE_AP)) {
+        if (errOut) *errOut = "Connect to Wi-Fi STA or start the AP first";
+        return false;
+    }
+    ensureMux();
+    s_lastErr[0] = 0;
+    s_baseline.clear();
+    s_startedMs = millis();
+    s_stopReq = false;
+    s_running = true;
+    if (xTaskCreatePinnedToCore(lanGuardTask, "lanGuard", 5120, nullptr, 2, &s_task, 0) != pdPASS) {
+        s_running = false;
+        s_task = nullptr;
+        setErr("LAN Guard task spawn failed");
+        if (errOut) *errOut = s_lastErr;
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+bool lanGuardStart(String *errOut) { return startEngine(errOut); }
+
+void lanGuardStop() {
+    if (!s_running) return;
+    s_stopReq = true;
+    for (int i = 0; i < 60 && s_running; i++) vTaskDelay(pdMS_TO_TICKS(25));
+}
+
+bool lanGuardIsRunning() { return s_running; }
+
+bool lanGuardGetAuto() { return bruceConfig.seclabPlus.lanGuardAutoArm; }
+
+void lanGuardSetAuto(bool enable) {
+    bruceConfig.seclabPlus.lanGuardAutoArm = enable;
+    bruceConfig.saveFile();
+    if (enable && !s_running) {
+        String err;
+        lanGuardStart(&err);
+    }
+}
+
+void lanGuardClear() {
+    if (s_running) return;
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(200)) == pdTRUE) {
+        s_alerts.clear();
+        s_arpChanges = s_rogueDhcp = s_dhcpSeen = 0;
+        s_sampledDhcp = s_sampledArp = false;
+        s_baseline.clear();
+        s_lastErr[0] = 0;
+        persistStateLocked();
+        xSemaphoreGive(s_mux);
+    }
+    LittleFS.remove(kLogPath);
+}
+
+String lanGuardGetStateJson() {
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(100)) != pdTRUE) return seclabReadState(kStatePath);
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"auto\":" + String(bruceConfig.seclabPlus.lanGuardAutoArm ? "true" : "false") + ",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"dhcpSniff\":" + String(s_dhcpSniffOk ? "true" : "false") + ",";
+    j += "\"arpWatch\":" + String(s_arpWatchOk ? "true" : "false") + ",";
+    j += "\"gateway\":\"" + seclabIp(staGateway()) + "\",";
+    j += "\"gatewayMac\":\"" + (s_baseline.known() ? seclabMacColon(s_baseline.mac()) : String("--")) + "\",";
+    j += "\"arpChanges\":" + String((unsigned long)s_arpChanges) + ",";
+    // Legacy key retained for older clients; this is a heuristic mismatch,
+    // not a confirmed rogue server.
+    j += "\"rogueDhcp\":" + String((unsigned long)s_rogueDhcp) + ",";
+    j += "\"dhcpMismatch\":" + String((unsigned long)s_rogueDhcp) + ",";
+    j += "\"dhcpComparison\":\"" +
+         String(s_dhcpSniffOk && WiFi.isConnected() && !(WiFi.getMode() & WIFI_MODE_AP) && (uint32_t)staGateway() != 0
+                    ? "gateway-heuristic" : "unavailable") + "\",";
+    j += "\"dhcpCoverage\":\"best-effort\",";
+    j += "\"dhcpSeen\":" + String((unsigned long)s_dhcpSeen) + ",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + ",";
+    j += "\"alerts\":[";
+    for (size_t i = 0; i < s_alerts.size(); i++) {
+        const Alert &a = s_alerts[i];
+        if (i) j += ",";
+        j += "{\"ts\":" + String((unsigned long)a.tsSec) + ",\"kind\":\"" + a.kind +
+             "\",\"ip\":\"" + a.ip + "\",\"mac\":\"" + a.mac +
+             "\",\"detail\":\"" + seclabJsonEscape(a.detail) + "\"}";
+    }
+    j += "]}";
+    xSemaphoreGive(s_mux);
+    return j;
+}
+
+void lan_guard_setup() {
+    if (!WiFi.isConnected() && !(WiFi.getMode() & WIFI_MODE_AP)) {
+        displayWarning("Join a network or start the AP first", true);
+        return;
+    }
+    int choice = -1;
+    options = {
+        {lanGuardIsRunning() ? "Stop LAN Guard" : "Start LAN Guard", [&]() { choice = 0; }},
+        {String("Auto-arm: ") + (lanGuardGetAuto() ? "ON" : "OFF"), [&]() { choice = 1; }},
+        {"View Alerts", [&]() { choice = 2; }},
+        {"Clear Alerts", [&]() { choice = 3; }},
+        {"Back", [&]() { choice = 4; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "LAN Blue-Team Guard");
+    options.clear();
+    if (choice == 1) {
+        lanGuardSetAuto(!lanGuardGetAuto());
+        return;
+    } else if (choice == 2) {
+        if (LittleFS.exists(kLogPath)) loopSD(LittleFS, false, "*", "/");
+        else displayInfo("No alerts yet", true);
+        return;
+    } else if (choice == 3) {
+        lanGuardClear();
+        displayInfo("Alerts cleared", true);
+        return;
+    } else if (choice != 0) return;
+
+    if (lanGuardIsRunning()) lanGuardStop();
+    else {
+        String err;
+        if (!lanGuardStart(&err)) { displayError("Start failed: " + err, true); return; }
+    }
+
+    uint32_t lastDraw = 0;
+    while (s_running) {
+        if (check(EscPress)) { lanGuardStop(); break; }
+        if (millis() - lastDraw > 500) {
+            lastDraw = millis();
+            drawMainBorderWithTitle("LAN BLUE-TEAM GUARD");
+            ensureMux();
+            if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                padprintln("Gateway : " + staGateway().toString());
+                padprintln("MAC     : " + (s_baseline.known() ? seclabMacColon(s_baseline.mac()) : String("--")));
+                padprintln("ARP changes : " + String((unsigned long)s_arpChanges));
+                padprintln("DHCP differs: " + String((unsigned long)s_rogueDhcp));
+                padprintln("DHCP replies: " + String((unsigned long)s_dhcpSeen));
+                padprintln(s_dhcpSniffOk ? "DHCP: best effort" : "DHCP: unavailable");
+                padprintln("");
+                int shown = 0;
+                for (auto it = s_alerts.rbegin(); it != s_alerts.rend() && shown < 3; ++it, ++shown) {
+                    padprintln(String(it->kind) + " " + String(it->ip));
+                }
+                xSemaphoreGive(s_mux);
+            }
+            padprintln("Hold Boot to stop");
+        }
+        vTaskDelay(pdMS_TO_TICKS(30));
+    }
+}
+
+#else  // LITE_VERSION
+
+void lan_guard_setup() {}
+bool lanGuardStart(String *errOut) { if (errOut) *errOut = "LITE build"; return false; }
+void lanGuardStop() {}
+bool lanGuardIsRunning() { return false; }
+void lanGuardClear() {}
+String lanGuardGetStateJson() { return "{}"; }
+bool lanGuardGetAuto() { return false; }
+void lanGuardSetAuto(bool) {}
+
+#endif
diff --git a/src/modules/wifi/lan_guard.h b/src/modules/wifi/lan_guard.h
