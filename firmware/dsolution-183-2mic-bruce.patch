+// ------------------------- Mouse jiggler -------------------------
+#if defined(USB_as_HID) && CONFIG_TINYUSB_HID_ENABLED
+static USBHIDMouse *s_mouse = nullptr;
+static bool s_mouseBegan = false;
+
+static bool ensureMouse(String *errOut) {
+    if (!s_mouse) s_mouse = new USBHIDMouse();
+    if (!s_mouse) { if (errOut) *errOut = "Mouse alloc failed"; return false; }
+    USB.begin();
+    uint32_t t0 = millis();
+    while (!tud_mounted() && millis() - t0 < 5000) vTaskDelay(pdMS_TO_TICKS(100));
+    if (!tud_mounted()) { if (errOut) *errOut = "USB host not connected"; return false; }
+    if (!s_mouseBegan) { s_mouse->begin(); s_mouseBegan = true; }
+    return true;
+}
+#endif
