--- /dev/null
+++ b/src/core/seclab_util.h
@@ -0,0 +1,26 @@
+#ifndef __SECLAB_UTIL_H__
+#define __SECLAB_UTIL_H__
+
+// Small, dependency-light helpers shared by every "SecLab+" module.
+// Keeping escaping / hex / state-file handling in one place makes the WebUI
+// payloads identical across WiFi, LAN, USB and BLE tools.
+
+#include <Arduino.h>
+#include <IPAddress.h>
+
+String seclabJsonEscape(const String &in);
+String seclabHex(const uint8_t *data, size_t len);
+String seclabMacHex(const uint8_t mac[6]);          // 12 hex chars, no separators
+String seclabMacColon(const uint8_t mac[6]);        // AA:BB:CC:DD:EE:FF
+bool seclabParseMac(const String &in, uint8_t out[6]);
+
+bool seclabEnsureDir(const char *path);
+bool seclabWriteState(const char *path, const String &json);
+String seclabReadState(const char *path, size_t maxBytes = 12288);
+void seclabAppendLog(const char *path, const String &line, size_t capBytes = 32768);
+
+uint32_t seclabUptimeSec();
+String seclabIp(const IPAddress &ip);
+String seclabSafeText(const String &in, size_t maxLen = 48); // strips control bytes / caps length
+
+#endif
