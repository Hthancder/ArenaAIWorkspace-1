+static bool selectBleTarget(String &addr, uint8_t &addrType, String &name) {
+    if (!ble_scan_setup() || !pBLEScan) { displayError("BLE Scan init failed", true); return false; }
+    displayTextLine("Scanning BLE (4s)...");
+    pBLEScan->clearResults();
+    BLEScanResults found = pBLEScan->getResults(4000, false);
+    std::vector<ScanTarget> targets;
+    for (int i = 0; i < found.getCount() && targets.size() < 16; i++) {
+        const NimBLEAdvertisedDevice *d = found.getDevice(i);
+        if (!d) continue;
+        ScanTarget st;
+        st.name = d->getName().c_str();
+        if (st.name.isEmpty()) st.name = "<no name>";
+        st.addr = d->getAddress().toString().c_str();
+        st.addrType = d->getAddressType();
+        st.rssi = d->getRSSI();
+        targets.push_back(st);
+    }
+    pBLEScan->stop();
+    pBLEScan->clearResults();
+    if (targets.empty()) { stopBLEStack(); displayWarning("No BLE targets found", true); return false; }
+    std::sort(targets.begin(), targets.end(), [](const ScanTarget &a, const ScanTarget &b) { return a.rssi > b.rssi; });
+    int pick = -1;
+    options.clear();
+    for (size_t i = 0; i < targets.size(); i++) {
+        String lbl = targets[i].name.substring(0, 14) + " (" + String(targets[i].rssi) + "dB)";
+        options.push_back({lbl, [&, i]() { pick = (int)i; }});
+    }
+    options.push_back({"Cancel", [&]() { pick = -1; }});
+    loopOptions(options, MENU_TYPE_SUBMENU, "Pairing Audit Target");
+    options.clear();
+    if (pick < 0 || pick >= (int)targets.size()) { stopBLEStack(); return false; }
+    addr = targets[pick].addr;
+    addrType = targets[pick].addrType;
+    name = targets[pick].name;
+    return true;
+}
+
+static bool enterBleTarget(String &addr, uint8_t &addrType, String &name) {
+    String raw = keyboard("", 17, "BLE MAC AA:BB:CC:DD:EE:FF");
+    if (raw == "\x1B" || raw.isEmpty()) return false;
+    uint8_t mac[6] = {0};
+    if (!seclabParseMac(raw, mac)) { displayError("Invalid BLE MAC", true); return false; }
+    addr = seclabMacColon(mac);
+    name = "Manual target";
+    int typeChoice = 0;
+    options = {
+        {"Public address (type 0)", [&]() { typeChoice = 0; }},
+        {"Random address (type 1)", [&]() { typeChoice = 1; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "BLE Address Type");
+    options.clear();
+    addrType = (uint8_t)typeChoice;
+    return true;
+}
+
+static bool chooseBleTarget(String &addr, uint8_t &addrType, String &name) {
+    int source = -1;
+    options = {
+        {"Scan nearby devices (4s)", [&]() { source = 0; }},
+        {"Enter MAC manually", [&]() { source = 1; }},
+        {"Cancel", [&]() { source = -1; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "Pairing Audit Target");
+    options.clear();
+    if (source == 1) return enterBleTarget(addr, addrType, name);
+    if (source == 0) return selectBleTarget(addr, addrType, name);
+    return false;
+}
+
+static uint32_t chooseBeaconDuration() {
+    uint32_t sec = 60;
+    int choice = -1;
+    options = {
+        {"30 seconds", [&]() { sec = 30; }},
+        {"60 seconds", [&]() { sec = 60; }},
+        {"120 seconds", [&]() { sec = 120; }},
+        {"Custom 5-300s", [&]() { choice = 3; }},
+        {"Cancel", [&]() { choice = -1; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "Tag Verification Duration");
+    options.clear();
+    if (choice == 3) {
+        String v = num_keyboard("60", 3, "Beacon seconds (5-300)");
+        if (v == "\x1B" || v.isEmpty()) return 0;
+        long n = v.toInt();
+        if (n < 5) n = 5;
+        if (n > 300) n = 300;
+        sec = (uint32_t)n;
+    } else if (choice == -1) return 0;
+    return sec;
+}
