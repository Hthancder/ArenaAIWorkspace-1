+void ble_security_audit_setup() {
+    int choice = -1;
+    bool justWorks = bruceConfig.seclabPlus.blePairAuditJustWorks;
+    const String modeLabel = justWorks ? String("Just Works / NoInputNoOutput") : String("MITM baseline / keyboard+display");
+    options = {
+        {"Pairing Audit (" + String(justWorks ? "Just Works" : "MITM") + ")", [&]() { choice = 0; }},
+        {"Mode: " + modeLabel + " [toggle]", [&]() { choice = 1; }},
+        {"Test Tag Verification...", [&]() { choice = 2; }},
+        {String("Boundary writes: ") + (bruceConfig.seclabPlus.bleSafeFuzzer ? "ON" : "OFF"), [&]() { choice = 3; }},
+        {"View Audit JSON", [&]() { choice = 4; }},
+        {"Clear Reports", [&]() { choice = 5; }},
+        {"Back", [&]() { choice = 6; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "BLE Security Audit+");
+    options.clear();
+
+    if (choice == 1) {
+        justWorks = !justWorks;
+        bruceConfig.seclabPlus.blePairAuditJustWorks = justWorks;
+        bruceConfig.saveFile();
+        displayInfo(String("Pair mode: ") + (justWorks ? "Just Works" : "MITM baseline"), true);
+        return;
+    }
+    if (choice == 3) {
+        bruceConfig.seclabPlus.bleSafeFuzzer = !bruceConfig.seclabPlus.bleSafeFuzzer;
+        bruceConfig.saveFile();
+        displayInfo(String("Boundary writes ") + (bruceConfig.seclabPlus.bleSafeFuzzer ? "ON" : "OFF"), true);
+        return;
+    }
+    if (choice == 4) {
+        if (LittleFS.exists(kAuditPath)) loopSD(LittleFS, false, "*", "/");
+        else displayInfo("No GATT audit yet. Use GATT Explorer -> Auto Audit.", true);
+        return;
+    }
+    if (choice == 5) { bleSecurityAuditClear(); displayInfo("BLE reports cleared", true); return; }
+    if (choice == 2) {
+        uint32_t beaconSec = chooseBeaconDuration();
+        if (!beaconSec) return;
+        displayWarning("Sanitized tracker simulation. Use a phone/Privacy Guard to verify alerts.", true);
+        String err;
+        if (!bleTagBeaconStart(beaconSec, &err)) { displayError("Beacon failed: " + err, true); return; }
+        uint32_t lastDraw = 0;
+        while (s_tagRunning) {
+            if (check(EscPress)) { bleTagBeaconStop(); break; }
+            if (millis() - lastDraw > 500) {
+                lastDraw = millis();
+                drawMainBorderWithTitle("TAG VERIFY BEACON");
+                padprintln("Pattern : " + String(s_tagCurrent));
+                padprintln("Rotations: " + String((unsigned long)s_tagRotations));
+                padprintln("Elapsed : " + String((unsigned long)((millis() - s_tagStartedMs) / 1000UL)) + " s");
+                padprintln("Limit   : " + String((unsigned long)beaconSec) + " s");
+                padprintln("");
+                padprintln("Safe dummy payload only");
+                padprintln("Hold Boot to stop");
+            }
+            vTaskDelay(pdMS_TO_TICKS(30));
+        }
+        return;
+    }
+    if (choice != 0) return;
+
+    String addr, name, err;
+    uint8_t addrType = 0;
+    if (!chooseBleTarget(addr, addrType, name)) return;
+    displayWarning(justWorks ? "Authorized target only. Testing Just Works downgrade."
+                             : "Authorized target only. Testing MITM pairing baseline.", true);
+    if (!blePairingAuditStart(addr, addrType, justWorks, &err)) {
+        displayError("Pairing audit failed: " + err, true);
+        return;
+    }
+    String state = blePairingAuditGetStateJson();
+    int vi = state.indexOf("\"verdict\":\"");
+    String verdict = vi >= 0 ? state.substring(vi + 11, state.indexOf('"', vi + 11)) : "DONE";
+    drawMainBorderWithTitle("PAIRING AUDIT");
+    padprintln("Target : " + name.substring(0, 18));
+    padprintln("Mode   : " + (justWorks ? String("Just Works") : String("MITM baseline")));
+    padprintln("Result : " + verdict);
+    padprintln("");
+    padprintln("Report: /ble_pair_audit.json");
+    vTaskDelay(pdMS_TO_TICKS(2500));
+}
