+             }                                                                               },
+            {"mDNS: " + bruceConfig.mdnsHost + ".local",
+             []() {
+                 String val = keyboard(bruceConfig.mdnsHost, 24, "mDNS Hostname (a-z, 0-9, -)");
+                 if (val.length() > 0 && val != "\x1B") { bruceConfig.setMdnsHost(val); }
+             }                                                                               },
+            {"AP SSID: " + bruceConfig.wifiAp.ssid,
+             []() {
+                 String val = keyboard(bruceConfig.wifiAp.ssid, 28, "WebUI AP SSID");
+                 if (val.length() > 0 && val != "\x1B") {
+                     bruceConfig.setWifiApCreds(val, bruceConfig.wifiAp.pwd);
+                 }
+             }                                                                               },
+            {"Preview Boot Anim", []() { boot_screen_anim(); }                               },
+            {"Back",              []() {}                                                    },
+        };
+
+        int selected = loopOptions(localOptions, MENU_TYPE_SUBMENU, "Personalize");
+
+        if (selected == -1 || selected == localOptions.size() - 1) { return; }
+    }
