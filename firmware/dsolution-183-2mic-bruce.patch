+++ b/boards/dsolution-183-2mic/NV3023_Panel.h
@@ -0,0 +1,159 @@
+// =====================================================================================
+//  boards/dsolution-183-2mic/NV3023_Panel.h
+//
+//  LovyanGFX panel class for the NewVision NV3023 1.83" IPS panel (284x240 glass in
+//  landscape, 240x320 controller RAM) used on the DSolution 1.83" 2-Mic board.
+//
+//  Identity: the retail device is the OSTB-2ST-WIFI cube ("Xingzhi cube 1.83 2mic" in
+//  the ESPHome/Chinese community). Its panel is an NV3023 -- Espressif even ships an
+//  esp_lcd_nv3023 component for it. Our earlier NV3030B label came from the vendor sheet
+//  and was wrong, which is why the first flash stayed black. The register table below was
+//  checked line by line against the init_sequence of a working ESPHome config for this
+//  exact box (RealDeco/xiaozhi-esphome, devices/Xingzhi/xingzhi-cube-1.83-2mic.yaml) and
+//  they match, so what is left of the display side is bus speed (40 MHz, see the .ini)
+//  and the MADCTL/offset pair below.
+//
+//  The NV3023 is NOT an ST7789. Its registers only accept writes after the 0xFD
+//  "unlock" pages are selected, and its power/gamma tables are its own -- driving it
+//  with an ST7789 init sequence (LovyanGFX's Panel_ST7789, TFT_eSPI's ST7789_DRIVER,
+//  Arduino_GFX's Arduino_ST7789) leaves the panel black. That is why this board ships
+//  its own panel class instead of reusing a stock one.
+//
+//  This header is pulled in from Bruce's include/DisplayDrivers_User_Setup.h (the
+//  documented extension point of the DisplayDrivers library) when the board macro
+//  DSOLUTION_183_2MIC is set, so the class exists before DisplayDrivers' LovyanGFX
+//  backend names it via -DLOVYAN_PANEL=Panel_NV3023.
+//
+//  Everything else -- pins, geometry, offsets, orientation -- is configured at runtime
+//  from DisplayConfig (the -DTFT_* flags in this board's .ini); this file only carries
+//  the part no build flag can express: the init table and the MADCTL rotation table.
+// =====================================================================================
+
+#ifndef DSOLUTION_NV3023_PANEL_H
+#define DSOLUTION_NV3023_PANEL_H
+
+#include <Arduino.h>
+#include <LovyanGFX.hpp>
+#include <lgfx/v1/panel/Panel_LCD.hpp>
+
+namespace lgfx {
+
+// MADCTL bits of the NV3023 (same layout as ST7789/NV30xx family).
+//   MY = 0x80 : mirror Y (vertical flip / 180 degree flip together with MX)
+//   MX = 0x40 : mirror X
+//   MV = 0x20 : swap X and Y (transpose)
+//   0x08      : BGR colour order instead of RGB
+struct Panel_NV3023 : public Panel_LCD {
+    Panel_NV3023() {
+        // Native (untransposed) geometry: 240 columns x 284 visible rows.
+        // The controller has 320 rows of RAM and the visible 284 are the *last* ones,
+        // i.e. the window starts at row 36 -- see the setRotation() override below for how
+        // that offset is applied in each orientation.
+        _cfg.panel_width = 240;
+        _cfg.panel_height = 284;
+        _cfg.memory_width = 240;
+        _cfg.memory_height = 320;
+
+        _cfg.dummy_read_pixel = 8;
+        _cfg.dummy_read_bits = 1;
+        _cfg.readable = false; // no MISO on this board
+    }
+
+protected:
+    // -----------------------------------------------------------------------------
+    //  Init sequence -- the vendor table, verbatim.
+    //
+    //  Encoding (LovyanGFX command_list): {cmd, arg_count | CMD_INIT_DELAY, args...,
+    //  [delay_ms]}, terminated by {0xFF, 0xFF}. CMD_INIT_DELAY is 0x80, so a delay is
+    //  written as <cmd>, 0x80, <ms>.
+    //
+    //  Deliberately absent from this table, because LovyanGFX sends them itself once
+    //  the table has run (Panel_LCD::update_madctl / setInvert):
+    //      0x3A COLMOD -> 0x55 (RGB565)    0x36 MADCTL -> getMadCtl() below
+    //      0x21 INVON  (invert=true from -DTFT_INVERTION=1)
+    // -----------------------------------------------------------------------------
+    const uint8_t *getInitCommands(uint8_t listno) const override {
+        static constexpr uint8_t list0[] = {
+            0xFD, 2, 0x06, 0x08,                   // unlock manufacturer page 1
+            0x61, 2, 0x07, 0x04,                   //
+            0x62, 3, 0x00, 0x44, 0x45,             //
+            0x63, 4, 0x41, 0x07, 0x12, 0x12,       //
+            0x64, 1, 0x37,                         //
+            0x65, 3, 0x09, 0x10, 0x21,             //
+            0x66, 3, 0x09, 0x10, 0x21,             //
+            0x67, 2, 0x20, 0x40,                   //
+            0x68, 4, 0x90, 0x4C, 0x7C, 0x66,       //
+            0xB1, 3, 0x0F, 0x02, 0x01,             //
+            0xB4, 1, 0x01,                         //
+            0xB5, 4, 0x02, 0x02, 0x0A, 0x14,       //
+            0xB6, 5, 0x04, 0x01, 0x9F, 0x00, 0x02, //
+            0xDF, 1, 0x11,                         //
+            0xE2, 6, 0x13, 0x00, 0x00, 0x30, 0x33, 0x3F, //
+            0xE5, 6, 0x3F, 0x33, 0x30, 0x00, 0x00, 0x13, //
+            0xE1, 2, 0x00, 0x57,                   //
+            0xE4, 2, 0x58, 0x00,                   //
+            0xE0, 8, 0x01, 0x03, 0x0D, 0x0E, 0x0E, 0x0C, 0x15, 0x19, //
+            0xE3, 8, 0x1A, 0x16, 0x0C, 0x0F, 0x0E, 0x0D, 0x02, 0x01, //
+            0xE6, 2, 0x00, 0xFF,                   //
+            0xE7, 6, 0x01, 0x04, 0x03, 0x03, 0x00, 0x12, //
+            0xE8, 3, 0x00, 0x70, 0x00,             //
+            0xEC, 1, 0x52,                         //
+            0xF1, 3, 0x01, 0x01, 0x02,             //
+            0xF6, 4, 0x09, 0x10, 0x00, 0x00,       //
+            0xFD, 2, 0xFA, 0xFC,                   // unlock manufacturer page 2
+            0x35, 1, 0x00,                         // TEON: tearing effect line off
+            0x11, 0x80, 200,                       // SLPOUT, wait 200 ms
+            0x29, 0x80, 10,                        // DISPON, wait 10 ms
+            0xFF, 0xFF,                            // end of table
+        };
+        switch (listno) {
+            case 0: return list0;
+            default: return nullptr;
+        }
+    }
+
+    // -----------------------------------------------------------------------------
+    //  Rotation -> MADCTL.
+    //
+    //  index: internal rotation (user rotation + TFT_ROTATION). The board boots with
+    //  -DROTATION=0 and -DTFT_ROTATION=3, so the boot orientation is index 3:
+    //
+    //      MV | MY  = 0xA0 | BGR = 0xA8
+    //
+    //  which is exactly what the working ESPHome config asks for on this panel:
+    //  transform swap_xy (MV) + mirror_y (MY), mirror_x off, color_order bgr.
+    //  The same config puts the 284-pixel window at x-offset 36 of the 320-pixel RAM
+    //  axis, which Panel_LCD derives by itself from memory_width - (panel_width + ox). The other three entries keep the usual four-step cycle, so
+    //  rotating from Config > Rotation stays correct instead of mirroring the image.
+    // -----------------------------------------------------------------------------
+    uint8_t getMadCtl(uint8_t r) const override {
+        static constexpr uint8_t madctl_table[] = {
+            0x00, // 0: no transform (portrait, 240 x 284)
+            0x60, // 1: MV | MX
+            0xC0, // 2: MX | MY (portrait, flipped)
+            0xA0, // 3: MV | MY (landscape 284 x 240 -- the board's default)
+        };
+        // Bit 3 of MADCTL selects BGR; the panel is wired BGR, so it is always set here.
+        // Keeping it here (instead of relying on -DTFT_RGB_ORDER) makes the colour order
+        // independent of how the backend maps the rgbOrder flag.
+        return madctl_table[r & 3] | 0x08;
+    }
+
+    // -----------------------------------------------------------------------------
+    //  Row offset for the portrait rotations.
+    //
+    //  The 284 visible rows are the *last* ones of the controller's 320, i.e. the window
+    //  starts at row 36. Panel_LCD lands there by itself for the transposed (MV) rotations,
+    //  because it swaps the axes and computes _colstart = memory_width - (panel_width +
+    //  offset_x) = 320 - 284 = 36. For the two portrait rotations there is no swap, and it
+    //  would leave the window at rows 0..283 instead -- visible as a 36-pixel shift.
+    // -----------------------------------------------------------------------------
+    void setRotation(uint_fast8_t r) override {
+        Panel_LCD::setRotation(r);
+        if ((_internal_rotation & 1) == 0) { _rowstart = _cfg.memory_height - (_cfg.panel_height + _cfg.offset_y); }
+    }
+};
+
+} // namespace lgfx
+
+#endif // DSOLUTION_NV3023_PANEL_H
