--- /dev/null
+++ b/src/modules/pwnagotchi/pet_layout.h
@@ -0,0 +1,15 @@
+#pragma once
+// Board-independent layout. All rectangles are inside the content region.
+struct PetLayout {
+    int left, top, width, height, phraseY, phraseWidth;
+};
+inline PetLayout petLayout(int w, int /*h*/, int header, int footer) {
+    const int margin = 8;
+    int availableW = w - 2 * margin;
+    int availableH = footer - header - 48;
+    int size = availableW < availableH ? availableW : availableH;
+    if (size > 136) size = 136;
+    if (size < 20) size = 20;
+    return {(w - size) / 2, header + 5, size, size,
+            footer - 20, availableW};
+}
