+
+extern "C" bool tud_mounted(void);
+
+namespace {
+
+constexpr uint16_t kSecSize = 512;
+constexpr const char *kVaultDir = "/usb_vault";
+constexpr const char *kFlashImgPath = "/usb_disk.img";
+
+enum VmscStorageMode {
+    VMSC_RAM_2M = 0,       // 2.2 MB temporary FAT16 in PSRAM
+    VMSC_FLASH_128K = 1,   // 128 KB persistent FAT12 in /usb_disk.img (fits Dual-Boot 256KB brucefs)
+    VMSC_FLASH_512K = 2,   // 512 KB persistent FAT12 in /usb_disk.img
+    VMSC_FLASH_1M = 3      // 1.0 MB persistent FAT12 in /usb_disk.img
+};
+
+struct FatGeom {
+    uint32_t totalSectors;
+    uint16_t fatSectors;
+    uint16_t rootEntries;
+    uint16_t reservedSectors;
+    uint8_t numFats;
+    uint8_t secPerClus;
+    bool isFat16;
+    uint32_t fatStartSec;
+    uint32_t rootStartSec;
+    uint32_t rootSectors;
+    uint32_t dataStartSec;
+    uint32_t totalClusters;
+};
+
+static USBMSC s_msc;
+static bool s_mscInited = false;
+#ifdef USB_as_HID
+static USBHIDKeyboard s_vmscKbd;
+static bool s_vmscKbdBegan = false;
+#endif
+static SemaphoreHandle_t s_diskMux = nullptr;
+
+static uint8_t *s_diskMem = nullptr;
+static uint32_t s_diskBytes = 0;
+static uint32_t s_diskSectors = 0;
+static uint8_t *s_dirtyMap = nullptr; // 1 bit per 512B sector when backed by /usb_disk.img
+static bool s_backedByFlash = false;
+static volatile bool s_dirtyAny = false;
+static volatile uint32_t s_lastWriteMs = 0;
+static volatile uint32_t s_rxBytes = 0;
+static volatile uint32_t s_txBytes = 0;
+static volatile bool s_ejectRequested = false;
+static volatile int32_t s_usbEventState = -1;
+static bool s_usbEventHooked = false;
+
+static void ensureDiskMux() {
+    if (!s_diskMux) s_diskMux = xSemaphoreCreateMutex();
+}
+
+static FatGeom computeFatGeom(VmscStorageMode mode) {
+    FatGeom g = {};
+    g.reservedSectors = 1;
+    g.numFats = 2;
+    g.secPerClus = 1;
+    if (mode == VMSC_RAM_2M) {
+        // 4400 * 512 = 2,252,800 B -> >= 4085 clusters -> strict Microsoft FAT16
+        g.totalSectors = 4400;
+        g.fatSectors = 18;
+        g.rootEntries = 512;
+        g.isFat16 = true;
+    } else if (mode == VMSC_FLASH_1M) {
+        // 2048 * 512 = 1,048,576 B -> FAT12
+        g.totalSectors = 2048;
+        g.fatSectors = 6;
+        g.rootEntries = 224;
+        g.isFat16 = false;
+    } else if (mode == VMSC_FLASH_512K) {
+        // 1024 * 512 = 524,288 B -> FAT12
+        g.totalSectors = 1024;
+        g.fatSectors = 3;
+        g.rootEntries = 128;
+        g.isFat16 = false;
+    } else {
+        // 256 * 512 = 131,072 B (128 KB) -> FAT12, fits inside Dual-Boot 256KB brucefs
+        g.totalSectors = 256;
+        g.fatSectors = 2;
+        g.rootEntries = 64;
+        g.isFat16 = false;
+    }
+    g.fatStartSec = g.reservedSectors;
+    g.rootStartSec = g.fatStartSec + (uint32_t)g.numFats * g.fatSectors;
+    g.rootSectors = ((uint32_t)g.rootEntries * 32U + (kSecSize - 1)) / kSecSize;
+    g.dataStartSec = g.rootStartSec + g.rootSectors;
+    g.totalClusters = (g.totalSectors - g.dataStartSec) / g.secPerClus;
+    return g;
+}
+
+static inline void wr16(uint8_t *p, uint16_t v) {
+    p[0] = (uint8_t)(v & 0xFF);
+    p[1] = (uint8_t)((v >> 8) & 0xFF);
+}
+static inline void wr32(uint8_t *p, uint32_t v) {
+    p[0] = (uint8_t)(v & 0xFF);
+    p[1] = (uint8_t)((v >> 8) & 0xFF);
+    p[2] = (uint8_t)((v >> 16) & 0xFF);
+    p[3] = (uint8_t)((v >> 24) & 0xFF);
+}
+static inline uint16_t rd16(const uint8_t *p) { return (uint16_t)p[0] | ((uint16_t)p[1] << 8); }
+static inline uint32_t rd32(const uint8_t *p) {
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static void fatSetCluster(uint8_t *fatBase, uint32_t clus, uint16_t val, bool isFat16) {
+    if (isFat16) {
+        wr16(fatBase + clus * 2, val);
+    } else {
+        uint32_t off = clus + (clus / 2);
+        if (clus & 1) {
+            fatBase[off] = (uint8_t)((fatBase[off] & 0x0F) | ((val & 0x0F) << 4));
+            fatBase[off + 1] = (uint8_t)((val >> 4) & 0xFF);
+        } else {
+            fatBase[off] = (uint8_t)(val & 0xFF);
+            fatBase[off + 1] = (uint8_t)((fatBase[off + 1] & 0xF0) | ((val >> 8) & 0x0F));
+        }
+    }
+}
+
+static uint16_t fatGetCluster(const uint8_t *fatBase, uint32_t clus, bool isFat16) {
+    if (isFat16) return rd16(fatBase + clus * 2);
+    uint32_t off = clus + (clus / 2);
+    uint16_t pair = (uint16_t)fatBase[off] | ((uint16_t)fatBase[off + 1] << 8);
+    return (clus & 1) ? (uint16_t)(pair >> 4) : (uint16_t)(pair & 0x0FFF);
+}
+
+static bool fatIsEof(uint16_t val, bool isFat16) {
+    return isFat16 ? (val >= 0xFFF8) : (val >= 0x0FF8);
+}
+
+static uint16_t fatEofVal(bool isFat16) { return isFat16 ? 0xFFFF : 0x0FFF; }
+
+static void formatDiskMemory(uint8_t *mem, const FatGeom &g, const char *volLabel) {
+    memset(mem, 0, g.totalSectors * kSecSize);
+    uint8_t *bs = mem;
+    bs[0] = 0xEB;
+    bs[1] = 0x3C;
+    bs[2] = 0x90;
+    memcpy(bs + 3, "MSDOS5.0", 8);
+    wr16(bs + 11, kSecSize);
+    bs[13] = g.secPerClus;
+    wr16(bs + 14, g.reservedSectors);
+    bs[16] = g.numFats;
+    wr16(bs + 17, g.rootEntries);
+    wr16(bs + 19, (uint16_t)g.totalSectors);
+    bs[21] = 0xF8;
+    wr16(bs + 22, g.fatSectors);
+    wr16(bs + 24, 32); // sectors/track
+    wr16(bs + 26, 64); // heads
+    bs[36] = 0x80;
+    bs[38] = 0x29;
+    wr32(bs + 39, 0x42525543UL); // 'BRUC'
+    char lbl[12];
+    memset(lbl, ' ', 11);
+    for (int i = 0; i < 11 && volLabel[i]; i++) lbl[i] = (char)toupper((unsigned char)volLabel[i]);
+    memcpy(bs + 43, lbl, 11);
+    memcpy(bs + 54, g.isFat16 ? "FAT16   " : "FAT12   ", 8);
+    bs[510] = 0x55;
+    bs[511] = 0xAA;
+
+    // Initialize both FAT copies
+    for (uint8_t f = 0; f < g.numFats; f++) {
+        uint8_t *fat = mem + (g.fatStartSec + f * g.fatSectors) * kSecSize;
+        fatSetCluster(fat, 0, g.isFat16 ? 0xFFF8 : 0x0FF8, g.isFat16);
+        fatSetCluster(fat, 1, fatEofVal(g.isFat16), g.isFat16);
+    }
+
+    // Volume label entry in root dir
+    uint8_t *root = mem + g.rootStartSec * kSecSize;
+    memcpy(root, lbl, 11);
+    root[11] = 0x08; // ATTR_VOLUME_ID
+}
+
+static bool parseFatGeomFromMemory(const uint8_t *mem, uint32_t memBytes, FatGeom &g) {
+    if (!mem || memBytes < 512) return false;
+    if (mem[510] != 0x55 || mem[511] != 0xAA) return false;
+    uint16_t bps = rd16(mem + 11);
+    if (bps != kSecSize) return false;
+    g.secPerClus = mem[13];
+    g.reservedSectors = rd16(mem + 14);
+    g.numFats = mem[16];
+    g.rootEntries = rd16(mem + 17);
+    uint16_t tot16 = rd16(mem + 19);
+    uint32_t tot32 = rd32(mem + 32);
+    g.totalSectors = tot16 ? tot16 : tot32;
+    g.fatSectors = rd16(mem + 22);
+    if (g.secPerClus == 0 || g.numFats == 0 || g.fatSectors == 0 ||
+        g.totalSectors * kSecSize > memBytes) {
+        return false;
+    }
+    g.fatStartSec = g.reservedSectors;
+    g.rootStartSec = g.fatStartSec + (uint32_t)g.numFats * g.fatSectors;
+    g.rootSectors = ((uint32_t)g.rootEntries * 32U + (kSecSize - 1)) / kSecSize;
+    g.dataStartSec = g.rootStartSec + g.rootSectors;
+    if (g.dataStartSec >= g.totalSectors) return false;
+    g.totalClusters = (g.totalSectors - g.dataStartSec) / g.secPerClus;
+    g.isFat16 = (g.totalClusters >= 4085);
+    return true;
+}
+
+static uint8_t lfnChecksum(const uint8_t shortName11[11]) {
+    uint8_t sum = 0;
+    for (int i = 0; i < 11; i++) sum = (uint8_t)(((sum & 1) ? 0x80 : 0) + (sum >> 1) + shortName11[i]);
+    return sum;
+}
+
+static void makeShortName83(const String &fname, int seqHint, uint8_t out11[11]) {
+    memset(out11, ' ', 11);
+    int dot = fname.lastIndexOf('.');
+    String base = (dot > 0) ? fname.substring(0, dot) : fname;
+    String ext = (dot > 0 && dot + 1 < (int)fname.length()) ? fname.substring(dot + 1) : "";
+
+    auto cleanChar = [](char c) -> char {
+        c = (char)toupper((unsigned char)c);
+        if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '$') return c;
+        return '_';
+    };
+
+    String bClean;
+    for (size_t i = 0; i < base.length() && bClean.length() < 8; i++) {
+        if (base[i] != ' ' && base[i] != '.') bClean += cleanChar(base[i]);
+    }
+    if (bClean.isEmpty()) bClean = "FILE";
+    if (fname.length() > 12 || dot != fname.indexOf('.') || base.length() > 8 || ext.length() > 3) {
+        char suf[6];
+        snprintf(suf, sizeof(suf), "~%d", (seqHint % 99) + 1);
+        int keep = std::max(1, 8 - (int)strlen(suf));
+        bClean = bClean.substring(0, keep) + suf;
+    }
+    for (size_t i = 0; i < bClean.length() && i < 8; i++) out11[i] = (uint8_t)bClean[i];
+
+    int ei = 0;
+    for (size_t i = 0; i < ext.length() && ei < 3; i++) {
+        if (ext[i] != ' ') out11[8 + ei++] = (uint8_t)cleanChar(ext[i]);
+    }
+}
+
+static bool writeLfnEntries(
+    uint8_t *root, uint16_t maxEntries, uint16_t &cursor, const String &name, const uint8_t short11[11]
+) {
+    // Check if strict ASCII 8.3 uppercase matches cleanly -> no LFN needed
+    bool needsLfn = false;
+    if (name.length() > 12) needsLfn = true;
+    for (size_t i = 0; i < name.length(); i++) {
+        char c = name[i];
+        if ((c >= 'a' && c <= 'z') || c == ' ') {
+            needsLfn = true;
+            break;
+        }
+    }
+    if (!needsLfn) return true;
+
+    size_t nlen = std::min<size_t>(name.length(), 130);
+    int nSlots = (int)((nlen + 12) / 13);
+    if (cursor + nSlots >= maxEntries) return false;
+
+    uint8_t cksum = lfnChecksum(short11);
+    for (int s = nSlots; s >= 1; s--) {
+        uint8_t *ent = root + (cursor++) * 32;
+        memset(ent, 0xFF, 32);
+        ent[0] = (uint8_t)((s == nSlots ? 0x40 : 0x00) | s);
+        ent[11] = 0x0F; // ATTR_LONG_NAME
+        ent[12] = 0x00;
+        ent[13] = cksum;
+        ent[26] = 0x00;
+        ent[27] = 0x00;
+        static const uint8_t charOffs[13] = {1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30};
+        size_t baseIdx = (size_t)(s - 1) * 13;
+        for (int k = 0; k < 13; k++) {
+            size_t ci = baseIdx + k;
+            uint16_t u16 = 0xFFFF;
+            if (ci < nlen) u16 = (uint8_t)name[ci];
+            else if (ci == nlen) u16 = 0x0000;
+            ent[charOffs[k]] = (uint8_t)(u16 & 0xFF);
+            ent[charOffs[k] + 1] = (uint8_t)(u16 >> 8);
+        }
+    }
+    return true;
+}
+
+static int importVaultToDiskMemory(uint8_t *mem, const FatGeom &g) {
+    if (!LittleFS.exists(kVaultDir)) LittleFS.mkdir(kVaultDir);
+    File dir = LittleFS.open(kVaultDir);
+    if (!dir) return 0;
+
+    uint8_t *fat0 = mem + g.fatStartSec * kSecSize;
+    uint8_t *fat1 = mem + (g.fatStartSec + g.fatSectors) * kSecSize;
+    uint8_t *root = mem + g.rootStartSec * kSecSize;
+    uint32_t clusBytes = (uint32_t)g.secPerClus * kSecSize;
+
+    // Find first free root slot & free cluster
+    uint16_t rootIdx = 0;
+    while (rootIdx < g.rootEntries && root[rootIdx * 32] != 0x00) rootIdx++;
+
+    uint32_t nextClus = 2;
+    auto allocCluster = [&]() -> uint32_t {
+        while (nextClus < g.totalClusters + 2) {
+            if (fatGetCluster(fat0, nextClus, g.isFat16) == 0) {
+                fatSetCluster(fat0, nextClus, fatEofVal(g.isFat16), g.isFat16);
+                return nextClus++;
+            }
+            nextClus++;
+        }
+        return 0;
+    };
+
+    int imported = 0;
+    int seqHint = 1;
+    while (true) {
+        bool isDir = false;
+        String fpath = dir.getNextFileName(&isDir);
+        if (fpath.isEmpty()) break;
+        if (isDir) continue;
+        String name = fpath.substring(fpath.lastIndexOf('/') + 1);
+        if (name.isEmpty() || name.startsWith(".")) continue;
+
+        File src = LittleFS.open(fpath, FILE_READ);
+        if (!src) continue;
+        uint32_t fsize = (uint32_t)src.size();
+
+        uint8_t short11[11];
+        makeShortName83(name, seqHint++, short11);
+
+        // Check duplicate short name in root & overwrite or skip
+        if (rootIdx + 12 >= g.rootEntries) {
+            src.close();
+            break;
+        }
+
+        uint32_t firstClus = 0;
+        uint32_t prevClus = 0;
+        uint32_t remaining = fsize;
+        bool diskFull = false;
+
+        while (remaining > 0) {
+            uint32_t c = allocCluster();
+            if (c == 0) {
+                diskFull = true;
+                break;
+            }
+            if (firstClus == 0) firstClus = c;
+            if (prevClus != 0) fatSetCluster(fat0, prevClus, (uint16_t)c, g.isFat16);
+            prevClus = c;
+
+            uint8_t *dst = mem + (g.dataStartSec + (c - 2) * g.secPerClus) * kSecSize;
+            uint32_t toRead = std::min(remaining, clusBytes);
+            size_t got = src.read(dst, toRead);
+            if (got < toRead) memset(dst + got, 0, toRead - got);
+            remaining -= toRead;
+        }
+        src.close();
+        if (diskFull) break;
+
+        if (!writeLfnEntries(root, g.rootEntries, rootIdx, name, short11)) break;
+        uint8_t *ent = root + (rootIdx++) * 32;
+        memset(ent, 0, 32);
+        memcpy(ent, short11, 11);
+        ent[11] = 0x20; // ARCHIVE
+        wr16(ent + 26, (uint16_t)(firstClus & 0xFFFF));
+        wr32(ent + 28, fsize);
+        imported++;
+    }
+    dir.close();
+
+    // Mirror FAT0 -> FAT1
+    memcpy(fat1, fat0, (size_t)g.fatSectors * kSecSize);
+    return imported;
+}
+
+static int exportDiskMemoryToVault(const uint8_t *mem, uint32_t memBytes) {
+    FatGeom g;
+    if (!parseFatGeomFromMemory(mem, memBytes, g)) return -1;
+    if (!LittleFS.exists(kVaultDir)) LittleFS.mkdir(kVaultDir);
+
+    const uint8_t *fat0 = mem + g.fatStartSec * kSecSize;
+    const uint8_t *root = mem + g.rootStartSec * kSecSize;
+    uint32_t clusBytes = (uint32_t)g.secPerClus * kSecSize;
+
+    char lfnBuf[260] = {0};
+    int saved = 0;
+
+    for (uint16_t i = 0; i < g.rootEntries; i++) {
+        const uint8_t *ent = root + i * 32;
+        if (ent[0] == 0x00) break;
+        if (ent[0] == 0xE5) {
+            lfnBuf[0] = '\0';
+            continue;
+        }
+        uint8_t attr = ent[11];
+        if (attr == 0x0F) {
+            uint8_t ord = ent[0] & 0x1F;
+            if (ord >= 1 && ord <= 19) {
+                static const uint8_t charOffs[13] = {1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30};
+                if (ent[0] & 0x40) memset(lfnBuf, 0, sizeof(lfnBuf));
+                int base = (ord - 1) * 13;
+                for (int k = 0; k < 13; k++) {
+                    uint16_t uc = (uint16_t)ent[charOffs[k]] | ((uint16_t)ent[charOffs[k] + 1] << 8);
+                    if (uc == 0x0000 || uc == 0xFFFF) break;
+                    if (base + k < 255) lfnBuf[base + k] = (uc < 0x80) ? (char)uc : '_';
+                }
+            }
+            continue;
+        }
+        if ((attr & 0x08) || (attr & 0x10) || (attr & 0x02)) { // Volume label, dir, or hidden system
+            lfnBuf[0] = '\0';
+            continue;
+        }
+
+        String fname;
+        if (lfnBuf[0] != '\0') {
+            fname = String(lfnBuf);
+        } else {
+            String base, ext;
+            for (int b = 0; b < 8 && ent[b] != ' '; b++) base += (char)ent[b];
+            for (int e = 0; e < 3 && ent[8 + e] != ' '; e++) ext += (char)ent[8 + e];
+            fname = ext.isEmpty() ? base : (base + "." + ext);
+        }
+        lfnBuf[0] = '\0';
+        fname.trim();
+        if (fname.isEmpty() || fname.startsWith(".") || fname.startsWith("WPSettings") ||
+            fname.startsWith("IndexerVolumeGuid")) {
+            continue;
+        }
+
+        uint32_t fsize = rd32(ent + 28);
+        uint32_t clus = rd16(ent + 26);
+        if (fsize > memBytes) continue;
+
+        String outPath = String(kVaultDir) + "/" + fname;
+        File dst = LittleFS.open(outPath, FILE_WRITE);
+        if (!dst) continue;
+
+        uint32_t left = fsize;
+        uint32_t safety = 0;
+        while (left > 0 && clus >= 2 && clus < g.totalClusters + 2 && safety++ < g.totalClusters) {
+            const uint8_t *src = mem + (g.dataStartSec + (clus - 2) * g.secPerClus) * kSecSize;
+            uint32_t n = std::min(left, clusBytes);
+            dst.write(src, n);
+            left -= n;
+            uint16_t nxt = fatGetCluster(fat0, clus, g.isFat16);
+            if (fatIsEof(nxt, g.isFat16)) break;
+            clus = nxt;
+        }
+        dst.close();
+        saved++;
+    }
+    return saved;
+}
+
+static bool saveMemoryToFlashImage() {
+    if (!s_diskMem || !s_backedByFlash) return false;
+    ensureDiskMux();
+    if (xSemaphoreTake(s_diskMux, pdMS_TO_TICKS(1000)) != pdTRUE) return false;
+
+    bool existed = LittleFS.exists(kFlashImgPath);
+    File f = LittleFS.open(kFlashImgPath, existed ? "r+b" : FILE_WRITE);
+    if (!f) {
+        xSemaphoreGive(s_diskMux);
+        return false;
+    }
+
+    if (!existed || f.size() != s_diskBytes) {
+        f.close();
+        f = LittleFS.open(kFlashImgPath, FILE_WRITE);
+        if (!f) {
+            xSemaphoreGive(s_diskMux);
+            return false;
+        }
+        f.write(s_diskMem, s_diskBytes);
+        if (s_dirtyMap) memset(s_dirtyMap, 0, (s_diskSectors + 7) / 8);
+    } else if (s_dirtyMap) {
+        for (uint32_t sec = 0; sec < s_diskSectors; sec++) {
+            if (s_dirtyMap[sec >> 3] & (1U << (sec & 7))) {
+                f.seek((size_t)sec * kSecSize);
+                f.write(s_diskMem + (size_t)sec * kSecSize, kSecSize);
+                s_dirtyMap[sec >> 3] &= ~(1U << (sec & 7));
+            }
+        }
+    }
+    f.flush();
+    f.close();
+    s_dirtyAny = false;
+    xSemaphoreGive(s_diskMux);
+    return true;
+}
+
+static int32_t vmscReadCb(uint32_t lba, uint32_t offset, void *buffer, uint32_t bufsize) {
+    if (!s_diskMem) return -1;
+    uint64_t byteOff = (uint64_t)lba * kSecSize + offset;
+    if (byteOff + bufsize > s_diskBytes) return -1;
+    memcpy(buffer, s_diskMem + byteOff, bufsize);
+    s_rxBytes += bufsize;
+    return (int32_t)bufsize;
+}
+
+static int32_t vmscWriteCb(uint32_t lba, uint32_t offset, uint8_t *buffer, uint32_t bufsize) {
+    if (!s_diskMem) return -1;
+    uint64_t byteOff = (uint64_t)lba * kSecSize + offset;
+    if (byteOff + bufsize > s_diskBytes) return -1;
+    memcpy(s_diskMem + byteOff, buffer, bufsize);
+    if (s_backedByFlash && s_dirtyMap) {
+        uint32_t firstSec = (uint32_t)(byteOff / kSecSize);
+        uint32_t lastSec = (uint32_t)((byteOff + bufsize - 1) / kSecSize);
+        for (uint32_t s = firstSec; s <= lastSec && s < s_diskSectors; s++) {
+            s_dirtyMap[s >> 3] |= (1U << (s & 7));
+        }
+        s_dirtyAny = true;
+        s_lastWriteMs = millis();
+    }
+    s_txBytes += bufsize;
+    return (int32_t)bufsize;
+}
+
+static bool vmscStartStopCb(uint8_t power_condition, bool start, bool load_eject) {
+    (void)power_condition;
+    if (!start && load_eject) {
+        s_ejectRequested = true;
+        return false;
+    }
+    return true;
+}
