--- a/src/modules/others/mic.cpp
+++ b/src/modules/others/mic.cpp
@@ -170,7 +170,14 @@ static esp_err_t micInitChannel(i2s_chan_handle_t chan, uint32_t sampleRate) {
         i2s_config.gpio_cfg.bclk = mic.clk;
         i2s_config.gpio_cfg.ws = mic.ws;
         i2s_config.gpio_cfg.dout = (gpio_num_t)I2S_PIN_NO_CHANGE;
-        i2s_config.gpio_cfg.mclk = (gpio_num_t)I2S_PIN_NO_CHANGE;
+        // Some mic ADCs (an ES7210 behind an I2S ADC, for instance) need an external master
