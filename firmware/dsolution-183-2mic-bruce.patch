--- /dev/null
+++ b/src/core/ui_sound_wav.h
@@ -0,0 +1,21 @@
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+// Strict, bounded PCM WAV profile for short UI cues. No allocations.
+struct UiWavInfo { uint16_t channels; uint32_t bytes; };
+inline uint16_t uiLe16(const uint8_t *p) { return (uint16_t)p[0] | ((uint16_t)p[1] << 8); }
+inline uint32_t uiLe32(const uint8_t *p) { return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24); }
+inline bool uiParseWav(const uint8_t *h, size_t fileSize, unsigned maxMs, UiWavInfo &info) {
+    if (fileSize < 44 || memcmp(h,"RIFF",4) || memcmp(h+8,"WAVEfmt ",8) ||
+        uiLe32(h+16) != 16 || uiLe16(h+20) != 1 || uiLe32(h+24) != 48000 ||
+        uiLe16(h+34) != 16 || memcmp(h+36,"data",4)) return false;
+    const uint16_t channels = uiLe16(h+22);
+    const uint32_t bytes = uiLe32(h+40);
+    if ((channels != 1 && channels != 2) || uiLe16(h+32) != channels * 2 ||
+        uiLe32(h+28) != 48000U * channels * 2 || !bytes || bytes % (channels * 2) ||
+        bytes > 48000U * channels * 2 * maxMs / 1000U || bytes > fileSize - 44 ||
+        uiLe32(h+4) != bytes + 36 || fileSize != bytes + 44U) return false;
+    info = {channels, bytes};
+    return true;
+}
