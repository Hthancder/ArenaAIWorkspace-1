+void mic_db_meter() {
+    ioExpander.turnPinOnOff(IO_EXP_MIC, HIGH);
+    bool gpioInput = false;
+    if (!isGPIOOutput(GPIO_NUM_0)) {
+        gpioInput = true;
+        gpio_hold_en(GPIO_NUM_0);
+    }
+
+    if (!InitI2SMicroPhone()) {
+        if (gpioInput) {
+            gpio_hold_dis(GPIO_NUM_0);
+#if defined(DSOLUTION_183_2MIC)
+            pinMode(GPIO_NUM_0, INPUT_PULLUP);
+#else
+            pinMode(GPIO_NUM_0, INPUT);
+#endif
+        }
+        ioExpander.turnPinOnOff(IO_EXP_MIC, LOW);
+        displayError("Mic init failed", true);
+        return;
+    }
+
+    int16_t *pcm = (int16_t *)(psramFound() ? ps_malloc(FFT_SIZE * sizeof(int16_t))
+                                            : malloc(FFT_SIZE * sizeof(int16_t)));
+    if (!pcm) {
+        deinitMicroPhone();
+        if (gpioInput) {
+            gpio_hold_dis(GPIO_NUM_0);
+#if defined(DSOLUTION_183_2MIC)
+            pinMode(GPIO_NUM_0, INPUT_PULLUP);
+#else
+            pinMode(GPIO_NUM_0, INPUT);
+#endif
+        }
+        ioExpander.turnPinOnOff(IO_EXP_MIC, LOW);
+        displayError("Out of RAM", true);
+        return;
+    }
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    float smoothDbfs = -65.0f;
+    float peakHoldDbfs = -72.0f;
+    uint32_t peakHoldAt = millis();
+    bool clipped = false;
+    returnToMenu = false;
+
+    while (!returnToMenu) {
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+        if (check(SelPress)) {
+            peakHoldDbfs = -72.0f;
+            clipped = false;
+        }
+
+        size_t bytesRead = 0;
+        if (i2s_channel_read(i2s_chan, (char *)pcm, FFT_SIZE * sizeof(int16_t), &bytesRead, pdMS_TO_TICKS(150)) !=
+                ESP_OK ||
+            bytesRead < sizeof(int16_t) * 64) {
+            continue;
+        }
+
+        size_t nSamples = bytesRead / sizeof(int16_t);
+        double sumSq = 0.0;
+        int16_t maxAbs = 0;
+        for (size_t i = 0; i < nSamples; i++) {
+            int16_t s = pcm[i];
+            int16_t a = s < 0 ? (s == -32768 ? 32767 : -s) : s;
+            if (a > maxAbs) maxAbs = a;
+            sumSq += (double)s * (double)s;
+        }
+        if (maxAbs >= 32000) clipped = true;
+        double rms = sqrt(sumSq / (double)nSamples);
+        float dbfs = (rms > 1.0) ? (float)(20.0 * log10(rms / 32768.0)) : -72.0f;
+        if (dbfs < -72.0f) dbfs = -72.0f;
+        if (dbfs > 0.0f) dbfs = 0.0f;
+        smoothDbfs = smoothDbfs * 0.65f + dbfs * 0.35f;
+
+        if (dbfs >= peakHoldDbfs || (millis() - peakHoldAt) > 2200) {
+            peakHoldDbfs = dbfs;
+            peakHoldAt = millis();
+        }
+
+        // Dominant frequency via FFT
+        int domHz = 0;
+        if (nSamples >= FFT_SIZE) {
+            fft_config_t *plan = fft_init(FFT_SIZE, FFT_REAL, FFT_FORWARD, NULL, NULL);
+            if (plan) {
+                for (int i = 0; i < FFT_SIZE; i++) plan->input[i] = (float)pcm[i] / 32768.0f;
+                fft_execute(plan);
+                float bestMag = 0.0f;
+                int bestBin = 1;
+                for (int b = 2; b < FFT_SIZE / 2; b++) {
+                    float re = plan->output[2 * b];
+                    float im = plan->output[2 * b + 1];
+                    float mag = re * re + im * im;
+                    if (mag > bestMag) {
+                        bestMag = mag;
+                        bestBin = b;
+                    }
+                }
+                if (bestMag > 0.002f) {
+                    domHz = (int)(((float)bestBin * (float)MIC_SAMPLE_RATE) / (float)FFT_SIZE);
+                }
+                fft_destroy(plan);
+            }
+        }
+
+        // Relative SPL estimate (~98 dB full-scale reference for MEMS mics)
+        float estSpl = smoothDbfs + 98.0f;
+        if (estSpl < 25.0f) estSpl = 25.0f;
+
+        if (hasSprite) {
+            const uint16_t bg = bruceConfig.bgColor;
+            const uint16_t pri = bruceConfig.priColor;
+            const uint16_t sec = bruceConfig.secColor;
+            uint16_t meterCol = (smoothDbfs > -10.0f) ? TFT_RED : ((smoothDbfs > -24.0f) ? TFT_YELLOW : pri);
+
+            frame.fillScreen(bg);
+            frame.drawRoundRect(3, 3, tftWidth - 6, tftHeight - 6, 6, meterCol);
+
+            frame.fillRoundRect(8, 8, tftWidth - 16, 24, 4, blendColors(bg, pri, 22));
+            frame.setTextDatum(ML_DATUM);
+            frame.setTextSize(1);
+            frame.setTextColor(pri, blendColors(bg, pri, 22));
+            frame.drawString("AUDIO dB MONITOR (ES7210)", 14, 20);
+            if (clipped) {
+                frame.setTextDatum(MR_DATUM);
+                frame.setTextColor(TFT_RED, blendColors(bg, pri, 22));
+                frame.drawString("CLIP!", tftWidth - 14, 20);
+            }
+
+            // Big dBFS & relative SPL readout
+            frame.setTextDatum(MC_DATUM);
+            frame.setTextSize(3);
+            frame.setTextColor(meterCol, bg);
+            frame.drawString(String(estSpl, 1) + " dB", tftWidth / 2, 56);
+            frame.setTextSize(1);
+            frame.setTextColor(sec, bg);
+            frame.drawString(
+                String(smoothDbfs, 1) + " dBFS  |  Peak " + String(peakHoldDbfs, 1) + "  |  " +
+                    String(domHz) + " Hz",
+                tftWidth / 2,
+                82
+            );
+
+            // Segmented dB bar (-72..0 dBFS)
+            int bx = 14, by = 96, bw = tftWidth - 28, bh = 18;
+            frame.drawRoundRect(bx, by, bw, bh, 4, blendColors(bg, pri, 80));
+            float frac = (smoothDbfs + 72.0f) / 72.0f;
+            if (frac < 0.0f) frac = 0.0f;
+            if (frac > 1.0f) frac = 1.0f;
+            int fillW = (int)(frac * (bw - 4));
+            if (fillW > 2) frame.fillRoundRect(bx + 2, by + 2, fillW, bh - 4, 2, meterCol);
+            float peakFrac = (peakHoldDbfs + 72.0f) / 72.0f;
+            int peakX = bx + 2 + (int)(min(1.0f, max(0.0f, peakFrac)) * (bw - 5));
+            frame.drawFastVLine(peakX, by + 1, bh - 2, TFT_WHITE);
+
+            // Oscilloscope waveform
+            int wx = 12, wy = 124, ww = tftWidth - 24, wh = 88;
+            frame.drawRoundRect(wx, wy, ww, wh, 4, blendColors(bg, pri, 60));
+            int midY = wy + wh / 2;
+            int prevX = wx + 3;
+            int prevY = midY;
+            int pts = 88;
+            for (int p = 0; p < pts; p++) {
+                size_t si = ((size_t)p * min<size_t>(nSamples, 512)) / pts;
+                int x = wx + 3 + (p * (ww - 6)) / (pts - 1);
+                int y = midY - ((int32_t)pcm[si] * (wh / 2 - 4)) / 32768;
+                if (p > 0) frame.drawLine(prevX, prevY, x, y, pri);
+                prevX = x;
+                prevY = y;
+            }
+
+            frame.setTextDatum(MC_DATUM);
+            frame.setTextColor(sec, bg);
+            frame.drawString("Sel:Reset Peak  Esc:Exit", tftWidth / 2, tftHeight - 13);
+            frame.pushSprite(0, 0);
+        }
+        wakeUpScreen();
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+
+    if (hasSprite) frame.deleteSprite();
+    free(pcm);
+    deinitMicroPhone();
+    if (gpioInput) {
+        gpio_hold_dis(GPIO_NUM_0);
+#if defined(DSOLUTION_183_2MIC)
+        pinMode(GPIO_NUM_0, INPUT_PULLUP);
+#else
+        pinMode(GPIO_NUM_0, INPUT);
+#endif
+    } else {
+        pinMode(GPIO_NUM_0, OUTPUT);
+        digitalWrite(GPIO_NUM_0, LOW);
+    }
+    ioExpander.turnPinOnOff(IO_EXP_MIC, LOW);
+    tft.fillScreen(bruceConfig.bgColor);
+}
