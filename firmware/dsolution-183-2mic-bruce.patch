+// =====================================================================================
+//  2. Wi-Fi CSI Motion & Presence Radar (esp_wifi_set_csi_rx_cb)
+// =====================================================================================
+static portMUX_TYPE s_csiMux = portMUX_INITIALIZER_UNLOCKED;
+static volatile uint32_t s_csiPktCount = 0;
+static volatile int32_t s_csiLatestAmp = 0;
+static volatile int8_t s_csiLatestRssi = -90;
+
+static void IRAM_ATTR csiRxCb(void *ctx, wifi_csi_info_t *data) {
+    (void)ctx;
+    if (!data || !data->buf || data->len < 8) return;
+    uint16_t start = data->first_word_invalid ? 4 : 0;
+    if (data->len <= start + 2) return;
+
+    uint32_t sum = 0;
+    uint16_t pairs = 0;
+    const int8_t *b = data->buf;
+    for (uint16_t i = start; (uint16_t)(i + 1) < data->len; i += 2) {
+        int32_t im = b[i];
+        int32_t re = b[i + 1];
+        sum += (uint32_t)(im < 0 ? -im : im) + (uint32_t)(re < 0 ? -re : re);
+        pairs++;
+    }
+    if (pairs == 0) return;
+
+    int32_t avgAmp = (int32_t)((sum * 100UL) / pairs);
+    portENTER_CRITICAL_ISR(&s_csiMux);
+    s_csiPktCount++;
+    s_csiLatestAmp = avgAmp;
+    s_csiLatestRssi = data->rx_ctrl.rssi;
+    portEXIT_CRITICAL_ISR(&s_csiMux);
+}
+
+void csi_radar_setup() {
+    cleanlyStopWebUiForWiFiFeature();
+    radioFreeBleForWifi();
+    if (!radioHasMemForWifi()) {
+        displayError("Low DMA RAM for WiFi", true);
+        return;
+    }
+
+    bool useApLink = false;
+    if (!bruceConfig.wifi.empty()) {
+        int modeChoice = 0;
+        options = {
+            {"AP Link CSI (Best)",   [&]() { modeChoice = 1; }},
+            {"Passive Sniff CH CSI", [&]() { modeChoice = 0; }},
+            {"Cancel",               [&]() { modeChoice = -1; }},
+        };
+        loopOptions(options, MENU_TYPE_SUBMENU, "CSI Radar Mode");
+        if (modeChoice < 0) return;
+        useApLink = (modeChoice == 1);
+    }
+
+    if (useApLink) {
+        if (!wifiConnecttoKnownNet()) {
+            if (!wifiConnectMenu(WIFI_STA)) {
+                useApLink = false;
+            }
+        }
+        if (WiFi.isConnected()) { WiFi.setSleep(WIFI_PS_NONE); }
+    }
+
+    uint8_t channel = 6;
+    if (!useApLink) {
+        if (!startPromiscuousWifi(WIFI_PROMIS_FILTER_MASK_MGMT | WIFI_PROMIS_FILTER_MASK_DATA, NULL)) {
+            displayError("WiFi init failed", true);
+            return;
+        }
+        esp_wifi_set_channel(channel, WIFI_SECOND_CHAN_NONE);
+    }
+
+    wifi_csi_config_t csiCfg = {};
+#if !defined(CONFIG_SOC_WIFI_HE_SUPPORT)
+    csiCfg.lltf_en = true;
+    csiCfg.htltf_en = true;
+    csiCfg.stbc_htltf2_en = true;
+    csiCfg.ltf_merge_en = true;
+    csiCfg.channel_filter_en = true;
+    csiCfg.manu_scale = false;
+    csiCfg.shift = 0;
+    csiCfg.dump_ack_en = false;
+#endif
+    if (esp_wifi_set_csi_config(&csiCfg) != ESP_OK || esp_wifi_set_csi_rx_cb(csiRxCb, NULL) != ESP_OK ||
+        esp_wifi_set_csi(true) != ESP_OK) {
+        if (!useApLink) stopPromiscuousWifi();
+        else wifiDisconnect();
+        displayError("CSI init failed", true);
+        return;
+    }
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    if (!frame.createSprite(tftWidth, tftHeight)) {
+        esp_wifi_set_csi(false);
+        esp_wifi_set_csi_rx_cb(NULL, NULL);
+        if (!useApLink) stopPromiscuousWifi();
+        else wifiDisconnect();
+        displayError("Out of RAM for UI", true);
+        return;
+    }
+
+    WiFiUDP udp;
+    if (useApLink) udp.begin(0);
+
+    constexpr int kHistLen = 96;
+    uint8_t hist[kHistLen] = {0};
+    int histPos = 0;
+
+    float baseAmp = 0.0f;
+    float smoothDelta = 0.0f;
+    uint8_t sensThr = 24; // 0..100 scale
+    uint32_t lastSecMs = millis();
+    uint32_t lastPktSnap = 0;
+    uint32_t pktRate = 0;
+    uint32_t lastProbeMs = 0;
+    returnToMenu = false;
+
+    while (!returnToMenu) {
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+        if (check(UpPress) && sensThr < 85) sensThr += 4;
+        if (check(DownPress) && sensThr > 6) sensThr -= 4;
+        if (check(SelPress)) {
+            baseAmp = 0.0f;
+            smoothDelta = 0.0f;
+            memset(hist, 0, sizeof(hist));
+        }
+        if (!useApLink) {
+            if (check(NextPress)) {
+                channel = (channel % 13) + 1;
+                esp_wifi_set_channel(channel, WIFI_SECOND_CHAN_NONE);
+            }
+            if (check(PrevPress)) {
+                channel = (channel <= 1) ? 13 : (channel - 1);
+                esp_wifi_set_channel(channel, WIFI_SECOND_CHAN_NONE);
+            }
+        }
+
+        if (useApLink && WiFi.isConnected() && (millis() - lastProbeMs) >= 55) {
+            lastProbeMs = millis();
+            udp.beginPacket(WiFi.gatewayIP(), 9);
+            uint8_t b = 0x43;
+            udp.write(&b, 1);
+            udp.endPacket();
+        }
+
+        uint32_t pktTotal = 0;
+        int32_t curAmp = 0;
+        int8_t curRssi = -90;
+        portENTER_CRITICAL(&s_csiMux);
+        pktTotal = s_csiPktCount;
+        curAmp = s_csiLatestAmp;
+        curRssi = s_csiLatestRssi;
+        portEXIT_CRITICAL(&s_csiMux);
+
+        if ((millis() - lastSecMs) >= 1000) {
+            pktRate = pktTotal - lastPktSnap;
+            lastPktSnap = pktTotal;
+            lastSecMs = millis();
+        }
+
+        if (curAmp > 0) {
+            if (baseAmp <= 0.1f) baseAmp = (float)curAmp;
+            float diff = fabsf((float)curAmp - baseAmp) / max(baseAmp, 100.0f) * 320.0f;
+            if (diff > 100.0f) diff = 100.0f;
+            smoothDelta = smoothDelta * 0.72f + diff * 0.28f;
+            baseAmp = baseAmp * 0.96f + (float)curAmp * 0.04f;
+        } else {
+            smoothDelta *= 0.90f;
+        }
+
+        uint8_t motionIdx = (uint8_t)min<int>(100, (int)(smoothDelta + 0.5f));
+        hist[histPos] = motionIdx;
+        histPos = (histPos + 1) % kHistLen;
+
+        bool motion = (motionIdx >= sensThr) && (pktRate > 0 || curAmp > 0);
+        const uint16_t bg = bruceConfig.bgColor;
+        const uint16_t pri = bruceConfig.priColor;
+        const uint16_t sec = bruceConfig.secColor;
+        const uint16_t stateCol = motion ? TFT_YELLOW : pri;
+        const uint16_t cardBg = blendColors(bg, stateCol, motion ? 35 : 18);
+
+        frame.fillScreen(bg);
+        frame.drawRoundRect(3, 3, tftWidth - 6, tftHeight - 6, 6, stateCol);
+
+        frame.fillRoundRect(8, 8, tftWidth - 16, 24, 4, cardBg);
+        frame.setTextDatum(ML_DATUM);
+        frame.setTextSize(1);
+        frame.setTextColor(stateCol, cardBg);
+        frame.drawString(motion ? "CSI RADAR [MOTION]" : "CSI RADAR [CALM]", 14, 20);
+        frame.setTextDatum(MR_DATUM);
+        frame.setTextColor(TFT_WHITE, cardBg);
+        frame.drawString(String(pktRate) + "Hz " + String(curRssi) + "dBm", tftWidth - 14, 20);
+
+        frame.setTextDatum(TL_DATUM);
+        frame.setTextColor(sec, bg);
+        String sub = useApLink ? ("Link: " + WiFi.SSID()) : ("Passive CH" + String(channel));
+        if (sub.length() > 24) sub = sub.substring(0, 24);
+        frame.drawString(sub + "  Thr:" + String(sensThr) + "%", 12, 38);
+
+        // Waveform plot box
+        int px = 10, py = 54, pw = tftWidth - 20, ph = 148;
+        frame.drawRoundRect(px, py, pw, ph, 5, blendColors(bg, pri, 70));
+
+        // Threshold horizontal guide
+        int thrY = py + ph - 6 - ((int)sensThr * (ph - 12) / 100);
+        for (int dx = px + 4; dx < px + pw - 6; dx += 6) {
+            frame.drawLine(dx, thrY, dx + 3, thrY, TFT_RED);
+        }
+
+        // Smooth scrolling waveform
+        int prevX = px + 4;
+        int prevY = py + ph - 6;
+        for (int i = 0; i < kHistLen; i++) {
+            uint8_t val = hist[(histPos + i) % kHistLen];
+            int wx = px + 4 + (i * (pw - 8)) / (kHistLen - 1);
+            int wy = py + ph - 6 - ((int)val * (ph - 12) / 100);
+            if (i > 0) {
+                uint16_t lineCol = (val >= sensThr) ? TFT_YELLOW : pri;
+                frame.drawLine(prevX, prevY, wx, wy, lineCol);
+            }
+            prevX = wx;
+            prevY = wy;
+        }
+
+        frame.setTextDatum(MC_DATUM);
+        frame.setTextColor(sec, bg);
+        frame.drawString(
+            useApLink ? "UP/DN:Sens  Sel:Calibrate  Esc:Exit" : "UP/DN:Sens  P/N:CH  Sel:Cal  Esc:Exit",
+            tftWidth / 2,
+            tftHeight - 14
+        );
+
+        frame.pushSprite(0, 0);
+        wakeUpScreen();
+        vTaskDelay(pdMS_TO_TICKS(35));
+    }
+
+    esp_wifi_set_csi(false);
+    esp_wifi_set_csi_rx_cb(NULL, NULL);
+    frame.deleteSprite();
+    if (useApLink) {
+        udp.stop();
+        wifiDisconnect();
+    } else {
+        stopPromiscuousWifi();
+    }
+    tft.fillScreen(bruceConfig.bgColor);
+}
+
+// =====================================================================================
+//  3. 802.11mc Wi-Fi FTM Distance Meter (ESP32-S3 FTM Initiator)
+// =====================================================================================
+static SemaphoreHandle_t s_ftmSem = nullptr;
+static volatile uint8_t s_ftmStatus = FTM_STATUS_FAIL;
+static volatile uint32_t s_ftmRttNs = 0;
+static volatile uint32_t s_ftmDistCm = 0;
+
+static void ftmReportCb(arduino_event_t *event) {
+    if (!event || event->event_id != ARDUINO_EVENT_WIFI_FTM_REPORT) return;
+    wifi_event_ftm_report_t *rep = &event->event_info.wifi_ftm_report;
+    s_ftmStatus = rep->status;
+    if (rep->status == FTM_STATUS_SUCCESS) {
+        s_ftmDistCm = rep->dist_est;
+        s_ftmRttNs = rep->rtt_est;
+    }
+#if ESP_IDF_VERSION < ESP_IDF_VERSION_VAL(6, 0, 0)
+    if (rep->ftm_report_data) {
+        free(rep->ftm_report_data);
+        rep->ftm_report_data = nullptr;
+    }
+#endif
+    if (s_ftmSem) xSemaphoreGive(s_ftmSem);
+}
+
+void ftm_ranging_setup() {
+    cleanlyStopWebUiForWiFiFeature();
+    radioFreeBleForWifi();
+    if (!radioHasMemForWifi()) {
+        displayError("Low DMA RAM for WiFi", true);
+        return;
+    }
+
+    struct FtmTarget {
+        String ssid;
+        uint8_t bssid[6];
+        uint8_t ch;
+        int rssi;
+    };
+
+    auto pickTarget = [](FtmTarget &chosen) -> bool {
+        displayInfo("Scanning APs for FTM...");
+        ensureWifiPlatform();
+        WiFi.mode(WIFI_MODE_STA);
+        WiFi.disconnect(false, true);
+        vTaskDelay(pdMS_TO_TICKS(80));
+        int n = WiFi.scanNetworks(false, false, false, 120);
+        std::vector<FtmTarget> aps;
+        for (int i = 0; i < n; i++) {
+            FtmTarget t;
+            t.ssid = WiFi.SSID(i);
+            if (t.ssid.isEmpty()) t.ssid = "<hidden>";
+            const uint8_t *b = WiFi.BSSID(i);
+            if (!b) continue;
+            memcpy(t.bssid, b, 6);
+            t.ch = (uint8_t)WiFi.channel(i);
+            t.rssi = WiFi.RSSI(i);
+            aps.push_back(t);
+        }
+        WiFi.scanDelete();
+
+        if (aps.empty()) {
+            displayWarning("No APs found", true);
+            return false;
+        }
+        std::sort(aps.begin(), aps.end(), [](const FtmTarget &a, const FtmTarget &b) {
+            return a.rssi > b.rssi;
+        });
+        if (aps.size() > 16) aps.resize(16);
+
+        int selIdx = -1;
+        options.clear();
+        for (size_t i = 0; i < aps.size(); i++) {
+            String lbl = aps[i].ssid.substring(0, 14) + " C" + String(aps[i].ch) + " " + String(aps[i].rssi);
+            options.push_back({lbl, [&, i]() { selIdx = (int)i; }});
+        }
+        options.push_back({"Cancel", [&]() { selIdx = -1; }});
+        loopOptions(options, MENU_TYPE_SUBMENU, "Select FTM Target");
+        options.clear();
+        if (selIdx < 0 || selIdx >= (int)aps.size()) return false;
+        chosen = aps[selIdx];
+        return true;
+    };
+
+    FtmTarget target;
+    if (!pickTarget(target)) {
+        wifiDisconnect();
+        return;
+    }
+
+    s_ftmSem = xSemaphoreCreateBinary();
+    network_event_handle_t evHandle = WiFi.onEvent(ftmReportCb, ARDUINO_EVENT_WIFI_FTM_REPORT);
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    float avgDistM = 0.0f;
+    uint32_t okCount = 0;
+    uint32_t failCount = 0;
+    bool paused = false;
+    const char *statusMsg = "Probing...";
+    returnToMenu = false;
+
+    while (!returnToMenu) {
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+        if (check(SelPress)) paused = !paused;
+        if (check(NextPress)) {
+            if (pickTarget(target)) {
+                avgDistM = 0.0f;
+                okCount = 0;
+                failCount = 0;
+                statusMsg = "Probing...";
+            }
+        }
+
+        if (!paused) {
+            wifi_ftm_initiator_cfg_t ftmCfg = {};
+            memcpy(ftmCfg.resp_mac, target.bssid, 6);
+            ftmCfg.channel = target.ch;
+            ftmCfg.frm_count = 16;
+            ftmCfg.burst_period = 2;
+#if ESP_IDF_VERSION < ESP_IDF_VERSION_VAL(6, 0, 0)
+            ftmCfg.use_get_report_api = false;
+#endif
+            s_ftmStatus = FTM_STATUS_FAIL;
+            if (esp_wifi_ftm_initiate_session(&ftmCfg) == ESP_OK) {
+                if (xSemaphoreTake(s_ftmSem, pdMS_TO_TICKS(1500)) == pdPASS) {
+                    if (s_ftmStatus == FTM_STATUS_SUCCESS) {
+                        float m = (float)s_ftmDistCm / 100.0f;
+                        avgDistM = (okCount == 0) ? m : (avgDistM * 0.7f + m * 0.3f);
+                        okCount++;
+                        statusMsg = "FTM OK";
+                    } else if (s_ftmStatus == FTM_STATUS_UNSUPPORTED) {
+                        failCount++;
+                        statusMsg = "AP lacks 802.11mc";
+                    } else if (s_ftmStatus == FTM_STATUS_NO_RESPONSE) {
+                        failCount++;
+                        statusMsg = "No FTM response";
+                    } else {
+                        failCount++;
+                        statusMsg = "FTM failed";
+                    }
+                } else {
+                    esp_wifi_ftm_end_session();
+                    failCount++;
+                    statusMsg = "FTM timeout";
+                }
+            } else {
+                failCount++;
+                statusMsg = "Session err";
+            }
+        }
+
+        char macBuf[20];
+        formatMacStr(target.bssid, macBuf, sizeof(macBuf));
+        const uint16_t bg = bruceConfig.bgColor;
+        const uint16_t pri = bruceConfig.priColor;
+        const uint16_t sec = bruceConfig.secColor;
+        bool isOk = (okCount > 0 && s_ftmStatus == FTM_STATUS_SUCCESS);
+
+        if (hasSprite) {
+            frame.fillScreen(bg);
+            frame.drawRoundRect(3, 3, tftWidth - 6, tftHeight - 6, 6, pri);
+            frame.fillRoundRect(8, 8, tftWidth - 16, 24, 4, blendColors(bg, pri, 24));
+            frame.setTextDatum(MC_DATUM);
+            frame.setTextSize(1);
+            frame.setTextColor(pri, blendColors(bg, pri, 24));
+            frame.drawString("802.11mc Wi-Fi FTM Ranging", tftWidth / 2, 20);
+
+            frame.setTextDatum(TL_DATUM);
+            frame.setTextColor(TFT_WHITE, bg);
+            frame.drawString("AP: " + target.ssid.substring(0, 26), 12, 40);
+            frame.setTextColor(sec, bg);
+            frame.drawString(String(macBuf) + "  CH" + String(target.ch) + "  " + String(target.rssi) + "dBm", 12, 54);
+
+            frame.fillRoundRect(10, 74, tftWidth - 20, 74, 6, blendColors(bg, pri, 18));
+            frame.drawRoundRect(10, 74, tftWidth - 20, 74, 6, isOk ? TFT_GREEN : pri);
+            frame.setTextDatum(MC_DATUM);
+            frame.setTextSize(3);
+            frame.setTextColor(isOk ? TFT_GREEN : TFT_WHITE, blendColors(bg, pri, 18));
+            String distStr = isOk ? (String(avgDistM, 2) + " m") : "--.-- m";
+            frame.drawString(distStr, tftWidth / 2, 102);
+            frame.setTextSize(1);
+            frame.setTextColor(sec, blendColors(bg, pri, 18));
+            frame.drawString(
+                "RTT: " + String((unsigned long)s_ftmRttNs) + " ns  (" + String(statusMsg) + ")",
+                tftWidth / 2,
+                133
+            );
+
+            // Visual 0..30m bar
+            int bx = 14, by = 162, bw = tftWidth - 28, bh = 12;
+            frame.fillRoundRect(bx, by, bw, bh, 4, blendColors(bg, pri, 30));
+            if (isOk) {
+                float frac = min(1.0f, max(0.02f, avgDistM / 30.0f));
+                frame.fillRoundRect(bx, by, (int)(frac * bw), bh, 4, pri);
+            }
+            frame.setTextColor(sec, bg);
+            frame.drawString("OK:" + String(okCount) + "  Err:" + String(failCount), tftWidth / 2, 190);
+            frame.drawString(
+                String("Sel:") + (paused ? "Resume" : "Pause") + "  Next:Target  Esc:Exit",
+                tftWidth / 2,
+                tftHeight - 15
+            );
+            frame.pushSprite(0, 0);
+        } else {
+            tft.fillScreen(bg);
+            tft.setTextColor(pri, bg);
+            tft.drawCentreString("FTM: " + String(avgDistM, 2) + " m", tftWidth / 2, tftHeight / 2, 1);
+        }
+        wakeUpScreen();
+        vTaskDelay(pdMS_TO_TICKS(250));
+    }
+
+    esp_wifi_ftm_end_session();
+    WiFi.removeEvent(evHandle);
+    if (s_ftmSem) {
+        vSemaphoreDelete(s_ftmSem);
+        s_ftmSem = nullptr;
+    }
+    if (hasSprite) frame.deleteSprite();
+    wifiDisconnect();
+    tft.fillScreen(bruceConfig.bgColor);
+}
+
+#endif
