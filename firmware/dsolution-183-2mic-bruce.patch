+
+/*
+ * Passive discovery (mDNS / SSDP) + active, read-only service checks.
+ * The checks are deliberately "banner + unauthenticated probe" only: no
+ * writes, no brute force, no payload execution. Results are exported to
+ * /lan_audit.json + .csv and shown on-device and in the SecLab WebUI.
+ */
+
+namespace {
+
+constexpr const char *kStatePath = "/lan_audit_state.json";
+constexpr const char *kJsonPath = "/lan_audit.json";
+constexpr const char *kCsvPath = "/lan_audit.csv";
+constexpr const char *kLogPath = "/lan_audit.log";
+constexpr int kMaxDevices = 32;
+constexpr int kMaxFindings = 64;
+
+struct Device {
+    String ip;
+    String name;
+    String model;
+    String service;
+    String vendorHint;
+    uint16_t port = 0;
+    uint16_t hits = 1;
+};
+
+struct Finding {
+    String ip;
+    String name;
+    uint16_t port;
+    String proto;
+    String banner;
+    String verdict; // OPEN_NO_AUTH | AUTH_REQUIRED | BANNER_ONLY
+    bool sensitive;
+};
+
+static TaskHandle_t s_task = nullptr;
+static SemaphoreHandle_t s_mux = nullptr;
+static volatile bool s_running = false;
+static volatile bool s_stopReq = false;
+static bool s_deep = true;
+static char s_lastErr[96] = {0};
+static String s_phase = "IDLE";
+static uint32_t s_startedMs = 0;
+static std::vector<Device> s_devices;
+static std::vector<Finding> s_findings;
+static uint32_t s_udpPackets = 0;
+
+static void ensureMux() {
+    if (!s_mux) s_mux = xSemaphoreCreateMutex();
+}
+
+static void setErr(const String &e) {
+    strncpy(s_lastErr, e.c_str(), sizeof(s_lastErr) - 1);
+    s_lastErr[sizeof(s_lastErr) - 1] = 0;
+}
+
+static String jsonEsc(const String &s) { return seclabJsonEscape(s); }
+
+static String riskLabel(const String &v) {
+    if (v == "OPEN_NO_AUTH") return "HIGH";
+    if (v == "BANNER_ONLY") return "MEDIUM";
+    return "OK";
+}
+
+static void lockState() {
+    ensureMux();
+    while (xSemaphoreTake(s_mux, pdMS_TO_TICKS(20)) != pdTRUE) { vTaskDelay(pdMS_TO_TICKS(5)); }
+}
+static void unlockState() { xSemaphoreGive(s_mux); }
+
+static void addDevice(const String &ip, const String &name, const String &model,
+                      const String &service, uint16_t port = 0) {
+    if (ip.isEmpty() || ip == "0.0.0.0") return;
+    for (auto &d : s_devices) {
+        if (d.ip == ip) {
+            d.hits++;
+            if (d.name.isEmpty() || d.name == ip) d.name = name;
+            if (d.model.isEmpty() && !model.isEmpty()) d.model = model;
+            if (d.service.indexOf(service) < 0 && d.service.length() < 48) {
+                d.service += (d.service.isEmpty() ? "" : ",") + service;
+            }
+            if (port && !d.port) d.port = port;
+            return;
+        }
+    }
+    if (s_devices.size() >= kMaxDevices) return;
+    Device d;
+    d.ip = ip;
+    d.name = name.isEmpty() ? ip : name;
+    d.model = model;
+    d.service = service;
+    d.port = port;
+    s_devices.push_back(d);
+}
+
+static void addFinding(const Finding &f) {
+    if (s_findings.size() >= kMaxFindings) return;
+    for (const auto &x : s_findings) {
+        if (x.ip == f.ip && x.port == f.port && x.proto == f.proto) return;
+    }
+    s_findings.push_back(f);
+}
+
+static void exportReportLocked() {
+    String j = "{\"generated\":" + String((unsigned long)seclabUptimeSec()) + ",\"deep\":" +
+               (s_deep ? "true" : "false") + ",\"devices\":[";
+    for (size_t i = 0; i < s_devices.size(); i++) {
+        const Device &d = s_devices[i];
+        if (i) j += ",";
+        j += "{\"ip\":\"" + jsonEsc(d.ip) + "\",\"name\":\"" + jsonEsc(d.name) +
+             "\",\"model\":\"" + jsonEsc(d.model) + "\",\"service\":\"" + jsonEsc(d.service) +
+             "\",\"port\":" + String((int)d.port) + ",\"hits\":" + String((unsigned)d.hits) + "}";
+    }
+    j += "],\"findings\":[";
+    for (size_t i = 0; i < s_findings.size(); i++) {
+        const Finding &f = s_findings[i];
+        if (i) j += ",";
+        j += "{\"ip\":\"" + jsonEsc(f.ip) + "\",\"name\":\"" + jsonEsc(f.name) +
+             "\",\"port\":" + String((int)f.port) + ",\"proto\":\"" + jsonEsc(f.proto) +
+             "\",\"verdict\":\"" + f.verdict + "\",\"risk\":\"" + riskLabel(f.verdict) +
+             "\",\"banner\":\"" + jsonEsc(f.banner) + "\"}";
+    }
+    j += "]}";
+    seclabWriteState(kJsonPath, j);
+
+    File csv = LittleFS.open(kCsvPath, FILE_WRITE);
+    if (csv) {
+        csv.println("ip,name,port,proto,verdict,risk,banner");
+        for (const auto &f : s_findings) {
+            String b = f.banner;
+            b.replace(",", ";");
+            csv.printf("%s,%s,%u,%s,%s,%s,%s\n", f.ip.c_str(), f.name.c_str(), (unsigned)f.port,
+                       f.proto.c_str(), f.verdict.c_str(), riskLabel(f.verdict).c_str(), b.c_str());
+        }
+        csv.close();
+    }
+}
+
+static void persistStateLocked() {
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"phase\":\"" + jsonEsc(s_phase) + "\",";
+    j += "\"deep\":" + String(s_deep ? "true" : "false") + ",";
+    j += "\"lastErr\":\"" + jsonEsc(s_lastErr) + "\",";
+    j += "\"udp\":" + String((unsigned long)s_udpPackets) + ",";
+    j += "\"devices\":" + String((int)s_devices.size()) + ",";
+    j += "\"findings\":" + String((int)s_findings.size()) + ",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + ",";
+    j += "\"deviceList\":[";
+    for (size_t i = 0; i < s_devices.size(); i++) {
+        const Device &d = s_devices[i];
+        if (i) j += ",";
+        j += "{\"ip\":\"" + jsonEsc(d.ip) + "\",\"name\":\"" + jsonEsc(d.name) +
+             "\",\"model\":\"" + jsonEsc(d.model) + "\",\"service\":\"" + jsonEsc(d.service) +
+             "\",\"port\":" + String((int)d.port) + "}";
+    }
+    j += "],\"findingList\":[";
+    for (size_t i = 0; i < s_findings.size(); i++) {
+        const Finding &f = s_findings[i];
+        if (i) j += ",";
+        j += "{\"ip\":\"" + jsonEsc(f.ip) + "\",\"name\":\"" + jsonEsc(f.name) +
+             "\",\"port\":" + String((int)f.port) + ",\"proto\":\"" + jsonEsc(f.proto) +
+             "\",\"verdict\":\"" + f.verdict + "\",\"risk\":\"" + riskLabel(f.verdict) +
+             "\",\"banner\":\"" + jsonEsc(f.banner) + "\"}";
+    }
+    j += "]}";
+    seclabWriteState(kStatePath, j);
+}
+
+// ------------------------ mDNS ------------------------
+static bool readDnsName(const uint8_t *pkt, size_t len, size_t &off, String &out) {
+    out = "";
+    bool jumped = false;
+    size_t nextOff = off;
+    size_t hops = 0;
+    while (hops++ < 16) {
+        if (off >= len) return false;
+        uint8_t n = pkt[off];
+        if ((n & 0xC0) == 0xC0) {
+            if (off + 1 >= len) return false;
+            size_t ptr = ((n & 0x3F) << 8) | pkt[off + 1];
+            if (!jumped) nextOff = off + 2;
+            off = ptr;
+            jumped = true;
+            continue;
+        }
+        off++;
+        if (n == 0) break;
+        if (off + n > len) return false;
+        if (!out.isEmpty()) out += ".";
+        for (size_t i = 0; i < n; i++) {
+            char c = (char)pkt[off + i];
+            out += (c >= 0x20 && c < 0x7F) ? c : '.';
+        }
+        off += n;
+    }
+    if (jumped) off = nextOff;
+    return !out.isEmpty();
+}
+
+static void writeDnsQuestion(uint8_t *p, size_t &n, const char *qname, uint16_t qtype) {
+    // qname is dot-separated; encode labels.
+    const char *cur = qname;
+    while (*cur) {
+        const char *dot = strchr(cur, '.');
+        size_t l = dot ? (size_t)(dot - cur) : strlen(cur);
+        p[n++] = (uint8_t)l;
+        memcpy(p + n, cur, l);
+        n += l;
+        if (!dot) break;
+        cur = dot + 1;
+    }
+    p[n++] = 0;
+    p[n++] = (uint8_t)(qtype >> 8);
+    p[n++] = (uint8_t)(qtype & 0xFF);
+    p[n++] = 0x00;
+    p[n++] = 0x01; // class IN
+}
+
+static void sendMdnsQueries(WiFiUDP &udp) {
+    static const char *const kQueries[] = {
+        "_services._dns-sdp._tcp.local", "_http._tcp.local", "_rtsp._tcp.local",
+        "_mqtt._tcp.local", "_ssh._tcp.local", "_printer._tcp.local",
+        "_airplay._tcp.local", "_raop._tcp.local", "_smb._tcp.local",
+    };
+    uint8_t pkt[256];
+    for (const char *q : kQueries) {
+        memset(pkt, 0, sizeof(pkt));
+        pkt[2] = 0x01; // standard query, RD
+        pkt[5] = 0x01; // QDCOUNT = 1
+        size_t n = 12;
+        writeDnsQuestion(pkt, n, q, 12); // PTR
+        udp.beginPacket(IPAddress(224, 0, 0, 251), 5353);
+        udp.write(pkt, n);
+        udp.endPacket();
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+}
+
+static void parseMdns(WiFiUDP &udp) {
+    uint8_t pkt[768];
+    int rlen = udp.read(pkt, sizeof(pkt));
+    if (rlen < 12) return;
+    IPAddress src = udp.remoteIP();
+    uint16_t qd = (uint16_t)((pkt[4] << 8) | pkt[5]);
+    uint16_t an = (uint16_t)((pkt[6] << 8) | pkt[7]);
+    size_t off = 12;
+    String qname;
+    for (int i = 0; i < qd; i++) {
+        if (!readDnsName(pkt, (size_t)rlen, off, qname)) return;
+        off += 4;
+    }
+    String host, model, svc;
+    uint16_t srvPort = 0;
+    for (int i = 0; i < an; i++) {
+        String owner;
+        if (!readDnsName(pkt, (size_t)rlen, off, owner)) return;
+        if (off + 10 > (size_t)rlen) return;
+        uint16_t type = (uint16_t)((pkt[off] << 8) | pkt[off + 1]);
+        uint16_t rdlen = (uint16_t)((pkt[off + 8] << 8) | pkt[off + 9]);
+        size_t rd = off + 10;
+        off = rd + rdlen;
+        if (rd + rdlen > (size_t)rlen) return;
+
+        if (type == 12) { // PTR
+            size_t po = rd;
+            String target;
+            if (readDnsName(pkt, (size_t)rlen, po, target)) {
+                svc = target;
+                if (!owner.isEmpty() && owner.endsWith(".local")) {
+                    String s = owner;
+                    int cut = s.indexOf("._");
+                    if (cut < 0) cut = s.indexOf(".");
+                    if (cut > 0) svc = s.substring(0, cut);
+                }
+            }
+        } else if (type == 33) { // SRV
+            if (rd + 6 <= (size_t)rlen) {
+                srvPort = (uint16_t)((pkt[rd + 4] << 8) | pkt[rd + 5]);
+                size_t to = rd + 6;
+                String target;
+                if (readDnsName(pkt, (size_t)rlen, to, target)) host = target;
+            }
+        } else if (type == 16) { // TXT
+            String txt;
+            for (size_t p = rd; p < rd + rdlen;) {
+                uint8_t l = pkt[p++];
+                if (p + l > rd + rdlen) break;
+                for (size_t k = 0; k < l; k++) txt += (char)pkt[p + k];
+                p += l;
+                txt += " ";
+            }
+            txt.toLowerCase();
+            int mi = txt.indexOf("model=");
+            if (mi >= 0) model = txt.substring(mi + 6, txt.indexOf(' ', mi + 6) < 0 ? txt.length() : txt.indexOf(' ', mi + 6));
+            if (txt.indexOf("camera") >= 0 && model.isEmpty()) model = "IP Camera";
+            if (txt.indexOf("nas") >= 0 && model.isEmpty()) model = "NAS";
+        } else if (type == 1 && rd + 4 <= (size_t)rlen) { // A
+            addDevice(IPAddress(pkt[rd], pkt[rd + 1], pkt[rd + 2], pkt[rd + 3]).toString(),
+                      host.isEmpty() ? owner : host, model, svc.isEmpty() ? "mDNS" : svc, srvPort);
+        }
+    }
+    // Also record the responder's own IP even when only PTR/SRV/TXT came back.
+    addDevice(src.toString(), host.isEmpty() ? src.toString() : host, model,
+              svc.isEmpty() ? "mDNS" : svc, srvPort);
+}
+
+// ------------------------ SSDP ------------------------
+static void sendSsdpSearch(WiFiUDP &udp) {
+    static const char *const kSt[] = {"ssdp:all", "upnp:rootdevice", "urn:schemas-upnp-org:device:MediaServer:1"};
+    for (const char *st : kSt) {
+        String req = "M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: \"ssdp:discover\"\r\nMX: 2\r\nST: ";
+        req += st;
+        req += "\r\n\r\n";
+        udp.beginPacket(IPAddress(239, 255, 255, 250), 1900);
+        udp.write((const uint8_t *)req.c_str(), req.length());
+        udp.endPacket();
+        vTaskDelay(pdMS_TO_TICKS(30));
+    }
+}
+
+static String headerValue(const String &s, const String &key) {
+    int i = s.indexOf(key);
+    if (i < 0) return "";
+    i = s.indexOf(':', i);
+    if (i < 0) return "";
+    int e = s.indexOf('\n', i);
+    String v = s.substring(i + 1, e < 0 ? s.length() : e);
+    v.trim();
+    return v;
+}
+
+static void parseSsdp(WiFiUDP &udp) {
+    char buf[1024];
+    int n = udp.read((uint8_t *)buf, sizeof(buf) - 1);
+    if (n < 20) return;
+    buf[n] = 0;
+    String s(buf);
+    s.toLowerCase();
+    String loc = headerValue(s, "location");
+    String server = headerValue(s, "server");
+    String st = headerValue(s, "st");
+    String usn = headerValue(s, "usn");
+    String ip = udp.remoteIP().toString();
+    String name = server.isEmpty() ? ip : server;
+    String model = st.isEmpty() ? (usn.isEmpty() ? "UPnP" : usn) : st;
+    uint16_t port = 0;
+    if (loc.length() > 0) {
+        int scheme = loc.indexOf("://");
+        if (scheme >= 0) {
+            int hostStart = scheme + 3;
+            int colon = loc.indexOf(':', hostStart);
+            int slash = loc.indexOf('/', hostStart);
+            int hostEnd = (colon > 0 && (slash < 0 || colon < slash)) ? colon : (slash < 0 ? loc.length() : slash);
+            String h = loc.substring(hostStart, hostEnd);
+            if (h.length() > 0 && isDigit(h.charAt(0))) ip = h;
+            if (colon > 0 && (slash < 0 || colon < slash)) {
+                port = (uint16_t)loc.substring(colon + 1, slash < 0 ? loc.length() : slash).toInt();
+            }
+        }
+    }
+    addDevice(ip, name, model, "SSDP/UPnP", port);
+}
+
+// ------------------------ Active probes ------------------------
+static String readBanner(WiFiClient &c, uint32_t timeoutMs, size_t max = 512) {
+    String out;
+    uint32_t t0 = millis();
+    while (millis() - t0 < timeoutMs && out.length() < max) {
+        if (c.available()) {
+            out += (char)c.read();
+        } else if (!c.connected() && out.length() > 0) {
+            break;
+        } else {
+            vTaskDelay(pdMS_TO_TICKS(5));
+        }
+    }
+    return seclabSafeText(out, 96);
+}
+
+static void probeHttp(const String &ip, uint16_t port, const String &name) {
+    WiFiClient c;
+    IPAddress target;
+    if (!target.fromString(ip)) return;
+    if (!c.connect(target, port, 350)) return;
+    String req = "GET / HTTP/1.0\r\nHost: " + ip + "\r\nUser-Agent: BruceSecLab/1.0\r\nConnection: close\r\n\r\n";
+    c.print(req);
+    String b = readBanner(c, 650);
+    c.stop();
+    if (b.isEmpty()) return;
+    String low = b;
+    low.toLowerCase();
+    Finding f;
+    f.ip = ip; f.name = name; f.port = port; f.proto = "HTTP";
+    f.banner = b.substring(0, 96);
+    f.verdict = (low.indexOf("www-authenticate") >= 0 || low.indexOf("401 unauthorized") >= 0)
+                    ? "AUTH_REQUIRED" : "OPEN_NO_AUTH";
+    f.sensitive = (low.indexOf("admin") >= 0 || low.indexOf("login") >= 0 || low.indexOf("camera") >= 0);
+    int ti = low.indexOf("<title");
+    if (ti >= 0) {
+        int gt = b.indexOf('>', ti);
+        int end = b.indexOf('<', gt + 1);
+        if (gt >= 0 && end > gt) f.banner = seclabSafeText(b.substring(gt + 1, end), 64);
+    }
+    addFinding(f);
+}
+
+static void probeRtsp(const String &ip, const String &name) {
+    WiFiClient c;
+    IPAddress target;
+    if (!target.fromString(ip)) return;
+    if (!c.connect(target, 554, 350)) return;
+    c.print("OPTIONS * RTSP/1.0\r\nCSeq: 1\r\nUser-Agent: BruceSecLab/1.0\r\n\r\n");
+    String b1 = readBanner(c, 500);
+    c.print("DESCRIBE rtsp://" + ip + "/ RTSP/1.0\r\nCSeq: 2\r\nAccept: application/sdp\r\n\r\n");
+    String b2 = readBanner(c, 600);
+    c.stop();
+    String all = b1 + " " + b2;
+    all.toLowerCase();
+    Finding f;
+    f.ip = ip; f.name = name; f.port = 554; f.proto = "RTSP";
+    f.banner = seclabSafeText(b1.isEmpty() ? b2 : b1, 96);
+    f.verdict = (all.indexOf("401 unauthorized") >= 0 || all.indexOf("www-authenticate") >= 0)
+                    ? "AUTH_REQUIRED" : "OPEN_NO_AUTH";
+    f.sensitive = true;
+    addFinding(f);
+}
+
+static void probeMqtt(const String &ip, const String &name) {
+    WiFiClient c;
+    IPAddress target;
+    if (!target.fromString(ip)) return;
+    if (!c.connect(target, 1883, 350)) return;
+    // MQTT 3.1.1 CONNECT, clean session, no username/password flags.
+    String cid = "bruce-audit";
+    uint8_t pkt[64];
+    size_t n = 0;
+    pkt[n++] = 0x10;
+    size_t rlPos = n++;
+    pkt[n++] = 0x00; pkt[n++] = 0x04; pkt[n++] = 'M'; pkt[n++] = 'Q'; pkt[n++] = 'T'; pkt[n++] = 'T';
+    pkt[n++] = 0x04;       // protocol level
+    pkt[n++] = 0x02;       // clean session only
+    pkt[n++] = 0x00; pkt[n++] = 0x3C; // keepalive 60s
+    pkt[n++] = 0x00; pkt[n++] = (uint8_t)cid.length();
+    memcpy(pkt + n, cid.c_str(), cid.length());
+    n += cid.length();
+    pkt[rlPos] = (uint8_t)(n - 2);
+    c.write(pkt, n);
+    uint8_t resp[8] = {0};
+    int r = c.read(resp, sizeof(resp));
+    c.stop();
+    Finding f;
+    f.ip = ip; f.name = name; f.port = 1883; f.proto = "MQTT";
+    f.banner = r >= 4 ? String("CONNACK rc=") + String((int)resp[3]) : String("no CONNACK");
+    f.verdict = (r >= 4 && resp[3] == 0) ? "OPEN_NO_AUTH" : "AUTH_REQUIRED";
+    f.sensitive = true;
+    addFinding(f);
+}
+
+static void probeRedis(const String &ip, const String &name) {
+    WiFiClient c;
+    IPAddress target;
+    if (!target.fromString(ip)) return;
+    if (!c.connect(target, 6379, 350)) return;
+    c.print("PING\r\nINFO server\r\n");
+    String b = readBanner(c, 500);
+    c.stop();
+    String low = b;
+    low.toLowerCase();
+    Finding f;
+    f.ip = ip; f.name = name; f.port = 6379; f.proto = "Redis";
+    f.banner = seclabSafeText(b, 96);
+    f.verdict = (low.indexOf("noauth") >= 0) ? "AUTH_REQUIRED" : "OPEN_NO_AUTH";
+    f.sensitive = true;
+    addFinding(f);
+}
+
+static void probeFtp(const String &ip, uint16_t port, const String &name) {
+    WiFiClient c;
+    IPAddress target;
+    if (!target.fromString(ip)) return;
+    if (!c.connect(target, port, 350)) return;
+    String banner = readBanner(c, 400);
+    if (s_deep) c.print("USER anonymous\r\n");
+    String userReply = s_deep ? readBanner(c, 400) : "";
+    c.stop();
+    String low = (banner + " " + userReply);
+    low.toLowerCase();
+    Finding f;
+    f.ip = ip; f.name = name; f.port = port; f.proto = "FTP";
+    f.banner = seclabSafeText(banner, 96);
+    f.verdict = (low.indexOf("331") >= 0 || low.indexOf("230") >= 0) ? "OPEN_NO_AUTH" : "BANNER_ONLY";
+    f.sensitive = true;
+    addFinding(f);
+}
+
+static void probeGeneric(const String &ip, uint16_t port, const char *proto, const String &name) {
+    WiFiClient c;
+    IPAddress target;
+    if (!target.fromString(ip)) return;
+    if (!c.connect(target, port, 300)) return;
+    String b = readBanner(c, 350);
+    c.stop();
+    Finding f;
+    f.ip = ip; f.name = name; f.port = port; f.proto = proto;
+    f.banner = seclabSafeText(b, 96);
+    f.verdict = "BANNER_ONLY";
+    f.sensitive = (String(proto) == "Telnet");
+    addFinding(f);
+}
+
+static void activeProbes() {
+    struct PortDef { uint16_t port; const char *proto; };
+    static const PortDef kPorts[] = {
+        {80, "HTTP"}, {8080, "HTTP"}, {443, "HTTPS"}, {554, "RTSP"},
+        {1883, "MQTT"}, {6379, "Redis"}, {21, "FTP"}, {23, "Telnet"},
+        {2323, "Telnet"}, {9200, "HTTP"},
+    };
+    for (auto &d : s_devices) {
+        if (s_stopReq) return;
+        // Always try the discovery-advertised port first, then the common set.
+        std::vector<uint16_t> ports;
+        if (d.port && d.port < 65535) ports.push_back(d.port);
+        for (const auto &p : kPorts) ports.push_back(p.port);
+        std::sort(ports.begin(), ports.end());
+        ports.erase(std::unique(ports.begin(), ports.end()), ports.end());
+        if (ports.size() > 10) ports.resize(10);
+
+        for (uint16_t port : ports) {
+            if (s_stopReq) return;
+            const char *proto = "TCP";
+            for (const auto &p : kPorts) if (p.port == port) { proto = p.proto; break; }
+            if (String(proto) == "HTTP") probeHttp(d.ip, port, d.name);
+            else if (String(proto) == "HTTPS") probeGeneric(d.ip, port, "HTTPS-TLS", d.name);
+            else if (String(proto) == "RTSP") probeRtsp(d.ip, d.name);
+            else if (String(proto) == "MQTT") probeMqtt(d.ip, d.name);
+            else if (String(proto) == "Redis") probeRedis(d.ip, d.name);
+            else if (String(proto) == "FTP") probeFtp(d.ip, port, d.name);
+            else if (String(proto) == "Telnet") probeGeneric(d.ip, port, "Telnet", d.name);
+            else probeGeneric(d.ip, port, "TCP", d.name);
+        }
+    }
+}
+
+static void lanAuditTask(void *) {
+    WiFiUDP mdns, ssdp;
+    bool mdnsOk = mdns.beginMulticast(IPAddress(224, 0, 0, 251), 5353);
+    bool ssdpOk = ssdp.beginMulticast(IPAddress(239, 255, 255, 250), 1900);
+    if (!mdnsOk && !ssdpOk) {
+        setErr("UDP 5353/1900 busy (WebUI mDNS?)");
+    } else {
+        if (mdnsOk) sendMdnsQueries(mdns);
+        if (ssdpOk) sendSsdpSearch(ssdp);
+    }
+
+    s_phase = "DISCOVER";
+    uint32_t t0 = millis();
+    while (!s_stopReq && millis() - t0 < 6500UL) {
+        if (mdnsOk && mdns.parsePacket() > 0) { s_udpPackets++; parseMdns(mdns); }
+        if (ssdpOk && ssdp.parsePacket() > 0) { s_udpPackets++; parseSsdp(ssdp); }
+        vTaskDelay(pdMS_TO_TICKS(15));
+    }
+    mdns.stop();
+    ssdp.stop();
+
+    // Always include the default gateway / local host if nothing answered.
+    if (s_devices.empty()) {
+        IPAddress gw = WiFi.gatewayIP();
+        if ((uint32_t)gw != 0) addDevice(gw.toString(), "Gateway", "", "ICMP/ARP", 0);
+    }
+
+    if (!s_stopReq) {
+        s_phase = "PROBE";
+        activeProbes();
+    }
+    s_phase = "EXPORT";
+    lockState();
+    exportReportLocked();
+    persistStateLocked();
+    for (const auto &f : s_findings) {
+        seclabAppendLog(kLogPath, String(seclabUptimeSec()) + "," + f.ip + "," + String(f.port) + "," +
+                                     f.proto + "," + f.verdict);
+    }
+    unlockState();
+    s_phase = "DONE";
+    lockState();
+    persistStateLocked();
+    unlockState();
+    s_running = false;
+    s_task = nullptr;
+    vTaskDelete(NULL);
+}
+
+static bool startEngine(bool deep, String *errOut) {
+    if (s_running) return true;
+    if (!WiFi.isConnected() && !(WiFi.getMode() & WIFI_MODE_AP)) {
+        if (errOut) *errOut = "Connect to Wi-Fi STA or start the AP first";
+        return false;
+    }
+    ensureMux();
+    s_deep = deep;
+    s_devices.clear();
+    s_findings.clear();
+    s_udpPackets = 0;
+    s_lastErr[0] = 0;
+    s_phase = "START";
+    s_startedMs = millis();
+    s_stopReq = false;
+    s_running = true;
+    if (xTaskCreatePinnedToCore(lanAuditTask, "lanAudit", 6144, nullptr, 2, &s_task, 0) != pdPASS) {
+        s_running = false;
+        s_task = nullptr;
+        setErr("LAN audit task spawn failed");
+        if (errOut) *errOut = s_lastErr;
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+bool lanAuditStart(bool deepCheck, String *errOut) { return startEngine(deepCheck, errOut); }
+
+void lanAuditStop() {
+    if (!s_running) return;
+    s_stopReq = true;
+    for (int i = 0; i < 80 && s_running; i++) vTaskDelay(pdMS_TO_TICKS(25));
+}
+
+bool lanAuditIsRunning() { return s_running; }
+
+void lanAuditClear() {
+    if (s_running) return;
+    lockState();
+    s_devices.clear();
+    s_findings.clear();
+    s_udpPackets = 0;
+    s_phase = "IDLE";
+    s_lastErr[0] = 0;
+    persistStateLocked();
+    unlockState();
+    LittleFS.remove(kJsonPath);
+    LittleFS.remove(kCsvPath);
+    LittleFS.remove(kLogPath);
+}
+
+bool lanAuditExport() {
+    if (s_running) return false;
+    lockState();
+    exportReportLocked();
+    unlockState();
+    return LittleFS.exists(kJsonPath);
+}
+
+String lanAuditGetStateJson() {
+    if (s_running) {
+        // While the task owns the vectors, serve the last on-disk snapshot.
+        return seclabReadState(kStatePath, 16384);
+    }
+    lockState();
+    String j = "{";
+    j += "\"running\":false,\"phase\":\"" + jsonEsc(s_phase) + "\",";
+    j += "\"deep\":" + String(s_deep ? "true" : "false") + ",";
+    j += "\"lastErr\":\"" + jsonEsc(s_lastErr) + "\",";
+    j += "\"udp\":" + String((unsigned long)s_udpPackets) + ",";
+    j += "\"devices\":" + String((int)s_devices.size()) + ",";
+    j += "\"findings\":" + String((int)s_findings.size()) + ",";
+    j += String("\"json\":\"") + kJsonPath + "\",\"csv\":\"" + kCsvPath + "\",";
+    j += "\"deviceList\":[";
+    for (size_t i = 0; i < s_devices.size(); i++) {
+        const Device &d = s_devices[i];
+        if (i) j += ",";
+        j += "{\"ip\":\"" + jsonEsc(d.ip) + "\",\"name\":\"" + jsonEsc(d.name) +
+             "\",\"model\":\"" + jsonEsc(d.model) + "\",\"service\":\"" + jsonEsc(d.service) +
+             "\",\"port\":" + String((int)d.port) + "}";
+    }
+    j += "],\"findingList\":[";
+    for (size_t i = 0; i < s_findings.size(); i++) {
+        const Finding &f = s_findings[i];
+        if (i) j += ",";
+        j += "{\"ip\":\"" + jsonEsc(f.ip) + "\",\"name\":\"" + jsonEsc(f.name) +
+             "\",\"port\":" + String((int)f.port) + ",\"proto\":\"" + jsonEsc(f.proto) +
+             "\",\"verdict\":\"" + f.verdict + "\",\"risk\":\"" + riskLabel(f.verdict) +
+             "\",\"banner\":\"" + jsonEsc(f.banner) + "\"}";
+    }
+    j += "]}";
+    unlockState();
+    return j;
+}
+
+void lan_auditor_setup() {
+    if (!WiFi.isConnected() && !(WiFi.getMode() & WIFI_MODE_AP)) {
+        displayWarning("Join a network or start the AP first", true);
+        return;
+    }
+    bool deep = s_deep;
+    int choice = -1;
+    options = {
+        {"Start LAN Audit", [&]() { choice = 0; }},
+        {String("Deep probes: ") + (deep ? "ON" : "OFF"), [&]() { deep = !deep; }},
+        {"View Last JSON", [&]() { choice = 1; }},
+        {"Clear Report", [&]() { choice = 2; }},
+        {"Back", [&]() { choice = 3; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "LAN IoT Auditor");
+    options.clear();
+
+    if (choice == 1) {
+        if (LittleFS.exists(kJsonPath)) loopSD(LittleFS, false, "*", "/");
+        else displayInfo("No report yet", true);
+        return;
+    }
+    if (choice == 2) { lanAuditClear(); displayInfo("Report cleared", true); return; }
+    if (choice != 0) return;
+
+    String err;
+    if (!lanAuditStart(deep, &err)) { displayError("Start failed: " + err, true); return; }
+
+    uint32_t lastDraw = 0;
+    while (s_running) {
+        if (check(EscPress)) { lanAuditStop(); break; }
+        if (millis() - lastDraw > 450) {
+            lastDraw = millis();
+            drawMainBorderWithTitle("LAN IoT AUDITOR");
+            lockState();
+            padprintln("Phase : " + s_phase);
+            padprintln("mDNS/SSDP replies : " + String((unsigned long)s_udpPackets));
+            padprintln("Devices  : " + String((int)s_devices.size()));
+            padprintln("Findings : " + String((int)s_findings.size()));
+            padprintln("");
+            int shown = 0;
+            for (const auto &f : s_findings) {
+                if (f.verdict == "OPEN_NO_AUTH" && shown++ < 4) {
+                    padprintln(f.ip + ":" + String(f.port) + " " + f.proto + " NO AUTH");
+                }
+            }
+            unlockState();
+            padprintln("Hold Boot to stop");
+        }
+        vTaskDelay(pdMS_TO_TICKS(30));
+    }
+    displayInfo("Report: /lan_audit.json", true);
+}
+
+#else  // LITE_VERSION
+
+void lan_auditor_setup() {}
+bool lanAuditStart(bool, String *errOut) { if (errOut) *errOut = "LITE build"; return false; }
+void lanAuditStop() {}
+bool lanAuditIsRunning() { return false; }
+void lanAuditClear() {}
+bool lanAuditExport() { return false; }
+String lanAuditGetStateJson() { return "{}"; }
+
+#endif
