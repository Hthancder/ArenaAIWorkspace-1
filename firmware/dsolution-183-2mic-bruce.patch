+static const char *classifyTracker(const NimBLEAdvertisedDevice *dev) {
+    if (!dev) return nullptr;
+
+    // 1. Check Service UUIDs / Service Data UUIDs (Tile 0xFEED, SmartTag 0xFD5A, Google FMD 0xFCF1)
+    if (dev->isAdvertisingService(NimBLEUUID((uint16_t)0xFEED))) return "Tile";
+    if (dev->isAdvertisingService(NimBLEUUID((uint16_t)0xFD5A))) return "SmartTag";
+    if (dev->isAdvertisingService(NimBLEUUID((uint16_t)0xFCF1))) return "Google FMD";
+
+    uint8_t sdCount = dev->getServiceDataCount();
+    for (uint8_t i = 0; i < sdCount; i++) {
+        NimBLEUUID su = dev->getServiceDataUUID(i);
+        if (su == NimBLEUUID((uint16_t)0xFEED)) return "Tile";
+        if (su == NimBLEUUID((uint16_t)0xFD5A)) return "SmartTag";
+        if (su == NimBLEUUID((uint16_t)0xFCF1)) return "Google FMD";
+    }
+
+    // 2. Check Manufacturer Data (Apple 0x004C FindMy/AirTag, Samsung 0x0075)
+    uint8_t mdCount = dev->getManufacturerDataCount();
+    for (uint8_t i = 0; i < mdCount; i++) {
+        std::string md = dev->getManufacturerData(i);
+        if (md.size() < 4) continue;
+        uint16_t cid = (uint8_t)md[0] | ((uint16_t)(uint8_t)md[1] << 8);
+        if (cid == 0x004C) {
+            uint8_t t = (uint8_t)md[2];
+            uint8_t len = (uint8_t)md[3];
+            // Apple FindMy offline-finding (0x12 0x19) or separated/near AirTag (0x12)
+            if (t == 0x12 && (len == 0x19 || md.size() >= 26)) return "AirTag/FindMy";
+            if (t == 0x07 && len == 0x19 && md.size() >= 26) return "Apple Nearby";
+        } else if (cid == 0x0075) {
+            if ((uint8_t)md[2] == 0x42 && (uint8_t)md[3] == 0x04) return "SmartTag";
+        }
+    }
+
+    return nullptr;
+}
+
+static bool saveBleGuardReport(const std::vector<TrackerSighting> &list, uint32_t peakPerSweep, bool flood) {
+    File f = LittleFS.open("/ble_guard.log", FILE_WRITE);
+    if (!f) return false;
+    f.printf(
+        "# Bruce BLE Privacy Guard | Owner: %s | Host: %s.local\n",
+        bruceConfig.ownerName.c_str(),
+        bruceConfig.mdnsHost.c_str()
+    );
+    f.printf("Uptime: %lus | PeakDevices/Sweep: %lu | FloodAlert: %s\n",
+             (unsigned long)(millis() / 1000UL),
+             (unsigned long)peakPerSweep,
+             flood ? "YES" : "NO");
+    f.printf("Trackers detected: %u\n", (unsigned)list.size());
+    for (const auto &t : list) {
+        f.printf("%s | %s | RSSI=%d dBm | hits=%u\n",
+                 t.kind.c_str(), t.mac.c_str(), t.rssi, (unsigned)t.hits);
+    }
+    f.close();
+    return true;
+}
