+constexpr int kProbeRingCap = 24;
+constexpr int kMaxProbeDevices = 48;
+constexpr int kMaxPnlPerDev = 6;
+constexpr int kMaxProbeRawLen = 192;
+
+struct RawProbeItem {
+    uint8_t srcMac[6];
+    int8_t rssi;
+    uint8_t ch;
+    uint16_t len;
+    uint8_t body[kMaxProbeRawLen]; // IE bytes starting after 24-byte 802.11 MAC header
+};
+
+struct ProbeDevice {
+    uint32_t id;
+    uint32_t ieHash;
+    uint8_t lastMac[6];
+    uint16_t macRotations;
+    uint32_t probeCount;
+    int8_t rssi;
+    int8_t peakRssi;
+    uint8_t lastCh;
+    uint32_t firstSeenMs;
+    uint32_t lastSeenMs;
+    bool randomizedMac;
+    bool watched;
+    char osHint[10];
+    std::vector<String> pnls;
+};
+
+struct PnlCount {
+    String ssid;
+    uint16_t hits;
+};
+
+static portMUX_TYPE s_probeMux = portMUX_INITIALIZER_UNLOCKED;
+static RawProbeItem *s_ring = nullptr;
+static volatile int s_ringHead = 0;
+static volatile int s_ringTail = 0;
+static volatile uint32_t s_totalRawProbes = 0;
+static volatile uint32_t s_totalMacSeen = 0;
+
+static void IRAM_ATTR probeRxCb(void *buf, wifi_promiscuous_pkt_type_t type) {
+    if (type != WIFI_PKT_MGMT || !s_ring) return;
+    const wifi_promiscuous_pkt_t *pkt = (const wifi_promiscuous_pkt_t *)buf;
+    if (!pkt || pkt->rx_ctrl.sig_len < 26) return;
+
+    const uint8_t *f = pkt->payload;
+    uint16_t fc = (uint16_t)f[0] | ((uint16_t)f[1] << 8);
+    uint8_t ftype = (fc & 0x0C) >> 2;
+    uint8_t fsub = (fc & 0xF0) >> 4;
+    if (ftype != 0x00 || fsub != 0x04) return; // Probe Request only
+
+    uint16_t ieLen = pkt->rx_ctrl.sig_len - 24;
+    if (ieLen > kMaxProbeRawLen) ieLen = kMaxProbeRawLen;
+
+    portENTER_CRITICAL_ISR(&s_probeMux);
+    s_totalRawProbes++;
+    int next = (s_ringHead + 1) % kProbeRingCap;
+    if (next != s_ringTail) {
+        RawProbeItem &slot = s_ring[s_ringHead];
+        memcpy(slot.srcMac, f + 10, 6);
+        slot.rssi = pkt->rx_ctrl.rssi;
+        slot.ch = pkt->rx_ctrl.channel;
+        slot.len = ieLen;
+        memcpy(slot.body, f + 24, ieLen);
+        s_ringHead = next;
+    }
+    portEXIT_CRITICAL_ISR(&s_probeMux);
+}
+
+static bool popProbeItem(RawProbeItem &out) {
+    bool ok = false;
+    portENTER_CRITICAL(&s_probeMux);
+    if (s_ringTail != s_ringHead && s_ring) {
+        out = s_ring[s_ringTail];
+        s_ringTail = (s_ringTail + 1) % kProbeRingCap;
+        ok = true;
+    }
+    portEXIT_CRITICAL(&s_probeMux);
+    return ok;
+}
+
+static String macToStrShort(const uint8_t *m) {
+    char b[18];
+    snprintf(b, sizeof(b), "%02X:%02X:%02X:%02X:%02X:%02X", m[0], m[1], m[2], m[3], m[4], m[5]);
+    return String(b);
+}
+
+static String jsonEscProbe(const String &in) {
+    String out;
+    out.reserve(in.length() + 6);
+    for (size_t i = 0; i < in.length(); i++) {
+        char c = in[i];
+        if (c == '\\') out += "\\\\";
+        else if (c == '"') out += "\\\"";
+        else if ((uint8_t)c >= 0x20) out += c;
+    }
+    return out;
+}
+
+// Computes stable 32-bit FNV-1a IE fingerprint ignoring Tag 0 (SSID) & Tag 3 (DS channel)
+static void analyzeProbeIE(
+    const uint8_t *body, uint16_t len, const uint8_t *mac,
+    uint32_t &outHash, String &outSsid, char *outOs, size_t osCap
+) {
+    uint32_t h = 2166136261UL;
+    auto fnvByte = [&](uint8_t v) {
+        h ^= v;
+        h *= 16777619UL;
+    };
+
+    outSsid = "";
+    bool hasHt = false, hasVht = false, hasHe = false, hasExtCap = false;
+    bool hasApple = false, hasMsft = false, hasBroadcom = false, hasWps = false;
+
+    uint16_t pos = 0;
+    while (pos + 2 <= len) {
+        uint8_t tag = body[pos];
+        uint8_t tlen = body[pos + 1];
+        if (pos + 2 + tlen > len) break;
+        const uint8_t *tval = body + pos + 2;
+
+        if (tag == 0) {
+            if (tlen > 0 && tlen <= 32) {
+                char sb[33];
+                size_t si = 0;
+                for (uint8_t i = 0; i < tlen; i++) {
+                    char c = (char)tval[i];
+                    if ((uint8_t)c >= 0x20 && (uint8_t)c < 0x7F) sb[si++] = c;
+                }
+                sb[si] = '\0';
+                outSsid = sb;
+            }
+        } else if (tag != 3) { // Ignore DS channel tag so sweep matches across channels
+            fnvByte(tag);
+            fnvByte(tlen);
+            for (uint8_t i = 0; i < tlen; i++) fnvByte(tval[i]);
+            if (tag == 45) hasHt = true;
+            else if (tag == 127) hasExtCap = true;
+            else if (tag == 191) hasVht = true;
+            else if (tag == 255 && tlen >= 1 && tval[0] == 35) hasHe = true;
+            else if (tag == 221 && tlen >= 3) {
+                if (tval[0] == 0x00 && tval[1] == 0x17 && tval[2] == 0xF2) hasApple = true;
+                else if (tval[0] == 0x00 && tval[1] == 0x50 && tval[2] == 0xF2) {
+                    if (tlen >= 4 && tval[3] == 0x04) hasWps = true;
+                    else hasMsft = true;
+                } else if (tval[0] == 0x00 && tval[1] == 0x10 && tval[2] == 0x18) hasBroadcom = true;
+            }
+        }
+        pos += (uint16_t)(2 + tlen);
+    }
+
+    if (h == 0) h = 1;
+    outHash = h;
+
+    bool randMac = (mac[0] & 0x02) != 0;
+    const char *os = "WiFi";
+    if (hasApple || (randMac && hasBroadcom && hasHt)) os = "iOS";
+    else if (hasMsft || hasWps) os = "Win/PC";
+    else if (randMac && hasHe) os = "Mob-6";
+    else if (randMac && (hasVht || hasExtCap)) os = "Andr";
+    else if (!randMac && hasHt && !hasVht) os = "IoT";
+    else if (randMac) os = "Rand";
+    strncpy(outOs, os, osCap - 1);
+    outOs[osCap - 1] = '\0';
+}
+
+static bool exportProbeSnapshot(const std::vector<ProbeDevice> &devs, const std::vector<PnlCount> &pnls) {
+    File jf = LittleFS.open("/probe_radar.json", FILE_WRITE);
+    if (jf) {
+        jf.print("{\"totalProbes\":");
+        jf.print((unsigned long)s_totalRawProbes);
+        jf.print(",\"uniqueMacs\":");
+        jf.print((unsigned long)s_totalMacSeen);
+        jf.print(",\"realDevices\":");
+        jf.print((unsigned)devs.size());
+        jf.print(",\"devices\":[");
+        size_t n = std::min<size_t>(devs.size(), 40);
+        for (size_t i = 0; i < n; i++) {
+            const auto &d = devs[i];
+            if (i > 0) jf.print(",");
+            char hashHex[12];
+            snprintf(hashHex, sizeof(hashHex), "%08lX", (unsigned long)d.ieHash);
+            jf.printf(
+                "{\"id\":%lu,\"ie\":\"%s\",\"os\":\"%s\",\"mac\":\"%s\",\"rot\":%u,\"cnt\":%lu,\"rssi\":%d,"
+                "\"peak\":%d,\"ch\":%u,\"rand\":%s,\"watch\":%s,\"pnls\":[",
+                (unsigned long)d.id,
+                hashHex,
+                d.osHint,
+                macToStrShort(d.lastMac).c_str(),
+                (unsigned)d.macRotations,
+                (unsigned long)d.probeCount,
+                (int)d.rssi,
+                (int)d.peakRssi,
+                (unsigned)d.lastCh,
+                d.randomizedMac ? "true" : "false",
+                d.watched ? "true" : "false"
+            );
+            for (size_t p = 0; p < d.pnls.size(); p++) {
+                if (p > 0) jf.print(",");
+                jf.print("\"" + jsonEscProbe(d.pnls[p]) + "\"");
+            }
+            jf.print("]}");
+        }
+        jf.print("],\"pnls\":[");
+        size_t pn = std::min<size_t>(pnls.size(), 25);
+        for (size_t i = 0; i < pn; i++) {
+            if (i > 0) jf.print(",");
+            jf.print("{\"ssid\":\"" + jsonEscProbe(pnls[i].ssid) + "\",\"hits\":" + String(pnls[i].hits) + "}");
+        }
+        jf.print("]}");
+        jf.close();
+    }
+
+    File cf = LittleFS.open("/probe_radar.csv", FILE_WRITE);
+    if (!cf) return false;
+    cf.println("id,ie_hash,os_hint,last_mac,mac_rotations,probes,rssi,peak_rssi,watched,pnls");
+    for (const auto &d : devs) {
+        String pJoin;
+        for (size_t p = 0; p < d.pnls.size(); p++) {
+            if (p > 0) pJoin += "|";
+            pJoin += d.pnls[p];
+        }
+        cf.printf(
+            "%lu,%08lX,%s,%s,%u,%lu,%d,%d,%d,\"%s\"\n",
+            (unsigned long)d.id,
+            (unsigned long)d.ieHash,
+            d.osHint,
+            macToStrShort(d.lastMac).c_str(),
+            (unsigned)d.macRotations,
+            (unsigned long)d.probeCount,
+            (int)d.rssi,
+            (int)d.peakRssi,
+            d.watched ? 1 : 0,
+            pJoin.c_str()
+        );
+    }
+    cf.close();
+    return true;
+}
+
+static bool startProbeSniffer(uint8_t initCh) {
+    ensureWifiPlatform();
+    nvs_flash_init();
+    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+    esp_err_t e = esp_wifi_init(&cfg);
+    if (e != ESP_OK && e != ESP_ERR_WIFI_INIT_STATE) return false;
+    esp_wifi_set_storage(WIFI_STORAGE_RAM);
+    esp_wifi_set_mode(WIFI_MODE_STA);
+    esp_wifi_start();
+    esp_wifi_disconnect();
+    esp_wifi_set_promiscuous(true);
+    wifi_promiscuous_filter_t filt = {};
+    filt.filter_mask = WIFI_PROMIS_FILTER_MASK_MGMT;
+    esp_wifi_set_promiscuous_filter(&filt);
+    esp_wifi_set_promiscuous_rx_cb(probeRxCb);
+    esp_wifi_set_channel(initCh, WIFI_SECOND_CHAN_NONE);
+    return true;
+}
+
+static void stopProbeSniffer() {
+    esp_wifi_set_promiscuous(false);
+    esp_wifi_set_promiscuous_rx_cb(NULL);
+    esp_wifi_stop();
+    wifiDisconnect();
+    vTaskDelay(pdMS_TO_TICKS(10));
+}
+
+} // namespace
+
+void probe_radar_setup() {
+    cleanlyStopWebUiForWiFiFeature();
+    radioFreeBleForWifi();
+    if (!radioHasMemForWifi()) {
+        displayError("Low DMA RAM for WiFi", true);
+        return;
+    }
+
+    s_ring = (RawProbeItem *)calloc(kProbeRingCap, sizeof(RawProbeItem));
+    if (!s_ring) {
+        displayError("Out of RAM", true);
+        return;
+    }
+    s_ringHead = 0;
+    s_ringTail = 0;
+    s_totalRawProbes = 0;
+    s_totalMacSeen = 0;
+
+    static const uint8_t kSweepCh[] = {1, 6, 11, 2, 7, 12, 3, 8, 13, 4, 9, 5, 10};
+    int chIdx = 0;
+    bool chLocked = false;
+    uint8_t curCh = kSweepCh[0];
+
+    if (!startProbeSniffer(curCh)) {
+        free(s_ring);
+        s_ring = nullptr;
+        displayError("WiFi init failed", true);
+        return;
+    }
+
+    std::vector<ProbeDevice> devs;
+    std::vector<PnlCount> pnls;
+    std::vector<uint64_t> seenMacKeys;
+    uint32_t nextDevId = 1;
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    int viewMode = 0; // 0 = Real Devices, 1 = PNL Hotlist
+    int cursor = 0;
+    int scroll = 0;
+    uint32_t lastChHop = millis();
+    uint32_t lastDraw = 0;
+    uint32_t lastWatchAlertAt = 0;
+    String watchBanner = "";
+    uint32_t watchBannerUntil = 0;
+    returnToMenu = false;
+
+    while (!returnToMenu) {
+        InputHandler();
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+
+        // Hop channels every 220ms unless locked
+        if (!chLocked && (millis() - lastChHop) >= 220) {
+            lastChHop = millis();
+            chIdx = (chIdx + 1) % (sizeof(kSweepCh) / sizeof(kSweepCh[0]));
+            curCh = kSweepCh[chIdx];
+            esp_wifi_set_channel(curCh, WIFI_SECOND_CHAN_NONE);
+        }
+
+        // Drain incoming probe requests
+        RawProbeItem item;
+        int drained = 0;
+        while (drained < 12 && popProbeItem(item)) {
+            drained++;
+            uint64_t mk = 0;
+            for (int i = 0; i < 6; i++) mk = (mk << 8) | item.srcMac[i];
+            if (std::find(seenMacKeys.begin(), seenMacKeys.end(), mk) == seenMacKeys.end()) {
+                if (seenMacKeys.size() < 256) seenMacKeys.push_back(mk);
+                s_totalMacSeen++;
+            }
+
+            uint32_t ieHash = 0;
+            String ssid;
+            char osHint[10];
+            analyzeProbeIE(item.body, item.len, item.srcMac, ieHash, ssid, osHint, sizeof(osHint));
+
+            if (!ssid.isEmpty()) {
+                bool foundPnl = false;
+                for (auto &p : pnls) {
+                    if (p.ssid == ssid) {
+                        p.hits++;
+                        foundPnl = true;
+                        break;
+                    }
+                }
+                if (!foundPnl && pnls.size() < 64) pnls.push_back({ssid, 1});
+            }
+
+            // Match existing device: exact MAC or same IE fingerprint within 10 min (anti-random-MAC)
+            uint32_t now = millis();
+            int match = -1;
+            bool isRand = (item.srcMac[0] & 0x02) != 0;
+            for (size_t i = 0; i < devs.size(); i++) {
+                if (memcmp(devs[i].lastMac, item.srcMac, 6) == 0) {
+                    match = (int)i;
+                    break;
+                }
+                if (isRand && devs[i].randomizedMac && devs[i].ieHash == ieHash &&
+                    strcmp(devs[i].osHint, osHint) == 0 && (now - devs[i].lastSeenMs) < 600000UL) {
+                    match = (int)i;
+                    break;
+                }
+            }
+
+            if (match < 0) {
+                if (devs.size() >= kMaxProbeDevices) {
+                    // Evict oldest unwatched device
+                    int evict = -1;
+                    uint32_t oldest = UINT32_MAX;
+                    for (size_t i = 0; i < devs.size(); i++) {
+                        if (!devs[i].watched && devs[i].lastSeenMs < oldest) {
+                            oldest = devs[i].lastSeenMs;
+                            evict = (int)i;
+                        }
+                    }
+                    if (evict >= 0) devs.erase(devs.begin() + evict);
+                }
+                if (devs.size() < kMaxProbeDevices) {
+                    ProbeDevice d;
+                    d.id = nextDevId++;
+                    d.ieHash = ieHash;
+                    memcpy(d.lastMac, item.srcMac, 6);
+                    d.macRotations = 1;
+                    d.probeCount = 1;
+                    d.rssi = item.rssi;
+                    d.peakRssi = item.rssi;
+                    d.lastCh = item.ch;
+                    d.firstSeenMs = now;
+                    d.lastSeenMs = now;
+                    d.randomizedMac = isRand;
+                    d.watched = false;
+                    strncpy(d.osHint, osHint, sizeof(d.osHint));
+                    if (!ssid.isEmpty()) d.pnls.push_back(ssid);
+                    devs.push_back(d);
+                }
+            } else {
+                ProbeDevice &d = devs[match];
+                if (memcmp(d.lastMac, item.srcMac, 6) != 0) {
+                    memcpy(d.lastMac, item.srcMac, 6);
+                    d.macRotations++;
+                }
+                d.probeCount++;
+                d.rssi = (int8_t)((d.rssi * 3 + item.rssi) / 4);
+                if (item.rssi > d.peakRssi) d.peakRssi = item.rssi;
+                d.lastCh = item.ch;
+                d.lastSeenMs = now;
+                if (!ssid.isEmpty()) {
+                    if (std::find(d.pnls.begin(), d.pnls.end(), ssid) == d.pnls.end() &&
+                        d.pnls.size() < kMaxPnlPerDev) {
+                        d.pnls.push_back(ssid);
+                    }
+                }
+                if (d.watched && item.rssi > -62 && (now - lastWatchAlertAt) > 8000UL) {
+                    lastWatchAlertAt = now;
+                    watchBanner = "WATCH #" + String(d.id) + " NEAR (" + String(item.rssi) + "dBm)";
+                    watchBannerUntil = now + 4000UL;
+                    setLedColor(CRGB::OrangeRed);
+                    if (bruceConfig.soundEnabled) _tone(2600, 70);
+                }
+            }
+        }
+
+        if (check(PrevPress)) {
+            if (cursor > 0) cursor--;
+            lastDraw = 0;
+        }
+        if (check(NextPress)) {
+            cursor++;
+            lastDraw = 0;
+        }
+        if (check(SelPress)) {
+            int act = -1;
+            bool hasDev = (viewMode == 0 && !devs.empty() && cursor < (int)devs.size());
+            options.clear();
+            if (hasDev) {
+                options.push_back({"Inspect Selected Device", [&]() { act = 0; }});
+                options.push_back({devs[cursor].watched ? "Unwatch Device" : "Pin / Watch Device", [&]() { act = 1; }});
+            }
+            options.push_back({viewMode == 0 ? "View: PNL Hotlist" : "View: Real Devices", [&]() { act = 2; }});
+            options.push_back({chLocked ? "Unlock Channel Sweep" : ("Lock CH " + String(curCh)), [&]() { act = 3; }});
+            options.push_back({"Export Snapshot (JSON/CSV)", [&]() { act = 4; }});
+            options.push_back({"Clear Capture", [&]() { act = 5; }});
+            options.push_back({"Exit", [&]() { act = 6; }});
+            loopOptions(options, MENU_TYPE_SUBMENU, "Probe Radar Menu");
+            options.clear();
+
+            if (act == 0 && hasDev) {
+                const auto &d = devs[cursor];
+                String info = "Dev #" + String(d.id) + " [" + String(d.osHint) + "]\n";
+                info += "IE Hash: " + String(d.ieHash, HEX) + "\n";
+                info += "MAC: " + macToStrShort(d.lastMac) + " (x" + String(d.macRotations) + ")\n";
+                info += "RSSI: " + String(d.rssi) + " dBm (Peak " + String(d.peakRssi) + ")\n";
+                info += "Probes: " + String(d.probeCount) + "\nPNLs:\n";
+                if (d.pnls.empty()) info += "  (broadcast / anonymous)";
+                else {
+                    for (const auto &s : d.pnls) info += "  - " + s + "\n";
+                }
+                displayInfo(info, true);
+            } else if (act == 1 && hasDev) {
+                devs[cursor].watched = !devs[cursor].watched;
+            } else if (act == 2) {
+                viewMode = 1 - viewMode;
+                cursor = 0;
+                scroll = 0;
+            } else if (act == 3) {
+                chLocked = !chLocked;
+            } else if (act == 4) {
+                std::sort(pnls.begin(), pnls.end(), [](const PnlCount &a, const PnlCount &b) {
+                    return a.hits > b.hits;
+                });
+                displayInfo(exportProbeSnapshot(devs, pnls) ? "Saved /probe_radar.json & .csv" : "Save failed", true);
+            } else if (act == 5) {
+                devs.clear();
+                pnls.clear();
+                seenMacKeys.clear();
+                s_totalRawProbes = 0;
+                s_totalMacSeen = 0;
+                cursor = 0;
+                scroll = 0;
+            } else if (act == 6) {
+                returnToMenu = true;
+                break;
+            }
+            lastDraw = 0;
+        }
+
+        if (millis() - lastDraw >= 260) {
+            lastDraw = millis();
+            // Sort by watched -> most recently seen -> strongest signal
+            std::sort(devs.begin(), devs.end(), [](const ProbeDevice &a, const ProbeDevice &b) {
+                if (a.watched != b.watched) return a.watched > b.watched;
+                bool aRecent = (millis() - a.lastSeenMs) < 12000UL;
+                bool bRecent = (millis() - b.lastSeenMs) < 12000UL;
+                if (aRecent != bRecent) return aRecent > bRecent;
+                return a.rssi > b.rssi;
+            });
+            std::sort(pnls.begin(), pnls.end(), [](const PnlCount &a, const PnlCount &b) {
+                return a.hits > b.hits;
+            });
+
+            if (hasSprite) {
+                const uint16_t bg = bruceConfig.bgColor;
+                const uint16_t pri = bruceConfig.priColor;
+                const uint16_t sec = bruceConfig.secColor;
+                const uint16_t okCol = 0x2F2F;
+                const uint16_t warnCol = 0xFD84;
+                const uint16_t errCol = 0xF9CA;
+
+                frame.fillScreen(bg);
+                bool alertNow = (millis() < watchBannerUntil);
+                uint16_t hdrBg = alertNow ? TFT_RED : blendColors(bg, pri, 28);
+                frame.fillRect(0, 0, tftWidth, 24, hdrBg);
+                frame.setTextSize(1);
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(alertNow ? TFT_WHITE : pri, hdrBg);
+                frame.drawString(alertNow ? watchBanner : (viewMode == 0 ? "PROBE IE RADAR" : "PNL SSID HOTLIST"), 8, 12);
+                frame.setTextDatum(MR_DATUM);
+                frame.setTextColor(TFT_WHITE, hdrBg);
+                frame.drawString((chLocked ? "L:" : "CH") + String(curCh), tftWidth - 8, 12);
+
+                // Counter strip
+                frame.fillRoundRect(6, 28, tftWidth - 12, 22, 4, blendColors(bg, pri, 12));
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 12));
+                frame.drawString(
+                    "Real Dev: " + String(devs.size()) + "  |  MACs: " + String((unsigned long)s_totalMacSeen) +
+                        "  |  PNLs: " + String(pnls.size()),
+                    tftWidth / 2,
+                    39
+                );
+
+                const int listY = 55;
+                if (viewMode == 0) {
+                    const int rowH = 38;
+                    const int visible = 4;
+                    if (devs.empty()) {
+                        cursor = 0;
+                        scroll = 0;
+                        frame.setTextDatum(MC_DATUM);
+                        frame.setTextColor(sec, bg);
+                        frame.drawString("Listening for 802.11 Probe Requests...", tftWidth / 2, 130);
+                        frame.drawString("Anti-Random-MAC IE Hash Active", tftWidth / 2, 146);
+                    } else {
+                        if (cursor >= (int)devs.size()) cursor = (int)devs.size() - 1;
+                        if (cursor < scroll) scroll = cursor;
+                        if (cursor >= scroll + visible) scroll = cursor - visible + 1;
+
+                        for (int r = 0; r < visible && (scroll + r) < (int)devs.size(); r++) {
+                            int di = scroll + r;
+                            const ProbeDevice &d = devs[di];
+                            int ry = listY + r * (rowH + 3);
+                            bool sel = (di == cursor);
+                            uint16_t cardBg = blendColors(bg, pri, sel ? 22 : 9);
+                            frame.fillRoundRect(6, ry, tftWidth - 12, rowH, 5, cardBg);
+                            if (sel) frame.drawRoundRect(6, ry, tftWidth - 12, rowH, 5, pri);
+
+                            uint16_t sigCol = (d.rssi > -60) ? okCol : ((d.rssi > -76) ? warnCol : errCol);
+                            frame.fillRoundRect(9, ry + 4, 4, rowH - 8, 2, d.watched ? TFT_RED : sigCol);
+
+                            frame.setTextDatum(ML_DATUM);
+                            frame.setTextColor(d.watched ? errCol : pri, cardBg);
+                            String top = "#" + String(d.id) + " [" + String(d.osHint) + "]";
+                            if (d.watched) top += " *WATCH";
+                            frame.drawString(top, 18, ry + 11);
+
+                            frame.setTextDatum(MR_DATUM);
+                            frame.setTextColor(sigCol, cardBg);
+                            String rt = String(d.rssi) + "dB  x" + String(d.macRotations) + "M";
+                            frame.drawString(rt, tftWidth - 12, ry + 11);
+
+                            frame.setTextDatum(ML_DATUM);
+                            frame.setTextColor(sec, cardBg);
+                            String sub;
+                            if (d.pnls.empty()) {
+                                sub = "MAC:" + macToStrShort(d.lastMac).substring(9) + " (No SSID)";
+                            } else {
+                                sub = "Seek: ";
+                                for (size_t p = 0; p < d.pnls.size(); p++) {
+                                    if (p > 0) sub += ", ";
+                                    sub += d.pnls[p];
+                                }
+                            }
+                            if (sub.length() > 40) sub = sub.substring(0, 38) + "..";
+                            frame.drawString(sub, 18, ry + 26);
+                        }
+                    }
+                } else {
+                    const int rowH = 24;
+                    const int visible = 6;
+                    if (pnls.empty()) {
+                        frame.setTextDatum(MC_DATUM);
+                        frame.setTextColor(sec, bg);
+                        frame.drawString("No named SSID probes captured yet", tftWidth / 2, 134);
+                    } else {
+                        if (cursor >= (int)pnls.size()) cursor = (int)pnls.size() - 1;
+                        if (cursor < scroll) scroll = cursor;
+                        if (cursor >= scroll + visible) scroll = cursor - visible + 1;
+                        for (int r = 0; r < visible && (scroll + r) < (int)pnls.size(); r++) {
+                            int pi = scroll + r;
+                            int ry = listY + r * (rowH + 2);
+                            bool sel = (pi == cursor);
+                            uint16_t cardBg = blendColors(bg, pri, sel ? 20 : 8);
+                            frame.fillRoundRect(6, ry, tftWidth - 12, rowH, 4, cardBg);
+                            frame.setTextDatum(ML_DATUM);
+                            frame.setTextColor(TFT_WHITE, cardBg);
+                            frame.drawString(pnls[pi].ssid.substring(0, 30), 12, ry + 12);
+                            frame.setTextDatum(MR_DATUM);
+                            frame.setTextColor(pri, cardBg);
+                            frame.drawString(String(pnls[pi].hits) + "x", tftWidth - 12, ry + 12);
+                        }
+                    }
+                }
+
+                frame.fillRect(0, tftHeight - 20, tftWidth, 20, blendColors(bg, pri, 14));
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 14));
+                frame.drawString("Vol-/+:Scroll   Boot:Inspect/Pin   Hold:Exit", tftWidth / 2, tftHeight - 10);
+                frame.pushSprite(0, 0);
+            }
+            wakeUpScreen();
+        }
+        vTaskDelay(pdMS_TO_TICKS(15));
+    }
+
+    if (!devs.empty()) {
+        std::sort(pnls.begin(), pnls.end(), [](const PnlCount &a, const PnlCount &b) {
+            return a.hits > b.hits;
+        });
+        exportProbeSnapshot(devs, pnls);
+    }
+
+    if (hasSprite) frame.deleteSprite();
+    stopProbeSniffer();
+    free(s_ring);
+    s_ring = nullptr;
+    setLedColor(CRGB::Black);
+    tft.fillScreen(bruceConfig.bgColor);
+}
