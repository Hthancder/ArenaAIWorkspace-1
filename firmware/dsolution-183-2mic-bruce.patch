+const char *getFeatureShortDesc(const String &itemLabel) {
+    const FeatureEntry *e = findFeatureEntry(itemLabel, "");
+    if (e && e->shortDesc) return e->shortDesc;
+    return "Hold Boot / [B+V+]: Feature Guide";
+}
+
+void showFeatureGuide(const String &itemLabel, const String &menuContext) {
+    const FeatureEntry *entry = findFeatureEntry(itemLabel, menuContext);
+
+    String tag = entry ? String(entry->tag) : "INFO";
+    String title = entry ? String(entry->title) : itemLabel;
+    String body;
+    if (entry) {
+        body = String(entry->body);
+    } else {
+        body = "# OVERVIEW\n"
+               "Selected option: " + itemLabel +
+               (menuContext.length() > 0 ? " (inside " + menuContext + ")" : "") + ".\n"
+               "# HOW TO USE\n"
+               "- Use Vol- / Vol+ (tap or hold) to browse items.\n"
+               "- Press Boot to run or toggle this option.\n"
+               "- Hold Boot (or Vol- + Vol+) to go back.\n"
+               "# CONTROLS & TIPS\n"
+               "- Open WebUI at http://bruce.local to manage files, run scripts, or view this screen remotely.";
+    }
+
+    const int outerL = BORDER_OFFSET_FROM_SCREEN_EDGE + 1;
+    const int outerR = tftWidth - BORDER_OFFSET_FROM_SCREEN_EDGE - 1;
+    const int outerW = outerR - outerL;
+
+    const int hdrY = BORDER_OFFSET_FROM_SCREEN_EDGE + 2;
+    const int hdrH = 26;
+    const int footH = LH * FP + 6;
+    const int footY = tftHeight - BORDER_OFFSET_FROM_SCREEN_EDGE - footH - 1;
+    const int contentTop = hdrY + hdrH + 4;
+    const int contentBottom = footY - 3;
+    const int contentH = contentBottom - contentTop;
+
+    const int textPadL = outerL + 6;
+    const int scrollBarW = 6;
+    const int maxChars = max(20, (outerW - 14 - scrollBarW) / (LW * FP));
+
+    std::vector<GuideLine> lines = buildWrappedLines(body, maxChars);
+
+    auto lineHeight = [](GuideLineType t) -> int {
+        switch (t) {
+            case GL_SECTION: return LH * FP + 8;
+            case GL_EMPTY: return 4;
+            default: return LH * FP + 4;
+        }
+    };
+
+    // Determine how many lines fit from a given start index
+    auto calcVisibleEnd = [&](int startIdx) -> int {
+        int usedH = 0;
+        int i = startIdx;
+        while (i < (int)lines.size()) {
+            int lh = lineHeight(lines[i].type);
+            if (usedH + lh > contentH && i > startIdx) break;
+            usedH += lh;
+            i++;
+        }
+        return i;
+    };
+
+    // Find maximum topLine so the last page fills nicely without blank bottom space
+    int maxTop = 0;
+    for (int cand = 0; cand < (int)lines.size(); cand++) {
+        int endIdx = calcVisibleEnd(cand);
+        if (endIdx >= (int)lines.size()) {
+            maxTop = cand;
+            break;
+        }
+    }
+
+    uint16_t hdrBg = blendColors(bruceConfig.bgColor, bruceConfig.priColor, 26);
+    uint16_t hdrBorder = blendColors(bruceConfig.bgColor, bruceConfig.priColor, 110);
+    uint16_t secBarBg = blendColors(bruceConfig.bgColor, bruceConfig.priColor, 34);
+    uint16_t bodyTextCol = blendColors(bruceConfig.priColor, 0xFFFF, 155);
+    uint16_t footBg = blendColors(bruceConfig.bgColor, bruceConfig.priColor, 16);
+    uint16_t footLine = blendColors(bruceConfig.bgColor, bruceConfig.priColor, 65);
+    uint16_t footFg = blendColors(bruceConfig.bgColor, bruceConfig.priColor, 170);
+
+    // Draw outer frame & static header once
+    tft.fillScreen(bruceConfig.bgColor);
+    tft.drawRoundRect(
+        BORDER_OFFSET_FROM_SCREEN_EDGE,
+        BORDER_OFFSET_FROM_SCREEN_EDGE,
+        tftWidth - 2 * BORDER_OFFSET_FROM_SCREEN_EDGE,
+        tftHeight - 2 * BORDER_OFFSET_FROM_SCREEN_EDGE,
+        6,
+        hdrBorder
+    );
+    tft.fillRoundRect(outerL + 2, hdrY, outerW - 4, hdrH, 5, hdrBg);
+    tft.drawRoundRect(outerL + 2, hdrY, outerW - 4, hdrH, 5, hdrBorder);
+
+    // Tag pill on the left
+    int pillW = tag.length() * LW * FP + 10;
+    int pillX = outerL + 7;
+    int pillY = hdrY + (hdrH - (LH * FP + 4)) / 2;
+    tft.fillRoundRect(pillX, pillY, pillW, LH * FP + 4, 3, bruceConfig.priColor);
+    tft.setTextSize(FP);
+    tft.setTextColor(bruceConfig.bgColor, bruceConfig.priColor);
+    tft.drawCentreString(tag, pillX + pillW / 2, pillY + 2, 1);
+
+    // Title to the right of tag pill
+    int titleX = pillX + pillW + 7;
+    int availTitleW = outerR - 8 - titleX;
+    uint8_t titleSz = ((int)title.length() * LW * FM <= availTitleW) ? FM : FP;
+    int maxTitleChars = max(4, availTitleW / (LW * titleSz));
+    tft.setTextSize(titleSz);
+    tft.setTextColor(bruceConfig.priColor, hdrBg);
+    tft.drawString(
+        title.substring(0, maxTitleChars),
+        titleX,
+        hdrY + (hdrH - LH * titleSz) / 2
+    );
+
+    int topLine = 0;
+    bool redraw = true;
+
+    // Drain residual key states from the combo that opened this guide
+    vTaskDelay(pdMS_TO_TICKS(160));
+    check(AnyKeyPress);
+    check(SelPress);
+    check(EscPress);
+    check(NextPagePress);
+    check(PrevPagePress);
+
+    while (true) {
+        if (redraw) {
+            tft.fillRect(outerL + 1, contentTop, outerW - 2, contentH, bruceConfig.bgColor);
+
+            int y = contentTop;
+            int visEnd = calcVisibleEnd(topLine);
+            for (int i = topLine; i < visEnd; i++) {
+                const GuideLine &gl = lines[i];
+                int lh = lineHeight(gl.type);
+                if (gl.type == GL_SECTION) {
+                    int barH = LH * FP + 5;
+                    tft.fillRoundRect(textPadL - 1, y + 1, outerW - 14 - scrollBarW, barH, 3, secBarBg);
+                    tft.fillRect(textPadL - 1, y + 1, 3, barH, bruceConfig.priColor);
+                    tft.setTextSize(FP);
+                    tft.setTextColor(bruceConfig.priColor, secBarBg);
+                    tft.drawString(gl.text, textPadL + 6, y + 3);
+                } else if (gl.type == GL_BULLET) {
+                    tft.setTextSize(FP);
+                    if (gl.prefix == "*") {
+                        tft.fillRect(textPadL + 2, y + 4, 4, 4, bruceConfig.priColor);
+                    } else if (gl.prefix.length() > 0) {
+                        tft.setTextColor(bruceConfig.priColor, bruceConfig.bgColor);
+                        tft.drawString(gl.prefix, textPadL, y + 1);
+                    }
+                    tft.setTextColor(bodyTextCol, bruceConfig.bgColor);
+                    tft.drawString(gl.text, textPadL + 16, y + 1);
+                } else if (gl.type == GL_TEXT) {
+                    tft.setTextSize(FP);
+                    tft.setTextColor(bodyTextCol, bruceConfig.bgColor);
+                    tft.drawString(gl.text, textPadL + 1, y + 1);
+                }
+                y += lh;
+            }
+
+            // Slim vertical scrollbar
+            int barX = outerR - 6;
+            int trackH = contentH - 4;
+            int trackY = contentTop + 2;
+            uint16_t trackCol = blendColors(bruceConfig.bgColor, bruceConfig.priColor, 32);
+            tft.fillRoundRect(barX, trackY, 3, trackH, 1, trackCol);
+            if (maxTop > 0) {
+                int visCount = max(1, visEnd - topLine);
+                int thumbH = max(10, trackH * visCount / (int)lines.size());
+                int thumbY = trackY + (trackH - thumbH) * topLine / maxTop;
+                tft.fillRoundRect(barX, thumbY, 3, thumbH, 1, bruceConfig.priColor);
+            } else {
+                tft.fillRoundRect(barX, trackY, 3, trackH, 1, bruceConfig.priColor);
+            }
+
+            // Footer strip with controls + scroll indicator
+            tft.drawFastHLine(outerL + 1, footY - 1, outerW - 2, footLine);
+            tft.fillRect(outerL + 1, footY, outerW - 2, footH, footBg);
+            tft.setTextSize(FP);
+            tft.setTextColor(footFg, footBg);
+            tft.drawString("[-/+]:Scroll  [Boot]:Close", outerL + 6, footY + 3);
+            String posStr = String(topLine + 1) + "-" + String(visEnd) + "/" + String(lines.size());
+            tft.setTextColor(bruceConfig.priColor, footBg);
+            tft.drawRightString(posStr, outerR - 6, footY + 3, 1);
+
+            redraw = false;
+        }
+
+        if (check(SelPress) || check(EscPress)) { break; }
+
+        if (check(NextPress) || check(DownPress)) {
+            if (topLine < maxTop) {
+                topLine++;
+                redraw = true;
+            }
+        } else if (check(PrevPress) || check(UpPress)) {
+            if (topLine > 0) {
+                topLine--;
+                redraw = true;
+            }
+        } else if (check(NextPagePress)) {
+            int step = max(4, (calcVisibleEnd(topLine) - topLine) - 2);
+            int nextTop = min(maxTop, topLine + step);
+            if (nextTop != topLine) {
+                topLine = nextTop;
+                redraw = true;
+            }
+        } else if (check(PrevPagePress)) {
+            int step = max(4, (calcVisibleEnd(topLine) - topLine) - 2);
+            int prevTop = max(0, topLine - step);
+            if (prevTop != topLine) {
+                topLine = prevTop;
+                redraw = true;
+            }
+        }
+
+        vTaskDelay(pdMS_TO_TICKS(15));
+    }
+    vTaskDelay(pdMS_TO_TICKS(140));
+    check(AnyKeyPress);
+    check(SelPress);
+    check(EscPress);
+    check(NextPagePress);
+    check(PrevPagePress);
+}
