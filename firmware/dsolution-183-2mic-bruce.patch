+static String pickDuckyScriptForComposite() {
+    std::vector<String> scripts;
+    const char *dirs[2] = {kVaultDir, "/"};
+    for (const char *dpath : dirs) {
+        if (!LittleFS.exists(dpath)) continue;
+        File dir = LittleFS.open(dpath);
+        if (!dir) continue;
+        while (true) {
+            bool isDir = false;
+            String p = dir.getNextFileName(&isDir);
+            if (p.isEmpty()) break;
+            if (!isDir && (p.endsWith(".txt") || p.endsWith(".duck"))) {
+                if (std::find(scripts.begin(), scripts.end(), p) == scripts.end()) scripts.push_back(p);
+            }
+        }
+        dir.close();
+    }
+    if (scripts.empty()) {
+        displayWarning("No .txt script in LittleFS or /usb_vault", true);
+        return "";
+    }
+    int sel = -1;
+    options.clear();
+    for (size_t i = 0; i < scripts.size() && i < 14; i++) {
+        options.push_back({scripts[i], [&, i]() { sel = (int)i; }});
+    }
+    options.push_back({"Cancel", [&]() { sel = -1; }});
+    loopOptions(options, MENU_TYPE_SUBMENU, "Pick BadUSB Script");
+    options.clear();
+    return (sel >= 0) ? scripts[sel] : String("");
+}
