+static bool isTrackerHeuristic(const String &dom) {
+    static const char *const kTrkPatterns[] = {
+        "doubleclick", "googlesyndication", "google-analytics", "googletagmanager",
+        "adservice", "app-measurement", "crashlytics", "telemetry", "analytics",
+        "metrics.", "pixel.", "tracking.", "tracker.", "ads.", "adsystem",
+        "scorecardresearch", "appsflyer", "adjust.com", "mixpanel", "amplitude",
+        "branch.io", "logx.", "umeng", "flurry", "taboola", "outbrain"
+    };
+    for (const char *p : kTrkPatterns) {
+        if (dom.indexOf(p) >= 0) return true;
+    }
+    return false;
+}
+
+static bool isDomainBlockedLocked(const String &domLower, bool &outTracker) {
+    loadBlockListLocked();
+    outTracker = isTrackerHeuristic(domLower);
+    for (const auto &b : s_blockDomains) {
+        if (domLower == b) return true;
+        if (domLower.length() > b.length() && domLower.endsWith("." + b)) return true;
+    }
+    if (s_autoBlockTrackers && outTracker) return true;
+    return false;
+}
+
+// Parses RFC1035 QNAME starting at offset 12. Returns end offset of QNAME (after 0-byte) or 0 on error.
+static size_t parseDnsQuestionName(const uint8_t *pkt, size_t len, char *outDomain, size_t outCap, uint16_t &outQtype) {
+    outDomain[0] = '\0';
+    outQtype = 1;
+    if (len < 17) return 0; // 12 hdr + >=1 qname + 4 qtype/qclass
+    size_t pos = 12;
+    size_t outLen = 0;
+    uint8_t jumps = 0;
+    while (pos < len && jumps < 64) {
+        uint8_t lab = pkt[pos++];
+        if (lab == 0) {
+            if (pos + 4 <= len) {
+                outQtype = ((uint16_t)pkt[pos] << 8) | pkt[pos + 1];
+            }
+            return pos;
+        }
+        if ((lab & 0xC0) != 0 || pos + lab > len) return 0; // compressed or malformed QNAME
+        if (outLen > 0 && outLen + 1 < outCap) outDomain[outLen++] = '.';
+        for (uint8_t i = 0; i < lab; i++) {
+            char c = (char)pkt[pos++];
+            if (c >= 'A' && c <= 'Z') c = (char)(c + 32);
+            if ((uint8_t)c >= 0x20 && (uint8_t)c < 0x7F && outLen + 1 < outCap) {
+                outDomain[outLen++] = c;
+            }
+        }
+        jumps++;
+    }
+    outDomain[outLen] = '\0';
+    return 0;
+}
+
+// Builds minimal zero-IP (0.0.0.0) or NXDOMAIN response for blocked domain so client fails fast cleanly.
+static size_t buildBlockedDnsResponse(const uint8_t *req, size_t reqLen, size_t qnameEnd, uint16_t qtype, uint8_t *resp, size_t respCap) {
+    size_t qEnd = qnameEnd + 4;
+    if (qEnd > reqLen || qEnd + 16 > respCap) return 0;
+    memcpy(resp, req, qEnd);
+    resp[2] = 0x81; // QR=1, RD=1
+    resp[3] = 0x80; // RA=1, RCODE=0 (NOERROR)
+    resp[4] = 0x00;
+    resp[5] = 0x01; // QDCOUNT=1
+    resp[8] = 0x00;
+    resp[9] = 0x00;
+    resp[10] = 0x00;
+    resp[11] = 0x00;
+
+    if (qtype == 1) { // A -> 0.0.0.0
+        resp[6] = 0x00;
+        resp[7] = 0x01; // ANCOUNT=1
+        size_t o = qEnd;
+        resp[o++] = 0xC0;
+        resp[o++] = 0x0C; // Pointer to QNAME
+        resp[o++] = 0x00;
+        resp[o++] = 0x01; // TYPE A
+        resp[o++] = 0x00;
+        resp[o++] = 0x01; // CLASS IN
+        resp[o++] = 0x00;
+        resp[o++] = 0x00;
+        resp[o++] = 0x00;
+        resp[o++] = 0x3C; // TTL 60s
+        resp[o++] = 0x00;
+        resp[o++] = 0x04; // RDLENGTH 4
+        resp[o++] = 0x00;
+        resp[o++] = 0x00;
+        resp[o++] = 0x00;
+        resp[o++] = 0x00;
+        return o;
+    }
+
+    // AAAA / HTTPS / other -> empty NOERROR answer (prevents fallback stall)
+    resp[6] = 0x00;
+    resp[7] = 0x00;
+    return qEnd;
+}
+
+static void recordDnsEvent(const IPAddress &cli, const char *domain, uint16_t qtype, bool blocked, bool tracker) {
+    ensureNaptMutex();
+    if (xSemaphoreTake(s_naptMutex, pdMS_TO_TICKS(50)) != pdTRUE) return;
+    DnsFeedEntry &e = s_feed[s_feedHead];
+    e.tsSec = millis() / 1000UL;
+    e.seq = ++s_feedSeq;
+    snprintf(e.clientIp, sizeof(e.clientIp), "%u.%u.%u.%u", cli[0], cli[1], cli[2], cli[3]);
+    strncpy(e.domain, domain, sizeof(e.domain) - 1);
+    e.domain[sizeof(e.domain) - 1] = '\0';
+    e.qtype = qtype;
+    e.blocked = blocked;
+    e.tracker = tracker;
+    s_feedHead = (s_feedHead + 1) % kNaptLogCap;
+    if (s_feedCount < kNaptLogCap) s_feedCount++;
+    s_totalQueries++;
+    if (blocked) s_blockedQueries++;
+    if (tracker) s_trackerQueries++;
+    xSemaphoreGive(s_naptMutex);
+}
+
+static void naptDnsProxyTask(void *pv) {
+    (void)pv;
+    WiFiUDP localDns;
+    WiFiUDP upDns;
+    PendingDnsSlot pending[kPendingDnsMax] = {};
+    uint8_t pktBuf[kMaxDnsPacket];
+    uint8_t respBuf[kMaxDnsPacket];
+    uint16_t nextUpId = 0x2100;
+
+    bool localOk = localDns.begin(53);
+    bool upOk = upDns.begin(53540);
+    if (!localOk || !upOk) {
+        Serial.printf("[NAPT] DNS proxy socket init failed (53=%d, up=%d)\n", localOk, upOk);
+        localDns.stop();
+        upDns.stop();
+        s_naptRunning = false;
+        s_naptTask = nullptr;
+        vTaskDelete(NULL);
+        return;
+    }
+
+    while (!s_naptStopReq) {
+        int plen = localDns.parsePacket();
+        if (plen > 0) {
+            int rlen = localDns.read(pktBuf, sizeof(pktBuf));
+            if (rlen >= 17 && (pktBuf[2] & 0x80) == 0) {
+                char domain[64];
+                uint16_t qtype = 1;
+                size_t qend = parseDnsQuestionName(pktBuf, (size_t)rlen, domain, sizeof(domain), qtype);
+                IPAddress cliIp = localDns.remoteIP();
+                uint16_t cliPort = localDns.remotePort();
+
+                if (qend > 0 && domain[0] != '\0') {
+                    String domStr(domain);
+                    bool tracker = false;
+                    bool blocked = false;
+                    ensureNaptMutex();
+                    if (xSemaphoreTake(s_naptMutex, pdMS_TO_TICKS(30)) == pdTRUE) {
+                        blocked = isDomainBlockedLocked(domStr, tracker);
+                        xSemaphoreGive(s_naptMutex);
+                    }
+                    recordDnsEvent(cliIp, domain, qtype, blocked, tracker);
+
+                    if (blocked) {
+                        size_t blen = buildBlockedDnsResponse(pktBuf, (size_t)rlen, qend, qtype, respBuf, sizeof(respBuf));
+                        if (blen > 0) {
+                            localDns.beginPacket(cliIp, cliPort);
+                            localDns.write(respBuf, blen);
+                            localDns.endPacket();
+                        }
+                    } else if (WiFi.isConnected()) {
+                        IPAddress upstream = WiFi.dnsIP(0);
+                        if ((uint32_t)upstream == 0) upstream = IPAddress(8, 8, 8, 8);
+
+                        // Find slot (prefer free or oldest)
+                        int pick = 0;
+                        uint32_t oldest = UINT32_MAX;
+                        for (int i = 0; i < kPendingDnsMax; i++) {
+                            if (!pending[i].active) {
+                                pick = i;
+                                break;
+                            }
+                            if (pending[i].sentAtMs < oldest) {
+                                oldest = pending[i].sentAtMs;
+                                pick = i;
+                            }
+                        }
+                        uint16_t upId = ++nextUpId;
+                        pending[pick].active = true;
+                        pending[pick].localId = ((uint16_t)pktBuf[0] << 8) | pktBuf[1];
+                        pending[pick].upstreamId = upId;
+                        pending[pick].clientIp = cliIp;
+                        pending[pick].clientPort = cliPort;
+                        pending[pick].sentAtMs = millis();
+
+                        pktBuf[0] = (uint8_t)(upId >> 8);
+                        pktBuf[1] = (uint8_t)(upId & 0xFF);
+                        upDns.beginPacket(upstream, 53);
+                        upDns.write(pktBuf, (size_t)rlen);
+                        upDns.endPacket();
+                    }
+                }
+            }
+        }
+
+        int ulen = upDns.parsePacket();
+        if (ulen > 0) {
+            int rlen = upDns.read(respBuf, sizeof(respBuf));
+            if (rlen >= 12) {
+                uint16_t upId = ((uint16_t)respBuf[0] << 8) | respBuf[1];
+                for (int i = 0; i < kPendingDnsMax; i++) {
+                    if (pending[i].active && pending[i].upstreamId == upId) {
+                        respBuf[0] = (uint8_t)(pending[i].localId >> 8);
+                        respBuf[1] = (uint8_t)(pending[i].localId & 0xFF);
+                        localDns.beginPacket(pending[i].clientIp, pending[i].clientPort);
+                        localDns.write(respBuf, (size_t)rlen);
+                        localDns.endPacket();
+                        pending[i].active = false;
+                        break;
+                    }
+                }
+            }
+        }
+
+        // Expire stale pending entries (>4s)
+        uint32_t now = millis();
+        for (int i = 0; i < kPendingDnsMax; i++) {
+            if (pending[i].active && (now - pending[i].sentAtMs) > 4000UL) pending[i].active = false;
+        }
+        vTaskDelay(pdMS_TO_TICKS(8));
+    }
+
+    localDns.stop();
+    upDns.stop();
+    s_naptRunning = false;
+    s_naptTask = nullptr;
+    vTaskDelete(NULL);
+}
+
+struct NaptClientInfo {
+    String mac;
+    String ip;
+    int8_t rssi;
+};
+
+static std::vector<NaptClientInfo> queryApClients() {
+    std::vector<NaptClientInfo> out;
+    wifi_sta_list_t staList = {};
+    if (esp_wifi_ap_get_sta_list(&staList) != ESP_OK || staList.num == 0) return out;
+    esp_netif_t *apNetif = esp_netif_get_handle_from_ifkey("WIFI_AP_DEF");
+    esp_netif_pair_mac_ip_t pairs[10] = {};
+    int count = std::min<int>(staList.num, 10);
+    if (apNetif) {
+        for (int i = 0; i < count; i++) memcpy(pairs[i].mac, staList.sta[i].mac, 6);
+        esp_netif_dhcps_get_clients_by_mac(apNetif, count, pairs);
+    }
+    for (int i = 0; i < count; i++) {
+        NaptClientInfo c;
+        char macBuf[20];
+        const uint8_t *m = staList.sta[i].mac;
+        snprintf(macBuf, sizeof(macBuf), "%02X:%02X:%02X:%02X:%02X:%02X", m[0], m[1], m[2], m[3], m[4], m[5]);
+        c.mac = macBuf;
+        IPAddress ip(pairs[i].ip.addr);
+        c.ip = ((uint32_t)ip != 0) ? ip.toString() : String("DHCP...");
+        c.rssi = staList.sta[i].rssi;
+        out.push_back(c);
+    }
+    return out;
+}
+
+static bool pickStaNetworkInteractive(String &outSsid, String &outPwd) {
+    drawMainBorderWithTitle("Travel Router Uplink");
+    padprintln("");
+    padprintln("Scanning 2.4 GHz Wi-Fi...");
+    ensureWifiPlatform();
+    WiFi.mode(WIFI_STA);
+    int n = WiFi.scanNetworks();
+    struct NetPick {
+        String ssid;
+        int rssi;
+        bool enc;
+        bool saved;
+    };
+    std::vector<NetPick> list;
+    for (int i = 0; i < n; i++) {
+        String s = WiFi.SSID(i);
+        if (s.isEmpty()) continue;
+        int r = WiFi.RSSI(i);
+        bool enc = WiFi.encryptionType(i) != WIFI_AUTH_OPEN;
+        bool dup = false;
+        for (auto &x : list) {
+            if (x.ssid == s) {
+                if (r > x.rssi) x.rssi = r;
+                dup = true;
+                break;
+            }
+        }
+        if (!dup) list.push_back({s, r, enc, bruceConfig.hasWifiCredential(s)});
+    }
+    WiFi.scanDelete();
+    std::sort(list.begin(), list.end(), [](const NetPick &a, const NetPick &b) { return a.rssi > b.rssi; });
+    if (list.size() > 16) list.resize(16);
+
+    if (list.empty()) {
+        displayError("No Wi-Fi found", true);
+        return false;
+    }
+
+    int chosen = -1;
+    options.clear();
+    for (size_t i = 0; i < list.size(); i++) {
+        String tag = list[i].saved ? "*" : (list[i].enc ? "+" : " ");
+        String lbl = tag + list[i].ssid.substring(0, 15) + " " + String(list[i].rssi);
+        options.push_back({lbl, [&, i]() { chosen = (int)i; }});
+    }
+    options.push_back({"Cancel", [&]() { chosen = -1; }});
+    loopOptions(options, MENU_TYPE_SUBMENU, "Pick Uplink Wi-Fi");
+    options.clear();
+    if (chosen < 0) return false;
+
+    outSsid = list[chosen].ssid;
+    outPwd = bruceConfig.getWifiPassword(outSsid);
+    if (outPwd.isEmpty() && list[chosen].enc) {
+        outPwd = keyboard("", 63, "Password: " + outSsid, true);
+        if (outPwd == "\x1B") return false;
+    }
+    return true;
+}
