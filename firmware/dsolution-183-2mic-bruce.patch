+bool pmkidStart(const String &bssid, const String &ssid, uint8_t channel, String *errOut = nullptr);
+bool pmkidStartStrongest(String *errOut = nullptr); // for WebUI / serial CLI
+void pmkidStop();
+bool pmkidIsRunning();
+String pmkidGetStateJson();
+bool pmkidExportHc22000(String *pathOut = nullptr);
+bool pmkidClear(); // false while capture is running
+
