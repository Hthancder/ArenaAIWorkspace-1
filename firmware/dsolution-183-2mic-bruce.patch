+static void recordDnsEvent(const IPAddress &cli, const char *domain, uint16_t qtype, bool blocked, bool tracker) {
+    ensureNaptMutex();
+    if (xSemaphoreTake(s_naptMutex, pdMS_TO_TICKS(50)) != pdTRUE) return;
+    DnsFeedEntry &e = s_feed[s_feedHead];
+    e.tsSec = millis() / 1000UL;
+    e.seq = ++s_feedSeq;
+    snprintf(e.clientIp, sizeof(e.clientIp), "%u.%u.%u.%u", cli[0], cli[1], cli[2], cli[3]);
+    strncpy(e.domain, domain, sizeof(e.domain) - 1);
+    e.domain[sizeof(e.domain) - 1] = '\0';
+    e.qtype = qtype;
+    e.blocked = blocked;
+    e.tracker = tracker;
+    s_feedHead = (s_feedHead + 1) % kNaptLogCap;
+    if (s_feedCount < kNaptLogCap) s_feedCount++;
+    s_totalQueries++;
+    if (blocked) s_blockedQueries++;
+    if (tracker) s_trackerQueries++;
+    xSemaphoreGive(s_naptMutex);
+}
