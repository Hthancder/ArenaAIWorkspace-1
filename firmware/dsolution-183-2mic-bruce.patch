+                frame.drawString(capStr, 92, 74);
+                frame.setTextColor(sec, blendColors(bg, pri, 12));
+                frame.drawString(
+                    s_backedByFlash ? (s_dirtyAny ? "Pending Flash sync..." : "Saved in Flash")
+                                    : "RAM-Disk (Save w/ Vol+)",
+                    92,
+                    90
+                );
+
+                // Transfer counters
+                frame.fillRoundRect(10, 114, (tftWidth - 28) / 2, 44, 6, blendColors(bg, pri, 8));
+                frame.fillRoundRect(18 + (tftWidth - 28) / 2, 114, (tftWidth - 28) / 2, 44, 6, blendColors(bg, pri, 8));
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 8));
+                frame.drawString("HOST READ", 10 + (tftWidth - 28) / 4, 126);
+                frame.drawString("HOST WRITE", 18 + (tftWidth - 28) * 3 / 4, 126);
+                frame.setTextColor(pri, blendColors(bg, pri, 8));
+                frame.drawString(String((unsigned long)(s_rxBytes / 1024)) + " KB", 10 + (tftWidth - 28) / 4, 142);
+                frame.drawString(String((unsigned long)(s_txBytes / 1024)) + " KB", 18 + (tftWidth - 28) * 3 / 4, 142);
+
+                if (compositeBadUsb) {
+                    frame.fillRoundRect(10, 166, tftWidth - 20, 42, 6, blendColors(bg, pri, 10));
+                    frame.setTextDatum(ML_DATUM);
+                    frame.setTextColor(TFT_WHITE, blendColors(bg, pri, 10));
+                    String sname = duckyPath.substring(duckyPath.lastIndexOf('/') + 1);
+                    frame.drawString("Payload: " + sname.substring(0, 22), 18, 180);
+                    frame.setTextColor(badUsbExecuted ? okCol : warnCol, blendColors(bg, pri, 10));
+                    frame.drawString(badUsbExecuted ? "Executed (Boot:Re-run)" : "Press Boot to run DuckyScript", 18, 196);
+                } else if (millis() < toastUntil && !toastMsg.isEmpty()) {
+                    frame.fillRoundRect(10, 170, tftWidth - 20, 32, 6, blendColors(bg, okCol, 28));
+                    frame.setTextDatum(MC_DATUM);
+                    frame.setTextColor(okCol, blendColors(bg, okCol, 28));
+                    frame.drawString(toastMsg, tftWidth / 2, 186);
+                } else {
+                    frame.setTextDatum(MC_DATUM);
+                    frame.setTextColor(sec, bg);
+                    frame.drawString("Copy files from PC, then save to /usb_vault", tftWidth / 2, 186);
+                }
+
+                frame.fillRect(0, tftHeight - 20, tftWidth, 20, blendColors(bg, pri, 14));
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 14));
+                frame.drawString(
+                    compositeBadUsb ? "Boot:RunPayload   Vol+:SaveVault   Hold:Eject"
+                                    : "Boot/Vol+:Save->Vault   Hold:Safely Eject",
+                    tftWidth / 2,
+                    tftHeight - 10
+                );
+                frame.pushSprite(0, 0);
+            }
+            wakeUpScreen();
+        }
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+
+    // Finalize: persist Flash dirty sectors, and offer/auto-save if needed
+    if (s_backedByFlash) {
+        saveMemoryToFlashImage();
+    } else if (s_txBytes > 0) {
+        int saved = exportDiskMemoryToVault(s_diskMem, s_diskBytes);
+        if (saved > 0) displayInfo("Saved " + String(saved) + " new/updated file(s)\nto /usb_vault!", true);
+    }
+
+    s_msc.mediaPresent(false);
+    vTaskDelay(pdMS_TO_TICKS(150));
+
+    if (hasSprite) frame.deleteSprite();
+    free(s_diskMem);
+    s_diskMem = nullptr;
+    free(s_dirtyMap);
+    s_dirtyMap = nullptr;
+    s_diskBytes = 0;
+    s_diskSectors = 0;
+    s_dirtyAny = false;
+    tft.fillScreen(bruceConfig.bgColor);
+}
