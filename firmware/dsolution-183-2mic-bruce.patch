diff --git a/src/core/seclab_util.cpp b/src/core/seclab_util.cpp
new file mode 100644
index 00000000..7f743fe8
--- /dev/null
+++ b/src/core/seclab_util.cpp
@@ -0,0 +1,123 @@
+#include "seclab_util.h"
+
+#include <LittleFS.h>
+#include <cstdio>
+#include <cstring>
+
+String seclabJsonEscape(const String &in) {
+    String out;
+    out.reserve(in.length() + 8);
+    for (size_t i = 0; i < in.length(); i++) {
+        char c = in[i];
+        if (c == '\\' || c == '"') {
+            out += '\\';
+            out += c;
+        } else if ((uint8_t)c >= 0x20) {
+            out += c;
+        } else {
+            // JSON has no \x escape; render control bytes as \u00XX.
+            char b[8];
+            snprintf(b, sizeof(b), "\\u%04x", (unsigned)(uint8_t)c);
+            out += b;
+        }
+    }
+    return out;
+}
+
+String seclabHex(const uint8_t *data, size_t len) {
+    static const char *kHex = "0123456789abcdef";
+    String out;
+    if (!data || len == 0) return out;
+    out.reserve(len * 2);
+    for (size_t i = 0; i < len; i++) {
+        out += kHex[data[i] >> 4];
+        out += kHex[data[i] & 0x0F];
+    }
+    return out;
+}
+
+String seclabMacHex(const uint8_t mac[6]) { return seclabHex(mac, 6); }
+
+String seclabMacColon(const uint8_t mac[6]) {
+    char b[18];
+    snprintf(b, sizeof(b), "%02X:%02X:%02X:%02X:%02X:%02X",
+             mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+    return String(b);
+}
+
+bool seclabParseMac(const String &in, uint8_t out[6]) {
+    String s = in;
+    s.replace(":", "");
+    s.replace("-", "");
+    s.trim();
+    if (s.length() != 12) return false;
+    for (int i = 0; i < 6; i++) {
+        char b[3] = {s.charAt(i * 2), s.charAt(i * 2 + 1), 0};
+        char *end = nullptr;
+        long v = strtol(b, &end, 16);
+        if (end != b + 2 || v < 0 || v > 255) return false;
+        out[i] = (uint8_t)v;
+    }
+    return true;
+}
+
+bool seclabEnsureDir(const char *path) {
+    if (!path || !*path) return false;
+    if (LittleFS.exists(path)) return true;
+    return LittleFS.mkdir(path);
+}
+
+bool seclabWriteState(const char *path, const String &json) {
+    if (!path || !*path) return false;
+    File f = LittleFS.open(path, FILE_WRITE);
+    if (!f) return false;
+    size_t n = f.write((const uint8_t *)json.c_str(), json.length());
+    f.close();
+    return n == json.length();
+}
+
+String seclabReadState(const char *path, size_t maxBytes) {
+    if (!path || !LittleFS.exists(path)) return "{}";
+    File f = LittleFS.open(path, FILE_READ);
+    if (!f) return "{}";
+    size_t sz = f.size();
+    if (sz < 2 || sz > maxBytes) {
+        f.close();
+        return "{}";
+    }
+    String out;
+    out.reserve(sz + 1);
+    while (f.available()) out += (char)f.read();
+    f.close();
+    out.trim();
+    if (!out.startsWith("{") || !out.endsWith("}")) return "{}";
+    return out;
+}
+
+void seclabAppendLog(const char *path, const String &line, size_t capBytes) {
+    if (!path || !*path || line.isEmpty()) return;
+    // Cheap log rotation: if the file passed the cap, keep a fresh chunk.
+    if (LittleFS.exists(path) && LittleFS.open(path, FILE_READ).size() > capBytes) {
+        LittleFS.remove(path);
+    }
+    File f = LittleFS.open(path, FILE_APPEND);
+    if (!f) return;
+    f.println(line);
+    f.close();
+}
+
+uint32_t seclabUptimeSec() { return (uint32_t)(millis() / 1000UL); }
+
+String seclabIp(const IPAddress &ip) { return ip.toString(); }
+
+String seclabSafeText(const String &in, size_t maxLen) {
+    String out;
+    out.reserve(in.length() > maxLen ? maxLen : in.length());
+    for (size_t i = 0; i < in.length() && out.length() < maxLen; i++) {
+        char c = in[i];
+        if (c == '\r' || c == '\n' || c == '\t') c = ' ';
+        if ((uint8_t)c >= 0x20 && (uint8_t)c < 0x7F) out += c;
+    }
+    out.trim();
+    return out;
+}
