+static bool startPromiscuousWifi(uint32_t filterMask, wifi_promiscuous_cb_t cb) {
+    ensureWifiPlatform();
+    nvs_flash_init();
+    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+    esp_err_t e = esp_wifi_init(&cfg);
+    if (e != ESP_OK && e != ESP_ERR_WIFI_INIT_STATE) {
+        Serial.printf("[WIDS/CSI] wifi_init: %s\n", esp_err_to_name(e));
+        return false;
+    }
+    esp_wifi_set_storage(WIFI_STORAGE_RAM);
+    esp_wifi_set_mode(WIFI_MODE_STA);
+    e = esp_wifi_start();
+    if (e != ESP_OK && e != ESP_ERR_WIFI_INIT_STATE) {
+        Serial.printf("[WIDS/CSI] wifi_start: %s\n", esp_err_to_name(e));
+        return false;
+    }
+    esp_wifi_disconnect();
+    esp_wifi_set_promiscuous(true);
+    wifi_promiscuous_filter_t filt = {};
+    filt.filter_mask = filterMask;
+    esp_wifi_set_promiscuous_filter(&filt);
+    if (cb) esp_wifi_set_promiscuous_rx_cb(cb);
+    return true;
+}
+
+static void stopPromiscuousWifi() {
+    esp_wifi_set_promiscuous(false);
+    esp_wifi_set_promiscuous_rx_cb(NULL);
+    esp_wifi_stop();
+    wifiDisconnect();
+    vTaskDelay(pdMS_TO_TICKS(10));
+}
