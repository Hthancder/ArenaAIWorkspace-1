+namespace {
+
+struct PairAsyncArgs {
+    String addr;
+    uint8_t addrType;
+    bool justWorks;
+};
+
+static volatile bool s_pairRunning = false;
+
+static void pairAsyncTask(void *arg) {
+    PairAsyncArgs *a = (PairAsyncArgs *)arg;
+    String err;
+    if (a) blePairingAuditStart(a->addr, a->addrType, a->justWorks, &err);
+    delete a;
+    s_pairRunning = false;
+    vTaskDelete(NULL);
+}
+
+} // namespace
+
+bool blePairingAuditStartAsync(const String &addr, uint8_t addrType, bool justWorks, String *errOut) {
+    if (s_pairRunning) { if (errOut) *errOut = "Pairing audit already running"; return false; }
+    PairAsyncArgs *args = new (std::nothrow) PairAsyncArgs{addr, addrType, justWorks};
+    if (!args) { if (errOut) *errOut = "Out of memory"; return false; }
+    s_pairRunning = true;
+    writePairState(addr, justWorks, false, false, false, false, "RUNNING", "");
+    TaskHandle_t th = nullptr;
+    if (xTaskCreatePinnedToCore(pairAsyncTask, "pairAudit", 6144, args, 2, &th, 0) != pdPASS) {
+        delete args;
+        s_pairRunning = false;
+        if (errOut) *errOut = "Pairing task spawn failed";
+        return false;
+    }
+    return true;
+}
+
+bool blePairingAuditIsRunning() { return s_pairRunning; }
