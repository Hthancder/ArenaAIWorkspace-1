+
+static void persistState() {
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"armed\":" + String(s_armed ? "true" : "false") + ",";
+    j += "\"handoffDone\":" + String(s_handoffDone ? "true" : "false") + ",";
+    j += "\"napt\":" + String(naptIsRunning() ? "true" : "false") + ",";
+    j += "\"apSsid\":\"" + seclabJsonEscape(s_apSsid) + "\",";
+    j += "\"staSsid\":\"" + seclabJsonEscape(s_staSsid) + "\",";
+    j += "\"forms\":" + String((unsigned long)s_formCount) + ",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + "}";
+    seclabWriteState(kStatePath, j);
+}
+
+static void tearDownPortal() {
+    if (s_portal) {
+        s_portal->stop();
+        delete s_portal;
+        s_portal = nullptr;
+    }
+    // Restore the user's Evil Portal / AP config (runtime-only change).
+    if (s_oldGatewayIp.length()) {
+        bruceConfig.evilPortalGatewayIp = s_oldGatewayIp;
+        s_oldGatewayIp = "";
+    }
+}
+
+static void portalNaptTask(void *) {
+    // Keep the captive AP on the NAPT subnet (192.168.4.1) and reuse the same
+    // SSID when napt_router restarts the AP, so clients stay attached.
+    s_oldGatewayIp = bruceConfig.evilPortalGatewayIp;
+    s_oldApSsid = bruceConfig.wifiAp.ssid;
+    s_oldApPwd = bruceConfig.wifiAp.pwd;
+    bruceConfig.evilPortalGatewayIp = "192.168.4.1";
+    bruceConfig.wifiAp.ssid = s_apSsid;
+    bruceConfig.wifiAp.pwd = ""; // open AP, identical before/after handoff
+
+    cleanlyStopWebUiForWiFiFeature();
+    radioFreeBleForWifi();
+    ensureWifiPlatform();
+
+    s_portal = new EvilPortal(String(s_apSsid), 6, false, false, true, true, "");
+    if (!s_portal) {
+        setErr("Portal alloc failed");
+        s_running = false;
+        s_task = nullptr;
+        vTaskDelete(NULL);
+        return;
+    }
+    // EvilPortal(autoMode=true, backgroundMode=true) already configured the
+    // captive AP on bruceConfig.evilPortalGatewayIp (set to 192.168.4.1 above),
+    // registered its routes and started DNS + AsyncWebServer. Do not duplicate
+    // any of that here -- it would add duplicate handlers / sockets.
+    vTaskDelay(pdMS_TO_TICKS(200));
+
+    uint32_t lastDraw = 0;
+    while (!s_stopReq) {
+        s_portal->processRequests();
+        if (s_portal->hasCredentials() && s_formCount == 0) s_formCount = 1;
+
+        if (s_armed && s_formCount > 0 && !s_handoffDone) {
+            String cred = s_portal->getCapturedSSID();
+            (void)cred;
+            tearDownPortal();
+            vTaskDelay(pdMS_TO_TICKS(150));
+            String err;
+            if (naptStartBackground(String(s_staSsid), String(s_staPwd), &err)) {
+                s_handoffDone = true;
+                seclabAppendLog("/portal_napt.log", String(seclabUptimeSec()) + ",handoff_ok," + s_staSsid);
+            } else {
+                setErr("NAPT handoff failed: " + err);
+                seclabAppendLog("/portal_napt.log", String(seclabUptimeSec()) + ",handoff_fail," + err);
+                s_handoffDone = true; // avoid retrying forever
+            }
+            ensureMux();
+            if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(100)) == pdTRUE) {
+                persistState();
+                xSemaphoreGive(s_mux);
+            }
+        }
+
+        if (millis() - lastDraw > 1500) {
+            lastDraw = millis();
+            ensureMux();
+            if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                persistState();
+                xSemaphoreGive(s_mux);
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(25));
+    }
+
+    tearDownPortal();
+    if (!naptIsRunning()) {
+        // Only restore AP config if the handoff did not take over the AP.
+        bruceConfig.wifiAp.ssid = s_oldApSsid;
+        bruceConfig.wifiAp.pwd = s_oldApPwd;
+    }
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(200)) == pdTRUE) {
+        persistState();
+        xSemaphoreGive(s_mux);
+    }
+    s_running = false;
+    s_task = nullptr;
+    vTaskDelete(NULL);
+}
+
+static bool startEngine(const String &apSsid, const String &staSsid, const String &staPwd,
+                        bool handoff, String *errOut) {
+    if (s_running) return true;
+    if (apSsid.isEmpty() || apSsid.length() > 32) { if (errOut) *errOut = "AP SSID must be 1..32 bytes"; return false; }
+    if (staSsid.isEmpty()) { if (errOut) *errOut = "An uplink STA network is required"; return false; }
+    if (!radioHasMemForWifi()) { if (errOut) *errOut = "Low DMA RAM for Wi-Fi"; return false; }
+
+    ensureMux();
+    strncpy(s_apSsid, apSsid.c_str(), sizeof(s_apSsid) - 1);
+    s_apSsid[sizeof(s_apSsid) - 1] = 0;
+    strncpy(s_staSsid, staSsid.c_str(), sizeof(s_staSsid) - 1);
+    s_staSsid[sizeof(s_staSsid) - 1] = 0;
+    strncpy(s_staPwd, staPwd.c_str(), sizeof(s_staPwd) - 1);
+    s_staPwd[sizeof(s_staPwd) - 1] = 0;
+    s_armed = handoff;
+    s_handoffDone = false;
+    s_formCount = 0;
+    s_lastErr[0] = 0;
+    s_startedMs = millis();
+
+    s_stopReq = false;
+    s_running = true;
+    if (xTaskCreatePinnedToCore(portalNaptTask, "portalNapt", 6144, nullptr, 2, &s_task, 0) != pdPASS) {
+        s_running = false;
+        s_task = nullptr;
+        setErr("Portal task spawn failed");
+        if (errOut) *errOut = s_lastErr;
+        return false;
+    }
+    persistState();
+    return true;
+}
+
+static bool pickUplink(String &ssid, String &pwd) {
+    if (WiFi.isConnected()) {
+        ssid = WiFi.SSID();
+        pwd = bruceConfig.getWifiPassword(ssid);
+        return !ssid.isEmpty();
+    }
+    for (const auto &kv : bruceConfig.wifi) {
+        ssid = kv.first;
+        pwd = kv.second;
+        return true;
+    }
+    return false;
+}
+
+} // namespace
+
+bool portalNaptHandoffFromPortal(EvilPortal *portal, String *errOut) {
+    if (!portal) { if (errOut) *errOut = "Portal object missing"; return false; }
+    if (naptIsRunning()) return true;
+    String staSsid, staPwd;
+    if (!pickUplink(staSsid, staPwd)) {
+        if (errOut) *errOut = "No uplink Wi-Fi saved. Connect once first.";
+        return false;
+    }
+    String apSsid = portal->getApName();
+    if (apSsid.isEmpty()) apSsid = bruceConfig.wifiAp.ssid;
+
+    // Keep the same open SSID when napt_router re-creates the AP. The NAPT
+    // router uses 192.168.4.1 so captive clients receive a seamless DHCP/DNS
+    // change instead of a dead-end network.
+    bruceConfig.wifiAp.ssid = apSsid;
+    bruceConfig.wifiAp.pwd = "";
+    bruceConfig.evilPortalGatewayIp = "192.168.4.1";
+    bruceConfig.saveFile();
+
+    strncpy(s_apSsid, apSsid.c_str(), sizeof(s_apSsid) - 1);
+    s_apSsid[sizeof(s_apSsid) - 1] = 0;
+    strncpy(s_staSsid, staSsid.c_str(), sizeof(s_staSsid) - 1);
+    s_staSsid[sizeof(s_staSsid) - 1] = 0;
+    strncpy(s_staPwd, staPwd.c_str(), sizeof(s_staPwd) - 1);
+    s_staPwd[sizeof(s_staPwd) - 1] = 0;
+    s_formCount = 1;
+    s_armed = true;
+    s_startedMs = millis();
+
+    portal->stop();
+    vTaskDelay(pdMS_TO_TICKS(180));
+    cleanlyStopWebUiForWiFiFeature();
+    String err;
+    if (!naptStartBackground(staSsid, staPwd, &err)) {
+        setErr("NAPT handoff failed: " + err);
+        if (errOut) *errOut = s_lastErr;
+        seclabAppendLog("/portal_napt.log", String(seclabUptimeSec()) + ",direct_handoff_fail," + err);
+        s_handoffDone = true;
+        persistState();
+        return false;
+    }
+    s_handoffDone = true;
+    s_lastErr[0] = 0;
+    seclabAppendLog("/portal_napt.log", String(seclabUptimeSec()) + ",direct_handoff_ok," + staSsid);
+    persistState();
+    return true;
+}
+
+bool portalNaptStart(const String &apSsid, const String &staSsid, const String &staPwd,
+                     bool handoff, String *errOut) {
+    return startEngine(apSsid, staSsid, staPwd, handoff, errOut);
+}
+
+bool portalNaptStartAuto(String *errOut) {
+    String ssid, pwd;
+    if (!pickUplink(ssid, pwd)) {
+        if (errOut) *errOut = "No uplink Wi-Fi saved. Connect once first.";
+        return false;
+    }
+    return startEngine(bruceConfig.wifiAp.ssid, ssid, pwd, bruceConfig.seclabPlus.portalNaptHandoff, errOut);
+}
+
+void portalNaptStop() {
+    if (!s_running) {
+        if (naptIsRunning()) naptStop(false);
+        return;
+    }
+    s_stopReq = true;
+    for (int i = 0; i < 80 && s_running; i++) vTaskDelay(pdMS_TO_TICKS(25));
+    // A successful handoff leaves NAPT running in the background: that is the
+    // whole point of this module. Callers can stop it explicitly from #1 NAPT.
+}
+
+bool portalNaptIsRunning() { return s_running; }
+bool portalNaptIsArmed() { return s_armed; }
+
+void portalNaptSetArmed(bool armed) {
+    s_armed = armed;
+    bruceConfig.seclabPlus.portalNaptHandoff = armed;
+    bruceConfig.saveFile();
+    persistState();
+}
+
+String portalNaptGetStateJson() {
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(100)) != pdTRUE) return seclabReadState(kStatePath);
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"armed\":" + String(s_armed ? "true" : "false") + ",";
+    j += "\"handoffDone\":" + String(s_handoffDone ? "true" : "false") + ",";
+    j += "\"napt\":" + String(naptIsRunning() ? "true" : "false") + ",";
+    j += "\"apSsid\":\"" + seclabJsonEscape(s_apSsid) + "\",";
+    j += "\"staSsid\":\"" + seclabJsonEscape(s_staSsid) + "\",";
+    j += "\"forms\":" + String((unsigned long)s_formCount) + ",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + "}";
+    xSemaphoreGive(s_mux);
+    return j;
+}
+
+void portal_napt_setup() {
+    if (s_running) { displayWarning("Portal -> NAPT already running", true); return; }
+    if (naptIsRunning()) { displayWarning("Stop #1 NAPT Router first", true); return; }
+
+    String staSsid, staPwd;
+    if (!pickUplink(staSsid, staPwd)) {
+        displayWarning("Connect an uplink Wi-Fi first", true);
+        if (!wifiConnectMenu(WIFI_STA) || !pickUplink(staSsid, staPwd)) {
+            displayError("No uplink network available", true);
+            return;
+        }
+    }
+
+    String apSsid = bruceConfig.wifiAp.ssid;
+    bool handoff = bruceConfig.seclabPlus.portalNaptHandoff;
+    int choice = -1;
+    options = {
+        {String("AP SSID: ") + apSsid, [&]() {
+             String s = keyboard(apSsid, 32, "Captive AP SSID:");
+             if (s.length() > 0 && s != "\x1B") apSsid = s;
+         }},
+        {String("Handoff: ") + (handoff ? "ON" : "OFF"), [&]() { handoff = !handoff; }},
+        {"Start Portal -> NAPT", [&]() { choice = 1; }},
+        {"Back", [&]() { choice = 0; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "Evil Portal -> NAPT");
+    options.clear();
+    if (choice != 1 || apSsid.isEmpty()) return;
+    portalNaptSetArmed(handoff);
+
+    String err;
+    if (!portalNaptStart(apSsid, staSsid, staPwd, handoff, &err)) {
+        displayError("Start failed: " + err, true);
+        return;
+    }
+
+    uint32_t lastDraw = 0;
+    while (s_running) {
+        if (check(EscPress)) { portalNaptStop(); break; }
+        if (millis() - lastDraw > 500) {
+            lastDraw = millis();
+            drawMainBorderWithTitle("PORTAL -> NAPT");
+            padprintln("Captive AP : " + String(s_apSsid));
+            padprintln("Uplink STA : " + String(s_staSsid));
+            padprintln("Handoff    : " + String(s_armed ? "ON" : "OFF"));
+            padprintln("Form seen  : " + String((unsigned long)s_formCount));
+            padprintln("NAPT       : " + String(naptIsRunning() ? "ONLINE" : "waiting"));
+            padprintln("");
+            padprintln(s_formCount ? "Handing victim to real Internet..." : "Waiting for captive form...");
+            padprintln("Hold Boot: stop portal");
+        }
+        vTaskDelay(pdMS_TO_TICKS(30));
+    }
+    displayInfo("Portal stopped. NAPT stays in background.", true);
+}
+
+#else  // LITE_VERSION
+
+void portal_napt_setup() {}
+bool portalNaptStart(const String &, const String &, const String &, bool, String *) { return false; }
+bool portalNaptStartAuto(String *errOut) { if (errOut) *errOut = "LITE build"; return false; }
+void portalNaptStop() {}
+bool portalNaptIsRunning() { return false; }
+bool portalNaptIsArmed() { return false; }
+void portalNaptSetArmed(bool) {}
+String portalNaptGetStateJson() { return "{}"; }
+
+#endif
