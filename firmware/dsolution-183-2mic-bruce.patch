diff --git a/src/core/menu_items/QuickMenu.cpp b/src/core/menu_items/QuickMenu.cpp
new file mode 100644
index 00000000..f42af790
--- /dev/null
+++ b/src/core/menu_items/QuickMenu.cpp
@@ -0,0 +1,81 @@
+#include "QuickMenu.h"
+#if defined(DSOLUTION_183_2MIC)
+#include "core/wifi/webInterface.h"
+#include "core/wifi/wifi_common.h"
+#include "modules/ble/ble_common.h"
+#include "modules/ble/ble_tracker_guard.h"
+#include "modules/wifi/channel_analyzer.h"
+#include <Preferences.h>
+#include <cstring>
+
+namespace {
+constexpr unsigned count = 5;
+const char *labels[count] = {"WiFi Connect", "Channel Analyzer", "BLE Scan", "BLE Privacy Guard", "WebUI control"};
+uint32_t favorites = 0x1f;
+int recent = -1;
+bool loaded = false;
+void load() {
+    if (loaded) return;
+    loaded = true;
+    Preferences p;
+    if (!p.begin("dsquick", true)) return;
+    favorites = p.getUInt("favorites", 0x1f) & ((1U << count) - 1);
+    recent = p.getInt("recent", -1);
+    if (recent < 0 || recent >= (int)count) recent = -1;
+    p.end();
+}
+void save(const char *key, int val) {
+    Preferences p;
+    if (p.begin("dsquick", false)) {
+        if (strcmp(key, "favorites") == 0) p.putUInt(key, (uint32_t)val);
+        else p.putInt(key, val);
+        p.end();
+    }
+}
+void run(unsigned id) {
+    if (id >= count) return;
+    if (recent != (int)id) { recent = id; save("recent", recent); }
+    switch (id) {
+        case 0: wifiConnectMenu(); break;
+        case 1: channel_analyzer_setup(); break;
+        case 2: ble_scan(); break;
+        case 3: ble_guard_setup(); break;
+        case 4: loopOptionsWebUi(); break;
+    }
+}
+void configure() {
+    while (true) {
+        std::vector<Option> list;
+        for (unsigned i = 0; i < count; ++i) {
+            list.push_back({String((favorites & (1U << i)) ? "[x] " : "[ ] ") + labels[i], [i]() {
+                favorites ^= 1U << i; save("favorites", (int)favorites);
+            }});
+        }
+        list.push_back({"Back", [](){}});
+        int selected = loopOptions(list, MENU_TYPE_SUBMENU, "Pin shortcuts");
+        if (selected < 0 || selected == (int)list.size() - 1 || returnToMenu) return;
+    }
+}
+}
+void QuickMenu::optionsMenu() {
+    load();
+    returnToMenu = false;
+    while (!returnToMenu) {
+        std::vector<Option> list;
+        if (recent >= 0) list.push_back({String("Recent: ") + labels[recent], [](){ run((unsigned)recent); }});
+        for (unsigned i = 0; i < count; ++i)
+            if (favorites & (1U << i)) list.push_back({String("* ") + labels[i], [i](){ run(i); }});
+        list.push_back({"Edit favorites", configure});
+        list.push_back({"Back", [](){}});
+        int selected = loopOptions(list, MENU_TYPE_SUBMENU, "Quick access");
+        if (selected < 0 || selected == (int)list.size() - 1) break;
+    }
+    returnToMenu = false;
+}
+void QuickMenu::drawIcon(float scale) {
+    int r = max(8, (int)(25 * scale));
+    tft.drawCircle(iconCenterX, iconCenterY, r, bruceConfig.priColor);
+    tft.drawWideLine(iconCenterX, iconCenterY - r / 2, iconCenterX, iconCenterY, max(1, (int)(3 * scale)), bruceConfig.priColor, bruceConfig.priColor);
+    tft.drawWideLine(iconCenterX, iconCenterY, iconCenterX + r / 2, iconCenterY, max(1, (int)(3 * scale)), bruceConfig.priColor, bruceConfig.priColor);
+}
+#endif
