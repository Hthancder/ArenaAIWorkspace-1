+/*
+ * LED Link protocol (short, host-driven, no USB storage / no network):
+ *   START : Scroll Lock toggled twice
+ *   CLOCK : Caps Lock toggled once per bit
+ *   DATA  : Num Lock toggled before CLOCK and restored after CLOCK => bit 1
+ *   END   : Scroll Lock toggled three times
+ *   Frame : 0xAA sync, 16-bit big-endian length, UTF-8 payload
+ * The target script uses OS-native key events so the host sends USB HID LED
+ * Output Reports back to Bruce. All captured values are saved on LittleFS.
+ */
+
+namespace {
+
+constexpr const char *kStatePath = "/led_link_state.json";
+constexpr const char *kDir = "/led_link";
+constexpr const char *kPayloadPath = "/led_link/payload.txt";
+constexpr const char *kExfilPath = "/led_link/exfil.txt";
+constexpr const char *kLastJsonPath = "/led_link/last.json";
+constexpr const char *kExportJsonPath = "/led_link/export.json";
+constexpr const char *kLogPath = "/led_link.log";
+constexpr const char *kWaitDemoPath = "/led_link/wait_demo.txt";
+
+static const char *kBase64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static String base64Encode(const uint8_t *data, size_t len) {
+    String out;
+    out.reserve(((len + 2) / 3) * 4 + 4);
+    for (size_t i = 0; i < len; i += 3) {
+        uint32_t v = (uint32_t)data[i] << 16;
+        if (i + 1 < len) v |= (uint32_t)data[i + 1] << 8;
+        if (i + 2 < len) v |= data[i + 2];
+        out += kBase64[(v >> 18) & 0x3F];
+        out += kBase64[(v >> 12) & 0x3F];
+        out += (i + 1 < len) ? kBase64[(v >> 6) & 0x3F] : '=';
+        out += (i + 2 < len) ? kBase64[v & 0x3F] : '=';
+    }
+    return out;
+}
+
+static String base64EncodeUtf16Le(const String &s) {
+    std::vector<uint8_t> v;
+    v.reserve(s.length() * 2);
+    for (size_t i = 0; i < s.length(); i++) {
+        v.push_back((uint8_t)s.charAt(i));
+        v.push_back(0);
+    }
+    return base64Encode(v.data(), v.size());
+}
+
+static String ledStateString(uint8_t leds) {
+    String s;
+    if (leds & 0x01) s += "NUM ";
+    if (leds & 0x02) s += "CAPS ";
+    if (leds & 0x04) s += "SCROLL";
+    s.trim();
+    return s.isEmpty() ? String("OFF") : s;
+}
+
+static String jsonEsc(const String &s) { return seclabJsonEscape(s); }
+
+// ------------------------- 3A receiver state -------------------------
+#if defined(USB_as_HID) && CONFIG_TINYUSB_HID_ENABLED
+static QueueHandle_t s_ledQueue = nullptr;
+static bool s_ledEventRegistered = false;
+static volatile uint8_t s_lastLeds = 0;
+static volatile uint32_t s_lastLedMs = 0;
+static TaskHandle_t s_ledTask = nullptr;
+static volatile bool s_ledRunning = false;
+static volatile bool s_ledStopReq = false;
+static uint32_t s_ledStartedMs = 0;
+static uint32_t s_ledTimeoutSec = 120;
+static char s_ledPhase[16] = "IDLE";
+static char s_ledLastErr[64] = {0};
+static String s_ledDecoded;
+static uint32_t s_ledBits = 0, s_ledBytes = 0, s_ledErrors = 0;
+
+static void smartUsbLedEvent(void *, esp_event_base_t, int32_t, void *event_data) {
+    if (!event_data) return;
+    auto *p = (arduino_usb_hid_keyboard_event_data_t *)event_data;
+    uint8_t leds = p->leds & 0x07;
+    s_lastLeds = leds;
+    s_lastLedMs = millis();
+    if (s_ledQueue) {
+        uint8_t v = leds;
+        xQueueSend(s_ledQueue, &v, 0);
+    }
+}
+
+static void persistLedState() {
+    String j = "{";
+    j += "\"running\":" + String(s_ledRunning ? "true" : "false") + ",";
+    j += "\"auto\":" + String(bruceConfig.seclabPlus.hidLedAutoArm ? "true" : "false") + ",";
+    j += "\"phase\":\"" + jsonEsc(s_ledPhase) + "\",";
+    j += "\"timeoutSec\":" + String((unsigned long)s_ledTimeoutSec) + ",";
+    j += "\"ledState\":\"" + jsonEsc(ledStateString(s_lastLeds)) + "\",";
+    j += "\"ledBits\":" + String((int)(s_lastLeds & 7)) + ",";
+    j += "\"lastErr\":\"" + jsonEsc(s_ledLastErr) + "\",";
+    j += "\"bits\":" + String((unsigned long)s_ledBits) + ",";
+    j += "\"bytes\":" + String((unsigned long)s_ledBytes) + ",";
+    j += "\"errors\":" + String((unsigned long)s_ledErrors) + ",";
+    j += "\"decoded\":\"" + jsonEsc(s_ledDecoded) + "\",";
+    j += "\"uptimeSec\":" + String(s_ledRunning ? (unsigned long)((millis() - s_ledStartedMs) / 1000UL) : 0UL) + ",";
+    j += String("\"payload\":\"") + kPayloadPath + "\",\"exfil\":\"" + kExfilPath +
+         "\",\"json\":\"" + kLastJsonPath + "\",\"log\":\"" + kLogPath + "\"}";
+    seclabWriteState(kStatePath, j);
+    seclabWriteState(kLastJsonPath, j);
+}
+
+static void setLedErr(const char *e) {
+    strncpy(s_ledLastErr, e, sizeof(s_ledLastErr) - 1);
+    s_ledLastErr[sizeof(s_ledLastErr) - 1] = 0;
+}
+
+static void finishFrame(bool ok, const char *reason, const String &payload) {
+    String clean = seclabSafeText(payload, 512);
+    s_ledDecoded = clean;
+    s_ledBytes = clean.length();
+    if (ok) {
+        setLedErr(reason);
+        File f = LittleFS.open(kExfilPath, FILE_WRITE);
+        if (f) { f.print(clean); f.close(); }
+        seclabAppendLog(kLogPath, String(seclabUptimeSec()) + ",OK," + String((unsigned long)s_ledBits) +
+                                     "," + clean);
+    } else {
+        setLedErr(reason);
+        s_ledErrors++;
+        seclabAppendLog(kLogPath, String(seclabUptimeSec()) + ",FAIL," + reason);
+    }
+    strncpy(s_ledPhase, ok ? "DONE" : "ERROR", sizeof(s_ledPhase) - 1);
+    s_ledPhase[sizeof(s_ledPhase) - 1] = 0;
+    persistLedState();
+}
+
+enum LedPhase { LP_IDLE = 0, LP_SYNC, LP_LEN, LP_DATA, LP_END };
+static LedPhase s_phase = LP_IDLE;
+static uint8_t s_prevCaps = 0, s_prevScroll = 0, s_baselineNum = 0;
+static uint8_t s_syncAcc = 0;
+static int s_syncBits = 0;
+static uint16_t s_expectedLen = 0;
+static int s_lenBits = 0;
+static uint8_t s_dataAcc = 0;
+static int s_dataBits = 0;
+static uint32_t s_scrollEdges = 0, s_scrollWindowMs = 0;
+static uint32_t s_frameStartMs = 0, s_lastEventMs = 0;
+static bool s_capsDuringStart = false;
+static String s_payload;
+
+static void resetFrame() {
+    s_phase = LP_IDLE;
+    s_syncAcc = 0; s_syncBits = 0;
+    s_expectedLen = 0; s_lenBits = 0;
+    s_dataAcc = 0; s_dataBits = 0;
+    s_scrollEdges = 0; s_scrollWindowMs = 0;
+    s_capsDuringStart = false;
+    s_payload = "";
+    s_ledBits = 0; s_ledBytes = 0;
+    strncpy(s_ledPhase, "IDLE", sizeof(s_ledPhase) - 1);
+    s_ledPhase[sizeof(s_ledPhase) - 1] = 0;
+}
+
+static void beginFrame(uint8_t leds) {
+    resetFrame();
+    s_phase = LP_SYNC;
+    s_baselineNum = (leds & 0x01) ? 1 : 0;
+    s_frameStartMs = millis();
+    s_lastEventMs = millis();
+    strncpy(s_ledPhase, "SYNC", sizeof(s_ledPhase) - 1);
+    s_ledPhase[sizeof(s_ledPhase) - 1] = 0;
+    s_ledLastErr[0] = 0;
+    persistLedState();
+}
+
+static void processBit(uint8_t bit) {
+    s_ledBits++;
+    if (s_phase == LP_SYNC) {
+        s_syncAcc = (uint8_t)((s_syncAcc << 1) | bit);
+        s_syncBits++;
+        if (s_syncBits >= 8) {
+            if (s_syncAcc == 0xAA) {
+                s_phase = LP_LEN;
+                s_lenBits = 0;
+                s_expectedLen = 0;
+                strncpy(s_ledPhase, "LENGTH", sizeof(s_ledPhase) - 1);
+                s_ledPhase[sizeof(s_ledPhase) - 1] = 0;
+            } else {
+                s_syncAcc = 0;
+                s_syncBits = 0;
+                s_ledErrors++;
+            }
+        }
+    } else if (s_phase == LP_LEN) {
+        s_expectedLen = (uint16_t)((s_expectedLen << 1) | bit);
+        s_lenBits++;
+        if (s_lenBits >= 16) {
+            if (!s_expectedLen || s_expectedLen > 512) {
+                finishFrame(false, "bad-length", s_payload);
+                resetFrame();
+                return;
+            }
+            s_phase = LP_DATA;
+            s_payload = "";
+            strncpy(s_ledPhase, "DATA", sizeof(s_ledPhase) - 1);
+            s_ledPhase[sizeof(s_ledPhase) - 1] = 0;
+        }
+    } else if (s_phase == LP_DATA) {
+        s_dataAcc = (uint8_t)((s_dataAcc << 1) | bit);
+        s_dataBits++;
+        if (s_dataBits >= 8) {
+            if (s_payload.length() < 512) s_payload += (char)s_dataAcc;
+            s_dataAcc = 0;
+            s_dataBits = 0;
+            if (s_payload.length() >= s_expectedLen) {
+                s_phase = LP_END;
+                s_scrollEdges = 0;
+                s_scrollWindowMs = millis();
+                strncpy(s_ledPhase, "WAIT_END", sizeof(s_ledPhase) - 1);
+                s_ledPhase[sizeof(s_ledPhase) - 1] = 0;
+            }
+        }
+    }
+}
+
+static void ledLinkTask(void *) {
+    resetFrame();
+    strncpy(s_ledPhase, "ARMED", sizeof(s_ledPhase) - 1);
+    s_ledPhase[sizeof(s_ledPhase) - 1] = 0;
+    persistLedState();
+    uint8_t leds = 0;
+    while (!s_ledStopReq) {
+        if (xQueueReceive(s_ledQueue, &leds, pdMS_TO_TICKS(50)) == pdTRUE) {
+            s_lastEventMs = millis();
+            uint8_t num = (leds & 0x01) ? 1 : 0;
+            uint8_t caps = (leds & 0x02) ? 1 : 0;
+            uint8_t scroll = (leds & 0x04) ? 1 : 0;
+            bool capsEdge = (caps != s_prevCaps);
+            bool scrollEdge = (scroll != s_prevScroll);
+
+            if (s_phase == LP_IDLE) {
+                if (scrollEdge) {
+                    if (millis() - s_scrollWindowMs > 1500 || s_scrollEdges == 0) {
+                        s_scrollEdges = 1;
+                        s_scrollWindowMs = millis();
+                        s_capsDuringStart = false;
+                    } else {
+                        s_scrollEdges++;
+                    }
+                    if (s_scrollEdges >= 2 && !s_capsDuringStart) beginFrame(leds);
+                } else if (capsEdge) {
+                    s_capsDuringStart = true;
+                    s_scrollEdges = 0;
+                }
+            } else if (s_phase == LP_END) {
+                if (scrollEdge) {
+                    if (millis() - s_scrollWindowMs > 1500) {
+                        s_scrollEdges = 1;
+                        s_scrollWindowMs = millis();
+                    } else s_scrollEdges++;
+                    if (s_scrollEdges >= 3) {
+                        finishFrame(true, "end-marker", s_payload);
+                        resetFrame();
+                    }
+                }
+            } else {
+                if (capsEdge) {
+                    uint8_t bit = (num != s_baselineNum) ? 1 : 0;
+                    processBit(bit);
+                }
+            }
+            s_prevCaps = caps;
+            s_prevScroll = scroll;
+        }
+
+        if (s_phase == LP_END && millis() - s_lastEventMs > 2500) {
+            finishFrame(true, "auto-end", s_payload);
+            resetFrame();
+        } else if (s_phase != LP_IDLE && s_ledTimeoutSec > 0 &&
+                   millis() - s_frameStartMs > s_ledTimeoutSec * 1000UL) {
+            finishFrame(false, "timeout", s_payload);
+            resetFrame();
+        }
+    }
+    strncpy(s_ledPhase, "IDLE", sizeof(s_ledPhase) - 1);
+    s_ledPhase[sizeof(s_ledPhase) - 1] = 0;
+    persistLedState();
+    s_ledRunning = false;
+    s_ledTask = nullptr;
+    vTaskDelete(NULL);
+}
+#endif // USB_as_HID
