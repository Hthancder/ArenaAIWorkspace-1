diff --git a/src/modules/ble/ble_guard_logic.h b/src/modules/ble/ble_guard_logic.h
new file mode 100644
index 00000000..0cd28104
--- /dev/null
+++ b/src/modules/ble/ble_guard_logic.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+enum class BleGuardManufacturer { None, FindMyLike, SmartTagLike };
+
+// Matches observable manufacturer patterns, not authenticated device identity.
+// Apple manufacturer data is a sequence of type/length/value records after
+// the two-byte company ID. Refuse truncated or malformed records.
+inline BleGuardManufacturer bleGuardManufacturer(const uint8_t *data, size_t length) {
+    if (!data || length < 4) return BleGuardManufacturer::None;
+    const uint16_t company = static_cast<uint16_t>(data[0]) | (static_cast<uint16_t>(data[1]) << 8);
+    if (company == 0x004c) {
+        bool findMy = false;
+        size_t offset = 2;
+        while (offset < length) {
+            if (length - offset < 2) return BleGuardManufacturer::None;
+            const uint8_t type = data[offset++];
+            const size_t size = data[offset++];
+            if (size > length - offset) return BleGuardManufacturer::None;
+            if (type == 0x12 && size == 0x19) findMy = true;
+            offset += size;
+        }
+        return findMy ? BleGuardManufacturer::FindMyLike : BleGuardManufacturer::None;
+    }
+    if (company == 0x0075 && data[2] == 0x42 && data[3] == 0x04 && length >= 8)
+        return BleGuardManufacturer::SmartTagLike;
+    return BleGuardManufacturer::None;
+}
+
+inline bool bleGuardExpired(uint32_t now, uint32_t lastSeen, uint32_t ttlMs) {
+    return static_cast<uint32_t>(now - lastSeen) >= ttlMs;
+}
+inline uint16_t bleGuardIncrement(uint16_t hits) { return hits == UINT16_MAX ? hits : hits + 1; }
diff --git a/src/modules/ble/ble_security_audit.cpp b/src/modules/ble/ble_security_audit.cpp
new file mode 100644
index 00000000..5e4c2f22
--- /dev/null
+++ b/src/modules/ble/ble_security_audit.cpp
@@ -0,0 +1,781 @@
+#include "ble_security_audit.h"
+#include "ble_audit_logic.h"
+#if !defined(LITE_VERSION)
+
+#include "ble_common.h"
+#include "ble_p4_compat.h"
+#include "core/config.h"
+#include "core/display.h"
+#include "core/mykeyboard.h"
+#include "core/radio_mem.h"
+#include "core/seclab_util.h"
+#include "core/utils.h"
+#include "core/wifi/wifi_common.h"
+#include <Arduino.h>
+#include <LittleFS.h>
+#include <NimBLEAdvertisementData.h>
+#include <NimBLEAdvertisedDevice.h>
+#include <NimBLEClient.h>
+#include <NimBLEConnInfo.h>
+#include <NimBLEDevice.h>
+#include <NimBLERemoteCharacteristic.h>
+#include <NimBLEScan.h>
+#include <NimBLEUUID.h>
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <globals.h>
+#include <new>
+#include <vector>
+
+/*
+ * 4A audits the GATT tree already discovered by the GATT Explorer/Cloner. It
+ * NimBLE may automatically initiate security during a read or write. Findings
+ * must use the link state after each operation, not just the initial state.
+ * Optional boundary writes may change state or disrupt the target.
+ *
+ * 4B starts a fresh, downgraded client (NoInputNoOutput + no MITM + no SC) and
+ * reports whether the peer accepts Just Works. The verification beacon emits
+ * sanitized manufacturer/service patterns; it carries no real tracker identity.
+ */
+
+namespace {
+
+constexpr const char *kAuditPath = "/ble_security_audit.json";
+constexpr const char *kPairPath = "/ble_pair_audit.json";
+constexpr const char *kTagPath = "/ble_tag_beacon.json";
+constexpr const char *kAuditLog = "/ble_security_audit.log";
+constexpr const char *kPairLog = "/ble_pair_audit.log";
+constexpr const char *kTagLog = "/ble_tag_beacon.log";
+constexpr int kMaxFindings = 80;
+
+struct AuditFinding {
+    String uuid;
+    String svc;
+    uint16_t handle;
+    String props;
+    String risk;      // HIGH / MEDIUM / INFO
+    String verdict;   // UNAUTH_READ / UNAUTH_WRITE / KEYWORD / FUZZ_DISCONNECT / FUZZ_LEAK / ENCRYPTED
+    String detail;
+    String preview;
+};
+
+static SemaphoreHandle_t s_mux = nullptr;
+static void ensureMux() { if (!s_mux) s_mux = xSemaphoreCreateMutex(); }
+
+static String jsonEsc(const String &s) { return seclabJsonEscape(s); }
+
+static String propsStr(uint8_t p) {
+    String s;
+    if (p & 0x01) s += "R";
+    if (p & 0x02) s += "W";
+    if (p & 0x04) s += "WnR";
+    if (p & 0x08) s += "N";
+    if (p & 0x10) s += "I";
+    return s.isEmpty() ? String("-") : s;
+}
+
+static String toHex(const uint8_t *p, size_t n, size_t max = 24) {
+    String s;
+    n = std::min(n, max);
+    for (size_t i = 0; i < n; i++) {
+        char b[3];
+        snprintf(b, sizeof(b), "%02X", p[i]);
+        s += b;
+    }
+    if (n == max && n > 0) s += "..";
+    return s;
+}
+
+static String asciiPreview(const uint8_t *p, size_t n, size_t max = 40) {
+    String s;
+    n = std::min(n, max);
+    for (size_t i = 0; i < n; i++) {
+        char c = (char)p[i];
+        s += (c >= 0x20 && c < 0x7F) ? c : '.';
+    }
+    return seclabSafeText(s, (int)max);
+}
+
+static bool hasSensitiveKeyword(const String &uuid, const uint8_t *p, size_t n) {
+    String s = uuid;
+    s += " " + asciiPreview(p, n, 64);
+    s.toLowerCase();
+    static const char *const k[] = {"pin", "pass", "pwd", "key", "ssid", "token", "secret", "auth", "cred", "lock"};
+    for (const char *w : k) if (s.indexOf(w) >= 0) return true;
+    return false;
+}
+
+static void appendFinding(std::vector<AuditFinding> &v, const GattChrSnap &c, const String &verdict,
+                          const String &risk, const String &detail, const uint8_t *p, size_t n) {
+    if (v.size() >= kMaxFindings) return;
+    AuditFinding f;
+    f.uuid = c.uuid;
+    f.svc = c.svcUuid;
+    f.handle = c.handle;
+    f.props = propsStr(c.props);
+    f.verdict = verdict;
+    f.risk = risk;
+    f.detail = detail;
+    f.preview = asciiPreview(p, n);
+    v.push_back(f);
+}
+
+static String auditFindingsJson(const std::vector<AuditFinding> &v) {
+    String j = "[";
+    for (size_t i = 0; i < v.size(); i++) {
+        const AuditFinding &f = v[i];
+        if (i) j += ",";
+        j += "{\"uuid\":\"" + jsonEsc(f.uuid) + "\",\"svc\":\"" + jsonEsc(f.svc) +
+             "\",\"handle\":" + String((int)f.handle) + ",\"props\":\"" + f.props +
+             "\",\"risk\":\"" + f.risk + "\",\"verdict\":\"" + f.verdict +
+             "\",\"detail\":\"" + jsonEsc(f.detail) + "\",\"preview\":\"" + jsonEsc(f.preview) + "\"}";
+    }
+    j += "]";
+    return j;
+}
+
+static void writeAuditState(const GattProfile &prof, const std::vector<AuditFinding> &v,
+                            bool encrypted, bool bonded, bool linkStateAtEndKnown, bool safeFuzzer, uint32_t reads,
+                            uint32_t writes, uint32_t disconnects) {
+    String j = "{";
+    j += "\"generated\":" + String((unsigned long)seclabUptimeSec()) + ",";
+    j += "\"target\":\"" + jsonEsc(prof.name) + "\",\"addr\":\"" + jsonEsc(prof.addr) +
+         "\",\"rssi\":" + String(prof.rssi) + ",";
+    j += "\"services\":" + String((int)prof.services.size()) + ",\"chars\":" + String((int)prof.chars.size()) + ",";
+    j += "\"encrypted\":" + String(encrypted ? "true" : "false") + ",\"bonded\":" + String(bonded ? "true" : "false") + ",";
+    j += "\"linkStateAtEndKnown\":" + String(linkStateAtEndKnown ? "true" : "false") + ",";
+    j += "\"safeFuzzer\":" + String(safeFuzzer ? "true" : "false") + ",";
+    j += "\"reads\":" + String((unsigned long)reads) + ",\"writes\":" + String((unsigned long)writes) +
+         ",\"disconnects\":" + String((unsigned long)disconnects) + ",";
+    j += "\"findings\":" + String((int)v.size()) + ",";
+    j += String("\"high\":0,\"file\":\"") + kAuditPath +
+         "\",\"log\":\"" + kAuditLog + "\",";
+    j.replace("\"high\":0", "\"high\":" + String((int)std::count_if(v.begin(), v.end(), [](const AuditFinding &f){ return f.risk == "HIGH"; })));
+    j += "\"findingList\":" + auditFindingsJson(v) + "}";
+    seclabWriteState(kAuditPath, j);
+    for (const auto &f : v) {
+        seclabAppendLog(kAuditLog, String(seclabUptimeSec()) + "," + f.risk + "," + f.verdict + "," +
+                                       String((int)f.handle) + "," + f.uuid + "," + f.detail);
+    }
+}
+
+} // namespace
+
+void ble_gatt_auto_audit(GattProfile &prof, NimBLEClient *client, bool safeFuzzer) {
+    if (!client || !client->isConnected()) return;
+    NimBLEConnInfo info = client->getConnInfo();
+    bool encrypted = info.isEncrypted();
+    bool bonded = info.isBonded();
+    uint32_t reads = 0, writes = 0, disconnects = 0;
+    std::vector<AuditFinding> findings;
+    std::vector<uint8_t> zero(32, 0x00), ff(32, 0xFF), maxLen(244, 0xA5);
+    static const uint8_t empty = 0;
+    const std::vector<uint8_t> boundary[] = {
+        {}, zero, maxLen, ff
+    };
+    const char *labels[] = {"0-byte", "0x00x32", "max-244", "0xFFx32"};
+
+    drawMainBorderWithTitle("BLE AUTO AUDIT");
+    padprintln("Target: " + prof.name.substring(0, 18));
+    padprintln(String("Initial link: ") + (encrypted ? "ENCRYPTED" : "UNENCRYPTED"));
+    padprintln("Walking " + String((int)prof.chars.size()) + " chars...");
+    vTaskDelay(pdMS_TO_TICKS(400));
+
+    int fuzzed = 0;
+    for (auto &c : prof.chars) {
+        if (!client->isConnected()) { disconnects++; break; }
+        bool sensitive = hasSensitiveKeyword(c.uuid, c.val.data(), c.val.size());
+        if (c.remote && (c.props & 0x01)) {
+            const bool beforeEncrypted = client->getConnInfo().isEncrypted();
+            time_t readStamp = static_cast<time_t>(-1);
+            NimBLEAttValue v = c.remote->readValue(&readStamp);
+            reads++;
+            const bool connected = client->isConnected();
+            const bool afterEncrypted = connected && client->getConnInfo().isEncrypted();
+            const BleAuditEvidence evidence = bleAuditReadEvidence(readStamp, connected, beforeEncrypted, afterEncrypted);
+            if (evidence != BleAuditEvidence::Unconfirmed) {
+                std::vector<uint8_t> fresh;
+                if (v.size()) fresh.assign(v.data(), v.data() + std::min<size_t>(v.size(), 64));
+                c.val = fresh;
+                sensitive = sensitive || hasSensitiveKeyword(c.uuid, fresh.data(), fresh.size());
+                if (evidence == BleAuditEvidence::Unencrypted) {
+                    appendFinding(findings, c, "UNAUTH_READ", sensitive ? "HIGH" : "MEDIUM",
+                                  "Read succeeded on unencrypted link" + String(sensitive ? " + sensitive keyword" : ""),
+                                  fresh.data(), fresh.size());
+                } else if (sensitive) {
+                    appendFinding(findings, c, "KEYWORD", "INFO",
+                                  "Sensitive keyword in UUID/value; link was encrypted during read",
+                                  fresh.data(), fresh.size());
+                }
+            }
+        }
+        bool writable = c.remote && (c.props & (0x02 | 0x04));
+        if (!writable || safeFuzzer == false || fuzzed >= 16) continue;
+
+        for (size_t b = 0; b < 4 && client->isConnected(); b++) {
+            const std::vector<uint8_t> &payload = boundary[b];
+            const uint8_t *ptr = payload.empty() ? &empty : payload.data();
+            const bool response = (c.props & 0x02) != 0;
+            const bool beforeEncrypted = client->getConnInfo().isEncrypted();
+            const bool ok = c.remote->writeValue(ptr, payload.size(), response);
+            writes++;
+            const bool connected = client->isConnected();
+            const bool afterEncrypted = connected && client->getConnInfo().isEncrypted();
+            const BleAuditEvidence evidence = bleAuditWriteEvidence(ok, response, connected, beforeEncrypted, afterEncrypted);
+            if (evidence == BleAuditEvidence::Unencrypted) {
+                appendFinding(findings, c, "UNAUTH_WRITE", "HIGH",
+                              String("Write request succeeded unencrypted; library may truncate ") + labels[b],
+                              ptr, payload.size());
+            } else if (ok && !response && connected) {
+                appendFinding(findings, c, "WRITE_QUEUED", "INFO",
+                              String("No-response write queued; acceptance unconfirmed: ") + labels[b],
+                              ptr, payload.size());
+            }
+            if (!connected) {
+                disconnects++;
+                appendFinding(findings, c, "FUZZ_DISCONNECT", "MEDIUM",
+                              String("Disconnected after ") + labels[b] + "; cause unknown", ptr, payload.size());
+                break;
+            }
+            if (ok && (c.props & 0x01) && b < 3) {
+                time_t readStamp = static_cast<time_t>(-1);
+                NimBLEAttValue v = c.remote->readValue(&readStamp);
+                reads++;
+                bool echo = readStamp != static_cast<time_t>(-1) && client->isConnected() &&
+                            v.size() == payload.size() &&
+                            (payload.empty() || memcmp(v.data(), ptr, payload.size()) == 0);
+                if (echo && !payload.empty()) {
+                    appendFinding(findings, c, "WRITE_ECHO", "INFO",
+                                  String("Read-back matches written test value ") + labels[b], v.data(), v.size());
+                }
+            }
+            vTaskDelay(pdMS_TO_TICKS(60));
+        }
+        fuzzed++;
+    }
+
+    const bool linkStateAtEndKnown = client->isConnected();
+    if (linkStateAtEndKnown) {
+        const NimBLEConnInfo finalInfo = client->getConnInfo();
+        encrypted = finalInfo.isEncrypted();
+        bonded = finalInfo.isBonded();
+    }
+    writeAuditState(prof, findings, encrypted, bonded, linkStateAtEndKnown, safeFuzzer, reads, writes, disconnects);
+    drawMainBorderWithTitle("BLE AUTO AUDIT");
+    padprintln("Done: " + String((int)findings.size()) + " findings");
+    padprintln("Reads/Writes: " + String((unsigned long)reads) + "/" + String((unsigned long)writes));
+    padprintln(!linkStateAtEndKnown ? "Link: disconnected" : encrypted ? "Link: encrypted" : "Link: unencrypted");
+    padprintln("Report: /ble_security_audit.json");
+    vTaskDelay(pdMS_TO_TICKS(1800));
+}
+
+// ------------------------------ 4B: pairing audit ------------------------------
+namespace {
+
+static volatile bool s_pairAuthComplete = false;
+static volatile bool s_pairEncrypted = false;
+static volatile bool s_pairBonded = false;
+static char s_pairVerdict[48] = "NOT_RUN";
+static char s_pairLastErr[96] = {0};
+static String s_pairTarget;
+static uint32_t s_pairFinishedMs = 0;
+
+class PairAuditCb : public NimBLEClientCallbacks {
+    void onAuthenticationComplete(NimBLEConnInfo &info) override {
+        s_pairAuthComplete = true;
+        s_pairEncrypted = info.isEncrypted();
+        s_pairBonded = info.isBonded();
+    }
+    void onPassKeyEntry(NimBLEConnInfo &info) override {
+        // Just Works audit: no PIN should be requested. If it is, provide 0 and
+        // record that the peer asked for a passkey (not a clean downgrade).
+        (void)info;
+        strncpy(s_pairVerdict, "PIN_REQUESTED", sizeof(s_pairVerdict) - 1);
+    }
+    uint32_t onPassKeyDisplay(NimBLEConnInfo &) override { return 0; }
+    void onConfirmPasskey(NimBLEConnInfo &info, uint32_t) override {
+        NimBLEDevice::injectConfirmPasskey(info, true);
+    }
+};
+
+static PairAuditCb s_pairCb;
+
+static void setPairErr(const String &e) {
+    strncpy(s_pairLastErr, e.c_str(), sizeof(s_pairLastErr) - 1);
+    s_pairLastErr[sizeof(s_pairLastErr) - 1] = 0;
+}
+
+static void writePairState(const String &addr, bool justWorks, bool connected, bool secureStarted,
+                           bool encrypted, bool bonded, const String &verdict, const String &err) {
+    String j = "{";
+    j += "\"generated\":" + String((unsigned long)seclabUptimeSec()) + ",";
+    j += "\"addr\":\"" + jsonEsc(addr) + "\",\"target\":\"" + jsonEsc(addr) + "\",";
+    j += "\"justWorksMode\":" + String(justWorks ? "true" : "false") + ",";
+    j += "\"connected\":" + String(connected ? "true" : "false") + ",";
+    j += "\"secureStarted\":" + String(secureStarted ? "true" : "false") + ",";
+    j += "\"encrypted\":" + String(encrypted ? "true" : "false") + ",";
+    j += "\"bonded\":" + String(bonded ? "true" : "false") + ",";
+    j += "\"verdict\":\"" + jsonEsc(verdict) + "\",\"lastErr\":\"" + jsonEsc(err) + "\",";
+    j += String("\"file\":\"") + kPairPath + "\",\"log\":\"" + kPairLog + "\"}";
+    seclabWriteState(kPairPath, j);
+    seclabAppendLog(kPairLog, String(seclabUptimeSec()) + "," + addr + "," + verdict + "," + err);
+}
+
+} // namespace
+
+bool blePairingAuditStart(const String &addr, uint8_t addrType, bool justWorks, String *errOut) {
+    if (bleTagBeaconIsRunning()) bleTagBeaconStop();
+    stopBLEStack();
+    vTaskDelay(pdMS_TO_TICKS(100));
+    if (!radioHasMemForBle()) radioFreeWiFiForBle();
+    if (!radioHasMemForBle()) { if (errOut) *errOut = "Low RAM for BLE pairing audit"; return false; }
+
+    s_pairAuthComplete = false;
+    s_pairEncrypted = false;
+    s_pairBonded = false;
+    s_pairTarget = addr;
+    strncpy(s_pairVerdict, "RUNNING", sizeof(s_pairVerdict) - 1);
+    s_pairVerdict[sizeof(s_pairVerdict) - 1] = 0;
+    s_pairLastErr[0] = 0;
+
+    NimBLEDevice::init("Bruce-PairAudit");
+    if (justWorks) {
+        NimBLEDevice::setSecurityAuth(false, false, false); // no bonding, no MITM, no LE Secure Connections
+        NimBLEDevice::setSecurityIOCap(0x03);               // BLE_HS_IO_NO_INPUT_OUTPUT
+        NimBLEDevice::setSecurityPasskey(0);
+    } else {
+        NimBLEDevice::setSecurityAuth(true, true, true);
+        NimBLEDevice::setSecurityIOCap(0x04);               // keyboard+display
+    }
+
+    NimBLEClient *client = NimBLEDevice::createClient();
+    if (!client) { if (errOut) *errOut = "createClient failed"; stopBLEStack(); return false; }
+    client->setClientCallbacks(&s_pairCb, false);
+    client->setConnectTimeout(12);
+    client->setConnectionParams(12, 24, 0, 200);
+
+    NimBLEAddress peer(addr.c_str(), addrType);
+    bool connected = client->connect(peer, true, false, true);
+    bool secureStarted = false;
+    bool encrypted = false, bonded = false;
+    String verdict = "CONNECT_FAILED";
+    String err = "";
+    if (!connected) {
+        err = "Connect failed (device busy / out of range)";
+        setPairErr(err);
+    } else {
+        secureStarted = client->secureConnection(false);
+        vTaskDelay(pdMS_TO_TICKS(1200));
+        NimBLEConnInfo info = client->getConnInfo();
+        encrypted = info.isEncrypted() || s_pairEncrypted;
+        bonded = info.isBonded() || s_pairBonded;
+        if (!secureStarted) {
+            verdict = "SECURITY_REQUEST_REFUSED";
+            err = "secureConnection() refused";
+        } else if (encrypted && justWorks && !bonded) {
+            verdict = "JUST_WORKS_ALLOWED";
+        } else if (encrypted && justWorks && bonded) {
+            verdict = "JUST_WORKS_BONDED";
+        } else if (!encrypted && s_pairAuthComplete) {
+            verdict = "PAIRING_FAILED";
+        } else if (!encrypted) {
+            verdict = "NO_ENCRYPTION";
+        } else {
+            verdict = justWorks ? "ENCRYPTED" : "MITM_PAIRING";
+        }
+        strncpy(s_pairVerdict, verdict.c_str(), sizeof(s_pairVerdict) - 1);
+        s_pairVerdict[sizeof(s_pairVerdict) - 1] = 0;
+        client->disconnect();
+    }
+    NimBLEDevice::deleteClient(client);
+    stopBLEStack();
+    s_pairFinishedMs = millis();
+    writePairState(addr, justWorks, connected, secureStarted, encrypted, bonded, verdict, err);
+    // A refused security request is a valid audit finding, not a transport failure.
+    // Keep errOut reserved for failures that prevented the audit from being queued.
+    bool success = connected && (verdict != "CONNECT_FAILED");
+    if (errOut) *errOut = success ? String("") : err;
+    return success;
+}
