--- /dev/null
+++ b/src/core/wifi/web_navigation.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <cctype>
+#include <cstdlib>
+#include <cstring>
+
+// Parse exact commands; prefix matching maps nextpage to next and unknown input to Select.
+enum class WebNavButton { Select, Back, Up, Down, Next, Previous, NextPage, PreviousPage };
+struct WebNavCommand { WebNavButton button; unsigned durationMs; };
+inline bool parseWebNav(const char *text, WebNavCommand &out) {
+    if (!text || std::strncmp(text, "nav", 3) || !std::isspace((unsigned char)text[3])) return false;
+    text += 3;
+    while (std::isspace((unsigned char)*text)) ++text;
+    const char *begin = text;
+    while (*text && !std::isspace((unsigned char)*text)) ++text;
+    const size_t n = text - begin;
+    auto equals = [&](const char *s) { return std::strlen(s) == n && std::strncmp(begin, s, n) == 0; };
+    if (equals("sel") || equals("select")) out.button = WebNavButton::Select;
+    else if (equals("esc")) out.button = WebNavButton::Back;
+    else if (equals("up")) out.button = WebNavButton::Up;
+    else if (equals("down")) out.button = WebNavButton::Down;
+    else if (equals("next")) out.button = WebNavButton::Next;
+    else if (equals("prev")) out.button = WebNavButton::Previous;
+    else if (equals("nextpage")) out.button = WebNavButton::NextPage;
+    else if (equals("prevpage")) out.button = WebNavButton::PreviousPage;
+    else return false;
+    while (std::isspace((unsigned char)*text)) ++text;
+    out.durationMs = 1;
+    if (*text) {
+        if (!std::isdigit((unsigned char)*text)) return false;
+        char *end = nullptr;
+        long duration = std::strtol(text, &end, 10);
+        while (std::isspace((unsigned char)*end)) ++end;
+        if (*end || duration < 1 || duration > 2000) return false;
+        out.durationMs = static_cast<unsigned>(duration);
+    }
+    return true;
+}
