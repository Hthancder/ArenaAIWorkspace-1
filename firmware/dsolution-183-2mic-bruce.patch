+
+String bleGattSavedProfilesJson() {
+    String out = "[";
+    if (LittleFS.exists(kGattProfilesDir)) {
+        File dir = LittleFS.open(kGattProfilesDir);
+        int n = 0;
+        if (dir) {
+            while (true) {
+                bool isDir = false;
+                String p = dir.getNextFileName(&isDir);
+                if (p.isEmpty()) break;
+                if (isDir || !p.endsWith(".json")) continue;
+                GattProfile gp;
+                if (loadGattProfileJson(p, gp)) {
+                    if (n++ > 0) out += ",";
+                    out += "{\"path\":\"" + jsonEscBle(p) + "\",\"name\":\"" + jsonEscBle(gp.name) +
+                           "\",\"addr\":\"" + jsonEscBle(gp.addr) +
+                           "\",\"services\":" + String((int)gp.services.size()) +
+                           ",\"chars\":" + String((int)gp.chars.size()) + "}";
+                }
+            }
+            dir.close();
+        }
+    }
+    out += "]";
+    return out;
+}
+
+String bleGattGetStateJson() {
+    String j = "{";
+    j += "\"mode\":\"" + s_activeMode + "\",";
+    j += "\"target\":\"" + jsonEscBle(s_activeTarget) + "\",";
+    j += "\"connected\":" + String((s_clientConnected || s_cloneClientConn) ? "true" : "false") + ",";
+    j += "\"txPhy\":\"" + String(phyCodeToStr(s_txPhy)) + "\",";
+    j += "\"rxPhy\":\"" + String(phyCodeToStr(s_rxPhy)) + "\",";
+    j += "\"notifyCount\":" + String((unsigned long)s_notifyCount) + ",";
+    j += "\"cloneWrites\":" + String((unsigned long)s_cloneWrites) + ",";
+    j += "\"lastEvent\":\"" + jsonEscBle(s_lastEventStr) + "\",";
+    j += "\"profiles\":" + bleGattSavedProfilesJson();
+    j += "}";
+    return j;
+}
