+
+void sonar_guard_setup() {
+    bool gpioInput = false;
+    uint32_t regVal = REG_READ(GPIO_ENABLE_REG);
+    if ((regVal & (1UL << GPIO_NUM_0)) == 0) {
+        gpioInput = true;
+        gpio_hold_en(GPIO_NUM_0);
+    }
+
+    int16_t *txBuf = (int16_t *)calloc(kSonarFrames * 2, sizeof(int16_t));
+    int16_t *rxBuf = (int16_t *)calloc(kSonarFrames * 2, sizeof(int16_t));
+    int16_t *txSilence = (int16_t *)calloc(kSonarFrames * 2, sizeof(int16_t));
+    if (!txBuf || !rxBuf || !txSilence) {
+        free(txBuf);
+        free(rxBuf);
+        free(txSilence);
+        if (gpioInput) gpio_hold_dis(GPIO_NUM_0);
+        displayError("Out of RAM", true);
+        return;
+    }
+
+    if (!initFullDuplexSonarI2S()) {
+        free(txBuf);
+        free(rxBuf);
+        free(txSilence);
+        if (gpioInput) {
+            gpio_hold_dis(GPIO_NUM_0);
+#if defined(DSOLUTION_183_2MIC)
+            pinMode(GPIO_NUM_0, INPUT_PULLUP);
+#endif
+        }
+        displayError("I2S Sonar init failed", true);
+        return;
+    }
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    SonarActionMode actionMode = SONAR_ACT_SIREN_LED;
+    SonarSensitivity sens = SONAR_SENS_MED;
+    uint16_t carrierHz = 18500;
+    bool armed = false;
+    bool armCountdown = false;
+    uint32_t armAtMs = 0;
+
+    bool calibrating = true;
+    uint32_t calibStart = millis();
+    double calibSum = 0.0;
+    int calibCount = 0;
+    float baselineSide = 0.01f;
+
+    float smoothMotion = 0.0f;
+    float smoothDir = 0.0f; // -1..+1
+    bool smoothApproach = true;
+    int consecHits = 0;
+    uint32_t lastAlertAt = 0;
+    uint32_t alertBannerUntil = 0;
+    uint32_t armedStartedMs = 0;
+    uint32_t sweepTick = 0;
+    std::vector<SonarEventRec> events;
+    saveSonarStateAndLog(false, actionMode, sens, carrierHz, 0, false, events, nullptr);
+
+    float txPhase = 0.0f;
+    uint32_t lastDraw = 0;
+    returnToMenu = false;
+
+    while (!returnToMenu) {
+        InputHandler();
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+
+        // Vol+ / Vol- quickly cycles sensitivity when in live mode
+        if (check(PrevPress)) {
+            sens = (SonarSensitivity)(((int)sens + 2) % 3);
+            lastDraw = 0;
+        }
+        if (check(NextPress)) {
+            sens = (SonarSensitivity)(((int)sens + 1) % 3);
+            lastDraw = 0;
+        }
+        if (check(SelPress)) {
+            if (armed || armCountdown) {
+                armed = false;
+                armCountdown = false;
+                setBrightness(bruceConfig.bright, false);
+                setLedColor(CRGB::Black);
+                saveSonarStateAndLog(false, actionMode, sens, carrierHz, (uint8_t)smoothMotion, false, events, nullptr);
+            } else {
+                int act = -1;
+                options.clear();
+                options.push_back({"ARM Motion Guard (8s)", [&]() { act = 0; }});
+                options.push_back({String("Alert: ") +
+                                   (actionMode == SONAR_ACT_SIREN_LED ? "Siren + LED"
+                                    : (actionMode == SONAR_ACT_SILENT_LOG ? "Silent + WebUI" : "Auto-Rec 6s WAV")),
+                                   [&]() { act = 1; }});
+                options.push_back({String("Carrier: ") + String(carrierHz) + " Hz", [&]() { act = 2; }});
+                options.push_back({"Recalibrate Room", [&]() { act = 3; }});
+                options.push_back({"Exit", [&]() { act = 4; }});
+                loopOptions(options, MENU_TYPE_SUBMENU, "Acoustic Sonar Guard");
+                options.clear();
+
+                if (act == 0) {
+                    armCountdown = true;
+                    armAtMs = millis() + 8000UL;
+                } else if (act == 1) {
+                    actionMode = (SonarActionMode)(((int)actionMode + 1) % 3);
+                    saveSonarStateAndLog(false, actionMode, sens, carrierHz, (uint8_t)smoothMotion, false, events, nullptr);
+                } else if (act == 2) {
+                    if (carrierHz == 18500) carrierHz = 17500;
+                    else if (carrierHz == 17500) carrierHz = 19200;
+                    else carrierHz = 18500;
+                    calibrating = true;
+                    calibStart = millis();
+                    calibSum = 0.0;
+                    calibCount = 0;
+                } else if (act == 3) {
+                    calibrating = true;
+                    calibStart = millis();
+                    calibSum = 0.0;
+                    calibCount = 0;
+                } else if (act == 4) {
+                    returnToMenu = true;
+                    break;
+                }
+            }
+            lastDraw = 0;
+        }
+
+        if (armCountdown && (int32_t)(millis() - armAtMs) >= 0) {
+            armCountdown = false;
+            armed = true;
+            armedStartedMs = millis();
+            calibrating = true;
+            calibStart = millis();
+            calibSum = 0.0;
+            calibCount = 0;
+            consecHits = 0;
+            saveSonarStateAndLog(true, actionMode, sens, carrierHz, 0, false, events, nullptr);
+        }
+
+        // Generate smooth continuous carrier tone (safe amplitude ~7500 avoids codec clipping)
+        float inc = 2.0f * (float)M_PI * (float)carrierHz / (float)kSonarRate;
+        for (size_t i = 0; i < kSonarFrames; i++) {
+            int16_t s = (int16_t)(sinf(txPhase) * 7500.0f);
+            txBuf[i * 2] = s;
+            txBuf[i * 2 + 1] = s;
+            txPhase += inc;
+            if (txPhase > 2.0f * (float)M_PI) txPhase -= 2.0f * (float)M_PI;
+        }
+
+        size_t wr = 0, rd = 0;
+        i2s_channel_write(s_txChan, txBuf, kSonarFrames * 4, &wr, pdMS_TO_TICKS(30));
+        if (i2s_channel_read(s_rxChan, rxBuf, kSonarFrames * 4, &rd, pdMS_TO_TICKS(30)) != ESP_OK ||
+            rd < kSonarFrames * 4) {
+            continue;
+        }
+
+        // Evaluate symmetric Doppler sidebands around carrierHz on MIC1 (L) and MIC2 (R)
+        static const float kOffsets[4] = {45.0f, 95.0f, 150.0f, 220.0f};
+        float sideL = 0.0f, sideR = 0.0f, posSum = 0.0f, negSum = 0.0f;
+        for (float df : kOffsets) {
+            float pL = goertzelStereo(rxBuf, kSonarFrames, (float)carrierHz + df, 0);
+            float nL = goertzelStereo(rxBuf, kSonarFrames, (float)carrierHz - df, 0);
+            float pR = goertzelStereo(rxBuf, kSonarFrames, (float)carrierHz + df, 1);
+            float nR = goertzelStereo(rxBuf, kSonarFrames, (float)carrierHz - df, 1);
+            sideL += pL + nL;
+            sideR += pR + nR;
+            posSum += pL + pR;
+            negSum += nL + nR;
+        }
+        float totalSide = 0.5f * (sideL + sideR);
+
+        if (calibrating) {
+            // Skip first 250ms settling
+            if (millis() - calibStart > 250) {
+                calibSum += totalSide;
+                calibCount++;
+            }
+            if (millis() - calibStart >= 1400 && calibCount >= 10) {
+                baselineSide = std::max(0.012f, (float)(calibSum / calibCount));
+                calibrating = false;
+                smoothMotion = 0.0f;
+            }
+        } else {
+            float ratio = (totalSide - baselineSide) / (baselineSide * 1.65f);
+            if (ratio < 0.0f) ratio = 0.0f;
+            float pct = std::min(100.0f, ratio * 100.0f);
+            smoothMotion = smoothMotion * 0.62f + pct * 0.38f;
+
+            float denom = sideL + sideR + 0.005f;
+            float rawDir = (sideR - sideL) / denom; // >0 = Right stronger, <0 = Left stronger
+            rawDir = std::max(-1.0f, std::min(1.0f, rawDir * 2.2f));
+            smoothDir = smoothDir * 0.72f + rawDir * 0.28f;
+            smoothApproach = (posSum >= negSum);
+
+            // Slowly adapt baseline only when completely still
+            if (smoothMotion < 8.0f) {
+                baselineSide = baselineSide * 0.992f + totalSide * 0.008f;
+            }
+
+            float thresh = (sens == SONAR_SENS_LOW) ? 45.0f : ((sens == SONAR_SENS_MED) ? 28.0f : 16.0f);
+            if (smoothMotion >= thresh) consecHits++;
+            else consecHits = 0;
+
+            if (armed && consecHits >= 3 && (millis() - lastAlertAt) > 6000UL) {
+                lastAlertAt = millis();
+                alertBannerUntil = millis() + 4500UL;
+                SonarEventRec ev = {};
+                ev.tsSec = millis() / 1000UL;
+                ev.score = (uint8_t)std::min(100.0f, smoothMotion);
+                ev.dir = (smoothDir < -0.22f) ? -1 : ((smoothDir > 0.22f) ? 1 : 0);
+                ev.approach = smoothApproach;
+                ev.wavFile[0] = '\0';
+
+                if (actionMode == SONAR_ACT_AUTOREC_WAV) {
+                    setBrightness(bruceConfig.bright, false);
+                    setLedColor(CRGB::Red);
+                    String wpath = recordGuardClipWav(rxBuf, txSilence, 6000);
+                    setLedColor(CRGB::Black);
+                    if (!wpath.isEmpty()) strncpy(ev.wavFile, wpath.c_str(), sizeof(ev.wavFile) - 1);
+                } else if (actionMode == SONAR_ACT_SIREN_LED) {
+                    setBrightness(bruceConfig.bright, false);
+                    playSirenBurst(txBuf, rxBuf);
+                } else {
+                    // Silent mode: subtle log only, keep screen dim
+                }
+
+                if ((int)events.size() >= kMaxSonarHistory) events.erase(events.begin());
+                events.push_back(ev);
+                saveSonarStateAndLog(true, actionMode, sens, carrierHz, (uint8_t)smoothMotion, true, events, &ev);
+                consecHits = 0;
+            }
+        }
+
+        // Dim display gently after 15s while armed in Silent mode to preserve battery
+        if (armed && actionMode == SONAR_ACT_SILENT_LOG && (millis() - armedStartedMs) > 15000UL &&
+            millis() > alertBannerUntil) {
+            setBrightness(12, false);
+        } else {
+            wakeUpScreen();
+        }
+
+        if (millis() - lastDraw >= 45) {
+            lastDraw = millis();
+            sweepTick = (sweepTick + 1) % 360;
+            if (hasSprite) {
+                const uint16_t bg = bruceConfig.bgColor;
+                const uint16_t pri = bruceConfig.priColor;
+                const uint16_t sec = bruceConfig.secColor;
+                const uint16_t okCol = 0x2F2F;
+                const uint16_t warnCol = 0xFD84;
+                const uint16_t errCol = 0xF9CA;
+
