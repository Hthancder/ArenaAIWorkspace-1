+bool naptAddBlockDomain(const String &domain) {
+    String d = domain;
+    d.trim();
+    d.toLowerCase();
+    if (d.isEmpty() || d.length() > 60) return false;
+    ensureNaptMutex();
+    if (xSemaphoreTake(s_naptMutex, pdMS_TO_TICKS(100)) != pdTRUE) return false;
+    loadBlockListLocked();
+    for (const auto &x : s_blockDomains) {
+        if (x == d) {
+            xSemaphoreGive(s_naptMutex);
+            return true;
+        }
+    }
+    if (s_blockDomains.size() < 64) {
+        s_blockDomains.push_back(d);
+        saveBlockListLocked();
+    }
+    xSemaphoreGive(s_naptMutex);
+    return true;
+}
+
+bool naptRemoveBlockDomain(const String &domain) {
+    String d = domain;
+    d.trim();
+    d.toLowerCase();
+    ensureNaptMutex();
+    if (xSemaphoreTake(s_naptMutex, pdMS_TO_TICKS(100)) != pdTRUE) return false;
+    loadBlockListLocked();
+    auto it = std::remove(s_blockDomains.begin(), s_blockDomains.end(), d);
+    bool changed = (it != s_blockDomains.end());
+    if (changed) {
+        s_blockDomains.erase(it, s_blockDomains.end());
+        saveBlockListLocked();
+    }
+    xSemaphoreGive(s_naptMutex);
+    return changed;
+}
+
+void naptClearLog() {
+    ensureNaptMutex();
+    if (xSemaphoreTake(s_naptMutex, pdMS_TO_TICKS(100)) != pdTRUE) return;
+    s_feedHead = 0;
+    s_feedCount = 0;
+    s_totalQueries = 0;
+    s_blockedQueries = 0;
+    s_trackerQueries = 0;
+    xSemaphoreGive(s_naptMutex);
+}
+
+bool naptExportLog() {
+    ensureNaptMutex();
+    if (xSemaphoreTake(s_naptMutex, pdMS_TO_TICKS(150)) != pdTRUE) return false;
+    File f = LittleFS.open(kDnsExportPath, FILE_WRITE);
+    if (!f) {
+        xSemaphoreGive(s_naptMutex);
+        return false;
+    }
+    f.printf("# Bruce NAPT DNS Log | Uplink: %s | Queries: %lu | Blocked: %lu\n",
+             WiFi.SSID().c_str(), (unsigned long)s_totalQueries, (unsigned long)s_blockedQueries);
+    f.println("# ts_sec,client_ip,qtype,status,domain");
+    int start = (s_feedHead - s_feedCount + kNaptLogCap) % kNaptLogCap;
+    for (int i = 0; i < s_feedCount; i++) {
+        const DnsFeedEntry &e = s_feed[(start + i) % kNaptLogCap];
+        const char *st = e.blocked ? "BLOCKED" : (e.tracker ? "TRACKER" : "ALLOW");
+        f.printf("%lu,%s,%u,%s,%s\n", (unsigned long)e.tsSec, e.clientIp, (unsigned)e.qtype, st, e.domain);
+    }
+    f.close();
+    xSemaphoreGive(s_naptMutex);
+    return true;
+}
+
+bool naptStartBackground(const String &staSsid, const String &staPwd, String *errOut) {
+    if (s_naptRunning) return true;
+    if (!radioHasMemForWifi()) {
+        if (errOut) *errOut = "Low DMA RAM for Wi-Fi";
+        return false;
+    }
+    ensureWifiPlatform();
+    WiFi.mode(WIFI_AP_STA);
+    applyConfiguredMAC();
+
+    if (!staSsid.isEmpty()) {
+        WiFi.begin(staSsid.c_str(), staPwd.length() > 0 ? staPwd.c_str() : NULL);
+        for (int i = 0; i < 100 && !WiFi.isConnected(); i++) vTaskDelay(pdMS_TO_TICKS(100));
+        if (!WiFi.isConnected()) {
+            if (errOut) *errOut = "Could not connect to uplink Wi-Fi";
+            return false;
+        }
+        bruceConfig.addWifiCredential(staSsid, staPwd);
+    } else if (!WiFi.isConnected()) {
+        if (!bruceConfig.wifi.empty()) wifiConnecttoKnownNet();
+        if (!WiFi.isConnected()) {
+            if (errOut) *errOut = "No uplink Wi-Fi connected";
+            return false;
+        }
+    }
+
+    wifiConnected = true;
+    IPAddress apIp(192, 168, 4, 1);
+    IPAddress mask(255, 255, 255, 0);
+    IPAddress leaseStart(192, 168, 4, 2);
+    // Point DHCP DNS Option to 192.168.4.1 so every client DNS query flows through our proxy
+    WiFi.softAPConfig(apIp, apIp, mask, leaseStart, apIp);
+    uint8_t staCh = (uint8_t)std::max(1, (int)WiFi.channel());
+    if (!WiFi.softAP(bruceConfig.wifiAp.ssid.c_str(),
+                     bruceConfig.wifiAp.pwd.length() >= 8 ? bruceConfig.wifiAp.pwd.c_str() : NULL,
+                     staCh, 0, 4, false)) {
+        if (errOut) *errOut = "Failed to start SoftAP";
+        return false;
+    }
+    vTaskDelay(pdMS_TO_TICKS(120));
+    if (!WiFi.AP.enableNAPT(true)) {
+        if (errOut) *errOut = "NAPT enable failed";
+        return false;
+    }
+
+    WiFi.setSleep(WIFI_PS_NONE);
+    wifiIP = WiFi.localIP().toString();
+    ensureNaptMutex();
+    if (xSemaphoreTake(s_naptMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
+        loadBlockListLocked();
+        xSemaphoreGive(s_naptMutex);
+    }
+
+    s_naptStopReq = false;
+    s_startedAtMs = millis();
+    s_naptRunning = true;
+    BaseType_t ok = xTaskCreatePinnedToCore(naptDnsProxyTask, "naptDns", 4096, NULL, 2, &s_naptTask, 0);
+    if (ok != pdPASS) {
+        s_naptRunning = false;
+        if (errOut) *errOut = "DNS proxy task spawn failed";
+        return false;
+    }
+    return true;
+}
+
+void naptStop(bool disconnectSta) {
+    s_naptStopReq = true;
+    for (int i = 0; i < 40 && s_naptTask != nullptr; i++) vTaskDelay(pdMS_TO_TICKS(25));
+    s_naptRunning = false;
+    WiFi.AP.enableNAPT(false);
+    if (disconnectSta) {
+        WiFi.softAPdisconnect(true);
+        wifiDisconnect();
+    } else if (WiFi.isConnected()) {
+        WiFi.softAPdisconnect(true);
+        WiFi.mode(WIFI_STA);
+        applyWifiPowerProfile();
+    }
+}
