diff --git a/src/modules/wifi/wifi_observation_logic.h b/src/modules/wifi/wifi_observation_logic.h
new file mode 100644
index 00000000..297064ff
--- /dev/null
+++ b/src/modules/wifi/wifi_observation_logic.h
@@ -0,0 +1,110 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+// ESP-IDF reports sig_len including the 4-byte FCS. Callers pass the
+// management frame length *without* FCS, so its bytes cannot be parsed as IEs.
+struct WifiSsidElement {
+    const uint8_t *bytes = nullptr;
+    uint8_t length = 0;
+    bool allZero = true;
+};
+
+// Validate the entire tagged-parameter sequence, including duplicate SSIDs.
+// Invalid or truncated elements are never treated as a hidden network.
+inline bool wifiFindSsid(const uint8_t *frame, size_t length, size_t offset, WifiSsidElement &out) {
+    if (!frame || offset > length) return false;
+    WifiSsidElement parsed;
+    bool found = false;
+    while (offset < length) {
+        if (length - offset < 2) return false;
+        const uint8_t id = frame[offset++];
+        const size_t n = frame[offset++];
+        if (n > length - offset) return false;
+        if (id == 0) {
+            if (found || n > 32) return false;
+            found = true;
+            parsed.bytes = frame + offset;
+            parsed.length = static_cast<uint8_t>(n);
+            for (size_t i = 0; i < n; ++i) if (parsed.bytes[i]) parsed.allZero = false;
+        }
+        offset += n;
+    }
+    if (!found) return false;
+    out = parsed;
+    return true;
+}
+
+// Bounded exact BSSID set: unlike a hash-only set it cannot merge unrelated
+// addresses. Saturation means the reported count is a lower bound.
+class WifiBssidSet {
+    static constexpr size_t kCapacity = 64;
+    uint8_t addresses_[kCapacity][6] = {};
+    bool used_[kCapacity] = {};
+    uint16_t count_ = 0;
+    bool saturated_ = false;
+public:
+    void clear() { std::memset(used_, 0, sizeof(used_)); count_ = 0; saturated_ = false; }
+    void add(const uint8_t *mac) {
+        if (!mac) return;
+        uint32_t hash = 2166136261u;
+        for (int i = 0; i < 6; ++i) { hash ^= mac[i]; hash *= 16777619u; }
+        for (size_t i = 0; i < kCapacity; ++i) {
+            const size_t slot = (hash + i) % kCapacity;
+            if (used_[slot]) {
+                if (std::memcmp(addresses_[slot], mac, 6) == 0) return;
+            } else {
+                std::memcpy(addresses_[slot], mac, 6);
+                used_[slot] = true;
+                ++count_;
+                return;
+            }
+        }
+        saturated_ = true;
+    }
+    uint16_t count() const { return count_; }
+    bool saturated() const { return saturated_; }
+};
+
+inline uint32_t wifiObservedRate(uint32_t count, uint32_t elapsedMs) {
+    if (!elapsedMs) return 0;
+    const uint64_t rate = static_cast<uint64_t>(count) * 1000u / elapsedMs;
+    return rate > UINT32_MAX ? UINT32_MAX : static_cast<uint32_t>(rate);
+}
+
+// A packet-count heuristic, not measured channel airtime. Use actual elapsed
+// time and wide arithmetic so a delayed dwell or large counter cannot wrap.
+inline uint8_t wifiEstimatedLoad(uint32_t bytes, uint32_t packets, uint32_t elapsedMs) {
+    if (!elapsedMs) return 0;
+    const uint64_t estimatedUs = static_cast<uint64_t>(bytes) * 8 / 6 + static_cast<uint64_t>(packets) * 60;
+    const uint64_t percent = estimatedUs * 100 / (static_cast<uint64_t>(elapsedMs) * 1000);
+    return static_cast<uint8_t>(percent > 100 ? 100 : percent);
+}
+inline uint8_t wifiRetryPercent(uint32_t retries, uint32_t packets) {
+    if (!packets) return 0;
+    const uint64_t percent = static_cast<uint64_t>(retries) * 100 / packets;
+    return static_cast<uint8_t>(percent > 100 ? 100 : percent);
+}
+
+inline int wifiCleanScore(const uint8_t load[14], uint8_t ch) {
+    if (!load || ch < 1 || ch > 13) return -1;
+    float busy = static_cast<float>(load[ch]);
+    if (ch > 1) busy += 0.65f * load[ch - 1];
+    if (ch < 13) busy += 0.65f * load[ch + 1];
+    if (ch > 2) busy += 0.25f * load[ch - 2];
+    if (ch < 12) busy += 0.25f * load[ch + 2];
+    const int score = 100 - static_cast<int>(busy / 1.9f);
+    return score < 0 ? 0 : score > 100 ? 100 : score;
+}
+inline int wifiPickBestPrimary(const uint8_t load[14], const bool sampled[14]) {
+    if (!load || !sampled) return 0;
+    for (int ch = 1; ch <= 11; ++ch) if (!sampled[ch]) return 0;
+    const uint8_t choices[] = {1, 6, 11};
+    int best = 0, bestScore = -1;
+    for (uint8_t ch : choices) {
+        const int score = wifiCleanScore(load, ch);
+        if (score > bestScore) { best = ch; bestScore = score; }
+    }
+    return best;
+}
