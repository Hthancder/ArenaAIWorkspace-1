+String naptGetStateJson() {
+    ensureNaptMutex();
+    std::vector<NaptClientInfo> clients = s_naptRunning ? queryApClients() : std::vector<NaptClientInfo>();
+    String json;
+    json.reserve(2400);
+    json += "{\"running\":";
+    json += (s_naptRunning ? "true" : "false");
+    json += ",\"staConnected\":";
+    json += (WiFi.isConnected() ? "true" : "false");
+    json += ",\"staSsid\":\"";
+    json += jsonEscNapt(WiFi.isConnected() ? WiFi.SSID() : "");
+    json += "\",\"staIp\":\"";
+    json += (WiFi.isConnected() ? WiFi.localIP().toString() : "0.0.0.0");
+    json += "\",\"staRssi\":";
+    json += String(WiFi.isConnected() ? WiFi.RSSI() : 0);
+    json += ",\"apSsid\":\"";
+    json += jsonEscNapt(bruceConfig.wifiAp.ssid);
+    json += "\",\"apIp\":\"";
+    json += WiFi.softAPIP().toString();
+    json += "\",\"autoBlock\":";
+    json += (s_autoBlockTrackers ? "true" : "false");
+    json += ",\"total\":";
+    json += String((unsigned long)s_totalQueries);
+    json += ",\"blocked\":";
+    json += String((unsigned long)s_blockedQueries);
+    json += ",\"trackers\":";
+    json += String((unsigned long)s_trackerQueries);
+    json += ",\"uptimeSec\":";
+    json += String(s_naptRunning ? (unsigned long)((millis() - s_startedAtMs) / 1000UL) : 0UL);
+
+    json += ",\"clients\":[";
+    for (size_t i = 0; i < clients.size(); i++) {
+        if (i > 0) json += ",";
+        json += "{\"mac\":\"" + clients[i].mac + "\",\"ip\":\"" + clients[i].ip + "\",\"rssi\":" +
+                String(clients[i].rssi) + "}";
+    }
+    json += "]";
+
+    if (xSemaphoreTake(s_naptMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
+        loadBlockListLocked();
+        json += ",\"blockList\":[";
+        for (size_t i = 0; i < s_blockDomains.size(); i++) {
+            if (i > 0) json += ",";
+            json += "\"" + jsonEscNapt(s_blockDomains[i]) + "\"";
+        }
+        json += "],\"feed\":[";
+        int show = std::min(s_feedCount, 32);
+        for (int i = 0; i < show; i++) {
+            int idx = (s_feedHead - 1 - i + kNaptLogCap) % kNaptLogCap;
+            const DnsFeedEntry &e = s_feed[idx];
+            if (i > 0) json += ",";
+            json += "{\"seq\":" + String((unsigned long)e.seq) + ",\"ts\":" + String((unsigned long)e.tsSec) +
+                    ",\"ip\":\"" + String(e.clientIp) + "\",\"dom\":\"" + jsonEscNapt(e.domain) +
+                    "\",\"blk\":" + (e.blocked ? "true" : "false") +
+                    ",\"trk\":" + (e.tracker ? "true" : "false") + "}";
+        }
+        json += "]";
+        xSemaphoreGive(s_naptMutex);
+    } else {
+        json += ",\"blockList\":[],\"feed\":[]";
+    }
+    json += "}";
+    return json;
+}
