@@ -0,0 +1,324 @@
+#include "ble_tracker_guard.h"
+#include "ble_guard_logic.h"
+
+#include "ble_common.h"
+#include "core/display.h"
+#include "core/led_control.h"
+#include "core/mykeyboard.h"
+#include "core/powerSave.h"
+#include "core/radio_mem.h"
+#include "core/utils.h"
+#include "core/wifi/wifi_common.h"
+#include "modules/others/audio.h"
+#include <Arduino.h>
+#include <LittleFS.h>
+#include <NimBLEDevice.h>
+#include <algorithm>
+#include <globals.h>
+#include <vector>
+
+namespace {
+
+struct TrackerSighting {
+    String mac;
+    uint8_t addrType;
+    String kind;
+    int rssi;
+    uint16_t hits;
+    uint32_t lastSeenMs;
+};
+
+static const char *classifyTracker(const NimBLEAdvertisedDevice *dev) {
+    if (!dev) return nullptr;
+
+    // 1. Check Service UUIDs / Service Data UUIDs (Tile 0xFEED, SmartTag 0xFD5A, Google FMD 0xFCF1)
+    if (dev->isAdvertisingService(NimBLEUUID((uint16_t)0xFEED))) return "Tile-like";
+    if (dev->isAdvertisingService(NimBLEUUID((uint16_t)0xFD5A))) return "SmartTag-like";
+    if (dev->isAdvertisingService(NimBLEUUID((uint16_t)0xFCF1))) return "FMD-like";
+
+    uint8_t sdCount = dev->getServiceDataCount();
+    for (uint8_t i = 0; i < sdCount; i++) {
+        NimBLEUUID su = dev->getServiceDataUUID(i);
+        if (su == NimBLEUUID((uint16_t)0xFEED)) return "Tile-like";
+        if (su == NimBLEUUID((uint16_t)0xFD5A)) return "SmartTag-like";
+        if (su == NimBLEUUID((uint16_t)0xFCF1)) return "FMD-like";
+    }
+
+    // Manufacturer patterns are unauthenticated hints, not proof of a tag.
+    for (uint8_t i = 0; i < dev->getManufacturerDataCount(); i++) {
+        const std::string md = dev->getManufacturerData(i);
+        const auto match = bleGuardManufacturer(reinterpret_cast<const uint8_t *>(md.data()), md.size());
+        if (match == BleGuardManufacturer::FindMyLike) return "FindMy-like";
+        if (match == BleGuardManufacturer::SmartTagLike) return "SmartTag-like";
+    }
+
+    return nullptr;
+}
+
+static bool saveBleGuardReport(const std::vector<TrackerSighting> &list, uint32_t peakPerSweep, bool crowded, bool limited, bool listFull) {
+    File f = LittleFS.open("/ble_guard.log", FILE_WRITE);
+    if (!f) return false;
+    f.printf(
+        "# Bruce BLE Privacy Guard | Owner: %s | Host: %s.local\n",
+        bruceConfig.ownerName.c_str(),
+        bruceConfig.mdnsHost.c_str()
+    );
+    f.printf("Uptime: %lus | PeakDevices/Sweep: %lu | CrowdedSweep: %s\n",
+             (unsigned long)(millis() / 1000UL),
+             (unsigned long)peakPerSweep,
+             crowded ? "YES" : "NO");
+    f.printf("Best-effort passive scan; patterns are not authenticated tracker identities.\n");
+    f.printf("ScanLimitReached: %s | CandidateListFull: %s | CandidateTTL: 120s\n",
+             limited ? "YES" : "NO", listFull ? "YES" : "NO");
+    f.printf("Candidates: %u\n", (unsigned)list.size());
+    for (const auto &t : list) {
+        f.printf("%s | %s | addrType=%u | RSSI=%d dBm | sweeps=%u | age=%lus\n",
+                 t.kind.c_str(), t.mac.c_str(), (unsigned)t.addrType, t.rssi, (unsigned)t.hits,
+                 (unsigned long)((millis() - t.lastSeenMs) / 1000UL));
+    }
+    f.close();
+    return true;
+}
+
+} // namespace
+
+void ble_guard_setup() {
+    radioFreeWiFiForBle();
+    stopBLEStack();
+    vTaskDelay(pdMS_TO_TICKS(100));
+
+    if (!radioHasMemForBle()) {
+        displayError("Low DMA RAM for BLE", true);
+        return;
+    }
+
+    NimBLEDevice::init("");
+    NimBLEScan *scan = NimBLEDevice::getScan();
+    if (!scan) {
+        NimBLEDevice::deinit(true);
+        displayError("BLE scan init failed", true);
+        return;
+    }
+
+    scan->setActiveScan(false); // pure passive
+    scan->setInterval(97);
+    scan->setWindow(89);
+    scan->setDuplicateFilter(true);
+    // NimBLE defaults to unlimited retained results. A crowded environment must
+    // not consume unbounded heap within a single scan.
+    constexpr uint8_t kMaxScanResults = 96;
+    constexpr uint32_t kCandidateTtlMs = 120000;
+    scan->setMaxResults(kMaxScanResults);
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    std::vector<TrackerSighting> trackers;
+    trackers.reserve(24);
+    int scrollIdx = 0;
+    bool paused = false;
+    uint32_t sweeps = 0;
+    uint32_t lastSeenDevs = 0;
+    uint32_t peakDevs = 0;
+    uint32_t appleContCount = 0;
+    bool floodAlert = false;
+    bool scanLimited = false, listFull = false;
+    uint32_t lastFallbackDraw = 0;
+    String bannerHint = "";
+    uint32_t bannerHintUntil = 0;
+    returnToMenu = false;
+
+    while (!returnToMenu) {
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+        if (check(NextPress)) paused = !paused;
+        if (check(PrevPress)) {
+            trackers.clear();
+            scrollIdx = 0;
+            peakDevs = 0;
+            floodAlert = false;
+            listFull = false;
+            bannerHint = "Cleared list";
+            bannerHintUntil = millis() + 1500;
+        }
+        if (check(UpPress) && scrollIdx > 0) scrollIdx--;
+        if (check(DownPress) && scrollIdx + 1 < (int)trackers.size()) scrollIdx++;
+        if (check(SelPress)) {
+            if (saveBleGuardReport(trackers, peakDevs, floodAlert, scanLimited, listFull)) {
+                bannerHint = "Saved /ble_guard.log";
+            } else {
+                bannerHint = "Save failed";
+            }
+            bannerHintUntil = millis() + 1800;
+        }
+
+        if (!paused) {
+            NimBLEScanResults results = scan->getResults(1000, false);
+            int cnt = results.getCount();
+            lastSeenDevs = (uint32_t)cnt;
+            scanLimited = cnt >= kMaxScanResults;
+            const uint32_t now = millis();
+            trackers.erase(std::remove_if(trackers.begin(), trackers.end(), [now](const TrackerSighting &t) {
+                return bleGuardExpired(now, t.lastSeenMs, kCandidateTtlMs);
+            }), trackers.end());
+            listFull = false;
+            if (lastSeenDevs > peakDevs) peakDevs = lastSeenDevs;
+            appleContCount = 0;
+            sweeps++;
+
+            for (int i = 0; i < cnt; i++) {
+                const NimBLEAdvertisedDevice *dev = results.getDevice(i);
+                if (!dev) continue;
+
+                // Count Apple advertisements as a density hint, not a spam verdict.
+                if (dev->getManufacturerDataCount() > 0) {
+                    std::string md = dev->getManufacturerData(0);
+                    if (md.size() >= 3 && (uint8_t)md[0] == 0x4C && (uint8_t)md[1] == 0x00) {
+                        appleContCount++;
+                    }
+                }
+
+                const char *kind = classifyTracker(dev);
+                if (!kind) continue;
+
+                String mac = String(dev->getAddress().toString().c_str());
+                mac.toUpperCase();
+                int rssi = dev->getRSSI();
+                const uint8_t addrType = dev->getAddressType();
+                bool updated = false;
+                for (auto &t : trackers) {
+                    if (t.mac == mac && t.addrType == addrType) {
+                        t.rssi = rssi;
+                        t.hits = bleGuardIncrement(t.hits);
+                        t.lastSeenMs = millis();
+                        t.kind = kind;
+                        updated = true;
+                        break;
+                    }
+                }
+                if (!updated) {
+                    if (trackers.size() < 40) trackers.push_back({mac, addrType, String(kind), rssi, 1, millis()});
+                    else listFull = true;
+                }
+            }
+            scan->clearResults();
+
+            floodAlert = (lastSeenDevs >= 48 || appleContCount >= 22);
+
+            std::sort(trackers.begin(), trackers.end(), [](const TrackerSighting &a, const TrackerSighting &b) {
+                if (a.rssi != b.rssi) return a.rssi > b.rssi;
+                return a.hits > b.hits;
+            });
+            if (scrollIdx >= (int)trackers.size() && scrollIdx > 0) {
+                scrollIdx = max(0, (int)trackers.size() - 1);
+            }
+        } else {
+            vTaskDelay(pdMS_TO_TICKS(50));
+        }
+
+        const uint16_t bg = bruceConfig.bgColor;
+        const uint16_t pri = bruceConfig.priColor;
+        const uint16_t sec = bruceConfig.secColor;
+        bool warn = floodAlert || !trackers.empty();
+        uint16_t accent = floodAlert ? TFT_RED : (!trackers.empty() ? TFT_YELLOW : pri);
+
+        if (hasSprite) {
+            frame.fillScreen(bg);
+            frame.drawRoundRect(3, 3, tftWidth - 6, tftHeight - 6, 6, accent);
+
+            frame.fillRoundRect(8, 8, tftWidth - 16, 24, 4, blendColors(bg, accent, warn ? 30 : 20));
+            frame.setTextDatum(ML_DATUM);
+            frame.setTextSize(1);
+            const uint16_t headerBg = blendColors(bg, accent, warn ? 30 : 20);
+            // A sweep indicator advances only when a real scan completes. Paused is static.
+            frame.drawCircle(17, 20, 5, accent);
+            if (!paused) {
+                const int dx[] = {0, 3, 0, -3};
+                const int dy[] = {-3, 0, 3, 0};
+                frame.drawLine(17, 20, 17 + dx[sweeps % 4], 20 + dy[sweeps % 4], accent);
+            } else frame.drawLine(15, 20, 19, 20, accent);
+            frame.setTextColor(accent, headerBg);
+            const String heading = floodAlert ? "BLE GUARD: BUSY" : (paused ? "BLE GUARD: PAUSED" : "BLE GUARD: SCAN");
+            frame.drawString(heading, 27, 20);
+            frame.setTextDatum(MR_DATUM);
+            frame.setTextColor(TFT_WHITE, blendColors(bg, accent, warn ? 30 : 20));
+            frame.drawString("Hints:" + String(trackers.size()) + ((scanLimited || listFull) ? "+" : ""), tftWidth - 14, 20);
+
+            frame.setTextDatum(TL_DATUM);
+            frame.setTextColor(sec, bg);
+            frame.drawString(
+                "BLE/sweep: " + String(lastSeenDevs) + " (peak " + String(peakDevs) + ")  #"+ String(sweeps),
+                12,
+                38
+            );
+
+            int listY = 54;
+            int listH = tftHeight - 82;
+            frame.drawRoundRect(8, listY, tftWidth - 16, listH, 5, blendColors(bg, pri, 65));
+
+            if (trackers.empty()) {
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, bg);
+                frame.drawString("No matching advertisements", tftWidth / 2, listY + listH / 2 - 8);
+                frame.drawString("Passive scan is incomplete", tftWidth / 2, listY + listH / 2 + 8);
+            } else {
+                int rowH = 30;
+                int fit = listH / rowH;
+                for (int r = 0; r < fit && (scrollIdx + r) < (int)trackers.size(); r++) {
+                    const TrackerSighting &t = trackers[scrollIdx + r];
+                    int ry = listY + 4 + r * rowH;
+                    bool strong = (t.rssi >= -62);
+                    uint16_t rowBg = blendColors(bg, strong ? TFT_RED : pri, strong ? 28 : 14);
+                    frame.fillRoundRect(12, ry, tftWidth - 24, rowH - 3, 4, rowBg);
+                    frame.setTextDatum(TL_DATUM);
+                    frame.setTextColor(strong ? TFT_YELLOW : pri, rowBg);
+                    frame.drawString(t.kind + " (" + String(t.hits) + "x)", 17, ry + 4);
+                    frame.setTextColor(TFT_WHITE, rowBg);
+                    frame.drawString(t.mac, 17, ry + 15);
+                    frame.setTextDatum(MR_DATUM);
+                    frame.setTextColor(strong ? TFT_RED : sec, rowBg);
+                    frame.drawString(String(t.rssi) + " dBm", tftWidth - 17, ry + 13);
+                }
+            }
+
+            frame.setTextDatum(MC_DATUM);
+            if (!bannerHint.isEmpty() && (int32_t)(millis() - bannerHintUntil) < 0) {
+                frame.setTextColor(TFT_GREEN, bg);
+                frame.drawString(bannerHint, tftWidth / 2, tftHeight - 14);
+            } else {
+                frame.setTextColor(sec, bg);
+                frame.drawString("SEL save  > pause  < clear  ESC exit", tftWidth / 2, tftHeight - 14);
+            }
+            frame.pushSprite(0, 0);
+            tft.markUnmappedPixels();
+        } else if (millis() - lastFallbackDraw >= 500) {
+            // Low-memory fallback: keep controls and observations usable without a sprite.
+            lastFallbackDraw = millis();
+            tft.fillScreen(bg);
+            tft.setTextDatum(TL_DATUM);
+            tft.setTextSize(1);
+            tft.setTextColor(pri, bg);
+            tft.drawString(paused ? "BLE GUARD [PAUSED]" : "BLE GUARD (passive)", 8, 8);
+            tft.drawString("Hints: " + String(trackers.size()) + ((scanLimited || listFull) ? "+" : "") +
+                           "  Sweep: " + String(lastSeenDevs), 8, 23);
+            tft.drawString(floodAlert ? "Crowded sweep; not proof of spam" : "Matches are unverified hints", 8, 38);
+            int y = 55;
+            for (int i = scrollIdx; i < (int)trackers.size() && y + 20 < tftHeight - 20; ++i, y += 20) {
+                const TrackerSighting &t = trackers[i];
+                tft.drawString(t.kind + " " + String(t.rssi) + " dBm", 8, y);
+                tft.drawString(t.mac, 8, y + 9);
+            }
+            tft.drawString("Sel:Save Next:Pause Prev:Clear Esc:Exit", 8, tftHeight - 12);
+        }
+        wakeUpScreen();
+    }
+
+    if (hasSprite) frame.deleteSprite();
+    scan->stop();
+    scan->clearResults();
+    stopBLEStack();
+    tft.fillScreen(bruceConfig.bgColor);
+}
