+.sl-tag { font-size: 10px; padding: 1px 6px; border-radius: 4px; cursor: pointer; border: 1px solid var(--border); background: var(--surface-2); color: var(--text); text-decoration: none; white-space: nowrap; }
+.sl-tag.blk { color: #ff9aa4; border-color: rgba(255,93,108,0.45); }
+.sl-tag.ok { color: var(--ok); border-color: rgba(44,229,155,0.45); }
+.sl-bars { display: grid; grid-template-columns: repeat(13, 1fr); gap: 4px; align-items: end; height: 76px; padding: 6px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); margin-top: 6px; }
+.sl-bar-col { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; gap: 3px; border-radius: 4px; padding: 1px 0; }
+.sl-bar-col.best { background: rgba(44,229,155,0.12); box-shadow: inset 0 0 0 1px rgba(44,229,155,0.55); }
+.sl-bar-col.best span { color: var(--ok); font-weight: 700; }
+.sl-bar-fill { width: 100%; min-height: 3px; border-radius: 3px 3px 0 0; background: var(--ok); }
+.sl-bar-col span { font-size: 9.5px; color: var(--muted); font-family: ui-monospace, Consolas, monospace; }
+.sl-file-btn { position: relative; overflow: hidden; display: inline-flex; align-items: center; }
+.sl-file-btn input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
+
+/* SecLab+ grouped, state-aware control center */
+.sl-note {
+  margin-top: 10px;
+  padding: 8px 10px;
+  border-radius: 8px;
+  border: 1px solid rgba(255, 176, 32, 0.35);
+  background: rgba(255, 176, 32, 0.08);
+  color: var(--muted);
+  font-size: 11px;
+  line-height: 1.45;
+}
+.sl-note strong { color: #ffbd59; }
+.sl-note code { color: var(--text); font-family: ui-monospace, Consolas, monospace; }
+.sl-global { display: flex; flex-wrap: wrap; gap: 9px; align-items: center; }
+.sl-global .muted-sm { max-width: 480px; }
+.sl-group {
+  min-width: 0;
+  margin: 10px 0 0;
+  padding: 9px 10px 10px;
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  background: rgba(127, 127, 127, 0.035);
+}
+.sl-group legend {
+  padding: 0 6px;
+  color: var(--color);
+  font-size: 11px;
+  letter-spacing: .02em;
+}
+.sl-group legend strong { font-size: 12px; }
+.sl-group legend small { color: var(--muted); font-size: 10.5px; margin-left: 5px; }
+.sl-group .sl-row { margin-top: 8px; }
+.sl-group .sl-row:first-of-type { margin-top: 2px; }
+.sl-group .btn-action { font-size: 11.5px; }
+.sl-inline-label { font-size: 10.5px; color: var(--muted); margin-left: 3px; }
+.sl-row input.sl-input { min-width: 74px; width: 84px; }
+.sl-row input.sl-input-wide { min-width: 168px; width: 205px; }
+.sl-row select[aria-label] { min-width: 108px; }
+.sl-scroll { max-height: 220px; overflow: auto; }
