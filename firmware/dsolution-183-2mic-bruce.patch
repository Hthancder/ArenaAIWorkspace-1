+bool naptIsRunning() { return s_naptRunning; }
+bool naptIsStarting() { return s_naptStarting; }
+
+static void naptAsyncStartTask(void *pv) {
+    NaptAsyncArgs *args = static_cast<NaptAsyncArgs *>(pv);
+    String err;
+    if (!naptStartBackground(args ? args->ssid : "", args ? args->pwd : "", &err)) {
+        snprintf(s_lastStartErr, sizeof(s_lastStartErr), "%s", err.c_str());
+    } else {
+        s_lastStartErr[0] = '\0';
+    }
+    delete args;
+    s_naptStarting = false;
+    vTaskDelete(NULL);
+}
+
+bool naptStartAsync(const String &staSsid, const String &staPwd, String *errOut) {
+    if (s_naptRunning) return true;
+    if (s_naptStarting) {
+        if (errOut) *errOut = "NAPT startup already in progress";
+        return false;
+    }
+    if (!radioHasMemForWifi()) {
+        if (errOut) *errOut = "Low DMA RAM for Wi-Fi";
+        return false;
+    }
+    s_lastStartErr[0] = '\0';
+    s_naptStarting = true;
+    NaptAsyncArgs *args = new (std::nothrow) NaptAsyncArgs{staSsid, staPwd};
+    if (!args) {
+        s_naptStarting = false;
+        if (errOut) *errOut = "Out of memory";
+        return false;
+    }
+    BaseType_t ok = xTaskCreatePinnedToCore(naptAsyncStartTask, "naptBoot", 5120, args, 1, NULL, 0);
+    if (ok != pdPASS) {
+        delete args;
+        s_naptStarting = false;
+        if (errOut) *errOut = "Failed to launch NAPT worker task";
+        return false;
+    }
+    return true;
+}
