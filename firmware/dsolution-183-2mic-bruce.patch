+                // Mini USB stick icon inside status card
+                frame.fillRoundRect(22, 49, 44, 26, 4, pri);
+                frame.fillRoundRect(66, 54, 14, 16, 2, TFT_LIGHTGREY);
+                frame.fillCircle(30, 62, 4, isMounted ? okCol : TFT_RED);
