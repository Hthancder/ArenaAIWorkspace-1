+static void naptDnsProxyTask(void *pv) {
+    (void)pv;
+    WiFiUDP localDns;
+    WiFiUDP upDns;
+    PendingDnsSlot pending[kPendingDnsMax] = {};
+    uint8_t pktBuf[kMaxDnsPacket];
+    uint8_t respBuf[kMaxDnsPacket];
+    uint16_t nextUpId = 0x2100;
+
+    bool localOk = localDns.begin(53);
+    bool upOk = upDns.begin(53540);
+    if (!localOk || !upOk) {
+        Serial.printf("[NAPT] DNS proxy socket init failed (53=%d, up=%d)\n", localOk, upOk);
+        localDns.stop();
+        upDns.stop();
+        s_naptRunning = false;
+        s_naptTask = nullptr;
+        vTaskDelete(NULL);
+        return;
+    }
+
+    while (!s_naptStopReq) {
+        int plen = localDns.parsePacket();
+        if (plen > 0) {
+            int rlen = localDns.read(pktBuf, sizeof(pktBuf));
+            if (rlen >= 17 && (pktBuf[2] & 0x80) == 0) {
+                char domain[64];
+                uint16_t qtype = 1;
+                size_t qend = parseDnsQuestionName(pktBuf, (size_t)rlen, domain, sizeof(domain), qtype);
+                IPAddress cliIp = localDns.remoteIP();
+                uint16_t cliPort = localDns.remotePort();
+
+                if (qend > 0 && domain[0] != '\0') {
+                    String domStr(domain);
+                    bool tracker = false;
+                    bool blocked = false;
+                    ensureNaptMutex();
+                    if (xSemaphoreTake(s_naptMutex, pdMS_TO_TICKS(30)) == pdTRUE) {
+                        blocked = isDomainBlockedLocked(domStr, tracker);
+                        xSemaphoreGive(s_naptMutex);
+                    }
+                    recordDnsEvent(cliIp, domain, qtype, blocked, tracker);
+
+                    if (blocked) {
+                        size_t blen = buildBlockedDnsResponse(pktBuf, (size_t)rlen, qend, qtype, respBuf, sizeof(respBuf));
+                        if (blen > 0) {
+                            localDns.beginPacket(cliIp, cliPort);
+                            localDns.write(respBuf, blen);
+                            localDns.endPacket();
+                        }
+                    } else if (WiFi.isConnected()) {
+                        IPAddress upstream = WiFi.dnsIP(0);
+                        if ((uint32_t)upstream == 0) upstream = IPAddress(8, 8, 8, 8);
+
+                        // Find slot (prefer free or oldest)
+                        int pick = 0;
+                        uint32_t oldest = UINT32_MAX;
+                        for (int i = 0; i < kPendingDnsMax; i++) {
+                            if (!pending[i].active) {
+                                pick = i;
+                                break;
+                            }
+                            if (pending[i].sentAtMs < oldest) {
+                                oldest = pending[i].sentAtMs;
+                                pick = i;
+                            }
+                        }
+                        uint16_t upId = ++nextUpId;
+                        pending[pick].active = true;
+                        pending[pick].localId = ((uint16_t)pktBuf[0] << 8) | pktBuf[1];
+                        pending[pick].upstreamId = upId;
+                        pending[pick].clientIp = cliIp;
+                        pending[pick].clientPort = cliPort;
+                        pending[pick].sentAtMs = millis();
+
+                        pktBuf[0] = (uint8_t)(upId >> 8);
+                        pktBuf[1] = (uint8_t)(upId & 0xFF);
+                        upDns.beginPacket(upstream, 53);
+                        upDns.write(pktBuf, (size_t)rlen);
+                        upDns.endPacket();
+                    }
+                }
+            }
+        }
+
+        int ulen = upDns.parsePacket();
+        if (ulen > 0) {
+            int rlen = upDns.read(respBuf, sizeof(respBuf));
+            if (rlen >= 12) {
+                uint16_t upId = ((uint16_t)respBuf[0] << 8) | respBuf[1];
+                for (int i = 0; i < kPendingDnsMax; i++) {
+                    if (pending[i].active && pending[i].upstreamId == upId) {
+                        respBuf[0] = (uint8_t)(pending[i].localId >> 8);
+                        respBuf[1] = (uint8_t)(pending[i].localId & 0xFF);
+                        localDns.beginPacket(pending[i].clientIp, pending[i].clientPort);
+                        localDns.write(respBuf, (size_t)rlen);
+                        localDns.endPacket();
+                        pending[i].active = false;
+                        break;
+                    }
+                }
+            }
+        }
+
+        // Expire stale pending entries (>4s)
+        uint32_t now = millis();
+        for (int i = 0; i < kPendingDnsMax; i++) {
+            if (pending[i].active && (now - pending[i].sentAtMs) > 4000UL) pending[i].active = false;
+        }
+        vTaskDelay(pdMS_TO_TICKS(8));
+    }
+
+    localDns.stop();
+    upDns.stop();
+    s_naptRunning = false;
+    s_naptTask = nullptr;
+    vTaskDelete(NULL);
+}
