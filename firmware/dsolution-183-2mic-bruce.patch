+void sonar_guard_setup() {
+    bool gpioInput = false;
+    uint32_t regVal = REG_READ(GPIO_ENABLE_REG);
+    if ((regVal & (1UL << GPIO_NUM_0)) == 0) {
+        gpioInput = true;
+        gpio_hold_en(GPIO_NUM_0);
+    }
+
+    int16_t *txBuf = (int16_t *)calloc(kSonarFrames * 2, sizeof(int16_t));
+    int16_t *rxBuf = (int16_t *)calloc(kSonarFrames * 2, sizeof(int16_t));
+    int16_t *txSilence = (int16_t *)calloc(kSonarFrames * 2, sizeof(int16_t));
+    if (!txBuf || !rxBuf || !txSilence) {
+        free(txBuf);
+        free(rxBuf);
+        free(txSilence);
+        if (gpioInput) gpio_hold_dis(GPIO_NUM_0);
+        displayError("Out of RAM", true);
+        return;
+    }
+
+    if (!initFullDuplexSonarI2S()) {
+        free(txBuf);
+        free(rxBuf);
+        free(txSilence);
+        if (gpioInput) {
+            gpio_hold_dis(GPIO_NUM_0);
+#if defined(DSOLUTION_183_2MIC)
+            pinMode(GPIO_NUM_0, INPUT_PULLUP);
+#endif
+        }
+        displayError("I2S Sonar init failed", true);
+        return;
+    }
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    SonarActionMode actionMode = SONAR_ACT_SIREN_LED;
+    SonarSensitivity sens = SONAR_SENS_MED;
+    uint16_t carrierHz = 18500;
+    bool armed = false;
+    bool armCountdown = false;
+    uint32_t armAtMs = 0;
+
+    bool calibrating = true;
+    uint32_t calibStart = millis();
+    double calibSum = 0.0;
+    int calibCount = 0;
+    float baselineSide = 0.01f;
+
+    float smoothMotion = 0.0f;
+    float smoothDir = 0.0f; // -1..+1
+    bool smoothApproach = true;
+    int consecHits = 0;
+    uint32_t lastAlertAt = 0;
+    uint32_t alertBannerUntil = 0;
+    uint32_t armedStartedMs = 0;
+    uint32_t sweepTick = 0;
+    uint8_t sessionPeak = 0;
+    const char *lastDirLbl = "--";
+    uint32_t lastJsonSync = 0;
+    std::vector<SonarEventRec> events;
+    saveSonarStateAndLog(false, actionMode, sens, carrierHz, 0, 0, lastDirLbl, false, events, nullptr);
+
+    float txPhase = 0.0f;
+    uint32_t lastDraw = 0;
+    returnToMenu = false;
+
+    while (!returnToMenu) {
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+
+        // Vol+ / Vol- (tap or hold) cycles sensitivity in live mode
+        if (check(PrevPress) || check(DownPress)) {
+            sens = (SonarSensitivity)(((int)sens + 2) % 3);
+            lastDraw = 0;
+        }
+        if (check(NextPress) || check(UpPress)) {
+            sens = (SonarSensitivity)(((int)sens + 1) % 3);
+            lastDraw = 0;
+        }
+        if (check(SelPress)) {
+            if (armed || armCountdown) {
+                armed = false;
+                armCountdown = false;
+                setBrightness(bruceConfig.bright, false);
+                setLedColor(CRGB::Black);
+                saveSonarStateAndLog(
+                    false, actionMode, sens, carrierHz, (uint8_t)smoothMotion, sessionPeak, lastDirLbl, false, events, nullptr
+                );
+            } else {
+                if (hasSprite) {
+                    frame.deleteSprite();
+                    hasSprite = false;
+                }
+                int act = -1;
+                options.clear();
+                options.push_back({"ARM Motion Guard (8s)", [&]() { act = 0; }});
+                options.push_back({String("Alert: ") +
+                                   (actionMode == SONAR_ACT_SIREN_LED ? "Siren + LED"
+                                    : (actionMode == SONAR_ACT_SILENT_LOG ? "Silent + WebUI" : "Auto-Rec 6s WAV")),
+                                   [&]() { act = 1; }});
+                options.push_back({String("Carrier: ") + String(carrierHz) + " Hz", [&]() { act = 2; }});
+                options.push_back({"Recalibrate Room", [&]() { act = 3; }});
+                options.push_back({"Exit", [&]() { act = 4; }});
+                loopOptions(options, MENU_TYPE_SUBMENU, "Acoustic Sonar Guard");
+                options.clear();
+
+                if (act == 0) {
+                    armCountdown = true;
+                    armAtMs = millis() + 8000UL;
+                } else if (act == 1) {
+                    actionMode = (SonarActionMode)(((int)actionMode + 1) % 3);
+                    saveSonarStateAndLog(
+                        false, actionMode, sens, carrierHz, (uint8_t)smoothMotion, sessionPeak, lastDirLbl, false, events, nullptr
+                    );
+                } else if (act == 2) {
+                    if (carrierHz == 18500) carrierHz = 17500;
+                    else if (carrierHz == 17500) carrierHz = 19200;
+                    else carrierHz = 18500;
+                    calibrating = true;
+                    calibStart = millis();
+                    calibSum = 0.0;
+                    calibCount = 0;
+                } else if (act == 3) {
+                    calibrating = true;
+                    calibStart = millis();
+                    calibSum = 0.0;
+                    calibCount = 0;
+                    sessionPeak = 0;
+                } else if (act == 4) {
+                    returnToMenu = true;
+                    break;
+                }
+                hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+            }
+            lastDraw = 0;
+        }
+
+        if (armCountdown && (int32_t)(millis() - armAtMs) >= 0) {
+            armCountdown = false;
+            armed = true;
+            armedStartedMs = millis();
+            calibrating = true;
+            calibStart = millis();
+            calibSum = 0.0;
+            calibCount = 0;
+            consecHits = 0;
+            sessionPeak = 0;
+            saveSonarStateAndLog(true, actionMode, sens, carrierHz, 0, 0, lastDirLbl, false, events, nullptr);
+        }
+
+        // Generate smooth continuous carrier tone (safe amplitude ~7500 avoids codec clipping)
+        float inc = 2.0f * (float)M_PI * (float)carrierHz / (float)kSonarRate;
+        for (size_t i = 0; i < kSonarFrames; i++) {
+            int16_t s = (int16_t)(sinf(txPhase) * 7500.0f);
+            txBuf[i * 2] = s;
+            txBuf[i * 2 + 1] = s;
+            txPhase += inc;
+            if (txPhase > 2.0f * (float)M_PI) txPhase -= 2.0f * (float)M_PI;
+        }
+
+        size_t wr = 0, rd = 0;
+        i2s_channel_write(s_txChan, txBuf, kSonarFrames * 4, &wr, pdMS_TO_TICKS(30));
+        if (i2s_channel_read(s_rxChan, rxBuf, kSonarFrames * 4, &rd, pdMS_TO_TICKS(30)) != ESP_OK ||
+            rd < kSonarFrames * 4) {
+            continue;
+        }
+
+        // Evaluate symmetric Doppler sidebands around carrierHz on MIC1 (L) and MIC2 (R)
+        static const float kOffsets[4] = {45.0f, 95.0f, 150.0f, 220.0f};
+        float sideL = 0.0f, sideR = 0.0f, posSum = 0.0f, negSum = 0.0f;
+        for (float df : kOffsets) {
+            float pL = goertzelStereo(rxBuf, kSonarFrames, (float)carrierHz + df, 0);
+            float nL = goertzelStereo(rxBuf, kSonarFrames, (float)carrierHz - df, 0);
+            float pR = goertzelStereo(rxBuf, kSonarFrames, (float)carrierHz + df, 1);
+            float nR = goertzelStereo(rxBuf, kSonarFrames, (float)carrierHz - df, 1);
+            sideL += pL + nL;
+            sideR += pR + nR;
+            posSum += pL + pR;
+            negSum += nL + nR;
+        }
+        float totalSide = 0.5f * (sideL + sideR);
+
+        if (calibrating) {
+            // Skip first 250ms settling
+            if (millis() - calibStart > 250) {
+                calibSum += totalSide;
+                calibCount++;
+            }
+            if (millis() - calibStart >= 1400 && calibCount >= 10) {
+                baselineSide = std::max(0.012f, (float)(calibSum / calibCount));
+                calibrating = false;
+                smoothMotion = 0.0f;
+            }
+        } else {
+            float ratio = (totalSide - baselineSide) / (baselineSide * 1.65f);
+            if (ratio < 0.0f) ratio = 0.0f;
+            float pct = std::min(100.0f, ratio * 100.0f);
+            smoothMotion = smoothMotion * 0.62f + pct * 0.38f;
+
+            float denom = sideL + sideR + 0.005f;
+            float rawDir = (sideR - sideL) / denom; // >0 = Right stronger, <0 = Left stronger
+            rawDir = std::max(-1.0f, std::min(1.0f, rawDir * 2.2f));
+            smoothDir = smoothDir * 0.72f + rawDir * 0.28f;
+            smoothApproach = (posSum >= negSum);
+
+            // Slowly adapt baseline only when completely still
+            if (smoothMotion < 8.0f) {
+                baselineSide = baselineSide * 0.992f + totalSide * 0.008f;
+            }
+
+            float thresh = (sens == SONAR_SENS_LOW) ? 45.0f : ((sens == SONAR_SENS_MED) ? 28.0f : 16.0f);
+            uint8_t mPct = (uint8_t)std::min(100.0f, smoothMotion);
+            if (mPct > sessionPeak) sessionPeak = mPct;
+            lastDirLbl = (smoothDir < -0.22f) ? "LEFT" : ((smoothDir > 0.22f) ? "RIGHT" : "CENTER");
+            if (smoothMotion >= thresh) consecHits++;
+            else consecHits = 0;
+
+            if (isWebUIActive && (millis() - lastJsonSync) >= 3000UL) {
+                lastJsonSync = millis();
+                saveSonarStateAndLog(
+                    armed, actionMode, sens, carrierHz, mPct, sessionPeak, lastDirLbl,
+                    millis() < alertBannerUntil, events, nullptr
+                );
+            }
+
+            if (armed && consecHits >= 3 && (millis() - lastAlertAt) > 6000UL) {
+                lastAlertAt = millis();
+                alertBannerUntil = millis() + 4500UL;
+                SonarEventRec ev = {};
+                ev.tsSec = millis() / 1000UL;
+                ev.score = mPct;
+                ev.dir = (smoothDir < -0.22f) ? -1 : ((smoothDir > 0.22f) ? 1 : 0);
+                ev.approach = smoothApproach;
+                ev.wavFile[0] = '\0';
+
+                if (actionMode == SONAR_ACT_AUTOREC_WAV) {
+                    setBrightness(bruceConfig.bright, false);
+                    setLedColor(CRGB::Red);
+                    String wpath = recordGuardClipWav(rxBuf, txSilence, 6000);
+                    setLedColor(CRGB::Black);
+                    if (!wpath.isEmpty()) strncpy(ev.wavFile, wpath.c_str(), sizeof(ev.wavFile) - 1);
+                } else if (actionMode == SONAR_ACT_SIREN_LED) {
+                    setBrightness(bruceConfig.bright, false);
+                    playSirenBurst(txBuf, rxBuf);
+                }
+
+                if ((int)events.size() >= kMaxSonarHistory) events.erase(events.begin());
+                events.push_back(ev);
+                lastJsonSync = millis();
+                saveSonarStateAndLog(true, actionMode, sens, carrierHz, mPct, sessionPeak, lastDirLbl, true, events, &ev);
+                consecHits = 0;
+                if (returnToMenu) break;
+            }
+        }
+
+        // Dim display gently after 15s while armed in Silent mode to preserve battery
+        if (armed && actionMode == SONAR_ACT_SILENT_LOG && (millis() - armedStartedMs) > 15000UL &&
+            millis() > alertBannerUntil) {
+            setBrightness(12, false);
+        } else {
+            wakeUpScreen();
+        }
+
+        if (millis() - lastDraw >= 45) {
+            lastDraw = millis();
+            sweepTick = (sweepTick + 1) % 360;
+            if (hasSprite) {
+                const uint16_t bg = bruceConfig.bgColor;
+                const uint16_t pri = bruceConfig.priColor;
+                const uint16_t sec = bruceConfig.secColor;
+                const uint16_t okCol = 0x2F2F;
+                const uint16_t warnCol = 0xFD84;
+                const uint16_t errCol = 0xF9CA;
+
+                bool triggered = (millis() < alertBannerUntil);
+                uint16_t hdrBg = triggered ? TFT_RED : (armed ? 0x0368 : blendColors(bg, pri, 28));
+                frame.fillScreen(bg);
+                frame.fillRect(0, 0, tftWidth, 24, hdrBg);
+                frame.setTextSize(1);
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(triggered ? TFT_WHITE : pri, hdrBg);
+                frame.drawString(
+                    triggered ? "!! MOTION TRIGGERED !!"
+                              : (armed ? "SONAR GUARD [ARMED]" : "2-MIC SONAR RADAR"),
+                    8,
+                    12
+                );
+                frame.setTextDatum(MR_DATUM);
+                frame.setTextColor(TFT_WHITE, hdrBg);
+                const char *sensLbl = (sens == SONAR_SENS_LOW) ? "LOW" : ((sens == SONAR_SENS_MED) ? "MED" : "HI");
+                frame.drawString(String(sensLbl) + " " + String(carrierHz / 1000.0f, 1) + "k", tftWidth - 8, 12);
+
+                if (armCountdown) {
+                    int rem = (int)((armAtMs - millis() + 999) / 1000);
+                    frame.setTextDatum(MC_DATUM);
+                    frame.setTextColor(warnCol, bg);
+                    frame.setTextSize(2);
+                    frame.drawString("ARMING IN", tftWidth / 2, 76);
+                    frame.setTextSize(4);
+                    frame.setTextColor(pri, bg);
+                    frame.drawString(String(std::max(1, rem)), tftWidth / 2, 126);
+                    frame.setTextSize(1);
+                    frame.setTextColor(sec, bg);
+                    frame.drawString("Step away from desk now...", tftWidth / 2, 174);
+                } else {
+                    // Draw 180-deg semi-circle Sonar Radar centered near bottom of radar zone
+                    int rCx = tftWidth / 2;
+                    int rCy = 152;
+                    int maxR = 112;
+                    uint16_t gridCol = blendColors(bg, pri, 45);
+                    for (int rr = 38; rr <= maxR; rr += 37) {
+                        int px = rCx - rr;
+                        int py = rCy;
+                        for (int deg = 180; deg <= 360; deg += 5) {
+                            float rad = (float)deg * ((float)M_PI / 180.0f);
+                            int nx = rCx + (int)lroundf(cosf(rad) * (float)rr);
+                            int ny = rCy + (int)lroundf(sinf(rad) * (float)rr);
+                            frame.drawLine(px, py, nx, ny, gridCol);
+                            px = nx;
+                            py = ny;
+                        }
+                    }
+                    frame.drawLine(rCx - maxR, rCy, rCx + maxR, rCy, gridCol);
+                    frame.drawLine(rCx, rCy, rCx, rCy - maxR, gridCol);
+                    frame.drawLine(rCx, rCy, rCx - 79, rCy - 79, gridCol);
+                    frame.drawLine(rCx, rCy, rCx + 79, rCy - 79, gridCol);
+
+                    // Direction labels around radar arc (284px wide display)
+                    frame.setTextDatum(MC_DATUM);
+                    frame.setTextColor(sec, bg);
+                    frame.drawString("L", rCx - maxR - 10, rCy - 6);
+                    frame.drawString("C", rCx, rCy - maxR - 8);
+                    frame.drawString("R", rCx + maxR + 10, rCy - 6);
+                    frame.setTextDatum(ML_DATUM);
+                    const char *actTag = (actionMode == SONAR_ACT_SIREN_LED) ? "SIREN"
+                                         : ((actionMode == SONAR_ACT_SILENT_LOG) ? "SILENT" : "WAV");
+                    frame.drawString(String("Act:") + actTag, 8, 34);
+
+                    // Sweeping ping arc line
+                    float sweepAng = (float)M_PI * (0.12f + 0.76f * (0.5f + 0.5f * sinf((float)sweepTick * 0.08f)));
+                    int sx = rCx + (int)(cosf(sweepAng) * maxR);
+                    int sy = rCy - (int)(sinf(sweepAng) * maxR);
+                    frame.drawLine(rCx, rCy, sx, sy, blendColors(bg, pri, 130));
+
+                    float thresh = (sens == SONAR_SENS_LOW) ? 45.0f : ((sens == SONAR_SENS_MED) ? 28.0f : 16.0f);
+                    if (calibrating) {
+                        frame.setTextDatum(MC_DATUM);
+                        frame.setTextColor(warnCol, bg);
+                        frame.drawString("Calibrating quiet room...", rCx, 94);
+                    } else {
+                        // Draw motion blip along estimated L/C/R angle and distance inversely proportional to score
+                        float angRad = (float)M_PI * 0.5f - smoothDir * 1.05f;
+                        float distNorm = 1.0f - std::min(0.88f, smoothMotion / 100.0f);
+                        int bx = rCx + (int)(cosf(angRad) * (maxR * distNorm));
+                        int by = rCy - (int)(sinf(angRad) * (maxR * distNorm));
+                        uint16_t blipCol = (smoothMotion >= thresh) ? errCol : ((smoothMotion >= thresh * 0.6f) ? warnCol : okCol);
+                        int br = 4 + (int)(smoothMotion / 14.0f);
+                        frame.fillCircle(bx, by, br + 3, blendColors(bg, blipCol, 85));
+                        frame.fillCircle(bx, by, br, blipCol);
+                        frame.drawLine(rCx, rCy, bx, by, blipCol);
+
+                        // Status bar below radar
+                        int barX = 14, barY = 166, barW = tftWidth - 28, barH = 14;
+                        frame.drawRoundRect(barX, barY, barW, barH, 4, gridCol);
+                        int fillW = (int)((smoothMotion / 100.0f) * (barW - 4));
+                        if (fillW > 2) frame.fillRoundRect(barX + 2, barY + 2, fillW, barH - 4, 2, blipCol);
+                        int thrX = barX + 2 + (int)((thresh / 100.0f) * (barW - 4));
+                        frame.drawFastVLine(thrX, barY, barH, TFT_WHITE);
+
+                        frame.setTextDatum(ML_DATUM);
+                        frame.setTextColor(TFT_WHITE, bg);
+                        const char *dirTxt = (smoothDir < -0.22f) ? "LEFT" : ((smoothDir > 0.22f) ? "RIGHT" : "CENTER");
+                        String st = (smoothMotion >= thresh)
+                                        ? (String("MOTION ") + dirTxt + (smoothApproach ? " [NEAR]" : " [AWAY]"))
+                                        : "Room Clear";
+                        frame.drawString(st, 14, 196);
+                        frame.setTextDatum(MR_DATUM);
+                        frame.setTextColor(blipCol, bg);
+                        frame.drawString(String((int)smoothMotion) + "%  Ev:" + String(events.size()), tftWidth - 14, 196);
+                    }
+                }
+
+                frame.fillRect(0, tftHeight - 20, tftWidth, 20, blendColors(bg, pri, 14));
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 14));
+                frame.drawString(
+                    armed ? "Boot:Disarm   Vol-/+:Sens   Hold:Exit" : "Vol-/+:Sens   Boot:Arm/Menu   Hold:Exit",
+                    tftWidth / 2,
+                    tftHeight - 10
+                );
+                frame.pushSprite(0, 0);
+                tft.markUnmappedPixels();
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(5));
+    }
+
+    setBrightness(bruceConfig.bright, false);
+    setLedColor(CRGB::Black);
+    saveSonarStateAndLog(false, actionMode, sens, carrierHz, 0, sessionPeak, lastDirLbl, false, events, nullptr);
+    if (hasSprite) frame.deleteSprite();
+    deinitFullDuplexSonarI2S();
+
+    if (gpioInput) {
+        gpio_hold_dis(GPIO_NUM_0);
+#if defined(DSOLUTION_183_2MIC)
+        pinMode(GPIO_NUM_0, INPUT_PULLUP);
+#else
+        pinMode(GPIO_NUM_0, INPUT);
+#endif
+    } else {
+        pinMode(GPIO_NUM_0, OUTPUT);
+        digitalWrite(GPIO_NUM_0, LOW);
+    }
+
+    free(txBuf);
+    free(rxBuf);
+    free(txSilence);
+    tft.fillScreen(bruceConfig.bgColor);
+}
+#else
+void sonar_guard_setup() {}
+#endif
