+void virtual_msc_setup(bool startWithCompositeBadUsb) {
+    virtualMscEnsureVaultDir();
+
+    VmscStorageMode stMode = VMSC_RAM_2M;
+    bool compositeBadUsb = startWithCompositeBadUsb;
+    bool loadVault = true;
+    bool reuseExistingFlashImg = LittleFS.exists(kFlashImgPath);
+    String duckyPath = "";
+
+    // Pre-mount clean configuration menu
+    bool largeFlash = (LittleFS.totalBytes() > 1024UL * 1024UL);
+    bool goMount = false;
+    while (!goMount) {
+        int sel = -1;
+        options.clear();
+        const char *stLbl = (stMode == VMSC_RAM_2M) ? "Storage: RAM 2.2MB (PSRAM)"
+                            : (stMode == VMSC_FLASH_128K) ? "Storage: Flash 128KB (Saved)"
+                            : (stMode == VMSC_FLASH_512K) ? "Storage: Flash 512KB (Saved)"
+                                                          : "Storage: Flash 1MB (Saved)";
+        options.push_back({stLbl, [&]() { sel = 0; }});
+        options.push_back({String("USB Mode: ") + (compositeBadUsb ? "Drive + BadUSB" : "USB Drive Only"), [&]() { sel = 1; }});
+        if (stMode != VMSC_RAM_2M && LittleFS.exists(kFlashImgPath)) {
+            options.push_back({String("Flash Img: ") + (reuseExistingFlashImg ? "Keep Saved" : "Rebuild / Vault"),
+                               [&]() { sel = 2; }});
+        } else {
+            options.push_back({String("Preload /usb_vault: ") + (loadVault ? "ON" : "Blank"), [&]() { sel = 2; }});
+        }
+        if (compositeBadUsb) {
+            String scLbl = duckyPath.isEmpty() ? "Script: <Pick .txt>" : ("Script: " + duckyPath.substring(duckyPath.lastIndexOf('/') + 1));
+            options.push_back({scLbl, [&]() { sel = 3; }});
+        }
+        options.push_back({"[MOUNT VIRTUAL USB]", [&]() { sel = 4; }});
+        options.push_back({"Save /usb_disk -> /vault", [&]() { sel = 5; }});
+        options.push_back({"Cancel", [&]() { sel = 6; }});
+        loopOptions(options, MENU_TYPE_SUBMENU, "Virtual USB Drive");
+        options.clear();
+
+        if (sel < 0 || sel == 6) return;
+        if (sel == 0) {
+            if (largeFlash) {
+                stMode = (VmscStorageMode)(((int)stMode + 1) % 4);
+            } else {
+                stMode = (stMode == VMSC_RAM_2M) ? VMSC_FLASH_128K : VMSC_RAM_2M;
+            }
+        } else if (sel == 1) {
+            compositeBadUsb = !compositeBadUsb;
+        } else if (sel == 2) {
+            if (stMode != VMSC_RAM_2M && LittleFS.exists(kFlashImgPath)) {
+                reuseExistingFlashImg = !reuseExistingFlashImg;
+            } else {
+                loadVault = !loadVault;
+            }
+        } else if (sel == 3) {
+            duckyPath = pickDuckyScriptForComposite();
+        } else if (sel == 4) {
+            if (compositeBadUsb && duckyPath.isEmpty()) {
+                duckyPath = pickDuckyScriptForComposite();
+                if (duckyPath.isEmpty()) continue;
+            }
+            goMount = true;
+        } else if (sel == 5) {
+            if (!LittleFS.exists(kFlashImgPath)) {
+                displayWarning("No /usb_disk.img saved yet", true);
+            } else {
+                File f = LittleFS.open(kFlashImgPath, FILE_READ);
+                size_t sz = f ? f.size() : 0;
+                uint8_t *tmp = (sz > 0 && psramFound()) ? (uint8_t *)ps_malloc(sz) : nullptr;
+                if (f && tmp && f.read(tmp, sz) == sz) {
+                    int n = exportDiskMemoryToVault(tmp, sz);
+                    displayInfo("Exported " + String(n) + " file(s) to /usb_vault", true);
+                } else {
+                    displayError("Read /usb_disk.img failed", true);
+                }
+                if (f) f.close();
+                if (tmp) free(tmp);
+            }
+        }
+    }
+
+    drawMainBorderWithTitle("Virtual USB Drive");
+    padprintln("");
+    padprintln("Preparing filesystem...");
+
+    FatGeom geom = computeFatGeom(stMode);
+    s_backedByFlash = (stMode != VMSC_RAM_2M);
+    s_diskSectors = geom.totalSectors;
+    s_diskBytes = geom.totalSectors * kSecSize;
+
+    if (psramFound()) s_diskMem = (uint8_t *)ps_malloc(s_diskBytes);
+    if (!s_diskMem) s_diskMem = (uint8_t *)malloc(s_diskBytes);
+    if (!s_diskMem) {
+        displayError("Insufficient PSRAM for USB", true);
+        return;
+    }
+
+    if (s_backedByFlash) {
+        s_dirtyMap = (uint8_t *)calloc((s_diskSectors + 7) / 8, 1);
+    }
+
+    int preloadedFiles = 0;
+    if (s_backedByFlash && reuseExistingFlashImg && LittleFS.exists(kFlashImgPath)) {
+        File f = LittleFS.open(kFlashImgPath, FILE_READ);
+        if (f && f.size() == s_diskBytes && f.read(s_diskMem, s_diskBytes) == s_diskBytes) {
+            padprintln("Loaded saved /usb_disk.img");
+        } else {
+            formatDiskMemory(s_diskMem, geom, "BRUCE FLASH");
+            if (loadVault) preloadedFiles = importVaultToDiskMemory(s_diskMem, geom);
+            if (s_dirtyMap) memset(s_dirtyMap, 0xFF, (s_diskSectors + 7) / 8);
+            s_dirtyAny = true;
+        }
+        if (f) f.close();
+    } else {
+        size_t lfsFree = (LittleFS.totalBytes() > LittleFS.usedBytes())
+                             ? (LittleFS.totalBytes() - LittleFS.usedBytes())
+                             : 0;
+        if (s_backedByFlash && lfsFree < s_diskBytes + 65536) {
+            free(s_diskMem);
+            s_diskMem = nullptr;
+            free(s_dirtyMap);
+            s_dirtyMap = nullptr;
+            displayError("LittleFS too low for disk image", true);
+            return;
+        }
+        formatDiskMemory(s_diskMem, geom, s_backedByFlash ? "BRUCE FLASH" : "BRUCE RAM");
+        if (loadVault) preloadedFiles = importVaultToDiskMemory(s_diskMem, geom);
+        if (s_backedByFlash) {
+            if (s_dirtyMap) memset(s_dirtyMap, 0xFF, (s_diskSectors + 7) / 8);
+            s_dirtyAny = true;
+            saveMemoryToFlashImage();
+        }
+    }
+
+    s_rxBytes = 0;
+    s_txBytes = 0;
+    s_ejectRequested = false;
+    s_usbEventState = -1;
+
+    if (!s_usbEventHooked) {
+        s_usbEventHooked = true;
+        USB.onEvent([](void *, esp_event_base_t base, int32_t id, void *) {
+            if (base == ARDUINO_USB_EVENTS) s_usbEventState = id;
+        });
+    }
+
+    s_msc.vendorID("BRUCE");
+    s_msc.productID(s_backedByFlash ? "FLASH_DISK" : "PSRAM_DISK");
+    s_msc.productRevision("1.1");
+    s_msc.onRead(vmscReadCb);
+    s_msc.onWrite(vmscWriteCb);
+    s_msc.onStartStop(vmscStartStopCb);
+    s_msc.isWritable(true);
+    s_msc.begin(s_diskSectors, kSecSize);
+    s_msc.mediaPresent(true);
+    s_mscInited = true;
+
+#ifdef USB_as_HID
+    if (compositeBadUsb && !s_vmscKbdBegan) {
+        const uint8_t *layout = (const uint8_t *)pgm_read_ptr(&keyboardLayouts[bruceConfig.badUSBBLEKeyboardLayout]);
+        s_vmscKbd.begin(layout);
+        s_vmscKbd.setDelay(bruceConfig.badUSBBLEKeyDelay);
+        s_vmscKbdBegan = true;
+    }
+#endif
+    USB.begin();
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    bool badUsbExecuted = false;
+    uint32_t mountedAtMs = 0;
+    uint32_t lastDraw = 0;
+    String toastMsg = preloadedFiles > 0 ? ("Preloaded " + String(preloadedFiles) + " vault file(s)") : "";
+    uint32_t toastUntil = preloadedFiles > 0 ? (millis() + 3000UL) : 0;
+    returnToMenu = false;
+
+    while (!returnToMenu && !s_ejectRequested) {
+        InputHandler();
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+
+        bool isMounted = tud_mounted() || (s_usbEventState == ARDUINO_USB_STARTED_EVENT);
+        if (isMounted && mountedAtMs == 0) mountedAtMs = millis();
+
+        // Periodically flush dirty sectors to /usb_disk.img after 700ms idle
+        if (s_backedByFlash && s_dirtyAny && (millis() - s_lastWriteMs) > 700UL) {
+            saveMemoryToFlashImage();
+            toastMsg = "Synced changes to Flash";
+            toastUntil = millis() + 2000UL;
+        }
+
+        if (check(SelPress)) {
+            if (compositeBadUsb && isMounted && !duckyPath.isEmpty()) {
+#ifdef USB_as_HID
+                if (hasSprite) {
+                    frame.deleteSprite();
+                    hasSprite = false;
+                }
+                key_input(LittleFS, duckyPath, &s_vmscKbd);
+                badUsbExecuted = true;
+                hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+#endif
+            } else {
