+
+bool smartBadUsbGeneratePayload(BadUsbOsProfile profile, bool permissionCheck, String *pathOut,
+                                String *errOut) {
+    seclabEnsureDir(kDir);
+    String script = buildTargetScript(profile, permissionCheck);
+    String ds = buildDuckyScript(profile, script);
+    String path = String(kDir) + "/payload_" + profileTag(profile) + ".txt";
+    File f = LittleFS.open(path, FILE_WRITE);
+    if (!f) { if (errOut) *errOut = "Cannot write payload"; return false; }
+    f.print(ds);
+    f.close();
+    // Also expose a stable path for the WebUI / BadUSB file picker.
+    File f2 = LittleFS.open(kPayloadPath, FILE_WRITE);
+    if (f2) { f2.print(ds); f2.close(); }
+    writeWaitDemo();
+    if (pathOut) *pathOut = path;
+    return true;
+}
+
+bool smartBadUsbRunPayload(BadUsbOsProfile profile, bool permissionCheck, String *errOut) {
+#if defined(USB_as_HID) && CONFIG_TINYUSB_HID_ENABLED
+    if (bruceConfig.seclabPlus.badUsbOsWarn) {
+        displayWarning("Authorized USB audit only. Connect Bruce to the test host.", true);
+        bruceConfig.seclabPlus.badUsbOsWarn = false;
+        bruceConfig.saveFile();
+    }
+    String path, err;
+    if (!smartBadUsbGeneratePayload(profile, permissionCheck, &path, &err)) {
+        if (errOut) *errOut = err;
+        return false;
+    }
+    smartBadUsbEnsureLedEvents();
+    if (!smartBadUsbIsLedLinkRunning()) {
+        String ledErr;
+        smartBadUsbStartLedLink(0, &ledErr);
+    }
+    ducky_startKb(hid_usb, false, 2);
+    if (returnToMenu || !hid_usb) { if (errOut) *errOut = "USB HID start cancelled"; return false; }
+    uint32_t t0 = millis();
+    while (!tud_mounted() && millis() - t0 < 8000 && !check(EscPress)) {
+        printStatusBadUSBBLE("Waiting USB Host...");
+        vTaskDelay(pdMS_TO_TICKS(200));
+    }
+    if (!tud_mounted()) { if (errOut) *errOut = "USB host not connected"; return false; }
+    key_input(LittleFS, path, hid_usb);
+    delete hid_usb;
+    hid_usb = nullptr;
+    return true;
+#else
+    (void)profile; (void)permissionCheck;
+    if (errOut) *errOut = "USB HID not enabled on this board";
+    return false;
+#endif
+}
