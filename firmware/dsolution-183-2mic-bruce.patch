+class ExplorerClientCb : public NimBLEClientCallbacks {
+    void onConnect(NimBLEClient *pClient) override {
+        s_clientConnected = true;
+        uint8_t tx = 1, rx = 1;
+        if (pClient && pClient->getPhy(&tx, &rx)) {
+            s_txPhy = tx;
+            s_rxPhy = rx;
+        }
+    }
+    void onDisconnect(NimBLEClient *, int reason) override {
+        s_clientConnected = false;
+        s_lastEventStr = "Disconnected (" + String(reason) + ")";
+    }
+    void onPhyUpdate(NimBLEClient *, uint8_t txPhy, uint8_t rxPhy) override {
+        s_txPhy = txPhy;
+        s_rxPhy = rxPhy;
+        s_lastEventStr = String("PHY -> TX:") + phyCodeToStr(txPhy) + " RX:" + phyCodeToStr(rxPhy);
+    }
+};
+
+class ClonerServerCb : public NimBLEServerCallbacks {
+    void onConnect(NimBLEServer *, NimBLEConnInfo &) override {
+        s_cloneClientConn = true;
+        s_lastEventStr = "Target App Connected!";
+    }
+    void onDisconnect(NimBLEServer *, NimBLEConnInfo &, int) override {
+        s_cloneClientConn = false;
+        s_lastEventStr = "Client Disconnected (Adv...)";
+    }
+};
+
+class ClonerChrCb : public NimBLECharacteristicCallbacks {
+    void onWrite(NimBLECharacteristic *pChr, NimBLEConnInfo &) override {
+        NimBLEAttValue v = pChr->getValue();
+        String uuid = pChr->getUUID().toString().c_str();
+        String hx = toHexStr(v.data(), v.size(), 18);
+        String asc = toAsciiStr(v.data(), v.size(), 16);
+        ensureBleMux();
+        if (xSemaphoreTake(s_bleUiMux, pdMS_TO_TICKS(50)) == pdTRUE) {
+            s_cloneWrites++;
+            s_lastEventStr = shortUuidLabel(uuid) + ": " + hx;
+            s_recentWrites.push_back({millis(), shortUuidLabel(uuid), hx, asc});
+            if (s_recentWrites.size() > 24) s_recentWrites.erase(s_recentWrites.begin());
+            xSemaphoreGive(s_bleUiMux);
+        }
+        File f = LittleFS.open(kCloneWriteLog, FILE_APPEND);
+        if (f) {
+            f.printf("%lu,%s,%s,%s\n", (unsigned long)(millis() / 1000), uuid.c_str(), hx.c_str(), asc.c_str());
+            f.close();
+        }
+    }
+};
+
+static ExplorerClientCb s_clientCb;
+static ClonerServerCb s_cloneSrvCb;
+static ClonerChrCb s_cloneChrCb;
