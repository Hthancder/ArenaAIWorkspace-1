+#if defined(USB_as_HID) && CONFIG_TINYUSB_HID_ENABLED
+void smartBadUsbEnsureLedEvents() {
+    if (s_ledEventRegistered) return;
+    if (!s_ledQueue) s_ledQueue = xQueueCreate(128, sizeof(uint8_t));
+    USBHIDKeyboard *kb = virtualMscKeyboard();
+    if (!kb) return;
+    kb->onEvent(ARDUINO_USB_HID_KEYBOARD_LED_EVENT, smartUsbLedEvent);
+    s_ledEventRegistered = true;
+    // Flush any stale LED reports accumulated before arming.
+    uint8_t tmp;
+    while (xQueueReceive(s_ledQueue, &tmp, 0) == pdTRUE) {}
+}
+
+uint8_t smartBadUsbLedState() { return s_lastLeds; }
+
+bool smartBadUsbWaitLock(bool capsLock, uint32_t timeoutMs) {
+    smartBadUsbEnsureLedEvents();
+    uint8_t mask = capsLock ? 0x02 : 0x01;
+    uint8_t initial = s_lastLeds & mask;
+    uint32_t t0 = millis();
+    while (millis() - t0 < timeoutMs) {
+        if (check(EscPress)) return false;
+        if ((s_lastLeds & mask) != initial) return true;
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+    return false;
+}
+
+bool smartBadUsbStartLedLink(uint32_t timeoutSec, String *errOut) {
+    if (s_ledRunning) return true;
+    smartBadUsbEnsureLedEvents();
+    if (!s_ledQueue) { if (errOut) *errOut = "LED queue alloc failed"; return false; }
+    seclabEnsureDir(kDir);
+    s_ledTimeoutSec = timeoutSec ? timeoutSec : bruceConfig.seclabPlus.hidLedTimeoutSec;
+    if (!s_ledTimeoutSec) s_ledTimeoutSec = 120;
+    s_ledStartedMs = millis();
+    s_ledDecoded = "";
+    s_ledBits = s_ledBytes = s_ledErrors = 0;
+    s_ledLastErr[0] = 0;
+    s_ledStopReq = false;
+    s_ledRunning = true;
+    if (xTaskCreatePinnedToCore(ledLinkTask, "ledLink", 4096, nullptr, 2, &s_ledTask, 0) != pdPASS) {
+        s_ledRunning = false;
+        s_ledTask = nullptr;
+        if (errOut) *errOut = "LED Link task spawn failed";
+        return false;
+    }
+    return true;
+}
+
+void smartBadUsbStopLedLink() {
+    if (!s_ledRunning) return;
+    s_ledStopReq = true;
+    for (int i = 0; i < 80 && s_ledRunning; i++) vTaskDelay(pdMS_TO_TICKS(25));
+}
+
+bool smartBadUsbIsLedLinkRunning() { return s_ledRunning; }
+
+void smartBadUsbClearLedLink() {
+    smartBadUsbStopLedLink();
+    s_ledDecoded = "";
+    s_ledBits = s_ledBytes = s_ledErrors = 0;
+    s_ledLastErr[0] = 0;
+    strncpy(s_ledPhase, "IDLE", sizeof(s_ledPhase) - 1);
+    s_ledPhase[sizeof(s_ledPhase) - 1] = 0;
+    LittleFS.remove(kExfilPath);
+    LittleFS.remove(kLastJsonPath);
+    LittleFS.remove(kExportJsonPath);
+    LittleFS.remove(kLogPath);
+    persistLedState();
+}
