diff --git a/src/modules/ble/ble_audit_logic.h b/src/modules/ble/ble_audit_logic.h
new file mode 100644
index 00000000..ce6f7d28
--- /dev/null
+++ b/src/modules/ble/ble_audit_logic.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <ctime>
+
+// NimBLE 2.5.1 sets the timestamp output only on successful reads; when
+// timestamps are disabled it writes zero. A sentinel therefore also handles
+// successful zero-length reads, while failures remain unconfirmed.
+enum class BleAuditEvidence { Unconfirmed, Encrypted, Unencrypted };
+inline BleAuditEvidence bleAuditReadEvidence(time_t stamp, bool connected, bool encryptedBefore, bool encryptedAfter) {
+    if (stamp == static_cast<time_t>(-1) || !connected) return BleAuditEvidence::Unconfirmed;
+    return encryptedBefore || encryptedAfter ? BleAuditEvidence::Encrypted : BleAuditEvidence::Unencrypted;
+}
+inline BleAuditEvidence bleAuditWriteEvidence(bool ok, bool response, bool connected,
+                                               bool encryptedBefore, bool encryptedAfter) {
+    // A write without response only confirms local queueing, not peer acceptance.
+    if (!ok || !response || !connected) return BleAuditEvidence::Unconfirmed;
+    return encryptedBefore || encryptedAfter ? BleAuditEvidence::Encrypted : BleAuditEvidence::Unencrypted;
+}
+
+// An ordinary audit is always read-only, even if an older saved config had
+// boundary writes enabled. Selection 2 is the explicit active-write mode.
+inline bool bleAuditUseBoundaryWrites(int selection, bool enabled) {
+    return selection == 2 && enabled;
+}
