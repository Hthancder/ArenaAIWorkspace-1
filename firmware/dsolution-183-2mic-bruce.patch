+// =====================================================================================
+//  1. WIDS Guard (Passive Deauth/Disassoc + Beacon Flood + Rogue SSID Clone Monitor)
+// =====================================================================================
+constexpr int kWidsMaxProtected = 12;
+constexpr int kWidsBssidSlots = 64;
+
+struct ProtectedSsid {
+    char ssid[33];
+    uint8_t ssidLen;
+    uint8_t bssid[6];
+    uint8_t ch;
+    bool learned;
+    bool cloned;
+    uint8_t cloneMac[6];
+};
+
+static portMUX_TYPE s_widsMux = portMUX_INITIALIZER_UNLOCKED;
+static ProtectedSsid s_prot[kWidsMaxProtected];
+static int s_protCount = 0;
+static volatile uint32_t s_widsDeauth = 0;
+static volatile uint32_t s_widsBeacon = 0;
+static volatile uint32_t s_widsTotal = 0;
+static uint8_t s_lastDeauthMac[6] = {0};
+static uint32_t s_seenHashes[kWidsBssidSlots] = {0};
+static volatile uint16_t s_uniqueBeacons = 0;
+
+static void IRAM_ATTR widsRxCb(void *buf, wifi_promiscuous_pkt_type_t type) {
+    (void)type;
+    const wifi_promiscuous_pkt_t *pkt = (const wifi_promiscuous_pkt_t *)buf;
+    if (!pkt || pkt->rx_ctrl.sig_len < 24) return;
+
+    const uint8_t *f = pkt->payload;
+    uint16_t len = pkt->rx_ctrl.sig_len;
+    uint16_t fc = (uint16_t)f[0] | ((uint16_t)f[1] << 8);
+    uint8_t ftype = (fc & 0x0C) >> 2;
+    uint8_t fsub = (fc & 0xF0) >> 4;
+
+    portENTER_CRITICAL_ISR(&s_widsMux);
+    s_widsTotal++;
+    if (ftype == 0x00) {
+        if (fsub == 0x0C || fsub == 0x0A) { // Deauth or Disassoc
+            s_widsDeauth++;
+            memcpy(s_lastDeauthMac, f + 10, 6);
+        } else if (fsub == 0x08 && len >= 38) { // Beacon
+            s_widsBeacon++;
+            const uint8_t *bssid = f + 16;
+            uint32_t h = (((uint32_t)bssid[2] << 24) | ((uint32_t)bssid[3] << 16) |
+                          ((uint32_t)bssid[4] << 8) | (uint32_t)bssid[5]) ^
+                         (((uint32_t)bssid[0] << 8) | (uint32_t)bssid[1]);
+            if (h == 0) h = 1;
+            int idx = (int)(h % kWidsBssidSlots);
+            bool seen = false;
+            for (int probe = 0; probe < 4; probe++) {
+                int slot = (idx + probe) % kWidsBssidSlots;
+                if (s_seenHashes[slot] == h) {
+                    seen = true;
+                    break;
+                }
+                if (s_seenHashes[slot] == 0) {
+                    s_seenHashes[slot] = h;
+                    if (s_uniqueBeacons < 999) s_uniqueBeacons++;
+                    seen = true;
+                    break;
+                }
+            }
+            (void)seen;
+
+            // Check Tag 0 (SSID) at fixed management frame body offset 36
+            if (f[36] == 0x00) {
+                uint8_t slen = f[37];
+                if (slen > 0 && slen <= 32 && (uint16_t)(38 + slen) <= len) {
+                    const uint8_t *ssidPtr = f + 38;
+                    for (int p = 0; p < s_protCount; p++) {
+                        if (s_prot[p].ssidLen == slen && memcmp(s_prot[p].ssid, ssidPtr, slen) == 0) {
+                            if (!s_prot[p].learned) {
+                                s_prot[p].learned = true;
+                                memcpy(s_prot[p].bssid, bssid, 6);
+                                s_prot[p].ch = pkt->rx_ctrl.channel;
+                            } else if (memcmp(s_prot[p].bssid, bssid, 6) != 0) {
+                                s_prot[p].cloned = true;
+                                memcpy(s_prot[p].cloneMac, bssid, 6);
+                            }
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    portEXIT_CRITICAL_ISR(&s_widsMux);
+}
+
+static void appendWidsAlertLog(const String &eventLine) {
+    constexpr size_t kMaxLogBytes = 16384;
+    bool needHeader = !LittleFS.exists("/wids_alerts.txt");
+    if (!needHeader) {
+        File chk = LittleFS.open("/wids_alerts.txt", FILE_READ);
+        if (chk) {
+            if (chk.size() > kMaxLogBytes) needHeader = true;
+            chk.close();
+        }
+    }
+    File f = LittleFS.open("/wids_alerts.txt", needHeader ? FILE_WRITE : FILE_APPEND);
+    if (!f) return;
+    if (needHeader) {
+        f.printf(
+            "# Bruce WIDS Guard Log | Owner: %s | Host: %s.local\n",
+            bruceConfig.ownerName.c_str(),
+            bruceConfig.mdnsHost.c_str()
+        );
+    }
+    f.printf("[%lus] %s\n", (unsigned long)(millis() / 1000UL), eventLine.c_str());
+    f.close();
+}
