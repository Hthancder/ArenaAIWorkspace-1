+static void runPeripheralCloner(const GattProfile &prof) {
+    stopBLEStack();
+    vTaskDelay(pdMS_TO_TICKS(120));
+
+    if (!radioHasMemForBle()) radioFreeWiFiForBle();
+    if (!radioHasMemForBle()) {
+        displayError("Low RAM for BLE Cloner", true);
+        return;
+    }
+
+    String devName = prof.name;
+    if (devName.isEmpty() || devName == "<unnamed>") devName = "BruceClone";
+    if (devName.length() > 24) devName = devName.substring(0, 24);
+
+    BLEDevice::init(devName.c_str());
+    NimBLEServer *pSrv = BLEDevice::createServer();
+    if (!pSrv) {
+        displayError("BLE createServer failed", true);
+        stopBLEStack();
+        return;
+    }
+    pSrv->setCallbacks(&s_cloneSrvCb);
+    pSrv->advertiseOnDisconnect(true);
+
+    int builtSvcs = 0;
+    int builtChrs = 0;
+    String firstUserSvc;
+
+    for (const auto &svcSnap : prof.services) {
+        if (isSystemServiceUuid(svcSnap.uuid)) continue;
+        NimBLEService *pSvc = pSrv->createService(svcSnap.uuid.c_str());
+        if (!pSvc) continue;
+        builtSvcs++;
+        if (firstUserSvc.isEmpty()) firstUserSvc = svcSnap.uuid;
+
+        for (const auto &chrSnap : prof.chars) {
+            if (chrSnap.svcUuid != svcSnap.uuid) continue;
+            uint32_t props = 0;
+            if (chrSnap.props & 0x01) props |= NIMBLE_PROPERTY::READ;
+            if (chrSnap.props & 0x02) props |= NIMBLE_PROPERTY::WRITE;
+            if (chrSnap.props & 0x04) props |= NIMBLE_PROPERTY::WRITE_NR;
+            if (chrSnap.props & 0x08) props |= NIMBLE_PROPERTY::NOTIFY;
+            if (chrSnap.props & 0x10) props |= NIMBLE_PROPERTY::INDICATE;
+            if (props == 0) props = NIMBLE_PROPERTY::READ | NIMBLE_PROPERTY::WRITE;
+
+            NimBLECharacteristic *pChr = pSvc->createCharacteristic(chrSnap.uuid.c_str(), props);
+            if (pChr) {
+                if (!chrSnap.val.empty()) pChr->setValue(chrSnap.val.data(), chrSnap.val.size());
+                pChr->setCallbacks(&s_cloneChrCb);
+                builtChrs++;
+            }
+        }
+        pSvc->start();
+    }
+
+    // Fallback dummy service if target only exposed 0x1800/0x1801
+    if (builtSvcs == 0) {
+        NimBLEService *pSvc = pSrv->createService("FFE0");
+        if (pSvc) {
+            NimBLECharacteristic *pChr =
+                pSvc->createCharacteristic("FFE1", NIMBLE_PROPERTY::READ | NIMBLE_PROPERTY::WRITE | NIMBLE_PROPERTY::NOTIFY);
+            if (pChr) pChr->setCallbacks(&s_cloneChrCb);
+            pSvc->start();
+            builtSvcs = 1;
+            builtChrs = 1;
+            firstUserSvc = "FFE0";
+        }
+    }
+
+    NimBLEAdvertising *pAdv = BLEDevice::getAdvertising();
+    if (pAdv) {
+        pAdv->enableScanResponse(true);
+        pAdv->setName(devName.c_str());
+        if (!prof.advUuids.empty()) {
+            pAdv->addServiceUUID(prof.advUuids[0].c_str());
+        } else if (!firstUserSvc.isEmpty()) {
+            pAdv->addServiceUUID(firstUserSvc.c_str());
+        }
+        if (!prof.mfrData.empty() && prof.mfrData.size() <= 20) {
+            pAdv->setManufacturerData(prof.mfrData);
+        }
+        pAdv->start();
+    }
+
+    s_activeMode = "CLONER";
+    s_activeTarget = devName;
+    s_cloneWrites = 0;
+    s_cloneClientConn = false;
+    s_lastEventStr = "Advertising Clone (" + String(builtSvcs) + "S/" + String(builtChrs) + "C)";
+    s_recentWrites.clear();
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    uint32_t lastDraw = 0;
+    returnToMenu = false;
+
+    while (!returnToMenu) {
+        InputHandler();
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+        if (check(SelPress)) {
+            // Clear write log view
+            ensureBleMux();
+            if (xSemaphoreTake(s_bleUiMux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                s_recentWrites.clear();
+                xSemaphoreGive(s_bleUiMux);
+            }
+            lastDraw = 0;
+        }
+        if (millis() - lastDraw >= 180) {
+            lastDraw = millis();
+            if (hasSprite) {
+                const uint16_t bg = bruceConfig.bgColor;
+                const uint16_t pri = bruceConfig.priColor;
+                const uint16_t sec = bruceConfig.secColor;
+                const uint16_t okCol = 0x2F2F;
+                const uint16_t warnCol = 0xFD84;
+
+                frame.fillScreen(bg);
+                frame.fillRect(0, 0, tftWidth, 24, blendColors(bg, pri, 28));
+                frame.setTextSize(1);
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(pri, blendColors(bg, pri, 28));
+                frame.drawString("BLE GATT CLONER", 8, 12);
+                frame.setTextDatum(MR_DATUM);
+                frame.setTextColor(s_cloneClientConn ? okCol : warnCol, blendColors(bg, pri, 28));
+                frame.drawString(s_cloneClientConn ? "APP CONN" : "ADV LIVE", tftWidth - 8, 12);
+
+                frame.fillRoundRect(8, 30, tftWidth - 16, 46, 6, blendColors(bg, pri, 12));
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(TFT_WHITE, blendColors(bg, pri, 12));
+                frame.drawString("Clone: " + devName + " (" + String(builtSvcs) + "S/" + String(builtChrs) + "C)", 16, 44);
+                frame.setTextColor(sec, blendColors(bg, pri, 12));
+                frame.drawString("Captured Writes: " + String((unsigned long)s_cloneWrites), 16, 62);
+
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(pri, bg);
+                frame.drawString("INCOMING APP WRITES:", 10, 90);
+
+                ensureBleMux();
+                std::vector<WriteLogItem> snap;
+                if (xSemaphoreTake(s_bleUiMux, pdMS_TO_TICKS(30)) == pdTRUE) {
+                    snap = s_recentWrites;
+                    xSemaphoreGive(s_bleUiMux);
+                }
+
+                if (snap.empty()) {
+                    frame.setTextDatum(MC_DATUM);
+                    frame.setTextColor(sec, bg);
+                    frame.drawString("Waiting for target app to connect", tftWidth / 2, 145);
+                    frame.drawString("& write to cloned characteristics", tftWidth / 2, 162);
+                } else {
+                    int y = 104;
+                    int shown = 0;
+                    for (int i = (int)snap.size() - 1; i >= 0 && shown < 5; i--, shown++) {
+                        frame.fillRoundRect(8, y, tftWidth - 16, 21, 3, blendColors(bg, pri, 8));
+                        frame.setTextDatum(ML_DATUM);
+                        frame.setTextColor(warnCol, blendColors(bg, pri, 8));
+                        frame.drawString(snap[i].chrUuid.substring(0, 10), 12, y + 10);
+                        frame.setTextColor(TFT_WHITE, blendColors(bg, pri, 8));
+                        frame.drawString(snap[i].hex.substring(0, 26), 84, y + 10);
+                        y += 23;
+                    }
+                }
+
+                frame.fillRect(0, tftHeight - 20, tftWidth, 20, blendColors(bg, pri, 14));
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 14));
+                frame.drawString("Boot:Clear Log   Log:/ble_clone_writes.log   Hold:Stop", tftWidth / 2, tftHeight - 10);
+                frame.pushSprite(0, 0);
+            }
+            wakeUpScreen();
+        }
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+
+    if (hasSprite) frame.deleteSprite();
+    stopBLEStack();
+    s_activeMode = "IDLE";
+    tft.fillScreen(bruceConfig.bgColor);
+}
+
+static void inspectAndExploreTarget(const ScanTarget &tgt) {
+    stopBLEStack();
+    vTaskDelay(pdMS_TO_TICKS(80));
+    if (!radioHasMemForBle()) radioFreeWiFiForBle();
+    if (!radioHasMemForBle()) {
+        displayError("Low RAM for BLE Client", true);
+        return;
+    }
+
+    drawMainBorderWithTitle("BLE GATT Explorer");
+    padprintln("");
+    padprintln("Connecting to " + tgt.addr + "...");
+
+    BLEDevice::init("");
+    NimBLEClient *pClient = BLEDevice::createClient();
+    if (!pClient) {
+        displayError("createClient failed", true);
+        stopBLEStack();
+        return;
+    }
+    pClient->setClientCallbacks(&s_clientCb, false);
+    pClient->setConnectionParams(12, 24, 0, 150);
+
+    NimBLEAddress peerAddr(tgt.addr.c_str(), tgt.addrType);
+    if (!pClient->connect(peerAddr, true, false, true)) {
+        BLEDevice::deleteClient(pClient);
+        stopBLEStack();
+        displayError("BLE Connect Failed\n(Device busy or out of range)", true);
+        return;
+    }
+
+    s_clientConnected = true;
+    s_txPhy = 1;
+    s_rxPhy = 1;
+    {
+        uint8_t tx = 1, rx = 1;
+        if (pClient->getPhy(&tx, &rx)) {
+            s_txPhy = tx;
+            s_rxPhy = rx;
+        }
+    }
+
+    padprintln("Discovering GATT services...");
+    GattProfile prof;
+    prof.name = tgt.name;
+    prof.addr = tgt.addr;
+    prof.addrType = tgt.addrType;
+    prof.rssi = tgt.rssi;
+    prof.mfrData = tgt.mfrData;
+    prof.advUuids = tgt.advUuids;
+
+    const std::vector<NimBLERemoteService *> &svcs = pClient->getServices(true);
+    for (NimBLERemoteService *s : svcs) {
+        if (!s) continue;
+        GattSvcSnap ss;
+        ss.uuid = s->getUUID().toString().c_str();
+        ss.label = shortUuidLabel(ss.uuid);
+        prof.services.push_back(ss);
+
+        const std::vector<NimBLERemoteCharacteristic *> &chrs = s->getCharacteristics(true);
+        for (NimBLERemoteCharacteristic *c : chrs) {
+            if (!c) continue;
+            GattChrSnap cs;
+            cs.svcUuid = ss.uuid;
+            cs.uuid = c->getUUID().toString().c_str();
+            cs.handle = c->getHandle();
+            cs.props = 0;
+            if (c->canRead()) cs.props |= 0x01;
+            if (c->canWrite()) cs.props |= 0x02;
+            if (c->canWriteNoResponse()) cs.props |= 0x04;
+            if (c->canNotify()) cs.props |= 0x08;
+            if (c->canIndicate()) cs.props |= 0x10;
+            cs.subscribed = false;
+            cs.remote = c;
+            if (c->canRead() && prof.chars.size() < 40) {
+                NimBLEAttValue v = c->readValue();
+                if (v.size() > 0) cs.val.assign(v.data(), v.data() + std::min<size_t>(v.size(), 64));
+            }
+            prof.chars.push_back(cs);
+            if (prof.chars.size() >= 60) break;
+        }
+        if (prof.chars.size() >= 60) break;
+    }
+
+    if (prof.chars.empty()) {
+        pClient->disconnect();
+        BLEDevice::deleteClient(pClient);
+        stopBLEStack();
+        displayWarning("No GATT characteristics found", true);
+        return;
+    }
+
+    s_activeMode = "EXPLORER";
+    s_activeTarget = prof.name;
+    s_notifyCount = 0;
+    s_lastEventStr = "Loaded " + String(prof.services.size()) + "S / " + String(prof.chars.size()) + "C";
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    int cursor = 0;
+    int topIdx = 0;
+    uint32_t lastDraw = 0;
+    bool triggerClone = false;
+    returnToMenu = false;
+
+    while (!returnToMenu && !triggerClone) {
+        InputHandler();
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+        if (check(PrevPress) || check(UpPress)) {
+            if (cursor > 0) cursor--;
+            else cursor = (int)prof.chars.size() - 1;
+            lastDraw = 0;
+        }
+        if (check(NextPress) || check(DownPress)) {
+            cursor = (cursor + 1) % (int)prof.chars.size();
+            lastDraw = 0;
+        }
+        if (cursor < topIdx) topIdx = cursor;
+        if (cursor >= topIdx + 5) topIdx = cursor - 4;
+
+        if (check(SelPress)) {
+            GattChrSnap &cur = prof.chars[cursor];
+            if (hasSprite) {
+                frame.deleteSprite();
+                hasSprite = false;
+            }
+            int act = -1;
+            options.clear();
+            if (cur.props & 0x01) options.push_back({"Read Value", [&]() { act = 0; }});
+            if (cur.props & (0x02 | 0x04)) options.push_back({"Write ASCII / Hex", [&]() { act = 1; }});
+            if (cur.props & (0x08 | 0x10)) {
+                options.push_back({cur.subscribed ? "Unsubscribe Notify" : "Subscribe Live Notify", [&]() { act = 2; }});
+            }
+            options.push_back({String("PHY Mode (Now ") + phyCodeToStr(s_txPhy) + ")", [&]() { act = 3; }});
+            options.push_back({"Save Profile to Flash", [&]() { act = 4; }});
+            options.push_back({"[CLONE & EMULATE THIS!]", [&]() { act = 5; }});
+            options.push_back({"Back", [&]() { act = 6; }});
+            loopOptions(options, MENU_TYPE_SUBMENU, shortUuidLabel(cur.uuid).c_str());
+            options.clear();
+
+            if (act == 0 && cur.remote && pClient->isConnected()) {
+                NimBLEAttValue v = cur.remote->readValue();
+                cur.val.assign(v.data(), v.data() + std::min<size_t>(v.size(), 64));
+                s_lastEventStr = "Read: " + toHexStr(cur.val.data(), cur.val.size(), 16);
+            } else if (act == 1 && cur.remote && pClient->isConnected()) {
+                String inp = keyboard("", 40, "Text or hex:AABBCC");
+                if (!inp.isEmpty()) {
+                    bool needResp = (cur.props & 0x02) && !(cur.props & 0x04);
+                    bool ok = false;
+                    if (inp.startsWith("hex:") || inp.startsWith("HEX:")) {
+                        std::vector<uint8_t> bytes;
+                        if (hexStringToBytes(inp.substring(4), bytes)) {
+                            ok = cur.remote->writeValue(bytes.data(), bytes.size(), needResp);
+                            if (ok) cur.val = bytes;
+                        }
+                    } else {
+                        ok = cur.remote->writeValue((const uint8_t *)inp.c_str(), inp.length(), needResp);
+                        if (ok) cur.val.assign((const uint8_t *)inp.c_str(), (const uint8_t *)inp.c_str() + inp.length());
+                    }
+                    s_lastEventStr = ok ? "Write OK" : "Write Failed";
+                }
+            } else if (act == 2 && cur.remote && pClient->isConnected()) {
+                if (cur.subscribed) {
+                    cur.remote->unsubscribe();
+                    cur.subscribed = false;
+                    s_lastEventStr = "Unsubscribed";
+                } else {
+                    bool useNotify = (cur.props & 0x08) != 0;
+                    int idxCapture = cursor;
+                    bool ok = cur.remote->subscribe(
+                        useNotify,
+                        [&prof, idxCapture](NimBLERemoteCharacteristic *rc, uint8_t *pData, size_t len, bool) {
+                            ensureBleMux();
+                            if (xSemaphoreTake(s_bleUiMux, pdMS_TO_TICKS(30)) == pdTRUE) {
+                                s_notifyCount++;
+                                if (idxCapture >= 0 && idxCapture < (int)prof.chars.size()) {
+                                    prof.chars[idxCapture].val.assign(pData, pData + std::min<size_t>(len, 64));
+                                }
+                                s_lastEventStr = "Ntf " + shortUuidLabel(rc->getUUID().toString().c_str()) + ": " +
+                                                 toHexStr(pData, len, 12);
+                                xSemaphoreGive(s_bleUiMux);
+                            }
+                        }
+                    );
+                    cur.subscribed = ok;
+                    s_lastEventStr = ok ? "Subscribed Live Notify!" : "Subscribe Failed";
+                }
+            } else if (act == 3 && pClient->isConnected()) {
+                int psel = -1;
+                options.clear();
+                options.push_back({"1M Standard PHY (Default)", [&]() { psel = 0; }});
+                options.push_back({"2M High-Speed PHY (BLE 5)", [&]() { psel = 1; }});
+                options.push_back({"Coded PHY S2 (Long Range)", [&]() { psel = 2; }});
+                options.push_back({"Coded PHY S8 (Max Range)", [&]() { psel = 3; }});
+                loopOptions(options, MENU_TYPE_SUBMENU, "Select BLE 5.x PHY");
+                options.clear();
+                bool ok = false;
+                if (psel == 0) ok = pClient->updatePhy(kPhyMask1M, kPhyMask1M, 0);
+                else if (psel == 1) ok = pClient->updatePhy(kPhyMask2M, kPhyMask2M, 0);
+                else if (psel == 2) ok = pClient->updatePhy(kPhyMaskCoded, kPhyMaskCoded, 1); // S2
+                else if (psel == 3) ok = pClient->updatePhy(kPhyMaskCoded, kPhyMaskCoded, 2); // S8
+                if (psel >= 0) {
+                    vTaskDelay(pdMS_TO_TICKS(250));
+                    uint8_t tx = s_txPhy, rx = s_rxPhy;
+                    pClient->getPhy(&tx, &rx);
+                    s_txPhy = tx;
+                    s_rxPhy = rx;
+                    s_lastEventStr = ok ? (String("PHY -> ") + phyCodeToStr(tx)) : "Peer rejected PHY";
+                }
+            } else if (act == 4) {
+                s_lastEventStr = saveGattProfileJson(prof) ? ("Saved " + prof.addr.substring(9)) : "Save failed";
+            } else if (act == 5) {
+                saveGattProfileJson(prof);
+                triggerClone = true;
+                break;
+            }
+
+            hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+            lastDraw = 0;
+        }
+
+        if (millis() - lastDraw >= 180) {
+            lastDraw = millis();
+            if (hasSprite) {
+                const uint16_t bg = bruceConfig.bgColor;
+                const uint16_t pri = bruceConfig.priColor;
+                const uint16_t sec = bruceConfig.secColor;
+                const uint16_t okCol = 0x2F2F;
+                const uint16_t warnCol = 0xFD84;
+
+                frame.fillScreen(bg);
+                frame.fillRect(0, 0, tftWidth, 24, blendColors(bg, pri, 28));
+                frame.setTextSize(1);
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(pri, blendColors(bg, pri, 28));
+                String title = prof.name;
+                if (title == "<no name>") title = prof.addr.substring(9);
+                frame.drawString(title.substring(0, 18), 6, 12);
+
+                // PHY + Connection badge
+                frame.setTextDatum(MR_DATUM);
+                uint16_t phyCol = (s_txPhy == 2) ? okCol : ((s_txPhy == 3) ? warnCol : pri);
+                frame.setTextColor(s_clientConnected ? phyCol : TFT_RED, blendColors(bg, pri, 28));
+                String badge = s_clientConnected ? (String("PHY:") + phyCodeToStr(s_txPhy)) : "DISC";
+                frame.drawString(badge, tftWidth - 6, 12);
+
+                // 5 visible characteristic rows
+                int y = 28;
+                for (int i = topIdx; i < (int)prof.chars.size() && i < topIdx + 5; i++) {
+                    const GattChrSnap &c = prof.chars[i];
+                    bool selRow = (i == cursor);
+                    uint16_t rowBg = selRow ? blendColors(bg, pri, 36) : blendColors(bg, pri, 8);
+                    frame.fillRoundRect(6, y, tftWidth - 12, 24, 4, rowBg);
+                    if (selRow) frame.drawRoundRect(6, y, tftWidth - 12, 24, 4, pri);
+
+                    frame.setTextDatum(ML_DATUM);
+                    frame.setTextColor(selRow ? TFT_WHITE : pri, rowBg);
+                    frame.drawString(shortUuidLabel(c.uuid).substring(0, 14), 11, y + 12);
+
+                    String perm;
+                    if (c.props & 0x01) perm += "R";
+                    if (c.props & (0x02 | 0x04)) perm += "W";
+                    if (c.props & (0x08 | 0x10)) perm += "N";
+                    if (c.subscribed) perm += "*";
+                    frame.setTextDatum(MR_DATUM);
+                    frame.setTextColor(c.subscribed ? okCol : sec, rowBg);
+                    frame.drawString(perm, tftWidth - 11, y + 12);
+                    y += 26;
+                }
+
+                // Selected Characteristic Value Inspector Box
+                const GattChrSnap &selChr = prof.chars[cursor];
+                frame.fillRoundRect(6, 160, tftWidth - 12, 56, 6, blendColors(bg, pri, 10));
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 10));
+                frame.drawString("Svc: " + shortUuidLabel(selChr.svcUuid) + "  [" + String(cursor + 1) + "/" +
+                                     String((int)prof.chars.size()) + "]",
+                                 12,
+                                 171);
+                frame.setTextColor(TFT_WHITE, blendColors(bg, pri, 10));
+                frame.drawString("HEX: " + toHexStr(selChr.val.data(), selChr.val.size(), 12), 12, 187);
+                frame.setTextColor(warnCol, blendColors(bg, pri, 10));
+                String asc = toAsciiStr(selChr.val.data(), selChr.val.size(), 18);
+                frame.drawString(asc.isEmpty() ? s_lastEventStr.substring(0, 32) : ("TXT: " + asc), 12, 203);
+
+                frame.fillRect(0, tftHeight - 20, tftWidth, 20, blendColors(bg, pri, 14));
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 14));
+                frame.drawString("Vol-/+:Scroll   Boot:Action/PHY/Clone   Hold:Exit", tftWidth / 2, tftHeight - 10);
+                frame.pushSprite(0, 0);
+            }
+            wakeUpScreen();
+        }
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+
+    if (hasSprite) frame.deleteSprite();
+    if (pClient->isConnected()) pClient->disconnect();
+    BLEDevice::deleteClient(pClient);
+    stopBLEStack();
+    s_activeMode = "IDLE";
+
+    if (triggerClone) {
+        runPeripheralCloner(prof);
+    }
+    tft.fillScreen(bruceConfig.bgColor);
+}
+
+static String jsonEscBle(const String &s) {
+    String out;
+    out.reserve(s.length() + 4);
+    for (size_t i = 0; i < s.length(); i++) {
+        char c = s[i];
+        if (c == '"' || c == '\\') out += '\\';
+        if (c >= 32 && c < 127) out += c;
+    }
+    return out;
+}
