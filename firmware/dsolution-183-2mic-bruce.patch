+constexpr const char *kGattProfilesDir = "/ble_gatt";
+constexpr const char *kCloneWriteLog = "/ble_clone_writes.log";
+#ifdef BLE_GAP_LE_PHY_1M_MASK
+constexpr uint8_t kPhyMask1M = BLE_GAP_LE_PHY_1M_MASK;
+constexpr uint8_t kPhyMask2M = BLE_GAP_LE_PHY_2M_MASK;
+constexpr uint8_t kPhyMaskCoded = BLE_GAP_LE_PHY_CODED_MASK;
+#else
+constexpr uint8_t kPhyMask1M = 0x01;
+constexpr uint8_t kPhyMask2M = 0x02;
+constexpr uint8_t kPhyMaskCoded = 0x04;
+#endif
+
+struct WriteLogItem {
+    uint32_t ms;
+    String chrUuid;
+    String hex;
+    String ascii;
+};
+
+static SemaphoreHandle_t s_bleUiMux = nullptr;
+static volatile bool s_clientConnected = false;
+static volatile uint8_t s_txPhy = 1; // 1=1M, 2=2M, 3=Coded
+static volatile uint8_t s_rxPhy = 1;
+static volatile uint32_t s_notifyCount = 0;
+static volatile uint32_t s_cloneWrites = 0;
+static volatile bool s_cloneClientConn = false;
+static String s_lastEventStr = "Ready";
+static String s_activeMode = "IDLE";
+static String s_activeTarget = "";
+static GattProfile * volatile s_activeProfPtr = nullptr;
+static std::vector<WriteLogItem> s_recentWrites;
+
+static void ensureBleMux() {
+    if (!s_bleUiMux) s_bleUiMux = xSemaphoreCreateMutex();
+}
+
+static void setLastBleEvent(const String &ev) {
+    ensureBleMux();
+    if (xSemaphoreTake(s_bleUiMux, pdMS_TO_TICKS(40)) == pdTRUE) {
+        s_lastEventStr = ev;
+        xSemaphoreGive(s_bleUiMux);
+    }
+}
+
+static String getLastBleEvent() {
+    String out = "Ready";
+    ensureBleMux();
+    if (xSemaphoreTake(s_bleUiMux, pdMS_TO_TICKS(40)) == pdTRUE) {
+        out = s_lastEventStr;
+        xSemaphoreGive(s_bleUiMux);
+    }
+    return out;
+}
+
+static const char *phyCodeToStr(uint8_t p) {
+    if (p == 2) return "2M";
+    if (p == 3) return "CODED";
+    if (p == 1) return "1M";
+    return "?";
+}
+
+static String toHexStr(const uint8_t *data, size_t len, size_t maxBytes = 24) {
+    if (!data || len == 0) return "<empty>";
+    String s;
+    size_t n = std::min(len, maxBytes);
+    char buf[4];
+    for (size_t i = 0; i < n; i++) {
+        snprintf(buf, sizeof(buf), i == 0 ? "%02X" : " %02X", data[i]);
+        s += buf;
+    }
+    if (len > maxBytes) s += "..";
+    return s;
+}
+
+static String toAsciiStr(const uint8_t *data, size_t len, size_t maxChars = 22) {
+    if (!data || len == 0) return "";
+    String s;
+    size_t n = std::min(len, maxChars);
+    for (size_t i = 0; i < n; i++) {
+        char c = (data[i] >= 32 && data[i] <= 126) ? (char)data[i] : '.';
+        s += c;
+    }
+    return s;
+}
+
+static String shortUuidLabel(const String &uuid) {
+    String u = uuid;
+    u.toUpperCase();
+    if (u.startsWith("0X")) u = u.substring(2);
+    // Match 16-bit UUIDs
+    if (u == "1800") return "Generic Access";
+    if (u == "1801") return "Generic Attr";
+    if (u == "180A") return "Device Info";
+    if (u == "180D") return "Heart Rate";
+    if (u == "180F") return "Battery Svc";
+    if (u == "1812") return "HID / Keyboard";
+    if (u == "181A") return "Env Sensing";
+    if (u == "FEE0" || u == "FEE1") return "Wearable/Mi";
+    if (u == "FE9F") return "Google FastPair";
+    if (u.startsWith("6E400001")) return "Nordic UART";
+    if (u.startsWith("6E400002")) return "NUS RX";
+    if (u.startsWith("6E400003")) return "NUS TX";
+    if (u == "2A00") return "Device Name";
+    if (u == "2A19") return "Battery Level";
+    if (u == "2A24") return "Model Number";
+    if (u == "2A29") return "Manufacturer";
+    if (u == "2A37") return "HR Measure";
+    if (u.length() > 12) return u.substring(0, 8) + "..";
+    return "0x" + u;
+}
+
+static bool isSystemServiceUuid(const String &uuid) {
+    String u = uuid;
+    u.toUpperCase();
+    if (u.startsWith("0X")) u = u.substring(2);
+    return (u == "1800" || u == "1801" || u == "00001800-0000-1000-8000-00805F9B34FB" ||
+            u == "00001801-0000-1000-8000-00805F9B34FB");
+}
+
+static String sanitizeAddrFile(const String &addr) {
+    String out;
+    for (size_t i = 0; i < addr.length(); i++) {
+        char c = addr[i];
+        if (c == ':' || c == '-') continue;
+        out += (char)tolower((unsigned char)c);
+    }
+    return String(kGattProfilesDir) + "/gatt_" + out + ".json";
+}
+
+static bool saveGattProfileJson(const GattProfile &prof) {
+    if (!LittleFS.exists(kGattProfilesDir)) LittleFS.mkdir(kGattProfilesDir);
+    String path = sanitizeAddrFile(prof.addr);
+    JsonDocument doc;
+    doc["name"] = prof.name;
+    doc["addr"] = prof.addr;
+    doc["addrType"] = prof.addrType;
+    doc["rssi"] = prof.rssi;
+    if (!prof.mfrData.empty()) {
+        String mh;
+        char b[3];
+        for (uint8_t v : prof.mfrData) {
+            snprintf(b, sizeof(b), "%02X", v);
+            mh += b;
+        }
+        doc["mfrHex"] = mh;
+    }
+    JsonArray advArr = doc["advUuids"].to<JsonArray>();
+    for (const auto &u : prof.advUuids) advArr.add(u);
+    JsonArray svcArr = doc["services"].to<JsonArray>();
+    for (const auto &s : prof.services) {
+        JsonObject so = svcArr.add<JsonObject>();
+        so["uuid"] = s.uuid;
+    }
+    JsonArray chrArr = doc["chars"].to<JsonArray>();
+    for (const auto &c : prof.chars) {
+        JsonObject co = chrArr.add<JsonObject>();
+        co["svc"] = c.svcUuid;
+        co["uuid"] = c.uuid;
+        co["props"] = c.props;
+        String vh;
+        char b[3];
+        for (size_t i = 0; i < c.val.size() && i < 64; i++) {
+            snprintf(b, sizeof(b), "%02X", c.val[i]);
+            vh += b;
+        }
+        co["hex"] = vh;
+    }
+    File f = LittleFS.open(path, FILE_WRITE);
+    if (!f) return false;
+    serializeJson(doc, f);
+    f.close();
+    return true;
+}
+
+static bool hexStringToBytes(const String &hexIn, std::vector<uint8_t> &out) {
+    out.clear();
+    String clean;
+    for (size_t i = 0; i < hexIn.length(); i++) {
+        char c = hexIn[i];
+        if (isxdigit((unsigned char)c)) clean += c;
+    }
+    if (clean.length() < 2 || (clean.length() % 2) != 0) return false;
+    for (size_t i = 0; i + 1 < clean.length(); i += 2) {
+        char b[3] = {clean[i], clean[i + 1], '\0'};
+        out.push_back((uint8_t)strtoul(b, nullptr, 16));
+    }
+    return true;
+}
+
+static bool loadGattProfileJson(const String &path, GattProfile &prof) {
+    File f = LittleFS.open(path, FILE_READ);
+    if (!f) return false;
+    JsonDocument doc;
+    DeserializationError err = deserializeJson(doc, f);
+    f.close();
+    if (err) return false;
+
+    prof = GattProfile();
+    prof.name = doc["name"] | "Cloned BLE";
+    prof.addr = doc["addr"] | "00:00:00:00:00:00";
+    prof.addrType = doc["addrType"] | 0;
+    prof.rssi = doc["rssi"] | -50;
+    hexStringToBytes(doc["mfrHex"] | "", prof.mfrData);
+
+    for (JsonVariant v : doc["advUuids"].as<JsonArray>()) prof.advUuids.push_back(v.as<String>());
+    for (JsonObject so : doc["services"].as<JsonArray>()) {
+        GattSvcSnap s;
+        s.uuid = so["uuid"] | "";
+        s.label = shortUuidLabel(s.uuid);
+        if (!s.uuid.isEmpty()) prof.services.push_back(s);
+    }
+    for (JsonObject co : doc["chars"].as<JsonArray>()) {
+        GattChrSnap c;
+        c.svcUuid = co["svc"] | "";
+        c.uuid = co["uuid"] | "";
+        c.props = co["props"] | 0x02;
+        c.handle = 0;
+        c.subscribed = false;
+        c.remote = nullptr;
+        hexStringToBytes(co["hex"] | "", c.val);
+        if (!c.uuid.isEmpty() && !c.svcUuid.isEmpty()) prof.chars.push_back(c);
+    }
+    return !prof.services.empty();
+}
+
+class ExplorerClientCb : public NimBLEClientCallbacks {
+    void onConnect(NimBLEClient *pClient) override {
+        s_clientConnected = true;
+        uint8_t tx = 1, rx = 1;
+        if (pClient && pClient->getPhy(&tx, &rx)) {
+            s_txPhy = tx;
+            s_rxPhy = rx;
+        }
+    }
+    void onDisconnect(NimBLEClient *, int reason) override {
+        s_clientConnected = false;
+        setLastBleEvent("Disconnected (" + String(reason) + ")");
+    }
+    void onPhyUpdate(NimBLEClient *, uint8_t txPhy, uint8_t rxPhy) override {
+        s_txPhy = txPhy;
+        s_rxPhy = rxPhy;
+        setLastBleEvent(String("PHY -> TX:") + phyCodeToStr(txPhy) + " RX:" + phyCodeToStr(rxPhy));
+    }
+};
+
+class ClonerServerCb : public NimBLEServerCallbacks {
+    void onConnect(NimBLEServer *, NimBLEConnInfo &) override {
+        s_cloneClientConn = true;
+        setLastBleEvent("Target App Connected!");
+    }
+    void onDisconnect(NimBLEServer *, NimBLEConnInfo &, int) override {
+        s_cloneClientConn = false;
+        setLastBleEvent("Client Disconnected (Adv...)");
+    }
+};
+
+class ClonerChrCb : public NimBLECharacteristicCallbacks {
+    void onWrite(NimBLECharacteristic *pChr, NimBLEConnInfo &) override {
+        NimBLEAttValue v = pChr->getValue();
+        String uuid = pChr->getUUID().toString().c_str();
+        String hx = toHexStr(v.data(), v.size(), 18);
+        String asc = toAsciiStr(v.data(), v.size(), 16);
+        ensureBleMux();
+        if (xSemaphoreTake(s_bleUiMux, pdMS_TO_TICKS(50)) == pdTRUE) {
+            s_cloneWrites++;
+            s_lastEventStr = shortUuidLabel(uuid) + ": " + hx;
+            s_recentWrites.push_back({static_cast<uint32_t>(millis()), shortUuidLabel(uuid), hx, asc});
+            if (s_recentWrites.size() > 24) s_recentWrites.erase(s_recentWrites.begin());
+            xSemaphoreGive(s_bleUiMux);
+        }
+        File f = LittleFS.open(kCloneWriteLog, FILE_APPEND);
+        if (f) {
+            f.printf("%lu,%s,%s,%s\n", (unsigned long)(millis() / 1000), uuid.c_str(), hx.c_str(), asc.c_str());
+            f.close();
+        }
+    }
+};
+
+static ExplorerClientCb s_clientCb;
+static ClonerServerCb s_cloneSrvCb;
+static ClonerChrCb s_cloneChrCb;
+
+static void runPeripheralCloner(const GattProfile &prof) {
+    stopBLEStack();
+    vTaskDelay(pdMS_TO_TICKS(120));
+
+    if (!radioHasMemForBle()) radioFreeWiFiForBle();
+    if (!radioHasMemForBle()) {
+        displayError("Low RAM for BLE Cloner", true);
+        return;
+    }
+
+    String devName = prof.name;
+    if (devName.isEmpty() || devName == "<unnamed>") devName = "BruceClone";
+    if (devName.length() > 24) devName = devName.substring(0, 24);
+
+    BLEDevice::init(devName.c_str());
+    NimBLEServer *pSrv = BLEDevice::createServer();
+    if (!pSrv) {
+        displayError("BLE createServer failed", true);
+        stopBLEStack();
+        return;
+    }
+    pSrv->setCallbacks(&s_cloneSrvCb);
+    pSrv->advertiseOnDisconnect(true);
+
+    int builtSvcs = 0;
+    int builtChrs = 0;
+    String firstUserSvc;
+    std::vector<NimBLECharacteristic *> notifyChrs;
+
+    for (const auto &svcSnap : prof.services) {
+        if (isSystemServiceUuid(svcSnap.uuid)) continue;
+        NimBLEService *pSvc = pSrv->createService(svcSnap.uuid.c_str());
+        if (!pSvc) continue;
+        builtSvcs++;
+        if (firstUserSvc.isEmpty()) firstUserSvc = svcSnap.uuid;
+
+        for (const auto &chrSnap : prof.chars) {
+            if (chrSnap.svcUuid != svcSnap.uuid) continue;
+            uint32_t props = 0;
+            if (chrSnap.props & 0x01) props |= NIMBLE_PROPERTY::READ;
+            if (chrSnap.props & 0x02) props |= NIMBLE_PROPERTY::WRITE;
+            if (chrSnap.props & 0x04) props |= NIMBLE_PROPERTY::WRITE_NR;
+            if (chrSnap.props & 0x08) props |= NIMBLE_PROPERTY::NOTIFY;
+            if (chrSnap.props & 0x10) props |= NIMBLE_PROPERTY::INDICATE;
+            if (props == 0) props = NIMBLE_PROPERTY::READ | NIMBLE_PROPERTY::WRITE;
+
+            NimBLECharacteristic *pChr = pSvc->createCharacteristic(chrSnap.uuid.c_str(), props);
+            if (pChr) {
+                if (!chrSnap.val.empty()) pChr->setValue(chrSnap.val.data(), chrSnap.val.size());
+                pChr->setCallbacks(&s_cloneChrCb);
+                if (chrSnap.props & (0x08 | 0x10)) notifyChrs.push_back(pChr);
+                builtChrs++;
+            }
+        }
+        pSvc->start();
+    }
+
+    // Fallback dummy service if target only exposed 0x1800/0x1801
+    if (builtSvcs == 0) {
+        NimBLEService *pSvc = pSrv->createService("FFE0");
+        if (pSvc) {
+            NimBLECharacteristic *pChr =
+                pSvc->createCharacteristic("FFE1", NIMBLE_PROPERTY::READ | NIMBLE_PROPERTY::WRITE | NIMBLE_PROPERTY::NOTIFY);
+            if (pChr) {
+                pChr->setCallbacks(&s_cloneChrCb);
+                notifyChrs.push_back(pChr);
+            }
+            pSvc->start();
+            builtSvcs = 1;
+            builtChrs = 1;
+            firstUserSvc = "FFE0";
+        }
+    }
+
+    NimBLEAdvertising *pAdv = BLEDevice::getAdvertising();
+    if (pAdv) {
+        pAdv->enableScanResponse(true);
+        pAdv->setName(devName.c_str());
+        if (!prof.advUuids.empty()) {
+            pAdv->addServiceUUID(prof.advUuids[0].c_str());
+        } else if (!firstUserSvc.isEmpty()) {
+            pAdv->addServiceUUID(firstUserSvc.c_str());
+        }
+        if (!prof.mfrData.empty() && prof.mfrData.size() <= 20) {
+            pAdv->setManufacturerData(prof.mfrData);
+        }
+        pAdv->start();
+    }
+
+    s_activeMode = "CLONER";
+    s_activeTarget = devName;
+    s_cloneWrites = 0;
+    s_cloneClientConn = false;
+    setLastBleEvent("Advertising Clone (" + String(builtSvcs) + "S/" + String(builtChrs) + "C)");
+    ensureBleMux();
+    if (xSemaphoreTake(s_bleUiMux, pdMS_TO_TICKS(50)) == pdTRUE) {
+        s_recentWrites.clear();
+        xSemaphoreGive(s_bleUiMux);
+    }
+
+    tft_sprite frame(&tft);
+    frame.setColorDepth(16);
+    bool hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+
+    int writeScroll = 0;
+    bool showAscii = false;
+    uint32_t lastDraw = 0;
+    returnToMenu = false;
+
+    while (!returnToMenu) {
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+        if (check(PrevPress) || check(UpPress)) {
+            if (writeScroll > 0) writeScroll--;
+            lastDraw = 0;
+        }
+        if (check(NextPress) || check(DownPress)) {
+            writeScroll++;
+            lastDraw = 0;
+        }
+        if (check(SelPress)) {
+            if (hasSprite) {
+                frame.deleteSprite();
+                hasSprite = false;
+            }
+            int cact = -1;
+            options.clear();
+            if (!notifyChrs.empty()) {
+                options.push_back({"Send Notify Test", [&]() { cact = 0; }});
+            }
+            options.push_back({showAscii ? "View: HEX Payload" : "View: ASCII Payload", [&]() { cact = 1; }});
+            options.push_back({"Clear Write Log", [&]() { cact = 2; }});
+            options.push_back({"Stop Cloner & Exit", [&]() { cact = 3; }});
+            loopOptions(options, MENU_TYPE_SUBMENU, "GATT Cloner Menu");
+            options.clear();
+
+            if (cact == 0) {
+                int sent = 0;
+                const uint8_t pingData[5] = {0x42, 0x52, 0x55, 0x43, 0x45}; // "BRUCE"
+                for (NimBLECharacteristic *nc : notifyChrs) {
+                    if (nc) {
+                        nc->setValue(pingData, sizeof(pingData));
+                        if (nc->notify()) sent++;
+                    }
+                }
+                setLastBleEvent("Notified " + String(sent) + " char(s)");
+            } else if (cact == 1) {
+                showAscii = !showAscii;
+            } else if (cact == 2) {
+                ensureBleMux();
+                if (xSemaphoreTake(s_bleUiMux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                    s_recentWrites.clear();
+                    xSemaphoreGive(s_bleUiMux);
+                }
+                writeScroll = 0;
+            } else if (cact == 3) {
+                returnToMenu = true;
+                break;
+            }
+            hasSprite = (frame.createSprite(tftWidth, tftHeight) != nullptr);
+            lastDraw = 0;
+        }
+        if (millis() - lastDraw >= 180) {
+            lastDraw = millis();
+            if (hasSprite) {
+                const uint16_t bg = bruceConfig.bgColor;
+                const uint16_t pri = bruceConfig.priColor;
+                const uint16_t sec = bruceConfig.secColor;
+                const uint16_t okCol = 0x2F2F;
+                const uint16_t warnCol = 0xFD84;
+
+                frame.fillScreen(bg);
+                frame.fillRect(0, 0, tftWidth, 24, blendColors(bg, pri, 28));
+                frame.setTextSize(1);
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(pri, blendColors(bg, pri, 28));
+                frame.drawString("BLE GATT CLONER", 8, 12);
+                frame.setTextDatum(MR_DATUM);
+                frame.setTextColor(s_cloneClientConn ? okCol : warnCol, blendColors(bg, pri, 28));
+                frame.drawString(s_cloneClientConn ? "APP CONN" : "ADV LIVE", tftWidth - 8, 12);
+
+                frame.fillRoundRect(8, 30, tftWidth - 16, 46, 6, blendColors(bg, pri, 12));
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(TFT_WHITE, blendColors(bg, pri, 12));
+                frame.drawString("Clone: " + devName + " (" + String(builtSvcs) + "S/" + String(builtChrs) + "C)", 16, 44);
+                frame.setTextColor(sec, blendColors(bg, pri, 12));
+                frame.drawString(
+                    "Writes:" + String((unsigned long)s_cloneWrites) + "  [" + (showAscii ? "ASCII" : "HEX") + "]",
+                    16,
+                    62
+                );
+
+                frame.setTextDatum(ML_DATUM);
+                frame.setTextColor(pri, bg);
+                frame.drawString("INCOMING APP WRITES:", 10, 90);
+
+                ensureBleMux();
+                std::vector<WriteLogItem> snap;
+                if (xSemaphoreTake(s_bleUiMux, pdMS_TO_TICKS(30)) == pdTRUE) {
+                    snap = s_recentWrites;
+                    xSemaphoreGive(s_bleUiMux);
+                }
+
+                if (snap.empty()) {
+                    writeScroll = 0;
+                    frame.setTextDatum(MC_DATUM);
+                    frame.setTextColor(sec, bg);
+                    frame.drawString("Waiting for target app to connect", tftWidth / 2, 145);
+                    frame.drawString("& write to cloned characteristics", tftWidth / 2, 162);
+                } else {
+                    int maxScroll = std::max(0, (int)snap.size() - 5);
+                    if (writeScroll > maxScroll) writeScroll = maxScroll;
+                    int y = 104;
+                    int shown = 0;
+                    for (int i = (int)snap.size() - 1 - writeScroll; i >= 0 && shown < 5; i--, shown++) {
+                        frame.fillRoundRect(8, y, tftWidth - 16, 21, 3, blendColors(bg, pri, 8));
+                        frame.setTextDatum(ML_DATUM);
+                        frame.setTextColor(warnCol, blendColors(bg, pri, 8));
+                        frame.drawString(snap[i].chrUuid.substring(0, 10), 12, y + 10);
+                        frame.setTextColor(TFT_WHITE, blendColors(bg, pri, 8));
+                        const String &payload = showAscii && !snap[i].ascii.isEmpty() ? snap[i].ascii : snap[i].hex;
+                        frame.drawString(payload.substring(0, 26), 84, y + 10);
+                        y += 23;
+                    }
+                }
+
+                frame.fillRect(0, tftHeight - 20, tftWidth, 20, blendColors(bg, pri, 14));
+                frame.setTextDatum(MC_DATUM);
+                frame.setTextColor(sec, blendColors(bg, pri, 14));
+                frame.drawString("Vol-/+:Scroll   Boot:Menu/Notify   Hold:Stop", tftWidth / 2, tftHeight - 10);
+                frame.pushSprite(0, 0);
+                tft.markUnmappedPixels();
+            }
+            wakeUpScreen();
+        }
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+
+    if (hasSprite) frame.deleteSprite();
+    stopBLEStack();
+    s_activeMode = "IDLE";
+    tft.fillScreen(bruceConfig.bgColor);
+}
