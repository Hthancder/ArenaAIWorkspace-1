+bool smartBadUsbIsLedLinkRunning() { return false; }
+void smartBadUsbClearLedLink() {}
+bool smartBadUsbExportLedLink() { return false; }
+String smartBadUsbGetLedLinkStateJson() { return "{}"; }
+void smartBadUsbMouseJiggler(uint32_t, uint16_t, bool, String *errOut) { if (errOut) *errOut = "LITE build"; }
+void smartBadUsbEnsureLedEvents() {}
+uint8_t smartBadUsbLedState() { return 0; }
+bool smartBadUsbWaitLock(bool, uint32_t) { return false; }
