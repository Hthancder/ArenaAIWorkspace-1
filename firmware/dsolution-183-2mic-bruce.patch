+static std::vector<NaptClientInfo> queryApClients() {
+    std::vector<NaptClientInfo> out;
+    wifi_sta_list_t staList = {};
+    if (esp_wifi_ap_get_sta_list(&staList) != ESP_OK || staList.num == 0) return out;
+    esp_netif_t *apNetif = esp_netif_get_handle_from_ifkey("WIFI_AP_DEF");
+    esp_netif_pair_mac_ip_t pairs[10] = {};
+    int count = std::min<int>(staList.num, 10);
+    if (apNetif) {
+        for (int i = 0; i < count; i++) memcpy(pairs[i].mac, staList.sta[i].mac, 6);
+        esp_netif_dhcps_get_clients_by_mac(apNetif, count, pairs);
+    }
+    for (int i = 0; i < count; i++) {
+        NaptClientInfo c;
+        char macBuf[20];
+        const uint8_t *m = staList.sta[i].mac;
+        snprintf(macBuf, sizeof(macBuf), "%02X:%02X:%02X:%02X:%02X:%02X", m[0], m[1], m[2], m[3], m[4], m[5]);
+        c.mac = macBuf;
+        IPAddress ip(pairs[i].ip.addr);
+        c.ip = ((uint32_t)ip != 0) ? ip.toString() : String("DHCP...");
+        c.rssi = staList.sta[i].rssi;
+        out.push_back(c);
+    }
+    return out;
+}
+
+static bool pickStaNetworkInteractive(String &outSsid, String &outPwd) {
+    drawMainBorderWithTitle("Travel Router Uplink");
+    padprintln("");
+    padprintln("Scanning 2.4 GHz Wi-Fi...");
+    ensureWifiPlatform();
+    WiFi.mode(WIFI_STA);
+    int n = WiFi.scanNetworks();
+    struct NetPick {
+        String ssid;
+        int rssi;
+        bool enc;
+        bool saved;
+    };
+    std::vector<NetPick> list;
+    for (int i = 0; i < n; i++) {
+        String s = WiFi.SSID(i);
+        if (s.isEmpty()) continue;
+        int r = WiFi.RSSI(i);
+        bool enc = WiFi.encryptionType(i) != WIFI_AUTH_OPEN;
+        bool dup = false;
+        for (auto &x : list) {
+            if (x.ssid == s) {
+                if (r > x.rssi) x.rssi = r;
+                dup = true;
+                break;
+            }
+        }
+        if (!dup) list.push_back({s, r, enc, bruceConfig.hasWifiCredential(s)});
+    }
+    WiFi.scanDelete();
+    std::sort(list.begin(), list.end(), [](const NetPick &a, const NetPick &b) { return a.rssi > b.rssi; });
+    if (list.size() > 16) list.resize(16);
+
+    if (list.empty()) {
+        displayError("No Wi-Fi found", true);
+        return false;
+    }
+
+    int chosen = -1;
+    options.clear();
+    for (size_t i = 0; i < list.size(); i++) {
+        String tag = list[i].saved ? "*" : (list[i].enc ? "+" : " ");
+        String lbl = tag + list[i].ssid.substring(0, 15) + " " + String(list[i].rssi);
+        options.push_back({lbl, [&, i]() { chosen = (int)i; }});
+    }
+    options.push_back({"Cancel", [&]() { chosen = -1; }});
+    loopOptions(options, MENU_TYPE_SUBMENU, "Pick Uplink Wi-Fi");
+    options.clear();
+    if (chosen < 0) return false;
+
+    outSsid = list[chosen].ssid;
+    outPwd = bruceConfig.getWifiPassword(outSsid);
+    if (outPwd.isEmpty() && list[chosen].enc) {
+        outPwd = keyboard("", 63, "Password: " + outSsid, true);
+        if (outPwd == "\x1B") return false;
+    }
+    return true;
+}
