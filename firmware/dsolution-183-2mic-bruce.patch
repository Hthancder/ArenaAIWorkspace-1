+    if (errOut) *errOut = "USB HID not enabled";
+}
+
+#endif // USB_as_HID
+
+void smart_badusb_setup() {
+    int choice = -1;
+    BadUsbOsProfile profile = smartBadUsbGetOsProfile();
+    bool permissionCheck = bruceConfig.seclabPlus.badUsbPermissionCheck;
+    bool autoArm = bruceConfig.seclabPlus.hidLedAutoArm;
+    options = {
+        {"OS Profile: " + profileLabel(profile), [&]() { choice = 0; }},
+        {String("Permission check: ") + (permissionCheck ? "ON" : "OFF"), [&]() { choice = 1; }},
+        {"Run LED Link (arm + payload)", [&]() { choice = 2; }},
+        {smartBadUsbIsLedLinkRunning() ? "Stop LED Link Receiver" : "Start LED Link Receiver", [&]() { choice = 3; }},
+        {"Generate Payload Files", [&]() { choice = 4; }},
+        {"View Last Exfil", [&]() { choice = 5; }},
+        {"Mouse Jiggler (60s)", [&]() { choice = 6; }},
+        {"Click Script Demo (60s)", [&]() { choice = 7; }},
+        {String("Auto-arm LED Link: ") + (autoArm ? "ON" : "OFF"), [&]() { choice = 8; }},
+        {String("LED timeout: ") + bruceConfig.seclabPlus.hidLedTimeoutSec + "s", [&]() { choice = 9; }},
+        {String("First-run OS warning: ") + (bruceConfig.seclabPlus.badUsbOsWarn ? "ON" : "OFF"), [&]() { choice = 10; }},
+        {"Clear / Export", [&]() { choice = 11; }},
+        {"Back", [&]() { choice = 12; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "Smart BadUSB Suite");
+    options.clear();
+
+    if (choice == 0) {
+        options = {
+            {"Windows", [&]() { profile = BADUSB_OS_WINDOWS; }},
+            {"macOS", [&]() { profile = BADUSB_OS_MACOS; }},
+            {"Linux", [&]() { profile = BADUSB_OS_LINUX; }},
+        };
+        loopOptions(options, MENU_TYPE_SUBMENU, "Quick OS Profile");
+        options.clear();
+        smartBadUsbSetOsProfile(profile);
+        displayInfo("Profile: " + profileLabel(profile), true);
+        return;
+    }
+    if (choice == 1) {
+        bruceConfig.seclabPlus.badUsbPermissionCheck = !permissionCheck;
+        bruceConfig.saveFile();
+        displayInfo(String("Permission check ") + (bruceConfig.seclabPlus.badUsbPermissionCheck ? "ON" : "OFF"), true);
+        return;
+    }
+    if (choice == 2) {
+        String err;
+        if (!smartBadUsbRunPayload(profile, permissionCheck, &err)) displayError("Run failed: " + err, true);
+        else displaySuccess("Payload sent. Keep LED receiver armed.", true);
+        return;
+    }
+    if (choice == 3) {
+        if (smartBadUsbIsLedLinkRunning()) smartBadUsbStopLedLink();
+        else {
+            String err;
+            if (!smartBadUsbStartLedLink(0, &err)) displayError("Receiver failed: " + err, true);
+            else displayInfo("LED Link armed. Run payload now.", true);
+        }
+        return;
+    }
+    if (choice == 4) {
+        String p, err;
+        if (smartBadUsbGeneratePayload(profile, permissionCheck, &p, &err)) {
+            writeWaitDemo();
+            displayInfo("Saved " + p + " + WAIT demo", true);
+        } else displayError("Generate failed: " + err, true);
+        return;
+    }
+    if (choice == 5) {
+        if (LittleFS.exists(kExfilPath)) loopSD(LittleFS, false, "*", "/led_link");
+        else displayInfo("No exfil yet", true);
+        return;
+    }
+    if (choice == 6) { smartBadUsbMouseJiggler(60, 1200, false); return; }
+    if (choice == 7) { smartBadUsbMouseJiggler(60, 900, true); return; }
+    if (choice == 8) {
+        bruceConfig.seclabPlus.hidLedAutoArm = !autoArm;
+        bruceConfig.saveFile();
+        displayInfo(String("Auto-arm ") + (bruceConfig.seclabPlus.hidLedAutoArm ? "ON" : "OFF"), true);
+        return;
+    }
+    if (choice == 9) {
+        String v = num_keyboard(String(bruceConfig.seclabPlus.hidLedTimeoutSec), 3, "LED timeout (3-300s)");
+        if (v != "\x1B" && !v.isEmpty()) {
+            long n = v.toInt();
+            if (n < 3) n = 3;
+            if (n > 300) n = 300;
+            bruceConfig.seclabPlus.hidLedTimeoutSec = (uint16_t)n;
+            bruceConfig.validateSecLabPlus();
+            bruceConfig.saveFile();
+            displayInfo(String("LED timeout: ") + bruceConfig.seclabPlus.hidLedTimeoutSec + "s", true);
+        }
+        return;
+    }
+    if (choice == 10) {
+        bruceConfig.seclabPlus.badUsbOsWarn = !bruceConfig.seclabPlus.badUsbOsWarn;
+        bruceConfig.saveFile();
+        displayInfo(String("First-run OS warning ") + (bruceConfig.seclabPlus.badUsbOsWarn ? "ON" : "OFF"), true);
+        return;
+    }
+    if (choice == 11) {
+        smartBadUsbExportLedLink();
+        smartBadUsbClearLedLink();
+        displayInfo("Exported then cleared", true);
+        return;
+    }
+}
