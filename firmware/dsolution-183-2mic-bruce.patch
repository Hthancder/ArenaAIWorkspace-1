+namespace {
+
+constexpr uint32_t kSonarRate = 48000;
+constexpr size_t kSonarFrames = 512; // ~10.67 ms per stereo frame block
+constexpr int kMaxSonarHistory = 24;
+
+enum SonarActionMode {
+    SONAR_ACT_SIREN_LED = 0,
+    SONAR_ACT_SILENT_LOG = 1,
+    SONAR_ACT_AUTOREC_WAV = 2
+};
+
+enum SonarSensitivity {
+    SONAR_SENS_LOW = 0,
+    SONAR_SENS_MED = 1,
+    SONAR_SENS_HIGH = 2
+};
+
+struct SonarEventRec {
+    uint32_t tsSec;
+    uint8_t score;
+    int8_t dir;       // -1 left, 0 center, +1 right
+    bool approach;
+    char wavFile[40];
+};
+
+static i2s_chan_handle_t s_txChan = nullptr;
+static i2s_chan_handle_t s_rxChan = nullptr;
+static bool s_txCodecOn = false;
+
+static bool initFullDuplexSonarI2S() {
+    i2s_chan_config_t chanCfg = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);
+    chanCfg.dma_desc_num = 6;
+    chanCfg.dma_frame_num = kSonarFrames;
+    chanCfg.auto_clear = true;
+    if (i2s_new_channel(&chanCfg, &s_txChan, &s_rxChan) != ESP_OK) {
+        s_txChan = nullptr;
+        s_rxChan = nullptr;
+        return false;
+    }
+
+    gpio_num_t mclkPin = bruceConfigPins.speaker_bus.mclk != GPIO_NUM_NC
+                             ? bruceConfigPins.speaker_bus.mclk
+                             : I2S_GPIO_UNUSED;
+
+    i2s_std_config_t stdCfg = {
+        .clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(kSonarRate),
+        .slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_STEREO),
+        .gpio_cfg = {
+            .mclk = mclkPin,
+            .bclk = bruceConfigPins.speaker_bus.bclk,
+            .ws = bruceConfigPins.speaker_bus.ws,
+            .dout = bruceConfigPins.speaker_bus.dout,
+            .din = bruceConfigPins.mic_bus.data,
+            .invert_flags = {.mclk_inv = false, .bclk_inv = false, .ws_inv = false},
+        },
+    };
+#if !SOC_I2S_HW_VERSION_1
+    stdCfg.clk_cfg.clk_src = I2S_CLK_SRC_PLL_160M;
+#endif
+    stdCfg.clk_cfg.mclk_multiple = I2S_MCLK_MULTIPLE_256;
+
+    if (i2s_channel_init_std_mode(s_txChan, &stdCfg) != ESP_OK ||
+        i2s_channel_init_std_mode(s_rxChan, &stdCfg) != ESP_OK) {
+        i2s_del_channel(s_txChan);
+        i2s_del_channel(s_rxChan);
+        s_txChan = nullptr;
+        s_rxChan = nullptr;
+        return false;
+    }
+
+    _setup_codec_mic(true);
+    _setup_codec_speaker(true);
+    s_txCodecOn = true;
+
+    if (i2s_channel_enable(s_txChan) != ESP_OK || i2s_channel_enable(s_rxChan) != ESP_OK) {
+        _setup_codec_speaker(false);
+        _setup_codec_mic(false);
+        s_txCodecOn = false;
+        i2s_del_channel(s_txChan);
+        i2s_del_channel(s_rxChan);
+        s_txChan = nullptr;
+        s_rxChan = nullptr;
+        return false;
+    }
+    return true;
+}
+
+static void deinitFullDuplexSonarI2S() {
+    if (s_txCodecOn) {
+        _setup_codec_speaker(false);
+        s_txCodecOn = false;
+    }
+    _setup_codec_mic(false);
+    if (s_txChan) {
+        i2s_channel_disable(s_txChan);
+        i2s_del_channel(s_txChan);
+        s_txChan = nullptr;
+    }
+    if (s_rxChan) {
+        i2s_channel_disable(s_rxChan);
+        i2s_del_channel(s_rxChan);
+        s_rxChan = nullptr;
+    }
+}
+
+// Fast Goertzel power at target frequency (Hz) on channel offset (0=Left/MIC1, 1=Right/MIC2)
+static float goertzelStereo(const int16_t *stereo, size_t frames, float targetHz, int chOffset) {
+    float k = 0.5f + ((float)frames * targetHz) / (float)kSonarRate;
+    float w = (2.0f * (float)M_PI / (float)frames) * k;
+    float coeff = 2.0f * cosf(w);
+    float q0 = 0.0f, q1 = 0.0f, q2 = 0.0f;
+    for (size_t i = 0; i < frames; i++) {
+        // Apply Hann window cheaply via symmetric slope approximation or direct sample
+        float x = (float)stereo[i * 2 + chOffset] / 32768.0f;
+        q0 = coeff * q1 - q2 + x;
+        q2 = q1;
+        q1 = q0;
+    }
+    float pwr = q1 * q1 + q2 * q2 - q1 * q2 * coeff;
+    return pwr > 0.0f ? sqrtf(pwr) : 0.0f;
+}
+
+static void saveSonarStateAndLog(
+    bool armed, SonarActionMode actMode, SonarSensitivity sens, uint16_t carrierHz,
+    uint8_t curMotion, bool triggered, const std::vector<SonarEventRec> &events, const SonarEventRec *newEv
+) {
+    if (newEv) {
+        File lf = LittleFS.open("/sonar_guard.log", LittleFS.exists("/sonar_guard.log") ? FILE_APPEND : FILE_WRITE);
+        if (lf) {
+            const char *dirStr = (newEv->dir < 0) ? "LEFT" : ((newEv->dir > 0) ? "RIGHT" : "CENTER");
+            lf.printf(
+                "[%lus] MOTION score=%u%% dir=%s %s%s%s\n",
+                (unsigned long)newEv->tsSec,
+                (unsigned)newEv->score,
+                dirStr,
+                newEv->approach ? "APPROACH" : "RECEDE",
+                newEv->wavFile[0] ? " wav=" : "",
+                newEv->wavFile[0] ? newEv->wavFile : ""
+            );
+            lf.close();
+        }
+    }
+
+    File sf = LittleFS.open("/sonar_state.json", FILE_WRITE);
+    if (!sf) return;
+    const char *actName = (actMode == SONAR_ACT_SIREN_LED) ? "Siren+LED"
+                          : ((actMode == SONAR_ACT_SILENT_LOG) ? "Silent" : "AutoRec-WAV");
+    const char *sensName = (sens == SONAR_SENS_LOW) ? "Low" : ((sens == SONAR_SENS_MED) ? "Med" : "High");
+    sf.printf(
+        "{\"armed\":%s,\"triggered\":%s,\"action\":\"%s\",\"sens\":\"%s\",\"carrierHz\":%u,\"motion\":%u,\"events\":[",
+        armed ? "true" : "false",
+        triggered ? "true" : "false",
+        actName,
+        sensName,
+        (unsigned)carrierHz,
+        (unsigned)curMotion
+    );
+    int n = (int)events.size();
+    for (int i = 0; i < n; i++) {
+        const auto &e = events[n - 1 - i];
+        if (i > 0) sf.print(",");
+        sf.printf(
+            "{\"ts\":%lu,\"score\":%u,\"dir\":%d,\"approach\":%s,\"wav\":\"%s\"}",
+            (unsigned long)e.tsSec,
+            (unsigned)e.score,
+            (int)e.dir,
+            e.approach ? "true" : "false",
+            e.wavFile
+        );
+    }
+    sf.print("]}");
+    sf.close();
+}
+
+// Records ~6 seconds of 16 kHz mono WAV from MIC1 using the already-open RX stream while speaker is muted
+static String recordGuardClipWav(int16_t *rxBuf, int16_t *txSilence, uint32_t durationMs) {
+    if (!LittleFS.exists("/BruceMIC")) LittleFS.mkdir("/BruceMIC");
+    char path[40];
+    int idx = 0;
+    do {
+        snprintf(path, sizeof(path), "/BruceMIC/guard_%03d.wav", idx++);
+    } while (LittleFS.exists(path) && idx < 999);
+
+    File f = LittleFS.open(path, FILE_WRITE);
+    if (!f) return "";
+
+    // Silence speaker first so WAV has zero ultrasonic whine
+    if (s_txCodecOn) {
+        _setup_codec_speaker(false);
+        s_txCodecOn = false;
+    }
+
+    uint8_t wavHdr[44] = {
+        'R', 'I', 'F', 'F', 0, 0, 0, 0, 'W', 'A', 'V', 'E', 'f', 'm', 't', ' ',
+        16,  0,   0,   0,   1, 0, 1, 0, 0x80, 0x3E, 0, 0,  0, 0x7D, 0, 0, // 16000 Hz, 16-bit mono
+        2,   0,   16,  0,   'd', 'a', 't', 'a', 0, 0, 0, 0
+    };
+    f.write(wavHdr, 44);
+
+    // Flush a couple of blocks
+    for (int k = 0; k < 4; k++) {
+        size_t wr = 0, rd = 0;
+        i2s_channel_write(s_txChan, txSilence, kSonarFrames * 4, &wr, pdMS_TO_TICKS(40));
+        i2s_channel_read(s_rxChan, rxBuf, kSonarFrames * 4, &rd, pdMS_TO_TICKS(40));
+    }
+
+    uint32_t t0 = millis();
+    uint32_t dataBytes = 0;
+    int16_t monoDown[kSonarFrames / 3 + 4];
+    while ((millis() - t0) < durationMs) {
+        InputHandler();
+        if (check(EscPress)) {
+            returnToMenu = true;
+            break;
+        }
+        size_t wr = 0, rd = 0;
+        i2s_channel_write(s_txChan, txSilence, kSonarFrames * 4, &wr, pdMS_TO_TICKS(40));
+        if (i2s_channel_read(s_rxChan, rxBuf, kSonarFrames * 4, &rd, pdMS_TO_TICKS(60)) == ESP_OK && rd >= 12) {
+            size_t frames = rd / 4;
+            size_t outN = 0;
+            // 48 kHz -> 16 kHz (3:1 decimation with simple 3-tap boxcar + 2.2x gain)
+            for (size_t i = 0; i + 2 < frames; i += 3) {
+                int32_t avg = ((int32_t)rxBuf[i * 2] + (int32_t)rxBuf[(i + 1) * 2] + (int32_t)rxBuf[(i + 2) * 2]) / 3;
+                avg = (avg * 22) / 10;
+                if (avg > 32767) avg = 32767;
+                if (avg < -32768) avg = -32768;
+                monoDown[outN++] = (int16_t)avg;
+            }
+            if (outN > 0) {
+                f.write((const uint8_t *)monoDown, outN * sizeof(int16_t));
+                dataBytes += (uint32_t)(outN * sizeof(int16_t));
+            }
+        }
+    }
+
+    uint32_t riffSize = dataBytes + 36;
+    f.seek(4);
+    f.write((const uint8_t *)&riffSize, 4);
+    f.seek(40);
+    f.write((const uint8_t *)&dataBytes, 4);
+    f.close();
+
+    // Re-enable speaker for sonar
+    _setup_codec_speaker(true);
+    s_txCodecOn = true;
+    return String(path);
+}
+
+static void playSirenBurst(int16_t *txBuf, int16_t *rxBuf) {
+    float phase = 0.0f;
+    for (int burst = 0; burst < 4; burst++) {
+        float freq = (burst & 1) ? 2600.0f : 1950.0f;
+        float inc = 2.0f * (float)M_PI * freq / (float)kSonarRate;
+        setLedColor((burst & 1) ? CRGB::Red : CRGB::Blue);
+        for (int blk = 0; blk < 14; blk++) {
+            for (size_t i = 0; i < kSonarFrames; i++) {
+                int16_t s = (int16_t)(sinf(phase) * 14000.0f);
+                txBuf[i * 2] = s;
+                txBuf[i * 2 + 1] = s;
+                phase += inc;
+                if (phase > 2.0f * (float)M_PI) phase -= 2.0f * (float)M_PI;
+            }
+            size_t wr = 0, rd = 0;
+            i2s_channel_write(s_txChan, txBuf, kSonarFrames * 4, &wr, pdMS_TO_TICKS(40));
+            i2s_channel_read(s_rxChan, rxBuf, kSonarFrames * 4, &rd, pdMS_TO_TICKS(40));
+        }
+    }
+    setLedColor(CRGB::Black);
+}
