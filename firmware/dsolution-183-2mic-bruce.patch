@@ -0,0 +1,625 @@
+// =====================================================================================
+//  boards/dsolution-183-2mic/interface.cpp
+//
+//  DSolution 1.83" 2-Mic -- ESP32-S3, NV3023 240x284 IPS, ES7210 mic ADC + ES8311
+//  speaker DAC + NS4150 amplifier, WS2812 on GPIO48.
+//
+//  What this file does, in boot order:
+//    _setup_gpio()        runtime pin defaults (I2C / I2S / IR / RF), PA Enable LOW at idle,
+//                         sleep control HIGH, charge detect input, button HAL
+//    _post_setup_gpio()   backlight PWM (needs the TFT to be initialised first)
+//    _late_setup_gpio()   puts ES8311 + ES7210 codecs into low-power standby until used
+//    InputHandler()       3-button poll (Vol- = Prev, Vol+ = Next, Boot = Sel)
+//    _setup_codec_speaker()   ES8311 register bring-up (0x18) -> PA Enable HIGH
+//    _setup_codec_mic()       ES7210 register bring-up (0x40)
+//    getBattery() / getBatteryMv()   ADC2-filtered battery telemetry
+//    isCharging() / powerOff() / enterBootloaderMode()
+//
+//  The display is configured entirely by the .ini (LovyanGFX panel class
+//  NV3023_Panel.h); nothing display-related is needed here.
+// =====================================================================================
+
+#include "core/bus_HAL.h"
+#include "core/display.h"
+#include "core/powerSave.h"
+#include "core/utils.h"
+#include "hal/bright/bright.h"
+#include "hal/device.h"
+#include "soc/rtc_cntl_reg.h"
+#include <Wire.h>
+#include <algorithm>
+#include <esp_sleep.h>
+#include <esp_system.h>
+#include <globals.h>
+#include <interface.h>
+
+// -------------------------------------------------------------------------------------
+//  Wiring (vendor pinout)
+// -------------------------------------------------------------------------------------
+#define PIN_I2C_SDA 12 // codec control bus (ES7210 + ES8311)
+#define PIN_I2C_SCL 11
+
+#define PIN_I2S_MCLK 5  // 6.144 MHz at 24 kHz; 12.288 MHz at 48 kHz (ratio 256)
+#define PIN_I2S_BCLK 15
+#define PIN_I2S_WS 16
+#define PIN_I2S_DIN 7  // ES7210 -> ESP32 (mic data)
+#define PIN_I2S_DOUT 6 // ESP32 -> ES8311 (speaker data)
+#define PIN_PA_ENABLE 4 // NS4150 enable: HIGH = speaker on (mandatory)
+
+#define PIN_BTN_PREV 40 // Volume down
+#define PIN_BTN_NEXT 39 // Volume up
+#define PIN_BTN_SEL 0   // Boot
+
+#define PIN_CHARGE_DETECT 47 // charger status in (active LOW on most charger ICs)
+#define PIN_BAT_ADC 17       // battery divider -> ADC2 channel 6 (1:2), *not* GPIO38
+#define PIN_SLEEP_CTRL 21    // from the vendor sheet; not driven by default (see _setup_gpio)
+
+// Codec I2C addresses (7-bit)
+#define ES8311_ADDR 0x18
+#define ES7210_ADDR 0x40
+
+// -------------------------------------------------------------------------------------
+//  Buttons -- Full-coverage 3-button multi-gesture driver (HAS_6_BUTTONS):
+//    Vol- (GPIO40): Tap = Prev, Hold (360ms+) = Up (repeats 130ms)
+//    Vol+ (GPIO39): Tap = Next, Hold (360ms+) = Down (repeats 130ms)
+//    Boot (GPIO0):  Tap = Sel,  Hold (520ms+) = Esc (1-shot)
+//    Combos:        Boot+Vol- = PrevPage, Boot+Vol+ = NextPage, Vol-+Vol+ = Esc
+// -------------------------------------------------------------------------------------
+namespace {
+struct DSolutionBtn {
+    uint8_t pin;
+    bool stableDown = false;
+    bool rawLast = false;
+    uint32_t rawChangedAt = 0;
+    uint32_t downAt = 0;
+    uint32_t lastRepeatAt = 0;
+    bool holdFired = false;
+    bool consumed = false;
+};
+
+static DSolutionBtn s_btnPrev{PIN_BTN_PREV};
+static DSolutionBtn s_btnNext{PIN_BTN_NEXT};
+static DSolutionBtn s_btnSel{PIN_BTN_SEL};
+static bool s_swallowWake = false;
+static uint32_t s_lastComboAt = 0;
+
+constexpr uint32_t kBtnDebounceMs = 20;
+constexpr uint32_t kNavHoldMs = 360;
+constexpr uint32_t kNavRepeatMs = 130;
+constexpr uint32_t kEscHoldMs = 520;
+constexpr uint32_t kComboRepeatMs = 250;
+
+static void initButtons3() {
+    pinMode(PIN_BTN_PREV, INPUT_PULLUP);
+    pinMode(PIN_BTN_NEXT, INPUT_PULLUP);
+    pinMode(PIN_BTN_SEL, INPUT_PULLUP);
+}
+
+static void updateBtnDebounce(DSolutionBtn &b, uint32_t now, bool &justPressed, bool &justReleased) {
+    justPressed = false;
+    justReleased = false;
+    bool raw = (digitalRead(b.pin) == LOW);
+    if (raw != b.rawLast) {
+        b.rawLast = raw;
+        b.rawChangedAt = now;
+    }
+    if ((now - b.rawChangedAt) >= kBtnDebounceMs && raw != b.stableDown) {
+        b.stableDown = raw;
+        if (raw) {
+            b.downAt = now;
+            b.lastRepeatAt = now;
+            b.holdFired = false;
+            b.consumed = false;
+            justPressed = true;
+        } else {
+            justReleased = true;
+        }
+    }
+}
+} // namespace
+
+// =====================================================================================
+//  Codec helpers
+// =====================================================================================
+
+static void codecWrite(uint8_t addr, uint8_t reg, uint8_t value) {
+    TwoWire *wire = getSysI2CBus();
+    if (!wire) return;
+    wire->beginTransmission(addr);
+    wire->write(reg);
+    wire->write(value);
+    wire->endTransmission();
+}
+
+static inline void es8311Write(uint8_t reg, uint8_t value) { codecWrite(ES8311_ADDR, reg, value); }
+static inline void es7210Write(uint8_t reg, uint8_t value) { codecWrite(ES7210_ADDR, reg, value); }
+
+// -------------------------------------------------------------------------------------
+//  ES8311 (speaker DAC)
+//
+//  I2S slave, 16-bit, MCLK taken from the MCLK pin with a 256 x fs ratio (vendor:
+//  6.144 MHz at 24 kHz). The register values mirror the ES8311 bring-up already used by
+//  boards/ES3C28P, which runs this chip at that same 256 x fs ratio.
+// -------------------------------------------------------------------------------------
+static void es8311Init() {
+    es8311Write(0x00, 0x1F); // reset
+    delay(20);
+    es8311Write(0x00, 0x00); // release reset
+    es8311Write(0x00, 0x80); // power on
+
+    es8311Write(0x01, 0x3F); // all clocks on, MCLK from the MCLK pin
+    es8311Write(0x02, 0x00); // pre_div = 1, pre_multi = 1x  -> 256 x fs
+    es8311Write(0x03, 0x10); // ADC OSR
+    es8311Write(0x04, 0x10); // DAC OSR
+    es8311Write(0x05, 0x00); // ADC/DAC clock divider = 1
+    es8311Write(0x06, 0x03); // BCLK divider (master mode only)
+    es8311Write(0x07, 0x00); // LRCK divider high
+    es8311Write(0x08, 0xFF); // LRCK divider low
+
+    es8311Write(0x09, 0x0C); // SDP in : 16-bit I2S
+    es8311Write(0x0A, 0x0C); // SDP out: 16-bit I2S
+
+    es8311Write(0x0D, 0x01); // power up analog
+    es8311Write(0x0E, 0x02); // analog PGA / modulator
+    es8311Write(0x12, 0x00); // power up DAC
+    es8311Write(0x13, 0x10); // enable HP drive output
+    es8311Write(0x1C, 0x6A); // ADC EQ bypass / DC offset cancel
+    es8311Write(0x37, 0x08); // bypass DAC equaliser
+
+    es8311Write(0x32, 0xBF); // DAC digital volume: 0 dB (software volume scales this)
+}
+
+// -------------------------------------------------------------------------------------
+//  ES7210 (2-mic ADC, with the ES8311 output looped back on MIC3 as the AEC reference)
+//
+//  Sequence and clock coefficients are the ones from Espressif's esp_codec_dev driver:
+//  software reset, high-pass filters, analog power, I2S format, sample-rate dividers
+//  for MCLK = 256 x fs, mic gains, then power-on.
+//
+//  Bruce's microphone path runs at 48 kHz, so MCLK is 12.288 MHz (coefficient
+//  {12288000, 48000, adc_div 1, dll on, doubler on, osr 0x20, lrck 0x01/0x00}).
+//  Same 256 x fs rule as the vendor's 24 kHz / 6.144 MHz pair.
+// -------------------------------------------------------------------------------------
+static void es7210Init() {
+    // --- reset + high-pass filters ---
+    es7210Write(0x00, 0xFF); // software reset
+    es7210Write(0x00, 0x32);
+    es7210Write(0x01, 0x3F); // ADC clocks off while configuring
+    es7210Write(0x09, 0x30);
+    es7210Write(0x0A, 0x30);
+    es7210Write(0x23, 0x2A); // HPF, ADC1/2
+    es7210Write(0x22, 0x0A);
+    es7210Write(0x20, 0x0A); // HPF, ADC3/4
+    es7210Write(0x21, 0x2A);
+
+    // --- slave I2S (bit0 = 0) ---
+    es7210Write(0x08, 0x00);
+
+    // --- analog power + mic bias ---
+    es7210Write(0x40, 0xC3);
+    es7210Write(0x41, 0x70); // MIC1/2 bias
+    es7210Write(0x42, 0x70); // MIC3/4 bias
+
+    // --- data format: 16-bit, MIC1/2 on SDOUT1 ---
+    es7210Write(0x11, 0x60);
+    es7210Write(0x12, 0x00);
+
+    // --- clock dividers for MCLK = 12.288 MHz / fs = 48 kHz ---
+    es7210Write(0x02, 0x01 | 0x40 | 0x80); // adc_div 1, doubler on, dll on  -> 0xC1
+    es7210Write(0x07, 0x20);               // OSR
+    es7210Write(0x04, 0x01);               // LRCK divider high
+    es7210Write(0x05, 0x00);               // LRCK divider low
+
+    // --- mic power + enable ---
+    es7210Write(0x47, 0x08);
+    es7210Write(0x48, 0x08);
+    es7210Write(0x49, 0x08);
+    es7210Write(0x4A, 0x08);
+    es7210Write(0x06, 0x04); // power down DLL (as the Espressif driver does)
+    es7210Write(0x4B, 0x0F); // MIC1/2 bias + ADC + PGA on
+    es7210Write(0x4C, 0x0F); // MIC3/4 bias + ADC + PGA on
+    es7210Write(0x00, 0x71);
+    es7210Write(0x00, 0x41); // device enabled
+
+    // --- gains: MIC1/MIC2 = 24 dB (reg value 8), MIC3 (AEC reference) = 0 dB ---
+    // Bit 4 of each gain register selects the differential input pair.
+    es7210Write(0x43, 0x10 | 8); // MIC1
+    es7210Write(0x44, 0x10 | 8); // MIC2
+    es7210Write(0x45, 0x10 | 0); // MIC3 -- ES8311 echo reference, unity gain
+    es7210Write(0x46, 0x10 | 0); // MIC4 -- unused
+}
+
+// =====================================================================================
+//  Codec hooks called by the audio modules (weak defaults in src/modules/others/*.cpp)
+// =====================================================================================
+
+static volatile bool s_speakerActive = false;
+
+bool isSpeakerActive() { return s_speakerActive; }
+
+/*********************************************************************
+** Function: _setup_codec_speaker
+** Enables / disables the speaker path.
+**
+** The order here is the vendor's mandatory one: the codec is configured over I2C
+** first, and the amplifier (PA Enable, GPIO4) is only driven HIGH afterwards. At idle
+** GPIO4 stays LOW so the NS4150 amp draws near-zero quiescent current and stays silent.
+**********************************************************************/
+void _setup_codec_speaker(bool enable) {
+    if (enable) {
+        s_speakerActive = true;
+        es8311Init();
+        delay(10);
+        digitalWrite(PIN_PA_ENABLE, HIGH); // NS4150: HIGH = amplified output on
+    } else {
+        digitalWrite(PIN_PA_ENABLE, LOW);
+        es8311Write(0x0D, 0xFC); // power down the analog block
+        es8311Write(0x01, 0x00); // gate codec clocks
+        es8311Write(0x00, 0x00); // hold the codec in reset
+        s_speakerActive = false;
+    }
+}
+
+/*********************************************************************
+** Function: _setup_codec_mic
+** Enables / disables the ES7210 microphone ADC.
+**********************************************************************/
+void _setup_codec_mic(bool enable) {
+    if (enable) {
+        es7210Init();
+    } else {
+        es7210Write(0x4B, 0x00); // MIC1/2 bias + ADC off
+        es7210Write(0x4C, 0x00); // MIC3/4 bias + ADC off
+        es7210Write(0x01, 0x3F); // gate ADC clocks
+        es7210Write(0x00, 0x00); // reset / power down
+    }
+}
+
+// =====================================================================================
+//  Setup
+// =====================================================================================
+
+/***************************************************************************************
+** Function name: _setup_gpio()
+** Description:   first stage -- pins, buses, input HAL. Runs before the display,
+**                the filesystem and brucePins.conf.
+***************************************************************************************/
+void _setup_gpio() {
+#ifdef DSOLUTION_LATCH_PIN
+    // First instruction on purpose: if this board latches its own power rail, giving the
+    // pin up costs the whole board, and USB re-enumerating in a loop is what that looks
+    // like from the host side.
+    pinMode(DSOLUTION_LATCH_PIN, OUTPUT);
+    digitalWrite(DSOLUTION_LATCH_PIN, HIGH);
+#endif
+
+    Serial.begin(115200);
+    Serial.println("[board] DSolution 1.83 2-Mic: NV3023 + ES7210/ES8311");
+
+    // ---- I2C: codec control bus (100 kHz, the vendor's recommended speed) ----
+    bruceConfigPins.sys_i2c = {(gpio_num_t)PIN_I2C_SDA, (gpio_num_t)PIN_I2C_SCL};
+    setSysI2CBus(&Wire);
+
+    // No second, user-facing I2C header on this board: the only exposed pins are the
+    // two volume buttons. Pointing i2c_bus at the codec bus keeps the Config > I2C
+    // menus usable (shared sys/i2c pins are handled by bus_HAL).
+    bruceConfigPins.i2c_bus = {(gpio_num_t)PIN_I2C_SDA, (gpio_num_t)PIN_I2C_SCL};
+
+    // ---- Audio ----
+    // Speaker: {bclk, ws/LRCK, dout, mclk}. MCLK comes from the ESP32 (the ES8311 is an
+    // I2S slave) at 256 x fs.
+    bruceConfigPins.speaker_bus = {
+        (gpio_num_t)PIN_I2S_BCLK, (gpio_num_t)PIN_I2S_WS, (gpio_num_t)PIN_I2S_DOUT, (gpio_num_t)PIN_I2S_MCLK
+    };
+    // Microphone: {clk/bclk, data/din, ws, type}. The ES7210 is an I2S ADC feeding DIN.
+    bruceConfigPins.mic_bus = {
+        (gpio_num_t)PIN_I2S_BCLK, (gpio_num_t)PIN_I2S_DIN, (gpio_num_t)PIN_I2S_WS, MIC_TYPE_I2S_MSB
+    };
+
+    // ---- Amplifier enable: keep LOW at idle to save power & eliminate amp hiss ----
+    pinMode(PIN_PA_ENABLE, OUTPUT);
+    digitalWrite(PIN_PA_ENABLE, LOW);
+
+    // ---- Power / sleep control ----
+    // Already driven at the top of this function (see DSOLUTION_LATCH_PIN); nothing left
+    // to do here, and powerOff() releases it.
+
+    // ---- Charge detect + battery status ----
+    pinMode(PIN_CHARGE_DETECT, INPUT_PULLUP);
+    pinMode(PIN_BAT_ADC, INPUT);
+
+    // ---- Buttons ----
+    initButtons3();
+
+    // ---- No expansion header on this board: leave IR/RF/UART unset ----
+    bruceConfigPins.irTx = GPIO_NUM_NC;
+    bruceConfigPins.irRx = GPIO_NUM_NC;
+    bruceConfigPins.rfTx = GPIO_NUM_NC;
+    bruceConfigPins.rfRx = GPIO_NUM_NC;
+}
+
+/***************************************************************************************
+** Function name: _pre_storage_gpio()
+** Description:   runs after the first TFT use, before LittleFS/SD are mounted.
+***************************************************************************************/
+void _pre_storage_gpio() {}
+
+/***************************************************************************************
+** Function name: _post_setup_gpio()
+** Description:   display + storage are up: backlight and anything sharing their buses.
+***************************************************************************************/
+void _post_setup_gpio() {
+    // Backlight on GPIO13, PWM through the shared brightness HAL. main.cpp applies the
+    // user's saved brightness right after this returns; 100% here only covers boot.
+    hal_bright_attach(TFT_BL);
+    hal_bright_set(TFT_BL, 100);
+}
+
+/***************************************************************************************
+** Function name: _late_setup_gpio()
+** Description:   runs once I2C and storage are up: puts both audio codecs into
+**                low-power standby until an audio/mic feature activates them.
+***************************************************************************************/
+void _late_setup_gpio() {
+    _setup_codec_speaker(false);
+    _setup_codec_mic(false);
+}
+
+/*********************************************************************
+** Function: _setBrightness
+** Applies a 0-100 brightness value (settings / screen-dim).
+**********************************************************************/
+void _setBrightness(uint8_t brightval) { hal_bright_set(TFT_BL, brightval); }
+
+/*********************************************************************
+** Function: InputHandler
+** Runs in taskInputHandler every ~10 ms. The task clears the input globals and holds
+** the input lock around this call, so it only has to poll the button HAL.
+**********************************************************************/
+void InputHandler(void) {
+    // deinitMicroPhone() in src/modules/others/mic.cpp calls gpio_reset_pin(GPIO_NUM_0) when
+    // a capture session ends (a leftover from boards whose mic power rail sits there). On
+    // this board GPIO0 is the Sel button, so re-arm it instead of losing the button after
+    // the first recording. pinMode() on an input is cheap and idempotent.
+    static uint32_t lastArm = 0;
+    uint32_t now = millis();
+    if (now - lastArm > 1000) {
+        lastArm = now;
+        pinMode(PIN_BTN_SEL, INPUT_PULLUP);
+    }
+
+    bool prevJP = false, prevJR = false;
+    bool nextJP = false, nextJR = false;
+    bool selJP = false, selJR = false;
+    updateBtnDebounce(s_btnPrev, now, prevJP, prevJR);
+    updateBtnDebounce(s_btnNext, now, nextJP, nextJR);
+    updateBtnDebounce(s_btnSel, now, selJP, selJR);
+
+    if (s_btnPrev.stableDown || s_btnNext.stableDown || s_btnSel.stableDown) {
+        previousMillis = now;
+    }
+
+    if (s_swallowWake) {
+        if (!s_btnPrev.stableDown && !s_btnNext.stableDown && !s_btnSel.stableDown) {
+            s_swallowWake = false;
+        }
+        if (prevJR) { s_btnPrev.holdFired = false; s_btnPrev.consumed = false; }
+        if (nextJR) { s_btnNext.holdFired = false; s_btnNext.consumed = false; }
+        if (selJR) { s_btnSel.holdFired = false; s_btnSel.consumed = false; }
+        return;
+    }
+
+    if ((prevJP || nextJP || selJP) && wakeUpScreen()) {
+        s_swallowWake = true;
+        if (s_btnPrev.stableDown) s_btnPrev.consumed = true;
+        if (s_btnNext.stableDown) s_btnNext.consumed = true;
+        if (s_btnSel.stableDown) s_btnSel.consumed = true;
+        return;
+    }
+
+    // 1. Two-button combos (checked first to suppress single-button tap/hold)
+    if (s_btnPrev.stableDown && s_btnNext.stableDown) {
+        if (!s_btnPrev.consumed || !s_btnNext.consumed) {
+            EscPress = true;
+            AnyKeyPress = true;
+            s_btnPrev.consumed = true;
+            s_btnNext.consumed = true;
+            s_lastComboAt = now;
+        }
+    } else if (s_btnSel.stableDown && s_btnPrev.stableDown) {
+        if (!s_btnSel.consumed || !s_btnPrev.consumed) {
+            PrevPagePress = true;
+            AnyKeyPress = true;
+            s_btnSel.consumed = true;
+            s_btnPrev.consumed = true;
+            s_lastComboAt = now;
+        } else if (now - s_lastComboAt >= kComboRepeatMs) {
+            PrevPagePress = true;
+            AnyKeyPress = true;
+            s_lastComboAt = now;
+        }
+    } else if (s_btnSel.stableDown && s_btnNext.stableDown) {
+        if (!s_btnSel.consumed || !s_btnNext.consumed) {
+            NextPagePress = true;
+            AnyKeyPress = true;
+            s_btnSel.consumed = true;
+            s_btnNext.consumed = true;
+            s_lastComboAt = now;
+        } else if (now - s_lastComboAt >= kComboRepeatMs) {
+            NextPagePress = true;
+            AnyKeyPress = true;
+            s_lastComboAt = now;
+        }
+    } else {
+        // 2. Single-button Hold (repeats for Up/Down, 1-shot for Esc)
+        if (s_btnPrev.stableDown && !s_btnPrev.consumed) {
+            if (!s_btnPrev.holdFired && (now - s_btnPrev.downAt >= kNavHoldMs)) {
+                s_btnPrev.holdFired = true;
+                s_btnPrev.lastRepeatAt = now;
+                UpPress = true;
+                AnyKeyPress = true;
+            } else if (s_btnPrev.holdFired && (now - s_btnPrev.lastRepeatAt >= kNavRepeatMs)) {
+                s_btnPrev.lastRepeatAt = now;
+                UpPress = true;
+                AnyKeyPress = true;
+            }
+        }
+        if (s_btnNext.stableDown && !s_btnNext.consumed) {
+            if (!s_btnNext.holdFired && (now - s_btnNext.downAt >= kNavHoldMs)) {
+                s_btnNext.holdFired = true;
+                s_btnNext.lastRepeatAt = now;
+                DownPress = true;
+                AnyKeyPress = true;
+            } else if (s_btnNext.holdFired && (now - s_btnNext.lastRepeatAt >= kNavRepeatMs)) {
+                s_btnNext.lastRepeatAt = now;
+                DownPress = true;
+                AnyKeyPress = true;
+            }
+        }
+        if (s_btnSel.stableDown && !s_btnSel.consumed) {
+            if (!s_btnSel.holdFired && (now - s_btnSel.downAt >= kEscHoldMs)) {
+                s_btnSel.holdFired = true;
+                EscPress = true;
+                AnyKeyPress = true;
+            }
+        }
+    }
+
+    // 3. Clean short-tap release events
+    if (prevJR) {
+        if (!s_btnPrev.consumed && !s_btnPrev.holdFired) {
+            PrevPress = true;
+            AnyKeyPress = true;
+        }
+        s_btnPrev.holdFired = false;
+        s_btnPrev.consumed = false;
+    }
+    if (nextJR) {
+        if (!s_btnNext.consumed && !s_btnNext.holdFired) {
+            NextPress = true;
+            AnyKeyPress = true;
+        }
+        s_btnNext.holdFired = false;
+        s_btnNext.consumed = false;
+    }
+    if (selJR) {
+        if (!s_btnSel.consumed && !s_btnSel.holdFired) {
+            SelPress = true;
+            AnyKeyPress = true;
+        }
+        s_btnSel.holdFired = false;
+        s_btnSel.consumed = false;
+    }
+}
+
+// =====================================================================================
+//  Power
+// =====================================================================================
+
+/*********************************************************************
+** Function: isCharging
+** Charge detect on GPIO47. Charger ICs drive their status pin open-drain, so the pin is
+** pulled up and reads LOW while charging. If this board's charger works the other way
+** round, flip the comparison below.
+**********************************************************************/
+bool isCharging() { return digitalRead(PIN_CHARGE_DETECT) == LOW; }
+
+/*********************************************************************
+** Function: getBatteryMv / getBattery
+** GPIO17 sits on ADC2, which contends with Wi-Fi TX bursts. We take 5 quick samples,
+** discard zero/collapsed ADC2 glitches (< 600 mV raw), compute the median, apply an
+** EMA filter, and cache for 3 s so Wi-Fi/WebUI activity never causes wild % drops.
+**********************************************************************/
+int getBatteryMv() {
+    static int s_smoothMv = 0;
+    static uint32_t s_lastReadAt = 0;
+    constexpr uint32_t kBatCacheMs = 3000;
+
+    uint32_t now = millis();
+    if (s_smoothMv > 0 && (now - s_lastReadAt) < kBatCacheMs) { return s_smoothMv; }
+    s_lastReadAt = now;
+
+    int samples[5];
+    int valid = 0;
+    for (int i = 0; i < 5; i++) {
+        int rawMv = analogReadMilliVolts(PIN_BAT_ADC);
+        if (rawMv >= 600) {
+            samples[valid++] = static_cast<int>(rawMv * ANALOG_BAT_MULTIPLIER);
+        }
+        delayMicroseconds(120);
+    }
+
+    if (valid == 0) {
+        return s_smoothMv > 0 ? s_smoothMv : ANALOG_BAT_MAX_MV;
+    }
+
+    std::sort(samples, samples + valid);
+    int medianMv = samples[valid / 2];
+
+    if (s_smoothMv == 0) {
+        s_smoothMv = medianMv;
+    } else {
+        // Reject extreme single-burst spikes (> 350 mV step in 3s unless charging changed)
+        int delta = medianMv - s_smoothMv;
+        if (delta > 350) medianMv = s_smoothMv + 150;
+        else if (delta < -350) medianMv = s_smoothMv - 150;
+        s_smoothMv = (s_smoothMv * 7 + medianMv * 3) / 10;
+    }
+    return s_smoothMv;
+}
+
+int getBattery() {
+    int mv = getBatteryMv();
+    if (mv <= 0) return 0;
+    long pct = map(mv, ANALOG_BAT_MIN_MV, ANALOG_BAT_MAX_MV, 1, 100);
+    if (pct < 1) pct = 1;
+    if (pct > 100) pct = 100;
+    return static_cast<int>(pct);
+}
+
+/*********************************************************************
+** Function: enterBootloaderMode
+** Reboots the ESP32-S3 directly into ROM USB Download Boot while keeping the
+** power latch HIGH so Web Flasher / esptool can flash without holding Boot.
+**********************************************************************/
+void enterBootloaderMode() {
+    digitalWrite(PIN_PA_ENABLE, LOW);
+#ifdef DSOLUTION_LATCH_PIN
+    pinMode(DSOLUTION_LATCH_PIN, OUTPUT);
+    digitalWrite(DSOLUTION_LATCH_PIN, HIGH);
+#endif
+    wakeUpScreen();
+    tft.fillScreen(bruceConfig.bgColor);
+    tft.drawRoundRect(4, 4, tftWidth - 8, tftHeight - 8, 6, bruceConfig.priColor);
+    tft.setTextSize(FM);
+    tft.setTextColor(bruceConfig.priColor, bruceConfig.bgColor);
+    tft.drawCentreString("USB Bootloader Mode", tftWidth / 2, tftHeight / 2 - 28, 1);
+    tft.setTextSize(FP);
+    tft.setTextColor(bruceConfig.secColor, bruceConfig.bgColor);
+    tft.drawCentreString("Connect Web Flasher or esptool", tftWidth / 2, tftHeight / 2 + 2, 1);
+    tft.drawCentreString("Rebooting into ROM download...", tftWidth / 2, tftHeight / 2 + 18, 1);
+    delay(250);
+
+    REG_WRITE(RTC_CNTL_OPTION1_REG, RTC_CNTL_FORCE_DOWNLOAD_BOOT);
+    esp_restart();
+}
+
+/*********************************************************************
+** Function: powerOff
+** Mutes the amplifier, kills the backlight and goes to deep sleep with the Boot button
+** (GPIO0) as the wake-up source. The power latch (if this board has one) is only released
+** when the build defines DSOLUTION_LATCH_PIN.
+**********************************************************************/
+void powerOff() {
+    hal_bright_set(TFT_BL, 0);
+    panelSleep(true);
+    _setup_codec_speaker(false);
+    _setup_codec_mic(false);
+#ifdef DSOLUTION_LATCH_PIN
+    digitalWrite(DSOLUTION_LATCH_PIN, LOW); // release the power latch (board powers down)
+#endif
+    delay(50);
+
+    esp_sleep_enable_ext0_wakeup((gpio_num_t)PIN_BTN_SEL, 0); // wake on Boot = LOW
+    esp_deep_sleep_start();
+}
diff --git a/boards/dsolution-183-2mic/merge_bin.py b/boards/dsolution-183-2mic/merge_bin.py
new file mode 100644
index 00000000..372b2f96
--- /dev/null
+++ b/boards/dsolution-183-2mic/merge_bin.py
@@ -0,0 +1,133 @@
+# =====================================================================================
+#  boards/dsolution-183-2mic/merge_bin.py
+#
+#  Post-build hook: merges bootloader + partition table + boot_app0 + application into
+#  ONE image that is flashed at 0x0, so the board only ever needs a single .bin:
+#
+#      .pio/build/dsolution-183-2mic/firmware-factory.bin
+#
+#      esptool.py --chip esp32s3 write_flash 0x0 firmware-factory.bin
+#
+#  The image is *not* padded to the flash size: it ends right after the application
+#  (~4.7 MB instead of 16 MB), because the whole point of this file is to be flashed
+#  through a browser over WebSerial, and a third of the transfer time is a third of the
+#  chances to drop the link on a board whose USB is already flaky. Erase the chip first
+#  (one click in esptool-js, or `esptool.py erase_flash`) and the stale partition table /
+#  filesystem are gone anyway. Build with DSOLUTION_PAD_FACTORY=1 in the environment to
+#  get the padded 16 MB variant back.
+#
+#  The merge itself is done here, in pure Python, instead of shelling out to
+#  `esptool merge_bin`. esptool renamed that subcommand *and* its --flash_* options
+#  between v4 and v5, which is what made the first CI run of this hook fail with a bare
+#  "unrecognized arguments"; laying the images down at their offsets is exactly what
+#  merge_bin does internally anyway, and PlatformIO has already written the flash
+#  parameters into the bootloader image header.
+#
+#  PlatformIO's own upload target still works (`pio run -t upload` writes the four
+#  separate images); this is only the "one file" output.
+#
+#  Registered from the board .ini:
+#      extra_scripts = ${env.extra_scripts}
+#          post:boards/dsolution-183-2mic/merge_bin.py
+# =====================================================================================
+
+Import("env")
+
+from pathlib import Path
+
+TAG = "[merge_bin]"
+
+# ESP32-S3 boot loader / application images start with the 0xE9 magic byte.
+IMAGE_MAGIC = 0xE9
+
+FLASH_SIZES = {
+    "1MB": 1 << 20,
+    "2MB": 2 << 20,
+    "4MB": 4 << 20,
+    "8MB": 8 << 20,
+    "16MB": 16 << 20,
+    "32MB": 32 << 20,
+}
+
+
+def _flash_size_bytes(value, default="16MB"):
+    key = str(value or default).strip().upper().replace(" ", "")
+    return FLASH_SIZES.get(key, FLASH_SIZES[default])
+
+
+def _pad_wanted():
+    """DSOLUTION_PAD_FACTORY=1 in the shell (or in project options) -> 16 MB image."""
+    import os
+    return str(os.environ.get("DSOLUTION_PAD_FACTORY", "")).strip() not in ("", "0", "no", "false")
+
+
+def merge_bin(source, target, env):
+    build = Path(env.subst("$BUILD_DIR"))
+    app = build / f"{env.subst('$PROGNAME')}.bin"
+
+    bootloader = build / "bootloader.bin"
+    partitions = build / "partitions.bin"
+    boot_app0 = build / "boot_app0.bin"
+    if not boot_app0.is_file():
+        # Framework layout differences: the file lives somewhere under the packages dir.
+        boot_app0 = next(Path(env.subst("$PROJECT_PACKAGES_DIR")).rglob("boot_app0.bin"), boot_app0)
+
+    segments = [(0x0, bootloader), (0x8000, partitions)]
+    if boot_app0.is_file():
+        segments.append((0xE000, boot_app0))
+    else:
+        print(f"{TAG} boot_app0.bin not found -- otadata stays erased, factory app still boots")
+    segments.append((0x10000, app))
+
+    for _, image in segments:
+        if not image.is_file():
+            raise SystemExit(f"{TAG} missing segment: {image}")
+
+    flash_size = _flash_size_bytes(env.BoardConfig().get("upload.flash_size", "16MB"))
+
+    image = bytearray()
+    placed = []
+    for offset, path in segments:  # already ascending
+        data = path.read_bytes()
+        if not data:
+            raise SystemExit(f"{TAG} empty segment: {path}")
+        if len(image) > offset:
+            raise SystemExit(
+                f"{TAG} {path.name} at 0x{offset:X} overlaps the previous segment "
+                f"(which already reaches 0x{len(image):X})"
+            )
+        image.extend(b"\xff" * (offset - len(image)))
+        image.extend(data)
+        placed.append((path.name, offset, len(data)))
+
+    if len(image) > flash_size:
+        raise SystemExit(f"{TAG} merged image {len(image)} B does not fit in {flash_size} B")
+    if _pad_wanted():
+        image.extend(b"\xff" * (flash_size - len(image)))
+        size_note = f"padded to {flash_size} B"
+    else:
+        size_note = f"{len(image)} B, not padded (DSOLUTION_PAD_FACTORY=1 for the 16 MB variant)"
+
+    # Sanity: every image we placed must still be byte-identical where we put it and the
+    # bootloader/app must carry the ESP image magic. A silent offset mistake here is a
+    # bricked-looking board, so fail the build instead of shipping it.
+    for offset, path in segments:
+        data = path.read_bytes()
+        if image[offset:offset + len(data)] != data:
+            raise SystemExit(f"{TAG} verification failed for {path.name} at 0x{offset:X}")
+    for offset, path in ((0x0, bootloader), (0x10000, app)):
+        if image[offset] != IMAGE_MAGIC:
+            raise SystemExit(
+                f"{TAG} {path.name} at 0x{offset:X} does not start with 0x{IMAGE_MAGIC:02X} "
+                f"(got 0x{image[offset]:02X}) -- wrong file at that offset?"
+            )
+
+    out = build / f"{env.subst('$PROGNAME')}-factory.bin"
+    out.write_bytes(image)
+
+    for name, offset, length in placed:
+        print(f"{TAG}   0x{offset:06X}  {name:<18} {length:>9} B")
+    print(f"{TAG} OK: {out.name} {len(image)} B ({size_note}) -- flash it at 0x0")
+
+
+env.AddPostAction("$BUILD_DIR/${PROGNAME}.bin", merge_bin)
diff --git a/boards/dsolution-183-2mic/partitions_16Mb_ota.csv b/boards/dsolution-183-2mic/partitions_16Mb_ota.csv
new file mode 100644
index 00000000..fcf16fef
--- /dev/null
+++ b/boards/dsolution-183-2mic/partitions_16Mb_ota.csv
@@ -0,0 +1,19 @@
+# DSolution 1.83" 2-Mic (16 MB QIO Flash) Dual-OTA Partition Table
+#
+# Layout (16,777,216 bytes = 16 MB):
+#   0x000000 - 0x008000 : Bootloader (32 KB, flashed at 0x0)
+#   0x008000 - 0x009000 : Partition table (4 KB)
+#   0x009000 - 0x00E000 : NVS (20 KB)
+#   0x00E000 - 0x010000 : otadata (8 KB, initialized by boot_app0.bin)
+#   0x010000 - 0x410000 : app0 / ota_0 (4.00 MB = 4,194,304 B)
+#   0x410000 - 0x810000 : app1 / ota_1 (4.00 MB = 4,194,304 B)
+#   0x810000 - 0xFF0000 : spiffs / LittleFS (7.875 MB = 8,257,536 B)
+#   0xFF0000 - 0x1000000: coredump (64 KB)
+#
+# Name,   Type, SubType,  Offset,   Size,     Flags
+nvs,      data, nvs,      0x9000,   0x5000,
+otadata,  data, ota,      0xE000,   0x2000,
+app0,     app,  ota_0,    0x10000,  0x400000,
+app1,     app,  ota_1,    0x410000, 0x400000,
+spiffs,   data, spiffs,   0x810000, 0x7E0000,
+coredump, data, coredump, 0xFF0000, 0x10000,
