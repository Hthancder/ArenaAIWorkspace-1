+static int computeCleanScore(const uint8_t loadAll[14], uint8_t targetCh) {
+    // Weighted adjacent overlap interference across +-2 channels
+    float busy = (float)loadAll[targetCh];
+    if (targetCh > 1) busy += 0.65f * loadAll[targetCh - 1];
+    if (targetCh < 13) busy += 0.65f * loadAll[targetCh + 1];
+    if (targetCh > 2) busy += 0.25f * loadAll[targetCh - 2];
+    if (targetCh < 12) busy += 0.25f * loadAll[targetCh + 2];
+    int penalty = (int)(busy / 1.9f);
+    int score = 100 - penalty;
+    if (score < 0) score = 0;
+    if (score > 100) score = 100;
+    return score;
+}
+
+static int pickBestPrimaryChannel(const uint8_t loadAll[14]) {
+    const uint8_t cands[3] = {1, 6, 11};
+    int bestCh = 1;
+    int bestScore = -1;
+    for (uint8_t ch : cands) {
+        int s = computeCleanScore(loadAll, ch);
+        if (s > bestScore) {
+            bestScore = s;
+            bestCh = ch;
+        }
+    }
+    return bestCh;
+}
+
+static String bssidStr(const uint8_t *b) {
+    char buf[18];
+    snprintf(buf, sizeof(buf), "%02X:%02X:%02X:%02X:%02X:%02X", b[0], b[1], b[2], b[3], b[4], b[5]);
+    return String(buf);
+}
+
+static String caJsonEsc(const char *s) {
+    String out;
+    if (!s) return out;
+    for (size_t i = 0; s[i]; i++) {
+        char c = s[i];
+        if (c == '"' || c == '\\') out += '\\';
+        if ((uint8_t)c >= 0x20 && (uint8_t)c < 0x7F) out += c;
+    }
+    return out;
+}
