+// Parses RFC1035 QNAME starting at offset 12. Returns end offset of QNAME (after 0-byte) or 0 on error.
+static size_t parseDnsQuestionName(const uint8_t *pkt, size_t len, char *outDomain, size_t outCap, uint16_t &outQtype) {
+    outDomain[0] = '\0';
+    outQtype = 1;
+    if (len < 17) return 0; // 12 hdr + >=1 qname + 4 qtype/qclass
+    size_t pos = 12;
+    size_t outLen = 0;
+    uint8_t jumps = 0;
+    while (pos < len && jumps < 64) {
+        uint8_t lab = pkt[pos++];
+        if (lab == 0) {
+            if (pos + 4 <= len) {
+                outQtype = ((uint16_t)pkt[pos] << 8) | pkt[pos + 1];
+            }
+            return pos;
+        }
+        if ((lab & 0xC0) != 0 || pos + lab > len) return 0; // compressed or malformed QNAME
+        if (outLen > 0 && outLen + 1 < outCap) outDomain[outLen++] = '.';
+        for (uint8_t i = 0; i < lab; i++) {
+            char c = (char)pkt[pos++];
+            if (c >= 'A' && c <= 'Z') c = (char)(c + 32);
+            if ((uint8_t)c >= 0x20 && (uint8_t)c < 0x7F && outLen + 1 < outCap) {
+                outDomain[outLen++] = c;
+            }
+        }
+        jumps++;
+    }
+    outDomain[outLen] = '\0';
+    return 0;
+}
+
+// Builds minimal zero-IP (0.0.0.0) or NXDOMAIN response for blocked domain so client fails fast cleanly.
+static size_t buildBlockedDnsResponse(const uint8_t *req, size_t reqLen, size_t qnameEnd, uint16_t qtype, uint8_t *resp, size_t respCap) {
+    size_t qEnd = qnameEnd + 4;
+    if (qEnd > reqLen || qEnd + 16 > respCap) return 0;
+    memcpy(resp, req, qEnd);
+    resp[2] = 0x81; // QR=1, RD=1
+    resp[3] = 0x80; // RA=1, RCODE=0 (NOERROR)
+    resp[4] = 0x00;
+    resp[5] = 0x01; // QDCOUNT=1
+    resp[8] = 0x00;
+    resp[9] = 0x00;
+    resp[10] = 0x00;
+    resp[11] = 0x00;
+
+    if (qtype == 1) { // A -> 0.0.0.0
+        resp[6] = 0x00;
+        resp[7] = 0x01; // ANCOUNT=1
+        size_t o = qEnd;
+        resp[o++] = 0xC0;
+        resp[o++] = 0x0C; // Pointer to QNAME
+        resp[o++] = 0x00;
+        resp[o++] = 0x01; // TYPE A
+        resp[o++] = 0x00;
+        resp[o++] = 0x01; // CLASS IN
+        resp[o++] = 0x00;
+        resp[o++] = 0x00;
+        resp[o++] = 0x00;
+        resp[o++] = 0x3C; // TTL 60s
+        resp[o++] = 0x00;
+        resp[o++] = 0x04; // RDLENGTH 4
+        resp[o++] = 0x00;
+        resp[o++] = 0x00;
+        resp[o++] = 0x00;
+        resp[o++] = 0x00;
+        return o;
+    }
+
+    // AAAA / HTTPS / other -> empty NOERROR answer (prevents fallback stall)
+    resp[6] = 0x00;
+    resp[7] = 0x00;
+    return qEnd;
+}
