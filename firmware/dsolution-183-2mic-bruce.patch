+/**********************************************************************
+**  Function: startWebUiHeadless
+**  Silently connects to saved Wi-Fi (or falls back to AP) and starts the
+**  AsyncWebServer + mDNS in the background without touching the TFT screen.
+**********************************************************************/
+bool startWebUiHeadless(bool allowApFallback) {
+    if (server || isWebUIActive) return true;
+    if (s_webUiStarting) return false;
+    s_webUiStarting = true;
+
+    bool hasNetwork = WiFi.isConnected() || (WiFi.getMode() == WIFI_MODE_AP);
+    if (!hasNetwork) {
+        if (FORCE_RADIO_TEARDOWN_ON_SWITCH) {
+            stopBLEStack();
+            vTaskDelay(pdMS_TO_TICKS(100));
+        }
+
+        if (radioHasMemForWifi()) {
+            ensureWifiPlatform();
+            if (!bruceConfig.wifi.empty()) {
+                WiFi.mode(WIFI_MODE_STA);
+                int nets = WiFi.scanNetworks();
+                for (int i = 0; i < nets && !WiFi.isConnected(); i++) {
+                    String ssid = WiFi.SSID(i);
+                    String pwd = bruceConfig.getWifiPassword(ssid);
+                    bool knownOpen =
+                        WiFi.encryptionType(i) == WIFI_AUTH_OPEN && bruceConfig.hasWifiCredential(ssid);
+                    if (pwd == "" && !knownOpen) continue;
+
+                    int32_t ch = WiFi.channel(i);
+                    uint8_t *bssid = WiFi.BSSID(i);
+                    WiFi.begin(ssid.c_str(), pwd.length() > 0 ? pwd.c_str() : NULL, ch, bssid);
+                    for (int attempt = 0; attempt < 50; attempt++) {
+                        if (WiFi.isConnected()) {
+                            wifiConnected = true;
+                            wifiIP = WiFi.localIP().toString();
+                            applyWifiPowerProfile();
+                            xTaskCreate(updateTimezoneTask, "updateTimezone", 4096, NULL, 1, NULL);
+                            break;
+                        }
+                        vTaskDelay(pdMS_TO_TICKS(100));
+                    }
+                }
+                WiFi.scanDelete();
+            }
+
+            if (WiFi.isConnected()) {
+                hasNetwork = true;
+            } else if (allowApFallback) {
+                WiFi.mode(WIFI_MODE_AP);
+                hasNetwork = _setupAP();
+            }
+        }
+    }
+
+    if (hasNetwork && !server) {
+        Serial.println("[WebUI] Starting headless background server...");
+        if (psramFound()) server = (AsyncWebServer *)ps_malloc(sizeof(AsyncWebServer));
+        else server = (AsyncWebServer *)malloc(sizeof(AsyncWebServer));
+
+        if (server) {
+            new (server) AsyncWebServer(default_webserverporthttp);
+            configureWebServer();
+            isWebUIActive = true;
+            Serial.println("[WebUI] Ready at http://bruce.local (" + wifiIP + ")");
+        }
+    }
+
+    s_webUiStarting = false;
+    return isWebUIActive;
+}
+
+static void webUiAutoStartTask(void *pvParameters) {
+    (void)pvParameters;
+    vTaskDelay(pdMS_TO_TICKS(450));
+    startWebUiHeadless(true);
+    vTaskDelete(NULL);
+}
+
+void startWebUiBackgroundTask() {
+    if (server || isWebUIActive || s_webUiStarting) return;
+    xTaskCreate(webUiAutoStartTask, "webUiAutoStart", 6144, NULL, 1, NULL);
+}
