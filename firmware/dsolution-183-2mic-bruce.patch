diff --git a/src/core/dsolution_ux.cpp b/src/core/dsolution_ux.cpp
new file mode 100644
index 00000000..6f439bf4
--- /dev/null
+++ b/src/core/dsolution_ux.cpp
@@ -0,0 +1,270 @@
+#include "dsolution_ux.h"
+#if defined(DSOLUTION_183_2MIC)
+#include "core/led_control.h"
+#include "modules/others/audio.h"
+#include <globals.h>
+#include <Wire.h>
+#include <LittleFS.h>
+#include "ui_sound_wav.h"
+#include <Preferences.h>
+#include <driver/i2s_std.h>
+#include <math.h>
+
+extern void _setup_codec_speaker(bool);
+extern bool isSpeakerActive();
+extern bool isBoardMicActive();
+static TaskHandle_t s_menuTask = nullptr;
+static bool s_feedbackLoaded = false;
+static volatile bool s_uiFeedback = true;
+static portMUX_TYPE s_mux = portMUX_INITIALIZER_UNLOCKED;
+static bool s_find = false;
+static unsigned s_findPlayed = 0;
+static uint32_t s_findGeneration = 0;
+static uint32_t s_findStart = 0, s_findLast = 0, s_findCooldown = 0;
+static bool s_findAttempted = false;
+static bool s_findAudioSent = false;
+static const char *s_result = "idle";
+static uint8_t s_soundModes[5] = {0, 0, 0, 0, 0};
+static const char *const s_soundKeys[] = {"select", "back", "success", "warning", "find"};
+static const char *const s_soundPaths[] = {"/ui-sounds/select.wav", "/ui-sounds/back.wav",
+    "/ui-sounds/success.wav", "/ui-sounds/warning.wav", "/ui-sounds/find.wav"};
+static unsigned soundIndex(UiSound e) { unsigned n = (unsigned)e; return n < 5 ? n : 0; }
+unsigned uxSoundMode(UiSound e) { return s_soundModes[soundIndex(e)]; }
+const char *uxSoundModeName(UiSound e) {
+    const char *const names[] = {"Built-in", "Off", "WAV"};
+    return names[uxSoundMode(e)];
+}
+void uxCycleSoundMode(UiSound e) {
+    const unsigned n = soundIndex(e);
+    s_soundModes[n] = (s_soundModes[n] + 1) % 3;
+    Preferences p;
+    if (p.begin("dsounds", false)) { p.putUChar(s_soundKeys[n], s_soundModes[n]); p.end(); }
+}
+
+void uxInitMenuTask() {
+    s_menuTask = xTaskGetCurrentTaskHandle();
+    if (!s_feedbackLoaded) {
+        Preferences p;
+        if (p.begin("dsquick", true)) { s_uiFeedback = p.getBool("ui_feedback", true); p.end(); }
+        s_feedbackLoaded = true;
+        Preferences sounds;
+        if (sounds.begin("dsounds", true)) {
+            for (unsigned i = 0; i < 5; ++i) {
+                uint8_t mode = sounds.getUChar(s_soundKeys[i], 0);
+                s_soundModes[i] = mode <= 2 ? mode : 0;
+            }
+            sounds.end();
+        }
+    }
+}
+bool uxUiFeedbackEnabled() { return s_uiFeedback; }
+void uxSetUiFeedback(bool enabled) {
+    s_uiFeedback = enabled;
+    Preferences p;
+    if (p.begin("dsquick", false)) { p.putBool("ui_feedback", enabled); p.end(); }
+}
+
+// Claim I2S0 before enabling the codec. No auto port: the shared clock pins must
+// not be rerouted while a microphone/sonar or another audio player owns them.
+// This is deliberately called only by the main menu task; network handlers queue.
+static bool playUiTone(unsigned hz, unsigned duration) {
+    if (!s_menuTask || xTaskGetCurrentTaskHandle() != s_menuTask || !bruceConfig.soundEnabled ||
+        bruceConfig.soundVolume <= 0 || isSpeakerActive() || isBoardMicActive() || isAudioPlaying()) return false;
+    i2s_chan_handle_t tx = nullptr;
+    i2s_chan_config_t chan = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);
+    chan.dma_desc_num = 3; chan.dma_frame_num = 128;
+    if (i2s_new_channel(&chan, &tx, nullptr) != ESP_OK) return false;
+    i2s_std_config_t cfg = {
+        .clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(48000),
+        .slot_cfg = I2S_STD_MSB_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_STEREO),
+        .gpio_cfg = {.mclk = GPIO_NUM_5, .bclk = GPIO_NUM_15, .ws = GPIO_NUM_16,
+                     .dout = GPIO_NUM_6, .din = I2S_GPIO_UNUSED,
+                     .invert_flags = {.mclk_inv = false, .bclk_inv = false, .ws_inv = false}},
+    };
+    cfg.slot_cfg.bit_shift = true;
+    bool enabled = false, codec = false, ok = false;
+    if (i2s_channel_init_std_mode(tx, &cfg) != ESP_OK) goto done;
+    if (i2s_channel_enable(tx) != ESP_OK) goto done;
+    enabled = true;
+    // Fail explicitly when codec does not acknowledge instead of claiming sound played.
+    Wire.beginTransmission(0x18);
+    if (Wire.endTransmission() != 0) { Serial.println("[audio] ES8311 not responding at 0x18"); goto done; }
+    _setup_codec_speaker(true);
+    codec = true;
+    {
+        int16_t samples[128 * 2];
+        const unsigned total = duration * 48;
+        const int amplitude = 10000 * min(100, max(0, bruceConfig.soundVolume)) / 100;
+        unsigned pos = 0;
+        while (pos < total + 1536) { // 32 ms of silence drains the 8 ms DMA pipeline
+            unsigned frames = min(128U, total + 1536 - pos);
+            for (unsigned i = 0; i < frames; ++i) {
+                unsigned at = pos + i;
+                float ramp = at < 240 ? at / 240.0f : (at < total && total - at < 240 ? (total - at) / 240.0f : 1.0f);
+                int16_t sample = at < total ? (int16_t)(amplitude * ramp * sinf(6.2831853f * hz * at / 48000.0f)) : 0;
+                samples[2 * i] = samples[2 * i + 1] = sample;
+            }
+            size_t written = 0;
+            if (i2s_channel_write(tx, samples, frames * 4, &written, pdMS_TO_TICKS(100)) != ESP_OK || written != frames * 4) goto done;
+            pos += frames;
+        }
+    }
+    vTaskDelay(pdMS_TO_TICKS(10));
+    ok = true;
+done:
+    if (codec) _setup_codec_speaker(false);
+    if (enabled) i2s_channel_disable(tx);
+    i2s_del_channel(tx);
+    return ok;
+}
+
+// Validated short PCM cues use the same fixed clocks as built-in tones. Playback
+// stays on the menu task and never stops an existing audio/mic session.
+static bool playUiWav(unsigned which) {
+    if (!s_menuTask || xTaskGetCurrentTaskHandle() != s_menuTask || !bruceConfig.soundEnabled ||
+        bruceConfig.soundVolume <= 0 || isSpeakerActive() || isBoardMicActive() || isAudioPlaying()) return false;
+    File f = LittleFS.open(s_soundPaths[which], "r");
+    if (!f || f.isDirectory()) return false;
+    uint8_t header[44]; UiWavInfo info;
+    const unsigned limit = which < 2 ? 250 : 1000;
+    if (f.read(header, sizeof(header)) != sizeof(header) || !uiParseWav(header, f.size(), limit, info)) { f.close(); return false; }
+    i2s_chan_handle_t tx = nullptr;
+    i2s_chan_config_t chan = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);
+    chan.dma_desc_num = 3; chan.dma_frame_num = 128;
+    if (i2s_new_channel(&chan, &tx, nullptr) != ESP_OK) { f.close(); return false; }
+    i2s_std_config_t cfg = {
+        .clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(48000),
+        .slot_cfg = I2S_STD_MSB_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_STEREO),
+        .gpio_cfg = {.mclk = GPIO_NUM_5, .bclk = GPIO_NUM_15, .ws = GPIO_NUM_16,
+                     .dout = GPIO_NUM_6, .din = I2S_GPIO_UNUSED,
+                     .invert_flags = {.mclk_inv = false, .bclk_inv = false, .ws_inv = false}},
+    };
+    cfg.slot_cfg.bit_shift = true;
+    bool enabled = false, codec = false, ok = false;
+    if (i2s_channel_init_std_mode(tx, &cfg) != ESP_OK) goto wav_done;
+    if (i2s_channel_enable(tx) != ESP_OK) goto wav_done;
+    enabled = true;
+    Wire.beginTransmission(0x18);
+    if (Wire.endTransmission() != 0) goto wav_done;
+    _setup_codec_speaker(true); codec = true;
+    {
+        uint8_t input[512]; int16_t out[256]; uint32_t remaining = info.bytes;
+        const int volume = min(100, max(0, bruceConfig.soundVolume));
+        while (remaining) {
+            const unsigned frameBytes = info.channels * 2;
+            unsigned frames = min(128U, (unsigned)(remaining / frameBytes));
+            unsigned count = frames * frameBytes;
+            if (f.read(input, count) != count) goto wav_done;
+            for (unsigned i = 0; i < frames; ++i) {
+                int16_t left = (int16_t)uiLe16(input + i * frameBytes);
+                int16_t right = info.channels == 2 ? (int16_t)uiLe16(input + i * frameBytes + 2) : left;
+                out[2*i] = (int16_t)((int32_t)left * volume / 100);
+                out[2*i+1] = (int16_t)((int32_t)right * volume / 100);
+            }
+            size_t written = 0;
+            if (i2s_channel_write(tx, out, frames * 4, &written, pdMS_TO_TICKS(100)) != ESP_OK || written != frames * 4) goto wav_done;
+            remaining -= count;
+        }
+        memset(out, 0, sizeof(out));
+        for (unsigned i = 0; i < 12; ++i) {
+            size_t written = 0;
+            if (i2s_channel_write(tx, out, sizeof(out), &written, pdMS_TO_TICKS(100)) != ESP_OK || written != sizeof(out)) goto wav_done;
+        }
+    }
+    vTaskDelay(pdMS_TO_TICKS(10)); ok = true;
+wav_done:
+    f.close();
+    if (codec) _setup_codec_speaker(false);
+    if (enabled) i2s_channel_disable(tx);
+    i2s_del_channel(tx);
+    return ok;
+}
+static bool playUiEvent(UiSound e) {
+    const unsigned n = soundIndex(e), mode = uxSoundMode(e);
+    if (mode == 1) return false;
+    if (mode == 2) {
+        if (playUiWav(n)) return true;
+        Serial.println("[audio] Custom WAV unavailable or invalid; using built-in tone");
+    }
+    switch (e) {
+        case UiSound::Select: return playUiTone(1050, 55);
+        case UiSound::Back: return playUiTone(700, 65);
+        case UiSound::Success: return playUiTone(1300, 110);
+        case UiSound::Warning: return playUiTone(500, 180);
+        case UiSound::Find: return playUiTone(1100, 220);
+    }
+    return false;
+}
+bool uxPreviewSound(UiSound e) { return playUiEvent(e); }
+
+void uxSound(UiSound e) {
+    if ((e == UiSound::Select || e == UiSound::Back) && !s_uiFeedback) return;
+    static uint32_t lastWarning = 0;
+    static bool warned = false;
+    if (e == UiSound::Warning) {
+        uint32_t now = millis();
+        if (warned && (uint32_t)(now - lastWarning) < 3000) return;
+        warned = true; lastWarning = now;
+    }
+    playUiEvent(e);
+}
+bool uxSpeakerTest() { return playUiTone(1000, 350); }
+
+// Debounce an estimated gauge: two low readings 30s apart; repeat at most
+// once per ten minutes. Never interpret an unavailable zero reading as low.
+void uxBatteryCheck(int percent, bool charging) {
+    static unsigned lowSamples = 0;
+    static bool warned = false;
+    static uint32_t last = 0;
+    if (charging || percent > 20) { lowSamples = 0; warned = false; return; }
+    if (percent <= 0 || percent > 15) { lowSamples = 0; return; }
+    if (lowSamples < 2) ++lowSamples;
+    const uint32_t now = millis();
+    if (lowSamples >= 2 && (!warned || (uint32_t)(now - last) >= 600000)) {
+        uxSound(UiSound::Warning); warned = true; last = now;
+    }
+}
+
+bool uxFindStart(const char **error) {
+    uint32_t now = millis();
+    portENTER_CRITICAL(&s_mux);
+    if (s_find && (uint32_t)(now - s_findStart) > 15000) { s_find = false; s_result = "expired"; }
+    if (s_find) { if (error) *error = "Find is already running"; portEXIT_CRITICAL(&s_mux); return false; }
+    if (s_findAttempted && (uint32_t)(now - s_findCooldown) < 10000) {
+        if (error) *error = "Please wait 10 seconds before trying again";
+        portEXIT_CRITICAL(&s_mux); return false;
+    }
+    s_findAttempted = true; s_findCooldown = now; s_find = true; s_findPlayed = 0; ++s_findGeneration;
+    s_findStart = now; s_findLast = 0; s_findAudioSent = false; s_result = "queued";
+    portEXIT_CRITICAL(&s_mux);
+    return true;
+}
+void uxFindStop() { portENTER_CRITICAL(&s_mux); s_find = false; ++s_findGeneration; s_result = "cancelled"; portEXIT_CRITICAL(&s_mux); }
+String uxFindStatus() {
+    portENTER_CRITICAL(&s_mux);
+    if (s_find && (uint32_t)(millis() - s_findStart) > 15000) { s_find = false; s_result = "expired"; }
+    const char *r = s_result; portEXIT_CRITICAL(&s_mux);
+    return String(r);
+}
+void uxService() {
+    uint32_t now = millis(); bool play = false; uint32_t generation = 0;
+    portENTER_CRITICAL(&s_mux);
+    if (s_find && (uint32_t)(now - s_findStart) > 15000) { s_find = false; s_result = "expired"; }
+    if (s_find && (s_findPlayed == 0 || (uint32_t)(now - s_findLast) >= 700)) {
+        s_findLast = now; play = true; generation = s_findGeneration;
+    }
+    portEXIT_CRITICAL(&s_mux);
+    if (!play) return;
+    bool played = playUiEvent(UiSound::Find);
+    // Respect the user's LED blink setting; never clobber their configured effect/color.
+    blinkLed(70);
+    portENTER_CRITICAL(&s_mux);
+    if (s_find && generation == s_findGeneration) {
+        s_findAudioSent = s_findAudioSent || played;
+        if (++s_findPlayed >= 3) {
+            s_find = false; s_result = s_findAudioSent ? "finished" : "silent_or_busy";
+        } else s_result = played ? "playing" : "playing_silent";
+    }
+    portEXIT_CRITICAL(&s_mux);
+}
+#endif
