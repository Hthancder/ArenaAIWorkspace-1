@@ -0,0 +1,19 @@
+#ifndef __LAN_GUARD_H__
+#define __LAN_GUARD_H__
+
+#include <Arduino.h>
+
+// 2B (part 2) — LAN Blue-Team Guard.
+// Watches for ARP spoofing (a second MAC claiming the gateway IP) and rogue
+// DHCP servers (OFFER/ACK with an unexpected server identifier).
+void lan_guard_setup();
+
+bool lanGuardStart(String *errOut = nullptr);
+void lanGuardStop();
+bool lanGuardIsRunning();
+void lanGuardClear();
+String lanGuardGetStateJson();
+bool lanGuardGetAuto();
+void lanGuardSetAuto(bool enable);
+
+#endif
diff --git a/src/modules/wifi/lan_guard_logic.h b/src/modules/wifi/lan_guard_logic.h
new file mode 100644
index 00000000..662670e5
--- /dev/null
+++ b/src/modules/wifi/lan_guard_logic.h
@@ -0,0 +1,84 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+// Parse only complete BOOTREPLY DHCP packets. Addresses remain network-order
+// byte arrays so this logic can be tested without Arduino or lwIP.
+struct LanGuardDhcpReply {
+    uint8_t type = 0;
+    uint8_t server[4] = {};
+    uint8_t offered[4] = {};
+    bool hasServer = false;
+};
+
+inline bool lanGuardParseDhcp(const uint8_t *p, size_t len, LanGuardDhcpReply &result) {
+    if (!p || len < 240 || p[0] != 2 || p[236] != 0x63 || p[237] != 0x82 ||
+        p[238] != 0x53 || p[239] != 0x63) return false;
+    LanGuardDhcpReply parsed;
+    std::memcpy(parsed.offered, p + 16, 4);
+    bool seenType = false, ended = false;
+    size_t offset = 240;
+    while (offset < len) {
+        const uint8_t tag = p[offset++];
+        if (tag == 255) { ended = true; break; }
+        if (tag == 0) continue;
+        if (offset >= len) return false;
+        const size_t length = p[offset++];
+        if (length > len - offset) return false;
+        if (tag == 53) {
+            if (length != 1 || seenType) return false;
+            parsed.type = p[offset];
+            seenType = true;
+        } else if (tag == 54) {
+            if (length != 4 || parsed.hasServer) return false;
+            std::memcpy(parsed.server, p + offset, 4);
+            parsed.hasServer = true;
+        }
+        offset += length;
+    }
+    if (!ended || !seenType || (parsed.type != 2 && parsed.type != 5 && parsed.type != 6)) return false;
+    result = parsed;
+    return true;
+}
+
+// A gateway MAC baseline belongs to a particular STA gateway and AP BSSID.
+// Roaming, reconnecting after loss, or switching gateways starts a new
+// baseline instead of reporting the new network as an ARP anomaly.
+class LanGuardGatewayBaseline {
+    uint8_t gateway_[4] = {};
+    uint8_t bssid_[6] = {};
+    uint8_t mac_[6] = {};
+    bool linked_ = false;
+    bool known_ = false;
+public:
+    void clear() { linked_ = false; known_ = false; }
+    void link(const uint8_t *gateway, const uint8_t *bssid) {
+        if (!gateway || !bssid) { clear(); return; }
+        if (!linked_ || std::memcmp(gateway_, gateway, 4) || std::memcmp(bssid_, bssid, 6)) {
+            std::memcpy(gateway_, gateway, 4);
+            std::memcpy(bssid_, bssid, 6);
+            linked_ = true;
+            known_ = false;
+        }
+    }
+    bool observe(const uint8_t *mac, uint8_t *previous) {
+        if (!linked_ || !mac) return false;
+        const bool changed = known_ && std::memcmp(mac_, mac, 6) != 0;
+        if (changed && previous) std::memcpy(previous, mac_, 6);
+        std::memcpy(mac_, mac, 6);
+        known_ = true;
+        return changed;
+    }
+    bool known() const { return known_; }
+    const uint8_t *mac() const { return mac_; }
+};
+
+// Bound flash log writes during noisy or malicious traffic. Counters are still
+// incremented for every observation; this limits the persisted samples only.
+inline bool lanGuardAllowSample(uint32_t now, uint32_t &last, bool &initialized, uint32_t interval) {
+    if (initialized && static_cast<uint32_t>(now - last) < interval) return false;
+    last = now;
+    initialized = true;
+    return true;
+}
diff --git a/src/modules/wifi/napt_http_inspector.cpp b/src/modules/wifi/napt_http_inspector.cpp
new file mode 100644
index 00000000..e21d023e
--- /dev/null
+++ b/src/modules/wifi/napt_http_inspector.cpp
@@ -0,0 +1,585 @@
+#include "napt_http_inspector.h"
+#if !defined(LITE_VERSION)
+
+#include "core/config.h"
+#include "core/display.h"
+#include "core/mykeyboard.h"
+#include "core/seclab_util.h"
+#include "core/utils.h"
+#include <Arduino.h>
+#include <LittleFS.h>
+#include <WiFi.h>
+#include <WiFiClient.h>
+#include <WiFiServer.h>
+#include <algorithm>
+#include <cstring>
+#include <globals.h>
+#include <vector>
+
+/*
+ * Why a forward proxy instead of a transparent TCP tap?
+ * lwIP NAPT on the ESP32 does not expose a netfilter hook, and WPA2 AP frames
+ * cannot be decrypted from promiscuous RX. A standards-compliant HTTP proxy is
+ * therefore the stable option: WPAD (Responder+) or a manual proxy setting
+ * routes cleartext HTTP through :3128, we forward it upstream with
+ * "Connection: close" and inspect only the first few KB. The victim keeps real
+ * Internet access, and DNS remains visible in the #1 NAPT feed.
+ */
+
+namespace {
+
+constexpr const char *kStatePath = "/napt_http_state.json";
+constexpr const char *kLogPath = "/napt_http.log";
+constexpr const char *kJsonPath = "/napt_http_findings.json";
+constexpr int kMaxFindings = 48;
+constexpr int kMaxSessions = 4;
+constexpr size_t kMaxInspect = 4096;
+
+struct Finding {
+    uint32_t tsSec;
+    char src[16];
+    char host[48];
+    char kind[20];
+    char detail[64];
+};
+
+static WiFiServer *s_server = nullptr;
+static TaskHandle_t s_task = nullptr;
+static SemaphoreHandle_t s_mux = nullptr;
+static volatile bool s_running = false;
+static volatile bool s_stopReq = false;
+static volatile int s_activeSessions = 0;
+static uint16_t s_port = 3128;
+static uint32_t s_requests = 0, s_forwarded = 0, s_connectRefused = 0;
+static uint32_t s_startedMs = 0;
+static char s_lastErr[96] = {0};
+static std::vector<Finding> s_findings;
+
+static void ensureMux() {
+    if (!s_mux) s_mux = xSemaphoreCreateMutex();
+}
+
+static void setErr(const String &e) {
+    strncpy(s_lastErr, e.c_str(), sizeof(s_lastErr) - 1);
+    s_lastErr[sizeof(s_lastErr) - 1] = 0;
+}
+
+static String redact(const String &v) {
+    if (!bruceConfig.seclabPlus.httpInspectorRedact || v.length() <= 2) return v;
+    return v.substring(0, 2) + "***(" + String(v.length()) + ")";
+}
+
+static void addFindingLocked(const String &src, const String &host, const char *kind,
+                             const String &detail) {
+    Finding f = {};
+    f.tsSec = seclabUptimeSec();
+    strncpy(f.src, src.c_str(), sizeof(f.src) - 1);
+    strncpy(f.host, seclabSafeText(host, 47).c_str(), sizeof(f.host) - 1);
+    strncpy(f.kind, kind, sizeof(f.kind) - 1);
+    strncpy(f.detail, seclabSafeText(detail, 63).c_str(), sizeof(f.detail) - 1);
+    if (s_findings.size() >= kMaxFindings) s_findings.erase(s_findings.begin());
+    s_findings.push_back(f);
+    seclabAppendLog(kLogPath, String(f.tsSec) + "," + f.src + "," + f.host + "," + f.kind + "," + f.detail);
+}
+
+static void persistStateLocked() {
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"port\":" + String((int)s_port) + ",";
+    j += "\"redact\":" + String(bruceConfig.seclabPlus.httpInspectorRedact ? "true" : "false") + ",";
+    j += "\"auto\":" + String(bruceConfig.seclabPlus.httpInspectorAutoStart ? "true" : "false") + ",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"requests\":" + String((unsigned long)s_requests) + ",";
+    j += "\"forwarded\":" + String((unsigned long)s_forwarded) + ",";
+    j += "\"httpsRefused\":" + String((unsigned long)s_connectRefused) + ",";
+    j += "\"sessions\":" + String((int)s_activeSessions) + ",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + ",";
+    j += "\"wpadUrl\":\"http://" + (WiFi.getMode() & WIFI_MODE_AP ? WiFi.softAPIP().toString()
+                                                                  : WiFi.localIP().toString()) +
+         ":" + String((int)s_port) + "/wpad.dat\",";
+    j += "\"findings\":[";
+    for (size_t i = 0; i < s_findings.size(); i++) {
+        const Finding &f = s_findings[i];
+        if (i) j += ",";
+        j += "{\"ts\":" + String((unsigned long)f.tsSec) + ",\"src\":\"" + f.src +
+             "\",\"host\":\"" + seclabJsonEscape(f.host) + "\",\"kind\":\"" + f.kind +
+             "\",\"detail\":\"" + seclabJsonEscape(f.detail) + "\"}";
+    }
+    j += "]}";
+    seclabWriteState(kStatePath, j);
+}
+
+static void exportFindingsLocked() {
+    String j = "{\"generated\":" + String((unsigned long)seclabUptimeSec()) + ",\"findings\":[";
+    for (size_t i = 0; i < s_findings.size(); i++) {
+        const Finding &f = s_findings[i];
+        if (i) j += ",";
+        j += "{\"ts\":" + String((unsigned long)f.tsSec) + ",\"src\":\"" + f.src +
+             "\",\"host\":\"" + seclabJsonEscape(f.host) + "\",\"kind\":\"" + f.kind +
+             "\",\"detail\":\"" + seclabJsonEscape(f.detail) + "\"}";
+    }
+    j += "]}";
+    seclabWriteState(kJsonPath, j);
+}
+
+static String wpadPac() {
+    String ip = (WiFi.getMode() & WIFI_MODE_AP) ? WiFi.softAPIP().toString() : WiFi.localIP().toString();
+    String pac = "// Bruce SecLab NAPT HTTP Inspector (cleartext only)\n";
+    pac += "function FindProxyForURL(url, host) {\n";
+    pac += "  if (isPlainHostName(host)) return \"DIRECT\";\n";
+    pac += "  return \"PROXY " + ip + ":" + String((int)s_port) + "; DIRECT\";\n}\n";
+    return pac;
+}
+
+static void inspectText(const String &text, const String &src, const String &host, bool isRequest) {
+    String low = text;
+    low.toLowerCase();
+    struct Pattern { const char *key; const char *kind; };
+    static const Pattern kPatterns[] = {
+        {"authorization: basic", "HTTP_BASIC"},
+        {"proxy-authorization", "PROXY_AUTH"},
+        {"cookie:", "COOKIE"},
+        {"set-cookie:", "SET_COOKIE"},
+        {"api_key", "API_KEY"},
+        {"apikey", "API_KEY"},
+        {"access_token", "TOKEN"},
+        {"password=", "PASSWORD"},
+        {"passwd=", "PASSWORD"},
+        {"pwd=", "PASSWORD"},
+        {"secret=", "SECRET"},
+        {"login=", "LOGIN"},
+    };
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(50)) != pdTRUE) return;
+    for (const auto &p : kPatterns) {
+        int idx = low.indexOf(p.key);
+        if (idx < 0) continue;
+        int e = text.indexOf('\r', idx);
+        if (e < 0) e = text.indexOf('\n', idx);
+        String raw = text.substring(idx, e < 0 ? min((int)text.length(), idx + 64) : e);
+        // Query/form values may contain &-separated fields; keep it short.
+        raw = seclabSafeText(raw, 60);
+        String detail = String(isRequest ? "REQ " : "RESP ") + redact(raw);
+        addFindingLocked(src, host, p.kind, detail);
+    }
+    persistStateLocked();
+    xSemaphoreGive(s_mux);
+}
+
+static String headerValue(const String &headers, const String &key) {
+    int i = headers.indexOf(key);
+    if (i < 0) return "";
+    i = headers.indexOf(':', i);
+    if (i < 0) return "";
+    int e = headers.indexOf('\n', i);
+    String v = headers.substring(i + 1, e < 0 ? headers.length() : e);
+    v.trim();
+    return v;
+}
+
+static void rewriteRequest(const String &raw, const String &host, String &out) {
+    // Replace the absolute-form request target with origin-form and strip
+    // hop-by-hop proxy headers. Everything else is passed through verbatim.
+    int firstLineEnd = raw.indexOf("\r\n");
+    if (firstLineEnd < 0) { out = raw; return; }
+    String first = raw.substring(0, firstLineEnd);
+    int sp1 = first.indexOf(' ');
+    int sp2 = sp1 < 0 ? -1 : first.indexOf(' ', sp1 + 1);
+    if (sp1 < 0 || sp2 < 0) { out = raw; return; }
+    String method = first.substring(0, sp1);
+    String target = first.substring(sp1 + 1, sp2);
+    String version = first.substring(sp2 + 1);
+    if (target.startsWith("http://")) {
+        int schemeEnd = target.indexOf('/', 7);
+        target = (schemeEnd < 0) ? "/" : target.substring(schemeEnd);
+    }
+    out = method + " " + target + " " + version + "\r\n";
+
+    String rest = raw.substring(firstLineEnd + 2);
+    int headersEnd = rest.indexOf("\r\n\r\n");
+    String headers = (headersEnd < 0) ? rest : rest.substring(0, headersEnd);
+    String body = (headersEnd < 0) ? "" : rest.substring(headersEnd + 4);
+
+    int pos = 0;
+    while (pos < headers.length()) {
+        int e = headers.indexOf("\r\n", pos);
+        String line = headers.substring(pos, e < 0 ? headers.length() : e);
+        String low = line;
+        low.toLowerCase();
+        if (!low.startsWith("proxy-connection:") && !low.startsWith("proxy-authorization:") &&
+            !low.startsWith("connection:") && !low.startsWith("keep-alive:") &&
+            !low.startsWith("upgrade:") && !low.startsWith("te:")) {
+            out += line + "\r\n";
+        }
+        if (e < 0) break;
+        pos = e + 2;
+    }
+    out += "Host: " + host + "\r\nConnection: close\r\n\r\n";
+    out += body;
+}
+
+static void sessionTask(void *arg) {
+    WiFiClient *cliPtr = (WiFiClient *)arg;
+    WiFiClient cli = *cliPtr;
+    delete cliPtr;
+    cli.setTimeout(1500);
+    String srcIp = cli.remoteIP().toString();
+
+    String raw;
+    uint32_t t0 = millis();
+    while (millis() - t0 < 2000 && raw.length() < kMaxInspect) {
+        if (cli.available()) {
+            raw += (char)cli.read();
+            if (raw.indexOf("\r\n\r\n") >= 0) break;
+        } else if (!cli.connected()) break;
+        else vTaskDelay(pdMS_TO_TICKS(3));
+    }
+    if (raw.isEmpty()) {
+        cli.stop();
+        s_activeSessions--;
+        vTaskDelete(NULL);
+        return;
+    }
+
+    // Read a small body too, if Content-Length is present and modest.
+    String cl = headerValue(raw, "content-length");
+    int bodyLen = cl.toInt();
+    int haveBody = 0;
+    int he = raw.indexOf("\r\n\r\n");
+    if (he >= 0) haveBody = raw.length() - he - 4;
+    if (bodyLen > 0 && bodyLen <= 2048 && haveBody < bodyLen) {
+        uint32_t tb = millis();
+        while (millis() - tb < 800 && (int)raw.length() - he - 4 < bodyLen && cli.available()) {
+            raw += (char)cli.read();
+        }
+    }
+
+    s_requests++;
+    int firstEnd = raw.indexOf("\r\n");
+    String first = raw.substring(0, firstEnd < 0 ? raw.length() : firstEnd);
+    int sp1 = first.indexOf(' ');
+    int sp2 = sp1 < 0 ? -1 : first.indexOf(' ', sp1 + 1);
+    String method = sp1 < 0 ? "" : first.substring(0, sp1);
+    String target = (sp1 < 0 || sp2 < 0) ? "" : first.substring(sp1 + 1, sp2);
+
+    if (target == "/wpad.dat" || first.indexOf("/wpad.dat") >= 0) {
+        String pac = wpadPac();
+        cli.printf("HTTP/1.1 200 OK\r\nContent-Type: application/x-ns-proxy-autoconfig\r\n"
+                   "Content-Length: %u\r\nConnection: close\r\n\r\n", (unsigned)pac.length());
+        cli.print(pac);
+        cli.stop();
+        s_activeSessions--;
+        vTaskDelete(NULL);
+        return;
+    }
+
+    if (method == "CONNECT") {
+        s_connectRefused++;
+        ensureMux();
+        if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(50)) == pdTRUE) {
+            addFindingLocked(srcIp, target, "HTTPS_CONNECT", "TLS not inspected; CONNECT refused");
+            persistStateLocked();
+            xSemaphoreGive(s_mux);
+        }
+        cli.print("HTTP/1.1 502 Bad Gateway\r\nContent-Length: 38\r\nConnection: close\r\n\r\n"
+                  "HTTPS/TLS is not intercepted by SecLab.\r\n");
+        cli.stop();
+        s_activeSessions--;
+        vTaskDelete(NULL);
+        return;
+    }
+
+    String host = headerValue(raw, "Host");
+    uint16_t port = 80;
+    if (target.startsWith("http://")) {
+        int schemeEnd = target.indexOf('/', 7);
+        String authority = (schemeEnd < 0) ? target.substring(7) : target.substring(7, schemeEnd);
+        int colon = authority.indexOf(':');
+        host = colon < 0 ? authority : authority.substring(0, colon);
+        if (colon >= 0) port = (uint16_t)authority.substring(colon + 1).toInt();
+    }
+    if (host.isEmpty()) host = target;
+    int hostColon = host.indexOf(':');
+    if (hostColon >= 0) {
+        port = (uint16_t)host.substring(hostColon + 1).toInt();
+        host = host.substring(0, hostColon);
+    }
+    if (port == 0) port = 80;
+
+    inspectText(raw, srcIp, host, true);
+
+    WiFiClient up;
+    up.setTimeout(2500);
+    bool ok = up.connect(host.c_str(), port, 3500);
+    if (!ok) {
+        cli.print("HTTP/1.1 502 Bad Gateway\r\nContent-Length: 20\r\nConnection: close\r\n\r\n"
+                  "Upstream failed.\r\n");
+        cli.stop();
+        s_activeSessions--;
+        vTaskDelete(NULL);
+        return;
+    }
+    up.setNoDelay(true);
+    String fwd;
+    rewriteRequest(raw, host, fwd);
+    up.print(fwd);
+    s_forwarded++;
+
+    String head;
+    uint32_t t1 = millis();
+    while (millis() - t1 < 4000) {
+        int avail = up.available();
+        if (avail > 0) {
+            while (avail-- > 0 && cli.connected()) {
+                char c = (char)up.read();
+                cli.write((uint8_t)c);
+                if (head.length() < 2048) head += c;
+            }
+        } else if (!up.connected() && !up.available()) {
+            break;
+        } else {
+            vTaskDelay(pdMS_TO_TICKS(3));
+        }
+        if (!cli.connected()) break;
+    }
+    if (!head.isEmpty()) inspectText(head, srcIp, host, false);
+    up.stop();
+    cli.stop();
+    s_activeSessions--;
+    vTaskDelete(NULL);
+}
+
+static void inspectorTask(void *) {
+    s_server->begin();
+    s_server->setTimeout(1);
+    uint32_t lastState = 0;
+    while (!s_stopReq) {
+        WiFiClient incoming = s_server->available();
+        if (incoming) {
+            if (s_activeSessions >= kMaxSessions) {
+                incoming.print("HTTP/1.1 503 Busy\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
+                incoming.stop();
+            } else {
+                WiFiClient *arg = new WiFiClient(incoming);
+                if (arg) {
+                    s_activeSessions++;
+                    TaskHandle_t th = nullptr;
+                    if (xTaskCreatePinnedToCore(sessionTask, "httpInsp", 5120, arg, 2, &th, 0) != pdPASS) {
+                        delete arg;
+                        s_activeSessions--;
+                        incoming.stop();
+                    }
+                } else {
+                    incoming.stop();
+                }
+            }
+        }
+        if (millis() - lastState > 2000) {
+            lastState = millis();
+            ensureMux();
+            if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                persistStateLocked();
+                xSemaphoreGive(s_mux);
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(12));
+    }
+    s_server->stop();
+    delete s_server;
+    s_server = nullptr;
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(200)) == pdTRUE) {
+        persistStateLocked();
+        xSemaphoreGive(s_mux);
+    }
+    s_running = false;
+    s_task = nullptr;
+    vTaskDelete(NULL);
+}
+
+static bool startEngine(uint16_t port, String *errOut) {
+    if (s_running) return true;
+    if (!WiFi.isConnected() && !(WiFi.getMode() & WIFI_MODE_AP)) {
+        if (errOut) *errOut = "Start STA or AP/NAPT first";
+        return false;
+    }
+    s_port = port ? port : bruceConfig.seclabPlus.httpInspectorPort;
+    if (s_port < 1024) s_port = 3128;
+    ensureMux();
+    s_lastErr[0] = 0;
+    s_startedMs = millis();
+    s_stopReq = false;
+    s_server = new WiFiServer(s_port);
+    if (!s_server) { if (errOut) *errOut = "Out of RAM"; return false; }
+    s_running = true;
+    if (xTaskCreatePinnedToCore(inspectorTask, "httpInspSrv", 4096, nullptr, 2, &s_task, 0) != pdPASS) {
+        s_running = false;
+        delete s_server;
+        s_server = nullptr;
+        setErr("HTTP inspector task spawn failed");
+        if (errOut) *errOut = s_lastErr;
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+bool naptHttpInspectorStart(uint16_t port, String *errOut) { return startEngine(port, errOut); }
+
+void naptHttpInspectorStop() {
+    if (!s_running) return;
+    s_stopReq = true;
+    for (int i = 0; i < 80 && s_running; i++) vTaskDelay(pdMS_TO_TICKS(25));
+}
+
+bool naptHttpInspectorIsRunning() { return s_running; }
+
+void naptHttpInspectorClear() {
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(200)) == pdTRUE) {
+        s_findings.clear();
+        s_requests = s_forwarded = s_connectRefused = 0;
+        s_lastErr[0] = 0;
+        persistStateLocked();
+        xSemaphoreGive(s_mux);
+    }
+    LittleFS.remove(kLogPath);
+    LittleFS.remove(kJsonPath);
+}
+
+bool naptHttpInspectorExport() {
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(200)) == pdTRUE) {
+        exportFindingsLocked();
+        xSemaphoreGive(s_mux);
+    }
+    return LittleFS.exists(kJsonPath);
+}
+
+String naptHttpInspectorGetStateJson() {
+    ensureMux();
+    if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(100)) != pdTRUE) return seclabReadState(kStatePath);
+    String j = "{";
+    j += "\"running\":" + String(s_running ? "true" : "false") + ",";
+    j += "\"port\":" + String((int)s_port) + ",";
+    j += "\"redact\":" + String(bruceConfig.seclabPlus.httpInspectorRedact ? "true" : "false") + ",";
+    j += "\"auto\":" + String(bruceConfig.seclabPlus.httpInspectorAutoStart ? "true" : "false") + ",";
+    j += "\"lastErr\":\"" + seclabJsonEscape(s_lastErr) + "\",";
+    j += "\"requests\":" + String((unsigned long)s_requests) + ",";
+    j += "\"forwarded\":" + String((unsigned long)s_forwarded) + ",";
+    j += "\"httpsRefused\":" + String((unsigned long)s_connectRefused) + ",";
+    j += "\"sessions\":" + String((int)s_activeSessions) + ",";
+    j += "\"uptimeSec\":" + String(s_running ? (unsigned long)((millis() - s_startedMs) / 1000UL) : 0UL) + ",";
+    j += "\"wpadUrl\":\"http://" + (WiFi.getMode() & WIFI_MODE_AP ? WiFi.softAPIP().toString()
+                                                                  : WiFi.localIP().toString()) +
+         ":" + String((int)s_port) + "/wpad.dat\",";
+    j += String("\"log\":\"") + kLogPath + "\",\"json\":\"" + kJsonPath + "\",";
+    j += "\"findings\":[";
+    for (size_t i = 0; i < s_findings.size(); i++) {
+        const Finding &f = s_findings[i];
+        if (i) j += ",";
+        j += "{\"ts\":" + String((unsigned long)f.tsSec) + ",\"src\":\"" + f.src +
+             "\",\"host\":\"" + seclabJsonEscape(f.host) + "\",\"kind\":\"" + f.kind +
+             "\",\"detail\":\"" + seclabJsonEscape(f.detail) + "\"}";
+    }
+    j += "]}";
+    xSemaphoreGive(s_mux);
+    return j;
+}
+
+void napt_http_inspector_setup() {
+    int choice = -1;
+    bool redact = bruceConfig.seclabPlus.httpInspectorRedact;
+    bool autostart = bruceConfig.seclabPlus.httpInspectorAutoStart;
+    options = {
+        {naptHttpInspectorIsRunning() ? "Stop HTTP Inspector" : "Start HTTP Inspector", [&]() { choice = 0; }},
+        {String("Redact values: ") + (redact ? "ON" : "OFF"), [&]() { choice = 1; }},
+        {String("Auto with #1 NAPT: ") + (autostart ? "ON" : "OFF"), [&]() { choice = 2; }},
+        {String("Proxy port: ") + bruceConfig.seclabPlus.httpInspectorPort, [&]() { choice = 6; }},
+        {"Export Findings", [&]() { choice = 3; }},
+        {"Clear Findings", [&]() { choice = 4; }},
+        {"Back", [&]() { choice = 5; }},
+    };
+    loopOptions(options, MENU_TYPE_SUBMENU, "NAPT HTTP Inspector");
+    options.clear();
+
+    if (choice == 1 || choice == 2) {
+        if (choice == 1) bruceConfig.seclabPlus.httpInspectorRedact = !redact;
+        else bruceConfig.seclabPlus.httpInspectorAutoStart = !autostart;
+        bruceConfig.saveFile();
+        displayInfo("Setting saved", true);
+        return;
+    }
+    if (choice == 6) {
+        if (naptHttpInspectorIsRunning()) {
+            displayWarning("Stop HTTP Inspector before changing the proxy port", true);
+            return;
+        }
+        String v = num_keyboard(String(bruceConfig.seclabPlus.httpInspectorPort), 5, "Proxy port (1024-65535)");
+        if (v != "\x1B" && !v.isEmpty()) {
+            long n = v.toInt();
+            if (n < 1024 || n > 65535) { displayError("Proxy port must be 1024-65535", true); return; }
+            bruceConfig.seclabPlus.httpInspectorPort = (uint16_t)n;
+            bruceConfig.validateSecLabPlus();
+            bruceConfig.saveFile();
+            displayInfo(String("Proxy port: ") + bruceConfig.seclabPlus.httpInspectorPort, true);
+        }
+        return;
+    }
+    if (choice == 3) {
+        naptHttpInspectorExport();
+        displayInfo("Saved /napt_http_findings.json", true);
+        return;
+    }
+    if (choice == 4) { naptHttpInspectorClear(); displayInfo("Findings cleared", true); return; }
+    if (choice != 0) return;
+
+    if (naptHttpInspectorIsRunning()) {
+        naptHttpInspectorStop();
+        displayInfo("HTTP Inspector stopped", true);
+        return;
+    }
+    String err;
+    if (!naptHttpInspectorStart(0, &err)) { displayError("Start failed: " + err, true); return; }
+
+    uint32_t lastDraw = 0;
+    while (s_running) {
+        if (check(EscPress)) { naptHttpInspectorStop(); break; }
+        if (millis() - lastDraw > 500) {
+            lastDraw = millis();
+            drawMainBorderWithTitle("HTTP INSPECTOR");
+            ensureMux();
+            if (xSemaphoreTake(s_mux, pdMS_TO_TICKS(50)) == pdTRUE) {
+                padprintln("Proxy : " + (WiFi.getMode() & WIFI_MODE_AP ? WiFi.softAPIP().toString()
+                                                                        : WiFi.localIP().toString()) +
+                           ":" + String((int)s_port));
+                padprintln("WPAD  : /wpad.dat on this port");
+                padprintln("Requests / Forwarded");
+                padprintln(String((unsigned long)s_requests) + " / " + String((unsigned long)s_forwarded));
+                padprintln("HTTPS refused: " + String((unsigned long)s_connectRefused));
+                padprintln("Cleartext hits: " + String((int)s_findings.size()));
+                padprintln("");
+                int shown = 0;
+                for (auto it = s_findings.rbegin(); it != s_findings.rend() && shown < 3; ++it, ++shown) {
+                    padprintln(String(it->kind) + " " + String(it->host));
+                }
+                xSemaphoreGive(s_mux);
+            }
+            padprintln("Hold Boot to stop");
+        }
+        vTaskDelay(pdMS_TO_TICKS(30));
+    }
+}
