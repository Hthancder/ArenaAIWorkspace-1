{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piano-app/design-tokens",
  "version": "1.0.0",
  "note": "Sinh tokens.css + tailwind.config từ file này. Nguồn sự thật: research-piano/43-he-thong-thiet-ke-chi-tiet.md",
  "color": {
    "canvas": "#05060a",
    "canvas-raised": "#0a0b10",
    "glass-fill": "rgba(16,17,20,.58)",
    "glass-fill-strong": "rgba(16,17,20,.82)",
    "glass-fill-solid": "#15161a",
    "glass-edge": "rgba(255,255,255,.10)",
    "glass-highlight": "rgba(255,255,255,.07)",
    "scrim": "rgba(5,6,10,.45)",
    "ink": "#f3f2ee",
    "ink-muted": "rgba(255,255,255,.66)",
    "ink-faint": "rgba(255,255,255,.44)",
    "ink-disabled": "rgba(255,255,255,.28)",
    "on-ink": "#0e0f11",
    "fill-hover": "rgba(255,255,255,.07)",
    "fill-active": "rgba(255,255,255,.10)",
    "fill-selected": "rgba(255,255,255,.13)",
    "fill-field": "rgba(255,255,255,.07)",
    "fill-track": "rgba(255,255,255,.16)",
    "fill-well": "rgba(0,0,0,.32)",
    "record": "#ff5a4f",
    "danger": "#ff8b80",
    "success": "#5ad7a5",
    "warning": "#f5c451",
    "logo-note": "#5ad7ff",
    "note-default": "#f3f2ee",
    "note-left": "#6aa9ff",
    "note-right": "#ffb26a",
    "focus-ring": "#ffffff"
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px"
  },
  "radius": {
    "control": "8px",
    "panel": "16px",
    "dialog": "20px",
    "pill": "999px",
    "note": "2px",
    "chip": "10px"
  },
  "size": {
    "h-control-sm": "28px",
    "h-control": "32px",
    "h-control-lg": "40px",
    "h-icon-btn": "28px",
    "h-play": "44px",
    "h-pill": "52px",
    "h-bar": "36px",
    "h-tab": "30px",
    "w-panel": "320px",
    "w-panel-wide": "380px",
    "w-inspector": "260px",
    "w-label": "96px",
    "touch-min": "44px",
    "scrollbar": "8px"
  },
  "blur": {
    "glass": "36px",
    "glass-saturate": "1.5",
    "scrim": "8px"
  },
  "shadow": {
    "glass": "inset 0 1px 0 rgba(255,255,255,.07), 0 10px 40px rgba(0,0,0,.35)",
    "pop": "0 16px 48px rgba(0,0,0,.55)",
    "focus": "0 0 0 2px #ffffff"
  },
  "typography": {
    "font-sans": "\"Geist Variable\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "font-mono": "\"Geist Mono\", ui-monospace, \"SF Mono\", monospace",
    "scale": {
      "display":  { "size": "32px", "line": 1.2,  "weight": 600 },
      "title":    { "size": "22px", "line": 1.3,  "weight": 600 },
      "heading":  { "size": "16px", "line": 1.4,  "weight": 600 },
      "label":    { "size": "12px", "line": 1.35, "weight": 500 },
      "label-caps": { "size": "11px", "line": 1.3, "weight": 600, "letterSpacing": "0.06em", "uppercase": true },
      "body":     { "size": "14px", "line": 1.45, "weight": 400 },
      "body-sm":  { "size": "13px", "line": 1.45, "weight": 400 },
      "caption":  { "size": "12px", "line": 1.35, "weight": 400 },
      "mono":     { "size": "13px", "line": 1.4,  "weight": 400, "tabularNums": true }
    },
    "minSize": "12px",
    "vietnamese": { "minLineHeight": 1.35, "avoidUppercaseOnDiacritics": true }
  },
  "motion": {
    "duration": { "instant": "80ms", "fast": "120ms", "base": "180ms", "slow": "240ms" },
    "easing": {
      "out": "cubic-bezier(.2,.8,.2,1)",
      "in-out": "cubic-bezier(.4,0,.2,1)"
    },
    "chromeAutoHideMs": 2000,
    "reducedMotion": "all 0ms except progress"
  },
  "z": {
    "canvas": 0, "hud": 10, "island": 20, "pill": 30,
    "panel": 40, "popover": 50, "dialog": 60, "toast": 70, "tooltip": 80
  },
  "breakpoint": { "sm": "768px", "md": "1024px", "lg": "1280px", "xl": "1440px" },
  "icon": { "library": "lucide", "strokeWidth": 1.75, "sizes": [16, 20, 24, 40] }
}
